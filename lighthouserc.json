{
  "ci": {
    "collect": {
      "staticDistDir": "./dist",
      "url": [
        "http://localhost/index.html",
        "http://localhost/for-renters/index.html",
        "http://localhost/rental-calculator/index.html",
        "http://localhost/all-calculator/index.html",
        "http://localhost/blog/index.html",
        "http://localhost/blog/ontario-property-taxes-rising/index.html",
        "http://localhost/contact/index.html"
      ],
      "numberOfRuns": 1,
      "settings": {
        "preset": "desktop"
      }
    },
    "assert": {
      "assertions": {
        "categories:performance": ["warn", {"minScore": 0.85}],
        "categories:accessibility": ["error", {"minScore": 0.90}],
        "categories:best-practices": ["warn", {"minScore": 0.90}],
        "categories:seo": ["error", {"minScore": 0.90}]
      }
    },
    "upload": {
      "target": "temporary-public-storage"
    }
  }
}
