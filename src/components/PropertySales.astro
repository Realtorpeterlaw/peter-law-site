---
import { propertySales } from '../data/propertySales';

export interface Props {
  zh?: boolean;
}
const { zh = false } = Astro.props;

const labels = zh
  ? {
      housesTab: '独立屋',
      condosTab: '公寓',
      rentalTab: '租赁',
      allSub: '全部',
      sellerSub: '卖家',
      buyerSub: '买家',
      landlordSub: '房东',
      tenantSub: '租客',
      viewDetails: '查看详情 →',
      bedroom: '卧室',
      bathroom: '浴室',
      parking: '车位',
      emptyState: '该分类下暂无成交记录。',
    }
  : {
      housesTab: 'House',
      condosTab: 'Condo',
      rentalTab: 'Rental',
      allSub: 'All',
      sellerSub: 'Seller',
      buyerSub: 'Buyer',
      landlordSub: 'Landlord',
      tenantSub: 'Renter',
      viewDetails: 'View details →',
      bedroom: 'Bedroom',
      bathroom: 'Bathroom',
      parking: 'Parking',
      emptyState: 'No listings in this category yet.',
    };
---
<section class="property-sales">
  <div class="wrap">
    <div class="sales-filter" role="tablist" aria-label="Filter by property type">
      <button type="button" class="sales-filter-tab is-active" data-filter="House" role="tab" aria-selected="true">{labels.housesTab}</button>
      <button type="button" class="sales-filter-tab" data-filter="Condo" role="tab" aria-selected="false">{labels.condosTab}</button>
      <button type="button" class="sales-filter-tab" data-filter="Rental" role="tab" aria-selected="false">{labels.rentalTab}</button>
    </div>
    <div class="sales-subfilter" role="tablist" aria-label="Filter by representation">
      <button type="button" class="sales-subfilter-tab is-active" data-subfilter="all" role="tab" aria-selected="true">{labels.allSub}</button>
      <button type="button" class="sales-subfilter-tab" data-subfilter="seller" data-for="House,Condo" role="tab" aria-selected="false">{labels.sellerSub}</button>
      <button type="button" class="sales-subfilter-tab" data-subfilter="buyer" data-for="House,Condo" role="tab" aria-selected="false">{labels.buyerSub}</button>
      <button type="button" class="sales-subfilter-tab" data-subfilter="landlord" data-for="Rental" role="tab" aria-selected="false" hidden>{labels.landlordSub}</button>
      <button type="button" class="sales-subfilter-tab" data-subfilter="tenant" data-for="Rental" role="tab" aria-selected="false" hidden>{labels.tenantSub}</button>
    </div>
    <div class="sales-grid" data-empty-text={labels.emptyState}>
      {propertySales.map((p) => (
        <article class="sale-card" data-category={p.category} data-role={p.role || ''}>
          <div class="sale-card-photo">
            <picture>
              <source srcset={p.photo.replace(/\.jpg$/, '.webp')} type="image/webp" />
              <img src={p.photo} alt={`${zh ? p.propertyName_zh : p.propertyName_en}, ${zh ? p.address_zh : p.address_en}`} loading="lazy" />
            </picture>
          </div>
          <div class="sale-card-info">
            <div class="sale-status-group">
              <div class="sale-status">{zh ? p.status_zh : p.status_en}</div>
              {(zh ? p.representation_zh : p.representation_en) && (
                <div class="sale-rep">{zh ? p.representation_zh : p.representation_en}</div>
              )}
              {(zh ? p.representationNote_zh : p.representationNote_en) && (
                <div class="sale-rep-note">{zh ? p.representationNote_zh : p.representationNote_en}</div>
              )}
            </div>
            <div class="sale-price">{p.price}</div>
            <div class="sale-name">{zh ? p.propertyName_en : p.propertyName_en}</div>
            <div class="sale-address">{zh ? p.address_zh : p.address_en}</div>
            <div class="sale-features">
              <span>{p.bedrooms} {labels.bedroom}</span><span class="dot"> · </span><span>{p.bathrooms} {labels.bathroom}</span>{typeof p.parking === 'number' && p.parking > 0 && (<><span class="dot"> · </span><span>{p.parking} {labels.parking}</span></>)}
            </div>
            {(zh ? p.houseStyle_zh : p.houseStyle_en) && (
              <div class="sale-house-style">{zh ? p.houseStyle_zh : p.houseStyle_en}</div>
            )}
            <details class="sale-details">
              <summary class="sale-details-summary">{labels.viewDetails}</summary>
              <div class="sale-details-body">
                {(zh ? p.details_zh : p.details_en)
                  ? <p>{zh ? p.details_zh : p.details_en}</p>
                  : <p class="sale-details-empty">{zh ? '更多详情即将更新。' : 'More details coming soon.'}</p>}
              </div>
            </details>
          </div>
        </article>
      ))}
    </div>
  </div>
</section>

<script is:inline>
  (function () {
    function init() {
      document.querySelectorAll('.property-sales').forEach(function (section) {
        var tabs = section.querySelectorAll('.sales-filter-tab');
        var subTabs = section.querySelectorAll('.sales-subfilter-tab');
        var cards = section.querySelectorAll('.sale-card');
        var grid = section.querySelector('.sales-grid');
        var currentCategory = 'House';
        var currentRole = 'all';
        function updateSubTabsVisibility(cat) {
          subTabs.forEach(function (btn) {
            var forVal = btn.getAttribute('data-for');
            var isAll = btn.getAttribute('data-subfilter') === 'all';
            if (isAll) { btn.hidden = false; return; }
            btn.hidden = !forVal || forVal.split(',').indexOf(cat) === -1;
          });
          // If active sub isn't valid for the new category, reset to 'all'
          var activeSub = section.querySelector('.sales-subfilter-tab.is-active');
          if (activeSub && activeSub.hidden) {
            subTabs.forEach(function (b) {
              b.classList.remove('is-active');
              b.setAttribute('aria-selected', 'false');
            });
            var allBtn = section.querySelector('.sales-subfilter-tab[data-subfilter="all"]');
            if (allBtn) {
              allBtn.classList.add('is-active');
              allBtn.setAttribute('aria-selected', 'true');
            }
            currentRole = 'all';
          }
        }
        function applyFilters() {
          var visible = 0;
          cards.forEach(function (card) {
            var catMatch = card.getAttribute('data-category') === currentCategory;
            var role = card.getAttribute('data-role') || '';
            var roleMatch = currentRole === 'all' || role === currentRole;
            var matches = catMatch && roleMatch;
            card.style.display = matches ? '' : 'none';
            if (matches) visible++;
          });
          var existingEmpty = grid.querySelector('.sale-empty');
          if (existingEmpty) existingEmpty.remove();
          if (visible === 0) {
            var msg = document.createElement('div');
            msg.className = 'sale-empty';
            msg.textContent = grid.getAttribute('data-empty-text') || '';
            grid.appendChild(msg);
          }
        }
        // Legacy applyFilter kept for backwards compat with any external caller
        function applyFilter(filter) {
          var visible = 0;
          cards.forEach(function (card) {
            var matches = card.getAttribute('data-category') === filter;
            card.style.display = matches ? '' : 'none';
            if (matches) visible++;
          });
          var emptyMsg = grid.querySelector('.sales-empty');
          if (visible === 0) {
            if (!emptyMsg) {
              emptyMsg = document.createElement('div');
              emptyMsg.className = 'sales-empty';
              emptyMsg.textContent = grid.getAttribute('data-empty-text') || '';
              grid.appendChild(emptyMsg);
            }
          } else if (emptyMsg) {
            emptyMsg.remove();
          }
        }
        tabs.forEach(function (tab) {
          tab.addEventListener('click', function () {
            tabs.forEach(function (t) {
              t.classList.remove('is-active');
              t.setAttribute('aria-selected', 'false');
            });
            tab.classList.add('is-active');
            tab.setAttribute('aria-selected', 'true');
            currentCategory = tab.getAttribute('data-filter');
            updateSubTabsVisibility(currentCategory);
            applyFilters();
          });
        });
        subTabs.forEach(function (btn) {
          btn.addEventListener('click', function () {
            if (btn.hidden) return;
            subTabs.forEach(function (b) {
              b.classList.remove('is-active');
              b.setAttribute('aria-selected', 'false');
            });
            btn.classList.add('is-active');
            btn.setAttribute('aria-selected', 'true');
            currentRole = btn.getAttribute('data-subfilter');
            applyFilters();
          });
        });
        var activeTab = section.querySelector('.sales-filter-tab.is-active');
        if (activeTab) {
          currentCategory = activeTab.getAttribute('data-filter');
          updateSubTabsVisibility(currentCategory);
        }
        applyFilters();
      });
    }
    if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', init);
    else init();
  })();
</script>

<style>
  .property-sales { padding: 24px 0 16px; }

  .sales-filter {
    display: flex;
    gap: 32px;
    margin-bottom: 28px;
    border-bottom: 1px solid var(--rule);
  }
  .sales-filter-tab {
    background: transparent;
    border: none;
    border-bottom: 2px solid transparent;
    padding: 12px 0;
    font-family: inherit;
    font-size: 14px;
    color: var(--ink-mute);
    cursor: pointer;
    letter-spacing: 0.02em;
    transition: color 0.15s, border-color 0.15s;
    margin-bottom: -1px;
  }
  .sales-filter-tab:hover { color: var(--ink-soft); }
  .sales-filter-tab.is-active {
    color: var(--ink);
    border-bottom-color: var(--ink);
    font-weight: 600;
  }

  .sales-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 20px;
    /* Show ~5 cards at once; internal scroll keeps the rest reachable
       without pushing content below off-screen. */
    max-height: calc(5 * 220px + 4 * 20px + 16px);
    overflow-y: auto;
    overscroll-behavior: contain;            /* stop scroll-chain to page */
    scroll-behavior: smooth;
    padding-right: 10px;                     /* room for scrollbar so it doesn't overlap card border */
    /* Subtle top/bottom fade on the scroll edges — quiet-luxury cue that
       more content is available above/below. */
    mask-image: linear-gradient(180deg, transparent 0, #000 24px, #000 calc(100% - 24px), transparent 100%);
    -webkit-mask-image: linear-gradient(180deg, transparent 0, #000 24px, #000 calc(100% - 24px), transparent 100%);
  }
  /* Minimal scrollbar styling — thin, matches the site's rule/ink tokens. */
  .sales-grid::-webkit-scrollbar { width: 8px; }
  .sales-grid::-webkit-scrollbar-track { background: transparent; }
  .sales-grid::-webkit-scrollbar-thumb {
    background: var(--rule);
    border-radius: 999px;
    border: 2px solid transparent;
    background-clip: padding-box;
  }
  .sales-grid::-webkit-scrollbar-thumb:hover { background: var(--ink-mute); background-clip: padding-box; }
  .sales-grid { scrollbar-width: thin; scrollbar-color: var(--rule) transparent; }

  @media (max-width: 720px) {
    /* Mobile: cards stack (image on top → taller) — cap at ~85vh so page
       still fits everything, but internal scroll kicks in for long lists. */
    .sales-grid { max-height: 85vh; padding-right: 6px; }
  }

  .sale-card {
    display: grid;
    grid-template-columns: 260px 1fr;
    gap: 28px;
    padding: 22px;
    background: var(--surface);
    border: 1px solid var(--rule);
    border-radius: 6px;
    align-items: center;
  }

  .sale-card-photo {
    aspect-ratio: 4 / 3;
    border-radius: 4px;
    overflow: hidden;
    background: var(--bg-warm);
  }
  .sale-card-photo img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .sale-card-info { display: flex; flex-direction: column; position: relative; padding-right: 130px; }

  .sale-card-top {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 16px;
    margin-bottom: 0;
  }
  .sale-price {
    font-family: 'Fraunces', Georgia, serif;
    font-size: 28px;
    font-weight: 500;
    color: var(--ink);
    letter-spacing: -0.01em;
    line-height: 1.1;
  }
  .sale-status-group {
    position: absolute;
    top: 0;
    right: 0;
    text-align: right;
    display: flex;
    flex-direction: column;
    align-items: flex-end;
    gap: 4px;
  }
  .sale-status {
    font-size: 11px;
    text-transform: uppercase;
    letter-spacing: 0.18em;
    color: var(--ink-mute);
    font-weight: 600;
  }
  .sale-rep {
    font-size: 12px;
    color: var(--ink-soft);
    letter-spacing: 0.01em;
    font-style: italic;
  }
  .sale-rep-note {
    font-size: 11px;
    color: var(--ink-mute);
    letter-spacing: 0.01em;
    margin-top: 2px;
  }

  .sale-name {
    font-family: 'Fraunces', Georgia, serif;
    font-style: italic;
    font-size: 20px;
    color: var(--ink);
    margin-top: 2px;
  }
  .sale-address {
    font-size: 13px;
    color: var(--ink-mute);
    margin-top: 2px;
  }
  .sale-features {
    font-size: 14px;
    color: var(--ink-soft);
    margin-top: 10px;
  }
  .sale-features .dot { color: var(--ink-mute); margin: 0 2px; }
  .sale-house-style {
    font-size: 13px;
    color: var(--ink-mute);
    letter-spacing: 0.02em;
    margin-top: 2px;
    font-style: italic;
  }
  .sale-details {
    margin-top: 12px;
    align-self: stretch;
  }
  .sale-details-summary {
    cursor: pointer;
    list-style: none;
    font-size: 14px;
    color: var(--ink);
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 4px;
    display: inline-block;
    transition: color 0.15s;
  }
  .sale-details-summary::-webkit-details-marker { display: none; }
  .sale-details-summary::marker { content: ''; }
  .sale-details-summary:hover { color: var(--ink-soft); }
  .sale-details[open] .sale-details-summary { color: var(--ink-soft); }
  .sale-details-body {
    margin-top: 12px;
    padding-top: 12px;
    border-top: 1px solid var(--rule);
    font-size: 14px;
    color: var(--ink-soft);
    line-height: 1.55;
  }
  .sale-details-body p { margin: 0; }
  .sale-details-empty {
    color: var(--ink-mute);
    font-style: italic;
  }

  .sales-empty {
    text-align: center;
    padding: 56px 24px;
    color: var(--ink-mute);
    font-size: 15px;
    border: 1px dashed var(--rule);
    border-radius: 6px;
  }

  @media (max-width: 640px) {
    .sale-card-info { padding-right: 0; }
    .sale-status-group { position: static; align-items: flex-start; text-align: left; margin-bottom: 8px; }
    .sale-card { grid-template-columns: 1fr; padding: 18px; gap: 20px; }
    .sale-card-photo { aspect-ratio: 4 / 3; max-height: 240px; }
    .sale-price { font-size: 24px; }
    .sale-name { font-size: 18px; }
  }

  /* Second-tier filter: Seller/Buyer (Sales) or Landlord/Renter (Rental) */
  .sales-subfilter {
    display: flex;
    gap: 8px;
    margin: -12px 0 24px;
    padding: 0;
    flex-wrap: wrap;
  }
  .sales-subfilter-tab {
    background: transparent;
    border: 1px solid var(--rule);
    border-radius: 999px;
    padding: 6px 14px;
    font-size: 13px;
    font-family: inherit;
    color: var(--ink-mute);
    cursor: pointer;
    letter-spacing: 0.02em;
    transition: color 0.15s, border-color 0.15s, background 0.15s;
  }
  .sales-subfilter-tab:hover { color: var(--ink); border-color: var(--ink-mute); }
  .sales-subfilter-tab.is-active {
    color: var(--surface);
    background: var(--ink);
    border-color: var(--ink);
    font-weight: 500;
  }
  .sales-subfilter-tab[hidden] { display: none; }
  .sales-subfilter-tab:focus-visible {
    outline: 2px solid var(--ink);
    outline-offset: 2px;
  }
  @media (max-width: 480px) {
    .sales-subfilter { margin-top: -8px; margin-bottom: 20px; }
    .sales-subfilter-tab { padding: 5px 12px; font-size: 12.5px; }
  }
</style>
