---
// Shared rental questionnaire (homepage hero + For Renters, Step 2).
interface Props { id?: string; subject?: string; }
const { id = 'rental-questionnaire', subject = 'New Rental Questionnaire (French)' } = Astro.props;
---
<form id={id} class="quiz-form" method="POST" action="https://formspree.io/f/xnjrzgda" style="scroll-margin-top:100px">
  <div class="quiz-eyebrow">Questionnaire de location</div>
  <h2 class="quiz-heading">Que recherchez-vous?</h2>
  <p class="quiz-sub">(Durée minimale de 1 an)</p>
  <div class="quiz-fields">
    <div class="quiz-field">
      <label for="quiz-beds">Chambres*</label>
      <select id="quiz-beds" name="bedrooms" required>
        <option value="">Sélectionner…</option>
        <option>Studio</option>
        <option>1 CAC</option>
        <option>1 CAC + Bureau</option>
        <option>2 CAC</option>
        <option>3 CAC</option>
        <option>4+ CAC</option>
      </select>
    </div>
    <div class="quiz-field">
      <label for="quiz-baths">Salles de bain*</label>
      <select id="quiz-baths" name="bathrooms" required>
        <option value="">Sélectionner…</option>
        <option>1</option><option>1.5</option><option>2</option><option>2.5</option><option>3+</option>
      </select>
    </div>
    <div class="quiz-field">
      <label for="quiz-parking">Stationnement*</label>
      <select id="quiz-parking" name="parking" required>
        <option value="">Sélectionner…</option>
        <option>Pas nécessaire</option>
        <option>1 place</option>
        <option>2 places</option>
        <option>3+ places</option>
      </select>
    </div>
    <div class="quiz-field">
      <label for="quiz-budget">Budget / mois*</label>
      <select id="quiz-budget" name="budget" required>
        <option value="">Sélectionner…</option>
        <option>Moins de 2 000 $</option>
        <option>2 000 $ à 2 500 $</option>
        <option>2 500 $ à 3 000 $</option>
        <option>3 000 $ à 3 500 $</option>
        <option>3 500 $ à 4 500 $</option>
        <option>4 500 $ et plus</option>
      </select>
    </div>
    <div class="quiz-field">
      <label for="quiz-movein">Date d'emménagement*</label>
      <input id="quiz-movein" name="move_in_date" type="date" required>
    </div>
    <div class="quiz-field">
      <label for="quiz-notice">Préavis de 60 jours donné au propriétaire?*</label>
      <select id="quiz-notice" name="landlord_notice_60_days" required>
        <option value="">Sélectionner…</option>
        <option>Oui</option>
        <option>Non</option>
        <option>Non applicable</option>
      </select>
    </div>
    <div class="quiz-field quiz-field-full">
      <label>Secteur souhaité* <span class="quiz-hint">(cochez toutes les options qui s'appliquent)</span></label>
      <div class="quiz-checkboxes" data-checkbox-group="location">
        <label class="quiz-check"><input type="checkbox" name="location[]" value="Downtown Toronto (Yonge &amp; Dundas St)"> Centre-ville de Toronto (Yonge &amp; Dundas)</label>
        <label class="quiz-check"><input type="checkbox" name="location[]" value="King West / Liberty Village"> King West / Liberty Village</label>
        <label class="quiz-check"><input type="checkbox" name="location[]" value="Yonge & Bloor / Yorkville"> Yonge & Bloor / Yorkville</label>
        <label class="quiz-check"><input type="checkbox" name="location[]" value="Waterfront / Harbourfront"> Bord de l'eau / Harbourfront</label>
        <label class="quiz-check"><input type="checkbox" name="location[]" value="Yonge–Eglinton"> Yonge–Eglinton</label>
        <label class="quiz-check"><input type="checkbox" name="location[]" value="East Toronto (Leslieville, East York)"> Est de Toronto (Leslieville, East York)</label>
        <label class="quiz-check"><input type="checkbox" name="location[]" value="Markham / GTA North"> Markham / Nord du Grand Toronto</label>
        <label class="quiz-check"><input type="checkbox" name="location[]" value="Walking distance to Subway Station"> À distance de marche d'une station de métro</label>
        <label class="quiz-check"><input type="checkbox" name="location[]" value="Walking distance to Union Subway Station"> À distance de marche de la station Union</label>
        <label class="quiz-check"><input type="checkbox" name="location[]" value="Walking distance to UofT St. George"> À distance de marche de UofT St. George</label>
        <label class="quiz-check"><input type="checkbox" name="location[]" value="Walking distance to Waterfront"> À distance de marche du bord de l'eau</label>
        <label class="quiz-check"><input type="checkbox" name="location[]" value="Open to suggestions"> Ouvert aux suggestions</label>
      </div>
    </div>
    <div class="quiz-field">
      <label for="quiz-first-name">Prénom*</label>
      <input id="quiz-first-name" name="first_name" type="text" required autocomplete="given-name" placeholder="p. ex. Jacky">
    </div>
    <div class="quiz-field">
      <label for="quiz-last-name">Nom de famille*</label>
      <input id="quiz-last-name" name="last_name" type="text" required autocomplete="family-name" placeholder="p. ex. Chan">
    </div>
    <div class="quiz-field quiz-field-full">
      <label for="quiz-email">Courriel*</label>
      <input id="quiz-email" name="email" type="email" required autocomplete="email" placeholder="votre@email.com">
    </div>
  </div>
  <div class="hp-field" aria-hidden="true">
    <label for="quiz-gotcha">Ne pas remplir</label>
    <input id="quiz-gotcha" name="_gotcha" type="text" tabindex="-1" autocomplete="off">
  </div>
  <input type="hidden" name="_subject" value={subject}>
  <input type="hidden" name="_next" value="https://www.realtorpeterlaw.com/french/contact/thanks">
  <button type="submit" class="btn-primary quiz-cta">
    Commencer
    <svg width="14" height="14" viewBox="0 0 14 14" fill="none"><path d="M1 7h12M8 2l5 5-5 5" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/></svg>
  </button>
  <div class="quiz-cta-alt">
    <a href="/french/rental-calculator" class="btn-warm quiz-cta-warm">
      <svg width="15" height="15" viewBox="0 0 24 24" fill="none" aria-hidden="true"><rect x="5" y="3" width="14" height="18" rx="2" stroke="currentColor" stroke-width="1.8"/><line x1="8" y1="8" x2="16" y2="8" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/><circle cx="8.5" cy="12.5" r="1.2" fill="currentColor"/><circle cx="12" cy="12.5" r="1.2" fill="currentColor"/><circle cx="15.5" cy="12.5" r="1.2" fill="currentColor"/><circle cx="8.5" cy="16" r="1.2" fill="currentColor"/><circle cx="12" cy="16" r="1.2" fill="currentColor"/><circle cx="15.5" cy="16" r="1.2" fill="currentColor"/></svg>
      Calculateur de location
      <svg width="14" height="14" viewBox="0 0 14 14" fill="none" aria-hidden="true"><path d="M1 7h12M8 2l5 5-5 5" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/></svg>
    </a>
  </div>
</form>

<script>
  document.querySelectorAll('form.quiz-form').forEach(function(form){
    form.addEventListener('submit', function(e){
      var cbs = form.querySelectorAll('input[name="location[]"]');
      if (cbs.length && ![].some.call(cbs, function(cb){ return cb.checked; })) {
        e.preventDefault();
        alert('Veuillez sélectionner au moins un secteur.');
        cbs[0].focus();
      }
    });
  });
</script>
