---
// Rental History: every rental deal from src/data/recentDeals.ts, newest first.
// Replaces the former sales listings (removed for client confidentiality).
import { getDeals, type DealLang } from '../data/recentDeals';

interface Props { lang?: DealLang }
const { lang = 'en' } = Astro.props;
const deals = getDeals(lang);

const L = {
  en: { all: 'All', tenant: 'Renter side', landlord: 'Landlord side', filter: 'Filter by representation', leased: 'Leased', empty: 'No rentals in this category yet.', count: (n: number) => `${n} rentals` },
  zh: { all: '全部', tenant: '代表租客', landlord: '代表房东', filter: '按代表方筛选', leased: '已出租', empty: '该分类下暂无记录。', count: (n: number) => `${n} 笔租赁` },
  fr: { all: 'Tout', tenant: 'Côté locataire', landlord: 'Côté propriétaire', filter: 'Filtrer par représentation', leased: 'Loué', empty: 'Aucune location dans cette catégorie pour le moment.', count: (n: number) => `${n} locations` },
}[lang];

const roleOf = (status: string) => /landlord|房东|propri/i.test(status) ? 'landlord' : 'tenant';
const landlordCount = deals.filter((d) => roleOf(d.status) === 'landlord').length;
---
<section class="rental-history" data-empty-text={L.empty}>
  <div class="wrap">
    <div class="rh-toolbar">
      <div class="rh-filter" role="tablist" aria-label={L.filter}>
        <button type="button" class="rh-tab is-active" data-role-filter="all" role="tab" aria-selected="true">{L.all}</button>
        <button type="button" class="rh-tab" data-role-filter="tenant" role="tab" aria-selected="false">{L.tenant}</button>
        {landlordCount > 0 && <button type="button" class="rh-tab" data-role-filter="landlord" role="tab" aria-selected="false">{L.landlord}</button>}
      </div>
      <div class="rh-count" aria-live="polite" data-count-template={L.count(0).replace('0', '{n}')}>{L.count(deals.length)}</div>
    </div>

    <ol class="rh-list">
      {deals.map((d) => (
        <li class="rh-card" data-role={roleOf(d.status)}>
          <div class="rh-top">
            <span class="rh-date">{d.monthYear}</span>
            <span class="rh-status"><span class="rh-leased">{L.leased}</span> · {d.status}</span>
          </div>
          <div class="rh-rent">{d.rent}<span class="rh-period">{d.period}</span></div>
          <div class="rh-where">{d.intersection}</div>
          <div class="rh-city">{d.city}</div>
          {d.note && <p class="rh-note">{d.note}</p>}
        </li>
      ))}
    </ol>
    <p class="rh-empty" hidden>{L.empty}</p>
  </div>
</section>

<script>
  document.querySelectorAll('.rental-history').forEach((section) => {
    const tabs = section.querySelectorAll<HTMLButtonElement>('.rh-tab');
    const cards = section.querySelectorAll<HTMLElement>('.rh-card');
    const empty = section.querySelector<HTMLElement>('.rh-empty');
    const count = section.querySelector<HTMLElement>('.rh-count');
    const tpl = count?.dataset.countTemplate || '{n}';
    tabs.forEach((tab) => tab.addEventListener('click', () => {
      const want = tab.dataset.roleFilter || 'all';
      tabs.forEach((t) => { const on = t === tab; t.classList.toggle('is-active', on); t.setAttribute('aria-selected', on ? 'true' : 'false'); });
      let shown = 0;
      cards.forEach((c) => { const show = want === 'all' || c.dataset.role === want; c.hidden = !show; if (show) shown++; });
      if (empty) empty.hidden = shown > 0;
      if (count) count.textContent = tpl.replace('{n}', String(shown));
    }));
  });
</script>

<style>
  .rental-history { padding: 8px 0 24px; }
  .rh-toolbar { display: flex; justify-content: space-between; align-items: center; gap: 16px; flex-wrap: wrap; margin-bottom: 18px; }
  .rh-filter { display: flex; gap: 8px; flex-wrap: wrap; }
  .rh-tab { font: inherit; font-size: 13px; font-weight: 500; padding: 7px 14px; border-radius: 999px; border: 1px solid var(--rule); background: var(--surface); color: var(--ink-soft); cursor: pointer; transition: background .15s, color .15s, border-color .15s; }
  .rh-tab:hover { border-color: var(--ink); color: var(--ink); }
  .rh-tab.is-active { background: var(--ink); color: var(--bg); border-color: var(--ink); }
  .rh-tab:focus-visible { outline: 2px solid var(--accent); outline-offset: 2px; }
  .rh-count { font-size: 12px; letter-spacing: 0.14em; text-transform: uppercase; color: var(--ink-mute); font-weight: 600; }
  .rh-list { list-style: none; padding: 0; margin: 0; display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 16px; }
  .rh-card { background: var(--surface); border: 1px solid var(--rule); border-radius: 8px; padding: 20px 22px; display: flex; flex-direction: column; gap: 6px; transition: transform .18s ease, border-color .18s ease; }
  .rh-card:hover { transform: translateY(-2px); border-color: var(--accent); }
  .rh-card[hidden] { display: none; }
  .rh-top { display: flex; justify-content: space-between; align-items: baseline; gap: 10px; flex-wrap: wrap; font-size: 11.5px; letter-spacing: 0.12em; text-transform: uppercase; color: var(--ink-mute); font-weight: 600; }
  .rh-leased { color: #1f5a23; }
  html[data-theme="dark"] .rh-leased { color: #b7e0b9; }
  .rh-rent { font-family: 'Fraunces', 'Fraunces Fallback', Georgia, serif; font-weight: 500; font-size: 30px; line-height: 1.1; color: var(--ink); margin-top: 4px; }
  .rh-period { font-family: inherit; font-size: 13px; color: var(--ink-mute); font-weight: 400; margin-left: 6px; }
  .rh-where { font-family: 'Fraunces', 'Fraunces Fallback', Georgia, serif; font-style: italic; font-size: 18px; color: var(--ink); line-height: 1.3; }
  .rh-city { font-size: 13.5px; color: var(--ink-soft); }
  .rh-note { font-size: 14px; line-height: 1.5; color: var(--ink-soft); margin: 8px 0 0; padding-top: 10px; border-top: 1px solid var(--rule); }
  .rh-empty { text-align: center; color: var(--ink-mute); padding: 32px 0; }
  @media (max-width: 960px) { .rh-list { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
  @media (max-width: 600px) { .rh-list { grid-template-columns: 1fr; } .rh-card { padding: 18px; } .rh-rent { font-size: 26px; } }
</style>
