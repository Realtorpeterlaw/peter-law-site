---
// Shared rental questionnaire (homepage hero + For Renters, Step 2).
interface Props { id?: string; subject?: string; }
const { id = 'rental-questionnaire', subject = '新租房问卷 (中文版)' } = Astro.props;
---
<form id={id} class="quiz-form" method="POST" action="https://formspree.io/f/xnjrzgda" style="scroll-margin-top:100px">
          <div class="quiz-eyebrow">租房问卷</div>
          <h2 class="quiz-heading">您在找什么样的房子？</h2>
          <p class="quiz-sub">（最短租期 1 年）</p>
          <div class="quiz-fields">
            <div class="quiz-field">
              <label for="quiz-beds">卧室*</label>
              <select id="quiz-beds" name="bedrooms" required>
                <option value="">请选择…</option>
                <option>单间公寓 Studio</option>
                <option>1 卧</option>
                <option>1 卧 + 书房</option>
                <option>2 卧</option>
                <option>3 卧</option>
                <option>4 卧或以上</option>
              </select>
            </div>
            <div class="quiz-field">
              <label for="quiz-baths">卫浴*</label>
              <select id="quiz-baths" name="bathrooms" required>
                <option value="">请选择…</option>
                <option>1</option>
                <option>1.5</option>
                <option>2</option>
                <option>2.5</option>
                <option>3+</option>
              </select>
            </div>
            <div class="quiz-field">
              <label for="quiz-parking">停车位*</label>
              <select id="quiz-parking" name="parking" required>
                <option value="">请选择…</option>
                <option>不需要</option>
                <option>1 个</option>
                <option>2 个</option>
                <option>3 个或以上</option>
              </select>
            </div>
            <div class="quiz-field">
              <label for="quiz-budget">月预算*</label>
              <select id="quiz-budget" name="budget" required>
                <option value="">请选择…</option>
                <option>$2,000 以下</option>
                <option>$2,000 – $2,500</option>
                <option>$2,500 – $3,000</option>
                <option>$3,000 – $3,500</option>
                <option>$3,500 – $4,500</option>
                <option>$4,500 以上</option>
              </select>
            </div>
            <div class="quiz-field">
              <label for="quiz-movein">入住日期*</label>
              <input id="quiz-movein" name="move_in_date" type="date" required>
            </div>
            <div class="quiz-field">
              <label for="quiz-notice">已向房东发出 60 天通知*</label>
              <select id="quiz-notice" name="landlord_notice_60_days" required>
                <option value="">请选择…</option>
                <option>是</option>
                <option>否</option>
                <option>不适用</option>
              </select>
            </div>
            <div class="quiz-field quiz-field-full">
              <label>偏好地区* <span class="quiz-hint">（可多选）</span></label>
              <div class="quiz-checkboxes" data-checkbox-group="location">
                <label class="quiz-check"><input type="checkbox" name="location[]" value="多伦多市中心(Yonge &amp; Dundas 街)"> 多伦多市中心（Yonge &amp; Dundas 街）</label>
                <label class="quiz-check"><input type="checkbox" name="location[]" value="King West / Liberty Village"> King West / Liberty Village</label>
                <label class="quiz-check"><input type="checkbox" name="location[]" value="Yonge & Bloor / Yorkville"> Yonge & Bloor / Yorkville</label>
                <label class="quiz-check"><input type="checkbox" name="location[]" value="湖滨 / Harbourfront"> 湖滨 / Harbourfront</label>
                <label class="quiz-check"><input type="checkbox" name="location[]" value="Yonge–Eglinton"> Yonge–Eglinton</label>
                <label class="quiz-check"><input type="checkbox" name="location[]" value="东多伦多 (Leslieville, East York)"> 东多伦多 (Leslieville, East York)</label>
                <label class="quiz-check"><input type="checkbox" name="location[]" value="Markham / 大多伦多北部"> Markham / 大多伦多北部</label>
                <label class="quiz-check"><input type="checkbox" name="location[]" value="步行可达地铁站"> 步行可达地铁站</label>
                <label class="quiz-check"><input type="checkbox" name="location[]" value="步行可达 Union 车站"> 步行可达 Union 车站</label>
                <label class="quiz-check"><input type="checkbox" name="location[]" value="步行可达多大 St. George 校区"> 步行可达多大 St. George 校区</label>
                <label class="quiz-check"><input type="checkbox" name="location[]" value="步行可达湖滨"> 步行可达湖滨</label>
                <label class="quiz-check"><input type="checkbox" name="location[]" value="欢迎建议"> 欢迎建议</label>
              </div>
            </div>
            <div class="quiz-field">
              <label for="quiz-first-name">名字*</label>
              <input id="quiz-first-name" name="first_name" type="text" required autocomplete="given-name" placeholder="例如：Jacky">
            </div>
            <div class="quiz-field">
              <label for="quiz-last-name">姓氏*</label>
              <input id="quiz-last-name" name="last_name" type="text" required autocomplete="family-name" placeholder="例如：陈">
            </div>
            <div class="quiz-field quiz-field-full">
              <label for="quiz-email">电子邮件*</label>
              <input id="quiz-email" name="email" type="email" required autocomplete="email" placeholder="your@email.com">
            </div>
          </div>
          <div class="hp-field" aria-hidden="true">
            <label for="quiz-gotcha">请勿填写</label>
            <input id="quiz-gotcha" name="_gotcha" type="text" tabindex="-1" autocomplete="off">
          </div>
          <input type="hidden" name="_subject" value={subject}>
          <input type="hidden" name="_next" value="https://www.realtorpeterlaw.com/chinese/contact/thanks">
          <button type="submit" class="btn-primary quiz-cta">
            马上开始
            <svg width="14" height="14" viewBox="0 0 14 14" fill="none"><path d="M1 7h12M8 2l5 5-5 5" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/></svg>
          </button>
          <div class="quiz-cta-alt">
            <a href="/chinese/rental-calculator" class="btn-warm quiz-cta-warm">
              <svg width="15" height="15" viewBox="0 0 24 24" fill="none" aria-hidden="true"><rect x="5" y="3" width="14" height="18" rx="2" stroke="currentColor" stroke-width="1.8"/><line x1="8" y1="8" x2="16" y2="8" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/><circle cx="8.5" cy="12.5" r="1.2" fill="currentColor"/><circle cx="12" cy="12.5" r="1.2" fill="currentColor"/><circle cx="15.5" cy="12.5" r="1.2" fill="currentColor"/><circle cx="8.5" cy="16" r="1.2" fill="currentColor"/><circle cx="12" cy="16" r="1.2" fill="currentColor"/><circle cx="15.5" cy="16" r="1.2" fill="currentColor"/></svg>
              租房计算器
              <svg width="14" height="14" viewBox="0 0 14 14" fill="none" aria-hidden="true"><path d="M1 7h12M8 2l5 5-5 5" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/></svg>
            </a>
          </div>
        </form>

<script>
  document.querySelectorAll('form.quiz-form').forEach(function(form){
    form.addEventListener('submit', function(e){
      var cbs = form.querySelectorAll('input[name="location[]"]');
      if (cbs.length && ![].some.call(cbs, function(cb){ return cb.checked; })) {
        e.preventDefault();
        alert('请至少选择一个偏好地区。');
        cbs[0].focus();
      }
    });
  });
</script>
