    residencyLink: 'guide sur l’interdiction d’achat aux non-Canadiens',
    residencyHref: '/french/blog/foreign-buyer-ban',
    area: 'Secteur recherché*',
    areaPlaceholder: 'p. ex. Markham, North York, Leslieville',
    houseType: 'Type de maison*',
    multi: '(plusieurs choix possibles)',
    houseTypes: ['Détachée', 'Jumelée', 'Maison en rangée (pleine propriété)', 'Maison en rangée (copropriété)', 'Bungalow', 'Duplex ou multiplex', 'Ouvert aux suggestions'],
    exposure: 'Exposition*',
    exposures: ['Nord', 'Sud', 'Est', 'Ouest', 'Sans préférence'],
    moveIn: 'Date d’emménagement*',
    firstName: 'Prénom*', firstPh: 'p. ex. Jacky',
    lastName: 'Nom de famille*', lastPh: 'p. ex. Chan',
    email: 'Courriel*', emailPh: 'votre@email.com',
    phone: 'Numéro de cellulaire*', phonePh: 'p. ex. 647 888 8472', phoneTitle: '10 chiffres, p. ex. 647 888 8472',
