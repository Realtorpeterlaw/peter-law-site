---
import '../styles/global.css';
import Analytics from '@vercel/analytics/astro';
import SpeedInsights from '@vercel/speed-insights/astro';
// Google Search Console verification: set PUBLIC_GSC_VERIFICATION in Vercel env vars (Settings > Environment Variables) and redeploy.
const gscVerification = import.meta.env.PUBLIC_GSC_VERIFICATION || '';
interface HreflangAlt { hreflang: string; href: string; }
interface Props {
  title: string;
  description?: string;
  zh?: boolean;
  bodyClass?: string;
  lang?: string;
  dir?: 'ltr' | 'rtl';
  hreflangAlternates?: HreflangAlt[];
  noindex?: boolean;
}
const {
  title,
  description = "Trilingual Toronto real estate (English, 中文, Français). Pre-approved fast, moved in calmly. Hospitality-grade service from a former Airbnb host with 400+ guest reviews.",
  zh = false,
  bodyClass = "",
  lang: langProp,
  dir: dirProp,
  hreflangAlternates = [],
  noindex = false,
} = Astro.props;
// Normalize lang codes to include the region for hreflang/SEO parity.
// If lang prop is provided (e.g. 'fr' from French pages), upgrade to 'fr-CA'.
// If zh flag set, use 'zh-CN'. Otherwise default to 'en-CA'.
const _langMap: Record<string, string> = { en: 'en-CA', fr: 'fr-CA', zh: 'zh-CN' };
const htmlLang = _langMap[langProp || (zh ? 'zh' : 'en')] || langProp || 'en-CA';
const htmlDir = dirProp || 'ltr';
const canonical = new URL(Astro.url.pathname, Astro.site).toString();

// Auto-generate BreadcrumbList JSON-LD from URL path
const _path = Astro.url.pathname.replace(/\/$/, '');
const _segments = _path.split('/').filter(Boolean);
const _labelMaps: Record<string, Record<string, string>> = {
  en: {
    chinese: '中文', french: 'Français',
    blog: 'Blog', 'past-deals': 'Sale History', about: 'About',
    'buyer-guide': 'Buyer Guide', 'for-renters': 'For Renters', 'for-landlords': 'For Landlords',
    'rental-tour': 'Rental Tour', 'rent-control': 'Rent Control', 'lease-renewal': 'Rent Renewal',
    'n-forms': 'N Forms', 'land-transfer-tax': 'Land Transfer Tax',
    'payment-calculator': 'Mortgage Calculator', 'closing-costs': 'Closing Costs',
    'all-calculator': 'BUY Calculator', 'rental-calculator': 'Rental Calculator',
    'rent-vs-buy-calculator': 'Rent vs Buy Calculator', 'refinance-calculator': 'Refinance Calculator',
    'free-home-evaluation': 'Free Home Evaluation', apply: 'Apply',
    terms: 'Terms of Service', privacy: 'Privacy Policy',
    disclaimer: 'Disclaimer', accessibility: 'Accessibility', contact: 'Contact', thanks: 'Thank you',
  },
  zh: {
    chinese: '中文', blog: '博客', 'past-deals': '销售记录', about: '关于我',
    'buyer-guide': '买家指南', 'for-renters': '租客须知', 'for-landlords': '房东须知',
    'rental-tour': '看房视频', 'rent-control': '租金管制', 'lease-renewal': '租金续约',
    'n-forms': 'N 类表格', 'land-transfer-tax': '土地转让税',
    'payment-calculator': '按揭计算器', 'closing-costs': '交房费用',
    'all-calculator': 'BUY 计算器', 'rental-calculator': '租房计算器',
    'rent-vs-buy-calculator': '租房 vs 买房计算器', 'refinance-calculator': '再融资计算器',
    'free-home-evaluation': '免费房屋估值', apply: '申请',
    terms: '服务条款', privacy: '隐私政策', disclaimer: '免责声明', accessibility: '无障碍声明', contact: '联系', thanks: '谢谢',
  },
  fr: {
    french: 'Français', blog: 'Blog', 'past-deals': 'Historique des ventes', about: 'À propos',
    'buyer-guide': "Guide de l'acheteur", 'for-renters': 'Pour locataires', 'for-landlords': 'Pour propriétaires',
    'rental-tour': 'Visite locative', 'rent-control': 'Contrôle des loyers', 'lease-renewal': 'Renouvellement de loyer',
    'n-forms': 'Formulaires N', 'land-transfer-tax': 'Droits de mutation',
    'payment-calculator': 'Calculateur hypothécaire', 'closing-costs': 'Frais de clôture',
    'all-calculator': 'BUY Calculateur', 'rental-calculator': 'Calculateur de location',
    'rent-vs-buy-calculator': 'Louer ou acheter', 'refinance-calculator': 'Calculateur de refinancement',
    'free-home-evaluation': 'Évaluation gratuite', apply: 'Demande',
    terms: "Conditions d'utilisation", privacy: 'Politique de confidentialité', disclaimer: 'Avis de non-responsabilité', accessibility: 'Accessibilité', contact: 'Contact', thanks: 'Merci',
  },
};
const _crumbLang = _segments[0] === 'chinese' ? 'zh' : _segments[0] === 'french' ? 'fr' : 'en';
const _labelMap = { ..._labelMaps.en, ..._labelMaps[_crumbLang] };
function _title(seg: string): string {
  if (_labelMap[seg]) return _labelMap[seg];
  return seg.replace(/-/g, ' ').replace(/\b\w/g, (c) => c.toUpperCase());
}
const _homeName = _crumbLang === 'zh' ? '首页' : _crumbLang === 'fr' ? 'Accueil' : 'Home';
const _crumbs: {name: string, url: string}[] = [{ name: _homeName, url: 'https://www.realtorpeterlaw.com/' }];
let _acc = '';
for (const seg of _segments) {
  _acc += '/' + seg;
  _crumbs.push({ name: _title(seg), url: 'https://www.realtorpeterlaw.com' + _acc + '/' });
}
const _breadcrumbLd = _crumbs.length > 1 ? {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: _crumbs.map((c, i) => ({
    '@type': 'ListItem', position: i + 1, name: c.name, item: c.url,
  })),
} : null;
---
<!DOCTYPE html>
<html lang={htmlLang} dir={htmlDir}>
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <meta name="theme-color" content="#f6f4f0" id="theme-color-meta" />
  <script is:inline>
    /* Restore saved theme choice BEFORE first paint, prevents dark-mode flash.
       If no saved choice, default = light (site's original palette). */
    (function () {
      try {
        var saved = localStorage.getItem('theme');
        if (saved === 'dark') {
          document.documentElement.setAttribute('data-theme', 'dark');
          var m = document.getElementById('theme-color-meta');
          if (m) m.setAttribute('content', '#0f0e0c');
        }
      } catch (_) { /* localStorage blocked, silently keep light */ }
    })();
  </script>
  <!-- Mobile safety: prevent iOS from auto-linking arbitrary numbers/addresses/dates
       (Peter has actual tel: links for the real phone; iOS would otherwise wrap any
       10-digit sequence in tel:, creating spoofable "tap to call" targets). -->
  <meta name="format-detection" content="telephone=no, date=no, address=no, email=no" />
  <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
  <title>{title}</title>
  <meta name="description" content={description} />
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  <link rel="canonical" href={canonical} />
  {noindex && <meta name="robots" content="noindex, nofollow" />}
  {gscVerification && <meta name="google-site-verification" content={gscVerification} />}
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:type" content="website" />
  <meta property="og:image" content="https://www.realtorpeterlaw.com/photos/peter-cn-tower.jpg" />
  <meta property="og:image:alt" content="Peter Law, Toronto real estate sales representative, with the CN Tower behind him." />
  <meta property="og:url" content={canonical} />
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content={title} />
  <meta name="twitter:description" content={description} />
  <meta name="twitter:image" content="https://www.realtorpeterlaw.com/photos/peter-cn-tower.jpg" />
  <meta name="twitter:image:alt" content="Peter Law, Toronto real estate sales representative, with the CN Tower behind him." />
  <!-- Self-hosted variable fonts (Latin subset). Same-origin, edge-cached,
       preloaded so the LCP text renders in <300ms with no font swap. -->
  <link rel="preload" href="/fonts/fraunces-latin.woff2" as="font" type="font/woff2" crossorigin />
  <link rel="preload" href="/fonts/inter-latin.woff2" as="font" type="font/woff2" crossorigin />
  <style is:inline>
    @font-face {
      font-family: 'Fraunces';
      font-style: normal;
      font-weight: 100 900;
      font-display: swap;
      src: url('/fonts/fraunces-latin.woff2') format('woff2-variations');
      unicode-range: U+0000-00FF,U+0131,U+0152-0153,U+02BB-02BC,U+02C6,U+02DA,U+02DC,U+0304,U+0308,U+0329,U+2000-206F,U+20AC,U+2122,U+2191,U+2193,U+2212,U+2215,U+FEFF,U+FFFD;
    }
    @font-face {
      font-family: 'Inter';
      font-style: normal;
      font-weight: 100 900;
      font-display: swap;
      src: url('/fonts/inter-latin.woff2') format('woff2-variations');
      unicode-range: U+0000-00FF,U+0131,U+0152-0153,U+02BB-02BC,U+02C6,U+02DA,U+02DC,U+0304,U+0308,U+0329,U+2000-206F,U+20AC,U+2122,U+2191,U+2193,U+2212,U+2215,U+FEFF,U+FFFD;
    }
    /* Fallback metrics, matched to Fraunces + Inter so the pre-swap
       system-font render lays out at the same size, eliminating CLS. */
    @font-face {
      font-family: 'Fraunces Fallback';
      src: local('Georgia'), local('Times New Roman'), local('serif');
      size-adjust: 105%;
      ascent-override: 92%;
      descent-override: 24%;
    }
    @font-face {
      font-family: 'Inter Fallback';
      src: local('Arial'), local('Helvetica'), local('sans-serif');
      size-adjust: 107%;
      ascent-override: 90%;
      descent-override: 22%;
    }
  </style>
  {hreflangAlternates.map((alt) => (
    <link rel="alternate" hreflang={alt.hreflang} href={alt.href} />
  ))}
  {_breadcrumbLd && (
    <script type="application/ld+json" set:html={JSON.stringify(_breadcrumbLd)} />
  )}
  <slot name="head" />
</head>
<body class={bodyClass + (zh ? ' zh' : '')}>
  <a href="#main-content" class="skip-link">Skip to main content</a>
  <slot />
  <Analytics />
  <SpeedInsights />
  <script is:inline>
    /* Anchor navigation:
       - If target is inside/is a <details>, open the ancestor so content is visible.
       - Manually scroll with a fixed pixel offset (SCROLL_OFFSET), more reliable
         than scrollIntoView({block:'start'}), which is inconsistent across
         browsers when scroll-padding-top is used alongside a sticky header.
       - Applies to TOC clicks AND page loads with a #hash. */
    (function () {
      var SCROLL_OFFSET = 200; // px below viewport top the target should sit
      function openAncestorDetails(el) {
        if (!el) return false;
        var opened = false;
        if (el.tagName === 'DETAILS' && !el.open) { el.open = true; opened = true; }
        var parent = el.closest('details');
        if (parent && !parent.open) { parent.open = true; opened = true; }
        return opened;
      }
      function scrollToId(id) {
        if (!id) return;
        var el = document.getElementById(id);
        if (!el) return;
        var opened = openAncestorDetails(el);
        // Let layout settle after opening a details so the geometry is correct.
        var delay = opened ? 60 : 0;
        setTimeout(function () {
          var rect = el.getBoundingClientRect();
          var target = window.scrollY + rect.top - SCROLL_OFFSET;
          if (target < 0) target = 0;
          window.scrollTo({ top: target, behavior: 'smooth' });
        }, delay);
      }
      document.addEventListener('click', function (e) {
        var a = e.target.closest('a[href^="#"]');
        if (!a) return;
        var id = a.getAttribute('href').slice(1);
        if (!id || !document.getElementById(id)) return; // let the browser handle unknown targets
        e.preventDefault();  // prevent the browser's instant/partial default scroll
        history.pushState(null, '', '#' + id);
        scrollToId(id);
      });
      if (location.hash && location.hash.length > 1) {
        // Wait a beat for images/fonts to influence layout before measuring.
        setTimeout(function () { scrollToId(location.hash.slice(1)); }, 60);
      }
    })();
  </script>
  <script is:inline>
    /* Vercel Analytics, custom event tracking. Cookieless, no personal data:
       no typed numbers, no names, no emails. Only which action happened where.
       Event budget matters on the Hobby plan, so every event fires at most
       once per page view unless noted. */
    (function () {
      function ready(fn) {
        if (document.readyState !== 'loading') fn();
        else document.addEventListener('DOMContentLoaded', fn);
      }
      function track(name, props) {
        try { if (window.va) window.va('event', { name: name, data: props || {} }); } catch (_) {}
      }
      function tagFor(el) {
        return (el.getAttribute('aria-label') || el.textContent || '').trim().slice(0, 60);
      }
      var path = location.pathname;
      var lang = path.indexOf('/chinese') === 0 ? 'zh' : path.indexOf('/french') === 0 ? 'fr' : 'en';
      function langOf(href) {
        if (href.indexOf('/chinese') === 0) return 'zh';
        if (href.indexOf('/french') === 0) return 'fr';
        if (href === '/' || href.indexOf('/#') === 0) return 'en';
        return null;
      }
      function once(key) {
        // returns true the first time key is seen on this page view
        once.seen = once.seen || {};
        if (once.seen[key]) return false;
        once.seen[key] = true; return true;
      }
      ready(function () {
        // --- Clicks: CTAs, language switches, outbound links, downloads ---
        document.addEventListener('click', function (e) {
          var a = e.target.closest('a');
          if (!a) return;
          var href = a.getAttribute('href') || '';
          if (href.indexOf('cal.com/peter-law') >= 0)   { track('cta_book_call',  { location: path, label: tagFor(a) }); return; }
          if (href.indexOf('wa.me/') >= 0)              { track('cta_whatsapp',   { location: path }); return; }
          if (href.indexOf('tel:') === 0)               { track('cta_phone_tap',  { location: path }); return; }
          if (href.indexOf('mailto:') === 0)            { track('cta_email_tap',  { location: path }); return; }
          var to = langOf(href);
          if (to && to !== lang && (a.closest('.topbar') || a.classList.contains('mobile-lang') || a.classList.contains('lang-link'))) {
            track('lang_switch', { from: lang, to: to, location: path }); return;
          }
          if (/\.pdf(\?|#|$)/i.test(href)) { track('file_download', { file: href.split('/').pop().split('?')[0], location: path }); return; }
          if (/^https?:\/\//i.test(href) && href.indexOf(location.host) === -1) {
            var host = ''; try { host = new URL(href).hostname.replace(/^www\./, ''); } catch (_) {}
            track('outbound_click', { host: host, location: path, label: tagFor(a) }); return;
          }
          if (a.matches('.btn-primary, .btn-warm')) track('cta_primary_click', { location: path, label: tagFor(a), href: href });
        });
        // --- Theme toggle ---
        document.addEventListener('click', function (e) {
          var btn = e.target.closest('[data-theme-toggle]');
          if (!btn) return;
          var to = document.documentElement.getAttribute('data-theme') === 'dark' ? 'light' : 'dark';
          track('theme_toggle', { to: to, location: path });
        });
        // --- Form submissions ---
        document.addEventListener('submit', function (e) {
          var f = e.target;
          if (!f || f.tagName !== 'FORM') return;
          var action = f.getAttribute('action') || '';
          var formName = f.id || f.className || 'form';
          if (action.indexOf('formspree.io') >= 0)          track('form_submit_formspree', { form: formName, location: path });
          else if (action.indexOf('beehiiv.com') >= 0)      track('form_submit_newsletter', { location: path });
          else                                              track('form_submit_other', { form: formName, location: path });
        });
        // --- Calculators: one "used" event on first input, one "result" event
        //     with the verdict colour after the visitor stops typing (no numbers sent) ---
        var slug = path.replace(/\/$/, '').split('/').pop() || 'home';
        var calcName = ({ 'all-calculator': 'buy', 'payment-calculator': 'mortgage', 'rental-calculator': 'rental', 'rent-vs-buy-calculator': 'rent-vs-buy', 'refinance-calculator': 'refinance', 'land-transfer-tax': 'land-transfer-tax', 'rent-control': 'rent-control' })[slug] || slug;
        var verdictEl = document.querySelector('#ac-verdict, #rc-verdict, #rvb-verdict');
        if (document.querySelector('[data-output], .ac-verdict-title, .rc-verdict-title, [data-cash]')) {
          var resultTimer = null;
          document.addEventListener('input', function () {
            if (once('calc_used')) track('calculator_used', { calculator: calcName, lang: lang });
            if (!verdictEl) return;
            clearTimeout(resultTimer);
            resultTimer = setTimeout(function () {
              if (!once('calc_result')) return;
              var m = (verdictEl.className || '').match(/-verdict-(green|yellow|red|neutral|buy|rent)/);
              track('calculator_result', { calculator: calcName, verdict: m ? m[1] : 'unknown', lang: lang });
            }, 2500);
          }, { passive: true });
        }
        // --- Blog: search terms, category filter, articles read to the end ---
        var search = document.getElementById('blog-search-input');
        if (search) {
          var searchTimer = null;
          search.addEventListener('input', function () {
            clearTimeout(searchTimer);
            searchTimer = setTimeout(function () {
              var q = search.value.trim().toLowerCase().slice(0, 40);
              if (!q) return;
              var hits = 0;
              document.querySelectorAll('.blog-card').forEach(function (c) { if (c.style.display !== 'none') hits++; });
              track('blog_search', { q: q, results: hits, lang: lang });
            }, 900);
          });
          document.addEventListener('click', function (e) {
            var chip = e.target.closest('.blog-filter-chip');
            if (chip) track('blog_filter', { filter: chip.getAttribute('data-filter') || '', lang: lang });
          });
        }
        var article = document.querySelector('body.article-page article, body.article-page .prose-body, body.article-page main');
        if (article && 'IntersectionObserver' in window) {
          var sentinel = document.createElement('div');
          sentinel.setAttribute('aria-hidden', 'true');
          sentinel.style.cssText = 'height:1px;width:1px;';
          article.appendChild(sentinel);
          var startedAt = Date.now();
          var io = new IntersectionObserver(function (entries) {
            if (!entries.some(function (en) { return en.isIntersecting; })) return;
            io.disconnect();
            track('article_read_end', { post: slug, seconds: Math.round((Date.now() - startedAt) / 1000), lang: lang });
          }, { rootMargin: '0px 0px -10% 0px' });
          io.observe(sentinel);
        }
        // --- 404s: where did the visitor come from, and what did they ask for ---
        if (document.querySelector('.nf-h')) {
          var ref = ''; try { ref = document.referrer ? new URL(document.referrer).hostname : '(direct)'; } catch (_) { ref = '(unknown)'; }
          track('page_not_found', { path: path.slice(0, 120), referrer: ref });
        }
      });
    })();
  </script>
  <script is:inline>
    /* Theme toggle: switch dark ↔ light, persist in localStorage,
       and keep the theme-color meta in sync so mobile browser chrome updates. */
    (function () {
      function ready(fn) {
        if (document.readyState !== 'loading') fn();
        else document.addEventListener('DOMContentLoaded', fn);
      }
      function apply(theme) {
        if (theme === 'dark') document.documentElement.setAttribute('data-theme', 'dark');
        else document.documentElement.removeAttribute('data-theme');
        var m = document.getElementById('theme-color-meta');
        if (m) m.setAttribute('content', theme === 'dark' ? '#0f0e0c' : '#f6f4f0');
        try { localStorage.setItem('theme', theme); } catch (_) {}
        // Update all aria-labels on the toggle buttons
        var next = theme === 'dark' ? 'light' : 'dark';
        document.querySelectorAll('[data-theme-toggle]').forEach(function (btn) {
          var currentLabel = btn.getAttribute('aria-label') || '';
          if (currentLabel.indexOf('dark') >= 0 || currentLabel.indexOf('sombre') >= 0 || currentLabel.indexOf('深色') >= 0) {
            // Currently offering dark → now should offer light
            if (currentLabel.indexOf('dark') >= 0) btn.setAttribute('aria-label', 'Switch to light mode');
            else if (currentLabel.indexOf('sombre') >= 0) btn.setAttribute('aria-label', 'Basculer en mode clair');
            else btn.setAttribute('aria-label', '切换浅色模式');
          } else {
            if (currentLabel.indexOf('light') >= 0) btn.setAttribute('aria-label', 'Switch to dark mode');
            else if (currentLabel.indexOf('clair') >= 0) btn.setAttribute('aria-label', 'Basculer en mode sombre');
            else btn.setAttribute('aria-label', '切换深色模式');
          }
        });
      }
      ready(function () {
        document.addEventListener('click', function (e) {
          var btn = e.target.closest('[data-theme-toggle]');
          if (!btn) return;
          var current = document.documentElement.getAttribute('data-theme') === 'dark' ? 'dark' : 'light';
          apply(current === 'dark' ? 'light' : 'dark');
        });
        // Sync toggle aria-label to current state on load
        var current = document.documentElement.getAttribute('data-theme') === 'dark' ? 'dark' : 'light';
        if (current === 'dark') {
          document.querySelectorAll('[data-theme-toggle]').forEach(function (btn) {
            var current = btn.getAttribute('aria-label') || '';
            if (current.indexOf('dark') >= 0) btn.setAttribute('aria-label', 'Switch to light mode');
            else if (current.indexOf('sombre') >= 0) btn.setAttribute('aria-label', 'Basculer en mode clair');
            else if (current.indexOf('深色') >= 0) btn.setAttribute('aria-label', '切换浅色模式');
          });
        }
      });
    })();
  </script>
</body>
</html>
