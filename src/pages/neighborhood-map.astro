---
// The interactive map as its own small document. /neighborhood shows it in a frame;
// opened directly (full screen) it gets a slim title bar with a way back to the site.
// Not indexed: search engines get /neighborhood, which carries the same information as text.
import mapCss from '../map/neighborhood-map.css?url';
export const prerender = true;
---
<!DOCTYPE html>
<html lang="en-CA">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>Toronto Neighbourhood Map | Peter Law</title>
<meta name="robots" content="noindex, follow">
<meta name="theme-color" content="#16202b">
<link rel="icon" href="/favicon.ico" sizes="32x32">
<link rel="icon" type="image/svg+xml" href="/favicon.svg">
<link rel="preconnect" href="https://tile.openstreetmap.org">
<script is:inline>if (window.top === window) document.documentElement.className += ' standalone';</script>
<link rel="stylesheet" href={mapCss}>
</head>
<body>
<div class="top"><b>Toronto Neighbourhood Map</b><a href="/neighborhood"><span aria-hidden="true">&larr; </span>Back<span class="top-long"> to RealtorPeterLaw.com</span></a></div>
<div class="stage">
  <div id="map" role="region" aria-label="Map of Toronto real estate districts"></div>
  <details class="layers" id="layers" open>
    <summary><span class="lt-open">CLICK HERE to minimize</span><span class="lt-closed">CLICK HERE to expand</span></summary>
    <div class="lbody">
      <div class="lcols">
        <div class="lcol">
          <label><input type="checkbox" id="l-dist" checked><span>Districts</span></label>
          <label><input type="checkbox" id="l-pre"><span><i class="sw sw-pre" aria-hidden="true"></i>Pre-Con</span></label>
          <label><input type="checkbox" id="l-condo" checked><span><i class="sw sw-condo" aria-hidden="true"></i>Condos</span></label>
          <label><input type="checkbox" id="l-loft" checked><span><i class="sw sw-loft" aria-hidden="true"></i>Lofts</span></label>
          <label><input type="checkbox" id="l-base" checked><span>Street<br>Background</span></label>
        </div>
        <div class="lcol">
          <label><input type="checkbox" id="l-day"><span><i class="sw-day" aria-hidden="true"></i>Daycare</span></label>
          <label><input type="checkbox" id="l-s1" data-f="1"><span><i class="sw-cap sw-pub" aria-hidden="true"></i>K-8<br>(Public School)</span></label>
          <label><input type="checkbox" id="l-s2" data-f="2"><span><i class="sw-cap sw-pub" aria-hidden="true"></i>9-12<br>(Public School)</span></label>
          <label><input type="checkbox" id="l-s4" data-f="4"><span><i class="sw-cap sw-pri" aria-hidden="true"></i>K-8<br>(Private School)</span></label>
          <label><input type="checkbox" id="l-s8" data-f="8"><span><i class="sw-cap sw-pri" aria-hidden="true"></i>9-12<br>(Private School)</span></label>
        </div>
      </div>
      <div class="views"><button type="button" id="v-all">ZOOM out</button></div>
      <div class="views jump" id="jump"></div>
      <div class="find"><label for="find" class="find-label">Find a district, community, condo, school or park</label>
        <input id="find" list="names" placeholder="Yorkville, UofT, Toy Factory..." autocomplete="off"><datalist id="names"></datalist></div>
    </div>
  </details>
  <div class="note" id="note" role="status"></div>
  <aside class="panel" id="panel" aria-live="polite" aria-label="District details"><button type="button" class="x" id="close" aria-label="Close">&times;</button><div class="scroll" id="pbody"></div><div class="cta" id="cta"></div></aside>
</div>
<script>
  import '../map/neighborhood-map.js';
</script>
</body>
</html>
