---
import BaseLayout from '../layouts/BaseLayout.astro';
import TopBar from '../components/TopBar.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
export const prerender = true;
---
<BaseLayout noindex
  title="Page not found, Peter Law · Toronto Real Estate"
  description="This page doesn't exist. Try the homepage, or contact Peter directly."
>
  <TopBar />
  <Header />

  <section class="not-found-wrap">
    <div class="wrap">
      <p class="nf-eyebrow" data-nf="eyebrow">Error 404</p>
      <h1 class="nf-h" data-nf="heading">This page has moved on.</h1>
      <p class="nf-lead" data-nf="lead">The link you followed may be old, or the page was renamed. Here are a few good places to go next:</p>

      <nav class="nf-links" aria-label="Suggested pages" data-nf="nav">
        <a href="/" class="nf-primary" data-nf="home"><span>Homepage</span><svg width="14" height="14" viewBox="0 0 14 14" fill="none" aria-hidden="true"><path d="M1 7h12M8 2l5 5-5 5" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/></svg></a>
        <a href="/for-renters" data-nf="renters">For Renters</a>
        <a href="/buyer-guide" data-nf="buyers">Buyer Guide</a>
        <a href="/rental-calculator" data-nf="rentcalc">Rental Calculator</a>
        <a href="/all-calculator" data-nf="buycalc">Buyer Calculator</a>
        <a href="/blog" data-nf="blog">Blog</a>
        <a href="/#book" data-nf="contact">Contact Peter</a>
      </nav>

      <p class="nf-fine" data-nf="fine">If you were expecting a specific page and can't find it, please <a href="/#book" data-nf="fine-link">get in touch</a>, I'll help you find what you need.</p>
    </div>
  </section>

  <script is:inline>
    /* Localize the 404 page when the missing URL was under /chinese or /french */
    (function () {
      var p = location.pathname;
      var lang = /^\/chinese(\/|$)/.test(p) ? 'zh' : /^\/french(\/|$)/.test(p) ? 'fr' : null;
      if (!lang) return;
      var t = {
        zh: {
          eyebrow: '错误 404',
          heading: '这个页面已经搬走了。',
          lead: '您点击的链接可能已经过期，或者页面已被重命名。您可以试试以下这些去处：',
          nav: '推荐页面',
          home: '首页', renters: '租客须知', buyers: '买家指南', rentcalc: '租房计算器', buycalc: '购房计算器', blog: '博客', contact: '联系 Peter',
          fineBefore: '如果您在找某个特定页面却找不到，请', fineLink: '联系我', fineAfter: '，我会帮您找到您需要的内容。',
          base: '/chinese', title: '页面未找到，Peter Law · 多伦多房地产', htmlLang: 'zh-CN'
        },
        fr: {
          eyebrow: 'Erreur 404',
          heading: 'Cette page a déménagé.',
          lead: 'Le lien que vous avez suivi est peut-être périmé, ou la page a été renommée. Voici quelques bons endroits où aller :',
          nav: 'Pages suggérées',
          home: 'Accueil', renters: 'Pour locataires', buyers: "Guide de l'acheteur", rentcalc: 'Calculateur de location', buycalc: "Calculateur d'achat", blog: 'Blogue', contact: 'Contacter Peter',
          fineBefore: 'Si vous cherchiez une page précise et ne la trouvez pas, ', fineLink: 'écrivez-moi', fineAfter: ', je vous aiderai à trouver ce qu\'il vous faut.',
          base: '/french', title: 'Page introuvable, Peter Law · Immobilier Toronto', htmlLang: 'fr-CA'
        }
      }[lang];
      function q(k) { return document.querySelector('[data-nf="' + k + '"]'); }
      document.documentElement.lang = t.htmlLang;
      document.title = t.title;
      ['eyebrow', 'heading', 'lead'].forEach(function (k) { q(k).textContent = t[k]; });
      q('nav').setAttribute('aria-label', t.nav);
      q('home').querySelector('span').textContent = t.home; q('home').href = t.base;
      [['renters', '/for-renters'], ['buyers', '/buyer-guide'], ['rentcalc', '/rental-calculator'], ['buycalc', '/all-calculator'], ['blog', '/blog']].forEach(function (pair) {
        var a = q(pair[0]); a.textContent = t[pair[0]]; a.href = t.base + pair[1];
      });
      q('contact').textContent = t.contact; q('contact').href = t.base + '#book';
      var fine = q('fine'); var link = q('fine-link');
      link.textContent = t.fineLink; link.href = t.base + '#book';
      fine.textContent = ''; fine.appendChild(document.createTextNode(t.fineBefore)); fine.appendChild(link); fine.appendChild(document.createTextNode(t.fineAfter));
    })();
  </script>

  <Footer />
</BaseLayout>

<style>
  .not-found-wrap { padding: 96px 0 128px; min-height: 60vh; display: flex; align-items: center; }
  .not-found-wrap .wrap { width: 100%; }
  .nf-eyebrow { font-size: 12px; letter-spacing: 0.16em; text-transform: uppercase; color: var(--ink-mute); font-weight: 600; margin: 0 0 12px; }
  .nf-h { font-family: 'Fraunces', 'Fraunces Fallback', Georgia, serif; font-weight: 400; font-size: clamp(38px, 6vw, 64px); line-height: 1.1; margin: 0 0 20px; color: var(--ink); letter-spacing: -0.015em; }
  .nf-lead { font-size: 17px; line-height: 1.6; color: var(--ink-soft); max-width: 560px; margin: 0 0 32px; }
  .nf-links { display: flex; flex-wrap: wrap; gap: 12px 14px; margin-bottom: 40px; }
  .nf-links a { display: inline-flex; align-items: center; gap: 8px; font-size: 15px; font-weight: 500; padding: 11px 20px; background: var(--surface); border: 1px solid var(--rule); border-radius: 999px; color: var(--ink); text-decoration: none; transition: background 0.15s, border-color 0.15s, color 0.15s, transform 0.15s; }
  .nf-links a:hover { border-color: var(--ink); background: var(--bg-warm); transform: translateY(-1px); }
  .nf-links a.nf-primary { background: var(--ink); color: var(--bg); border-color: var(--ink); }
  .nf-links a.nf-primary:hover { background: var(--ink-soft); border-color: var(--ink-soft); color: var(--bg); }
  .nf-fine { font-size: 14px; color: var(--ink-mute); margin: 0; }
  .nf-fine a { color: var(--ink); text-decoration: underline; text-underline-offset: 3px; }
  @media (max-width: 640px) {
    .not-found-wrap { padding: 56px 0 80px; }
    .nf-links { gap: 10px; }
    .nf-links a { font-size: 14px; padding: 10px 16px; }
  }
</style>
