---
<BaseLayout
  title="Toronto Real Estate Blog | Peter Law"
  description="Real talk on Toronto rentals, sales, financing, and Ontario real estate legislation. Plain-English explainers from a bilingual Toronto realtor. Updated regularly."
  bodyClass="blog-page"
  hreflangAlternates={hreflangAlternates}
>
  <TopBar />
  <Header active="blog" />

  <section class="page-hero">
    <div class="wrap">
      <div class="eyebrow">Blog</div>
      <h1>Real talk on Toronto real estate.</h1>
      <p>Rumors, Trends, Markets, Finance, Policy, Immigration and staying&nbsp;ahead...</p>
      <div class="blog-search" role="search">
        <svg class="blog-search-icon" width="16" height="16" viewBox="0 0 16 16" fill="none" aria-hidden="true"><circle cx="7" cy="7" r="5" stroke="currentColor" stroke-width="1.6"/><path d="M11 11l3 3" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/></svg>
        <input id="blog-search-input" type="search" placeholder="Search articles…" aria-label="Search blog articles" autocomplete="off" />
      </div>

      <div class="blog-filter" role="group" aria-label="Filter articles by category">
        <button type="button" class="blog-filter-chip is-active" data-filter="all">All</button>
        <button type="button" class="blog-filter-chip blog-filter-chip-sale" data-filter="sale"><span class="blog-filter-dot" aria-hidden="true"></span>Sales</button>
        <button type="button" class="blog-filter-chip blog-filter-chip-rent" data-filter="rent"><span class="blog-filter-dot" aria-hidden="true"></span>Rent</button>
      </div>
    </div>
  </section>

  <section class="major" style="padding-top: 32px;">
    <div class="wrap">
      <div class="blog-list">
        {posts.map((post) => (
          <article class="blog-card" data-search={`${post.title} ${post.eyebrow}`.toLowerCase()} data-category={(post.categories || []).join(' ')}>
            <a href={`/blog/${post.slug}`} class="blog-card-link" aria-label={`Read: ${post.title}`}>
              {post.categories && post.categories.length > 0 && (
                <span class="blog-card-dots" aria-label={`Categories: ${post.categories.map(c => c === 'rent' ? 'Rent' : 'Sales').join(', ')}`}>
                  {post.categories.map(c => (
                    <span class={`blog-card-dot blog-card-dot-${c}`} title={c === 'rent' ? 'Rent' : 'Sales'}></span>
                  ))}
                </span>
              )}
              {post.iconKey && icons[post.iconKey] && (
                <div class="blog-card-icon" set:html={icons[post.iconKey]} />
              )}
              <div class="blog-card-text">
                <div class="blog-card-eyebrow">{post.eyebrow}</div>
                <h2 class="blog-card-title">{post.title}</h2>
                <div class="blog-card-meta">
                  <span>{post.readMin} min read</span>
                  <span class="blog-card-read">Read more
                    <svg width="12" height="12" viewBox="0 0 14 14" fill="none"><path d="M1 7h12M8 2l5 5-5 5" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/></svg>
                  </span>
                </div>
              </div>
            </a>
          </article>
        ))}
      </div>

      <div class="blog-newsletter">
        <div class="eyebrow">Monthly Market Report</div>
        <h3>New articles, in your inbox.</h3>
        <p>Subscribe to the monthly newsletter and you'll get every new explainer the day it goes live. Free, no pitch.</p>
        <form class="newsletter-form" method="POST" action="https://peters-newsletter-469474.beehiiv.com/subscribe" style="margin-top:14px;max-width:520px;">
          <label for="blog-newsletter-email" class="sr-only">Email address</label>
          <input id="blog-newsletter-email" type="email" name="email" placeholder="your@email.com" required autocomplete="email" />
          <button type="submit" class="btn-primary">Subscribe
            <svg width="14" height="14" viewBox="0 0 14 14" fill="none"><path d="M1 7h12M8 2l5 5-5 5" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/></svg>
          </button>
        </form>
        <p style="font-size:12px;color:var(--ink-mute);margin-top:10px;">Unsubscribe anytime. Your email isn't shared.</p>
      </div>
    </div>
  </section>

  <p class="blog-no-results" id="blog-no-results" hidden>No articles match that search yet. Try a different word.</p>

  <CTASection heading="Got a question for an article?" lead="If there's a topic you've been Googling and can't find a straight answer to, send it over. I'm always looking for the next one to write." />
  <Footer />

  <script>
    (function() {
      const input = document.getElementById('blog-search-input');
      const cards = document.querySelectorAll('.blog-card');
      const noResults = document.getElementById('blog-no-results');
      if (!input || !cards.length) return;
      let activeCategory = 'all';
      const chipBtns = document.querySelectorAll('.blog-filter-chip');
      chipBtns.forEach(function(btn) {
        btn.addEventListener('click', function() {
          chipBtns.forEach(b => b.classList.remove('is-active'));
          btn.classList.add('is-active');
          activeCategory = btn.getAttribute('data-filter') || 'all';
          filter();
        });
      });

      function filter() {
        const q = input.value.trim().toLowerCase();
        let visibleCount = 0;
        cards.forEach(function(card) {
          const text = card.getAttribute('data-search') || '';
          const catList = (card.getAttribute('data-category') || '').split(' ').filter(Boolean);
          const searchMatch = !q || text.indexOf(q) !== -1;
          const catMatch = activeCategory === 'all' || catList.indexOf(activeCategory) !== -1;
          const match = searchMatch && catMatch;
          card.style.display = match ? '' : 'none';
          if (match) visibleCount++;
        });
        if (noResults) noResults.hidden = (q.length === 0 || visibleCount > 0);
      }
      input.addEventListener('input', filter);
    })();
  </script>
</BaseLayout>

<style>
  /* Blog-post category dots — top-right corner of the card
     (solid coloured circles, no text; multiple stack side-by-side) */
  .blog-card { position: relative; }
  .blog-card-dots {
    position: absolute;
    top: 12px;
    right: 12px;
    z-index: 2;
    display: inline-flex;
    align-items: center;
    gap: 5px;
    pointer-events: none;
  }
  .blog-card-dot {
    display: inline-block;
    width: 12px;
    height: 12px;
    border-radius: 50%;
    border: 1.5px solid rgba(0, 0, 0, 0.08);
    box-shadow: 0 1px 2px rgba(0, 0, 0, 0.12);
  }
  .blog-card-dot-sale { background: #1a6b32; }
  .blog-card-dot-rent { background: #b8002e; }
  html[data-theme="dark"] .blog-card-dot { border-color: rgba(255, 255, 255, 0.15); }
  html[data-theme="dark"] .blog-card-dot-sale { background: #4bc774; }
  html[data-theme="dark"] .blog-card-dot-rent { background: #e35a72; }

  /* Filter chips row (below search input) */
  .blog-filter {
    display: flex;
    gap: 8px;
    margin-top: 14px;
    flex-wrap: wrap;
  }
  .blog-filter-chip {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 6px 14px;
    font-family: inherit;
    font-size: 13px;
    font-weight: 600;
    letter-spacing: 0.02em;
    background: var(--bg);
    color: var(--ink-soft);
    border: 1px solid var(--rule);
    border-radius: 999px;
    cursor: pointer;
    transition: background 0.15s, border-color 0.15s, color 0.15s;
  }
  .blog-filter-chip:hover { background: var(--bg-warm); color: var(--ink); }
  .blog-filter-chip.is-active { background: var(--ink); color: var(--bg); border-color: var(--ink); }
  .blog-filter-chip.is-active .blog-filter-dot { background: currentColor; }
  .blog-filter-dot {
    display: inline-block;
    width: 8px;
    height: 8px;
    border-radius: 50%;
  }
  .blog-filter-chip-sale .blog-filter-dot { background: #1a6b32; }
  .blog-filter-chip-rent .blog-filter-dot { background: #b8002e; }
  html[data-theme="dark"] .blog-filter-chip { background: var(--surface); color: var(--ink-soft); border-color: var(--rule); }
  html[data-theme="dark"] .blog-filter-chip:hover { background: var(--bg-warm); color: var(--ink); }
  /* Active-state override for dark mode. Without this, the earlier
     dark-mode background rule wins by specificity and the chip renders
     dark-on-dark, making the label + dot invisible. Cream fill + deep
     dark ink for high-contrast active state. */
  html[data-theme="dark"] .blog-filter-chip.is-active {
    background: var(--ink);
    color: var(--bg);
    border-color: var(--ink);
  }
  html[data-theme="dark"] .blog-filter-chip.is-active .blog-filter-dot {
    background: var(--bg);
  }
</style>

