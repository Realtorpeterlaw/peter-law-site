---
import BaseLayout from '../../layouts/BaseLayout.astro';
import TopBar from '../../components/TopBar.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import CTASection from '../../components/CTASection.astro';

export const prerender = true;

const publishedDate = '2026-11-02';
const articleTitle = 'BRRRR: What Is It?';
const articleDescription = 'The BRRRR method, made simple: Buy, Rehab, Rent, Refinance, Repeat. How some investors reuse the same money to buy rental after rental, a worked example, the catches, and how the strategy has to be adapted to Ontario lending rules, rent control and land transfer tax.';
const articleUrl = 'https://www.realtorpeterlaw.com/blog/brrrr';

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: articleTitle,
  description: articleDescription,
  author: { '@type': 'Person', name: 'Peter Law', url: 'https://www.realtorpeterlaw.com/about' },
  publisher: {
    '@type': 'Organization',
    name: 'Peter Law, Toronto Real Estate',
    logo: { '@type': 'ImageObject', url: 'https://www.realtorpeterlaw.com/photos/peter-cn-tower.jpg', width: 1500, height: 1887 },
  },
  datePublished: publishedDate,
  dateModified: publishedDate,
  mainEntityOfPage: { '@type': 'WebPage', '@id': articleUrl },
  keywords: 'BRRRR method, BRRRR Ontario, BRRRR Toronto, buy rehab rent refinance repeat, real estate investing Ontario, refinance rental property 80% LTV, rent control Ontario investors, additional residential unit Ontario, land transfer tax investor',
};

const hreflangAlternates = [
  { hreflang: 'en-CA', href: 'https://www.realtorpeterlaw.com/blog/brrrr' },
  { hreflang: 'zh-CN', href: 'https://www.realtorpeterlaw.com/chinese/blog/brrrr' },
  { hreflang: 'fr-CA', href: 'https://www.realtorpeterlaw.com/french/blog/brrrr' },
  { hreflang: 'x-default', href: 'https://www.realtorpeterlaw.com/blog/brrrr' },
];

const steps = [
  { key: 'Buy', title: 'Buy a cheap, run-down home', text: 'You look for a property that costs less because it needs work — not because it\'s in a bad spot. Buying it low is the most important step.' },
  { key: 'Rehab', title: 'Fix it up', text: 'You repair and upgrade it — things like the kitchen, bathroom, and floors. Good fixes make the home worth more than you paid, which is the key to the whole plan.' },
  { key: 'Rent', title: 'Rent it to a tenant', text: 'You find a tenant to move in and pay rent every month. That rent should cover your costs, and the bank likes to see a real tenant before the next step.' },
  { key: 'Refinance', title: 'Get a new loan on the higher value', text: 'Because the home is now worth more, you ask the bank for a new mortgage based on that higher value. This lets you pull most of your original money back out.' },
  { key: 'Repeat', title: 'Do it all again', text: 'You take the money you got back and buy the next run-down home. Same money, next property.' },
];
---
<BaseLayout
  title={`${articleTitle} | Peter Law`}
  description={articleDescription}
  bodyClass="guide-page article-page"
  hreflangAlternates={hreflangAlternates}
>
  <TopBar />
  <Header active="blog" />

  <article>
    <section class="page-hero">
      <div class="wrap">
        <div class="eyebrow"><a href="/blog" class="back-link"><svg width="11" height="11" viewBox="0 0 14 14" fill="none" style="vertical-align:-1px;margin-right:5px;" aria-hidden="true"><path d="M13 7H1M6 12L1 7l5-5" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/></svg>Blog</a> · Real Estate Investing · Quick read</div>
        <h1>{articleTitle}</h1>
        <p class="article-lead">The BRRRR method, made simple. How some investors use the same pile of money to buy rental property after rental property. Five steps, one easy word.</p>
        <div class="article-byline">
          <span>By <a href="/about">Peter Law</a></span>
          <span class="dot">·</span>
          <time datetime={publishedDate}>November 2, 2026</time>
          <span class="dot">·</span>
          <span>6 min read</span>
        </div>
      </div>
    </section>

    <section class="major" style="padding-top:32px;">
      <div class="wrap">
        <div class="prose-grid">
          <aside class="prose-side">
            <h2 class="side-h">On this page</h2>
            <ul>
              <li><a href="#the-idea">The idea</a></li>
              <li><a href="#five-steps">The five steps</a></li>
              <li><a href="#example">A simple example</a></li>
              <li><a href="#the-catch">The catch</a></li>
              <li><a href="#ontario">BRRRR in Ontario</a></li>
              <li><a href="#disclaimer">Disclaimer</a></li>
            </ul>
          </aside>

          <div class="prose-body">
            <p class="br-updated">Last updated: November 2026</p>

            <h2 id="the-idea">The idea</h2>
            <div class="br-intro">
              <p>Imagine you had $100 to start a lemonade stand. Normally, once you spend it, it's gone. But what if you could get that same $100 back and use it to open a <strong>second</strong> stand? That is the whole idea behind <strong>BRRRR</strong>.</p>
            </div>

            <h2 id="five-steps">The five steps</h2>
            <p>BRRRR stands for five actions you do in order, then repeat:</p>
            <ol class="br-letters" aria-label="The five BRRRR steps">
              {steps.map((s) => (
                <li><span class="br-letter">{s.key.charAt(0)}</span><span class="br-letter-label">{s.key}</span></li>
              ))}
            </ol>
            <p class="br-repeat"><span aria-hidden="true">↻</span> Then you start over at Buy — with your money back in your pocket.</p>

            <div class="br-steps">
              {steps.map((s) => (
                <div class="br-step">
                  <div class="br-step-key">{s.key}</div>
                  <div>
                    <h3>{s.title}</h3>
                    <p>{s.text}</p>
                  </div>
                </div>
              ))}
            </div>

            <h2 id="example">A simple example</h2>
            <div class="br-example">
              <ul>
                <li>You buy a fixer-upper and put in <strong>$175,000</strong> of your own money (down payment plus repairs).</li>
                <li>After fixing it up, the home is now worth much more than before.</li>
                <li>You refinance, and the bank's new loan lets you pull <strong>most of that $175,000 back out</strong>.</li>
                <li>Now you own a rental that makes money each month — and you have your cash back to buy the next one.</li>
              </ul>
            </div>
            <p>That's the magic investors chase: one pot of money building many properties, instead of being stuck in just one.</p>

            <h2 id="the-catch">The catch — read this part</h2>
            <p>BRRRR sounds easy, but it only works when the numbers line up. Here's what goes wrong:</p>
            <ul class="br-catch">
              <li><strong>The value has to come in high enough.</strong> If the home isn't worth as much as you hoped, the bank won't give your money back — and it gets stuck in the property.</li>
              <li><strong>Repairs often cost more than planned.</strong> Going over budget on the fix-up eats your profit fast.</li>
              <li><strong>Interest rates can change.</strong> You refinance at whatever rates exist later — if they're higher, your monthly costs jump.</li>
              <li><strong>In Ontario,</strong> banks usually only let you borrow up to about 80% of the home's value, and rent rules protect tenants — so the math here is tighter than the American version you might see online.</li>
            </ul>
            <p>BRRRR is a real and powerful way to build wealth. But it rewards careful planning and punishes wishful thinking. The best question to ask any deal is simple: <em>"What happens if the home is worth less than I hoped, and rates are higher?"</em> If it still works, it's a good deal.</p>

            <h2 id="ontario">Tailoring BRRRR to Ontario standards</h2>
            <p>The BRRRR playbook was written for the American market. It still works here, but an Ontario investor has to adjust it in four places before the numbers mean anything.</p>
            <p><strong>The refinance is capped at 80%.</strong> Federally regulated lenders will refinance a conventional mortgage to no more than 80% of the appraised value, and the appraisal is ordered by the lender, not by you. Plan the deal around the number a cautious appraiser will give, not the number you hope for, and expect at least 20% of the new value to stay locked in the property. You also have to qualify at the stress-test rate (the higher of your contract rate plus 2% or 5.25%), and most lenders count only part of the rent toward your income.</p>
            <p><strong>Rent follows the Residential Tenancies Act.</strong> A unit first occupied before November 15, 2018 is tied to the provincial rent increase guideline once a tenant is in place (2.1% for 2026, 1.9% for 2027). A newly created unit, such as a legal basement apartment, is exempt from the guideline, but every unit is limited to one increase every 12 months with 90 days' written notice. Renovating around a sitting tenant is tightly regulated, so most Ontario BRRRR deals rehab a vacant property first and rent it afterwards. If your plan depends on an existing tenant leaving, get legal advice before you buy, not after.</p>
            <p><strong>The "rehab" is often about adding a unit.</strong> Ontario now allows up to three residential units on most urban residential lots as of right, so a permitted basement suite or garden suite can lift both the appraised value and the rent in a single step. The word that matters is <em>permitted</em>: appraisers and lenders discount an unpermitted unit, and the city can order it closed.</p>
            <p><strong>Closing costs and tax are heavier here.</strong> Every purchase pays Ontario land transfer tax, and a property inside Toronto pays the municipal land transfer tax on top, with no first-time buyer rebate for an investor. Interest on the refinanced money is deductible only if that money goes into the next rental, not into your own pocket; our guide to <a href="/blog/interest-deductibility">interest deductibility</a> explains the use-of-funds rule.</p>
            <div class="br-rule">
              <p><strong>The Ontario rule of thumb:</strong> run the deal at 80% of a conservative appraisal, at today's rate plus two points, and with Ontario rent rules applied. If it still returns most of your cash, it is a real Ontario BRRRR. If it only works at 90% and with next year's rent, it isn't.</p>
            </div>

            <div class="br-disclaimer" id="disclaimer">
              <h3>Disclaimer</h3>
              <p>This article is general information for learning, not financial, mortgage, tax or investment advice. Peter Law is a licensed real estate Broker with HomeLife Golconda Realty Inc., Brokerage, not a mortgage broker, accountant or lawyer.</p>
              <p>Lending rules, interest rates, rent guidelines and tax laws change, and the example above is a simplified illustration. Always confirm the numbers with a licensed mortgage professional and your own advisors before making any investment decision. Information was current as of November 2026 and may have changed since.</p>
            </div>

            <div class="seo-tags" role="group" aria-label="Keywords">
              <h2 class="seo-tags-h">Keywords</h2>
              <ul>
                <li>BRRRR method</li>
                <li>BRRRR Ontario</li>
                <li>BRRRR Toronto</li>
                <li>Buy Rehab Rent Refinance Repeat</li>
                <li>Real estate investing Ontario</li>
                <li>Refinance rental property 80% LTV</li>
                <li>Rent control Ontario investors</li>
                <li>Additional residential unit Ontario</li>
                <li>Land transfer tax investor</li>
              </ul>
            </div>
          </div>
        </div>
      </div>
    </section>
  </article>

  <CTASection heading="Curious about investing in Toronto?" lead="I help buyers understand the real numbers behind a property before they commit — no pressure, just straight answers. Fifteen-minute call, no pitch." />
  <Footer />

  <script type="application/ld+json" is:inline set:html={JSON.stringify(jsonLd)} />
</BaseLayout>

<style>
  .br-updated { font-size: 12.5px; letter-spacing: 0.08em; text-transform: uppercase; color: var(--ink-mute); margin-bottom: 18px; }

  /* Intro callout */
  .br-intro { background: var(--bg-warm); border-left: 3px solid var(--accent); padding: 18px 22px; border-radius: 0 4px 4px 0; max-width: 660px; margin: 14px 0 24px; }
  .br-intro p { margin: 0; font-size: 16px; line-height: 1.6; }

  /* Letter strip */
  .br-letters { list-style: none; padding: 18px 12px; margin: 16px 0 10px; max-width: 700px; display: grid; grid-template-columns: repeat(5, minmax(0, 1fr)); gap: 8px; background: var(--surface); border: 1px solid var(--rule); border-radius: 8px; counter-reset: none; }
  .br-letters li { text-align: center; }
  .br-letter { display: block; font-family: 'Fraunces', 'Fraunces Fallback', Georgia, serif; font-weight: 600; font-size: 34px; line-height: 1; color: var(--ink); }
  .br-letter-label { display: block; margin-top: 8px; font-size: 11.5px; letter-spacing: 0.14em; text-transform: uppercase; font-weight: 600; color: var(--ink-soft); }
  .br-repeat { font-size: 13.5px; color: var(--ink-mute); text-align: center; max-width: 700px; margin: 0 0 22px; }

  /* Step cards */
  .br-steps { display: grid; gap: 12px; margin: 0 0 22px; max-width: 760px; }
  .br-step { display: grid; grid-template-columns: 92px 1fr; gap: 14px; align-items: start; background: var(--surface); border: 1px solid var(--rule); border-radius: 6px; padding: 16px 20px 14px; }
  .br-step-key { font-family: 'Fraunces', 'Fraunces Fallback', Georgia, serif; font-weight: 600; font-size: 17px; color: var(--ink); padding-top: 2px; }
  .br-step h3 { font-family: inherit; font-weight: 600; font-size: 16px; margin: 0 0 6px; color: var(--ink-soft); }
  .br-step p { margin: 0; font-size: 15px; line-height: 1.55; }

  /* Example box */
  .br-example { background: var(--surface); border: 1px solid var(--rule); border-radius: 8px; padding: 18px 22px; max-width: 700px; margin: 14px 0 18px; }
  .br-example ul { margin: 0; padding-left: 20px; }
  .br-example li { font-size: 15.5px; line-height: 1.6; margin-bottom: 8px; color: var(--ink-soft); }
  .br-example li:last-child { margin-bottom: 0; }
  .br-example strong { color: var(--ink); }

  /* The catch */
  .br-catch { list-style: none; padding: 0; margin: 14px 0 18px; max-width: 700px; }
  .br-catch li { position: relative; padding: 6px 0 6px 28px; font-size: 15.5px; line-height: 1.6; }
  .br-catch li::before { content: "!"; position: absolute; left: 4px; top: 6px; font-weight: 700; color: #b8002e; }

  /* Ontario rule */
  .br-rule { background: var(--bg-warm); border-left: 3px solid var(--ink); padding: 18px 22px; border-radius: 0 4px 4px 0; max-width: 660px; margin: 18px 0 24px; }
  .br-rule p { margin: 0; font-size: 15.5px; line-height: 1.6; }

  /* Disclaimer */
  .br-disclaimer { max-width: 660px; margin-top: 36px; padding-top: 20px; border-top: 1px solid var(--rule); }
  .br-disclaimer h3 { font-size: 12px; letter-spacing: 0.18em; text-transform: uppercase; color: var(--ink-mute); font-weight: 600; margin: 0 0 10px; font-family: inherit; }
  .br-disclaimer p { font-size: 13.5px; line-height: 1.6; color: var(--ink-mute); margin-bottom: 10px; }

  @media (max-width: 640px) {
    .br-letters { gap: 4px; padding: 14px 6px; }
    .br-letter { font-size: 26px; }
    .br-letter-label { font-size: 9.5px; letter-spacing: 0.08em; }
    .br-step { grid-template-columns: 1fr; gap: 6px; }
  }
  :global(html[data-theme="dark"]) .br-catch li::before { color: #ff7a94; }
</style>
