---
import BaseLayout from '../../layouts/BaseLayout.astro';
import TopBar from '../../components/TopBar.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import CTASection from '../../components/CTASection.astro';

export const prerender = true;

const publishedDate = '2026-09-08';
const articleTitle = "First-Time CONDO Buyer's Guide (Ontario)";
const articleDescription = "A plain-English guide to buying your first condo in Ontario. Types, status certificate, reserve fund, condo fees, parking rules, insurance, pre-construction risks, and a full section for international buyers. With visuals, charts, and a pre-closing checklist.";
const articleUrl = 'https://www.realtorpeterlaw.com/blog/first-time-buyer-guide-condos';

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: articleTitle,
  description: articleDescription,
  author: { '@type': 'Person', name: 'Peter Law', url: 'https://www.realtorpeterlaw.com/about' },
  publisher: {
    '@type': 'Organization',
    name: 'Peter Law — Toronto Real Estate',
    logo: { '@type': 'ImageObject', url: 'https://www.realtorpeterlaw.com/favicon.svg' },
  },
  datePublished: publishedDate,
  dateModified: publishedDate,
  mainEntityOfPage: { '@type': 'WebPage', '@id': articleUrl },
  keywords: 'first time condo buyer Ontario, Toronto condo guide, status certificate condo, reserve fund special assessment, condo fees mortgage approval, pre-construction condo Ontario, 10-day cooling-off condo, interim occupancy, POTL, leasehold co-op condo, NRST Ontario foreign buyer, international buyer Canada condo',
};

const hreflangAlternates = [
  { hreflang: 'en-CA', href: 'https://www.realtorpeterlaw.com/blog/first-time-buyer-guide-condos/' },
  { hreflang: 'zh-CN', href: 'https://www.realtorpeterlaw.com/chinese/blog/first-time-buyer-guide-condos/' },
  { hreflang: 'fr-CA', href: 'https://www.realtorpeterlaw.com/french/blog/first-time-buyer-guide-condos/' },
  { hreflang: 'x-default', href: 'https://www.realtorpeterlaw.com/blog/first-time-buyer-guide-condos/' },
];

// Condo-type icons (small SVG silhouettes)
const condoIcons = {
  highrise: `<svg viewBox="0 0 80 80" xmlns="http://www.w3.org/2000/svg" aria-hidden="true"><rect x="26" y="10" width="28" height="58" fill="var(--bg-warm)" stroke="currentColor" stroke-width="2"/><rect x="30" y="14" width="5" height="6" fill="currentColor" opacity="0.7"/><rect x="38" y="14" width="5" height="6" fill="currentColor" opacity="0.7"/><rect x="46" y="14" width="5" height="6" fill="currentColor" opacity="0.7"/><rect x="30" y="24" width="5" height="6" fill="currentColor" opacity="0.5"/><rect x="38" y="24" width="5" height="6" fill="currentColor" opacity="0.5"/><rect x="46" y="24" width="5" height="6" fill="currentColor" opacity="0.5"/><rect x="30" y="34" width="5" height="6" fill="currentColor" opacity="0.7"/><rect x="38" y="34" width="5" height="6" fill="currentColor" opacity="0.5"/><rect x="46" y="34" width="5" height="6" fill="currentColor" opacity="0.7"/><rect x="30" y="44" width="5" height="6" fill="currentColor" opacity="0.5"/><rect x="38" y="44" width="5" height="6" fill="currentColor" opacity="0.7"/><rect x="46" y="44" width="5" height="6" fill="currentColor" opacity="0.5"/><rect x="35" y="56" width="10" height="12" fill="none" stroke="currentColor" stroke-width="1.5"/></svg>`,
  condotown: `<svg viewBox="0 0 80 80" xmlns="http://www.w3.org/2000/svg" aria-hidden="true"><rect x="8" y="34" width="20" height="32" fill="var(--bg-warm)" stroke="currentColor" stroke-width="1.8"/><rect x="28" y="34" width="20" height="32" fill="var(--bg-warm)" stroke="currentColor" stroke-width="1.8"/><rect x="48" y="34" width="20" height="32" fill="var(--bg-warm)" stroke="currentColor" stroke-width="1.8"/><path d="M8 34 L18 22 L28 34" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round"/><path d="M28 34 L38 22 L48 34" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round"/><path d="M48 34 L58 22 L68 34" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round"/><rect x="14" y="48" width="6" height="12" fill="none" stroke="currentColor" stroke-width="1.4"/><rect x="34" y="48" width="6" height="12" fill="none" stroke="currentColor" stroke-width="1.4"/><rect x="54" y="48" width="6" height="12" fill="none" stroke="currentColor" stroke-width="1.4"/></svg>`,
  stacked: `<svg viewBox="0 0 80 80" xmlns="http://www.w3.org/2000/svg" aria-hidden="true"><rect x="14" y="18" width="52" height="18" fill="var(--bg-warm)" stroke="currentColor" stroke-width="1.8"/><rect x="14" y="36" width="52" height="18" fill="var(--bg-warm)" stroke="currentColor" stroke-width="1.8"/><rect x="14" y="54" width="52" height="14" fill="var(--bg-warm)" stroke="currentColor" stroke-width="1.8"/><rect x="22" y="22" width="6" height="10" fill="none" stroke="currentColor" stroke-width="1.2"/><rect x="52" y="22" width="6" height="10" fill="none" stroke="currentColor" stroke-width="1.2"/><rect x="22" y="40" width="6" height="10" fill="none" stroke="currentColor" stroke-width="1.2"/><rect x="52" y="40" width="6" height="10" fill="none" stroke="currentColor" stroke-width="1.2"/><rect x="36" y="58" width="8" height="10" fill="none" stroke="currentColor" stroke-width="1.4"/></svg>`,
  back2back: `<svg viewBox="0 0 80 80" xmlns="http://www.w3.org/2000/svg" aria-hidden="true"><rect x="10" y="30" width="60" height="36" fill="var(--bg-warm)" stroke="currentColor" stroke-width="1.8"/><line x1="40" y1="30" x2="40" y2="66" stroke="currentColor" stroke-width="1.6"/><path d="M8 32 L40 12 L72 32" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round"/><rect x="18" y="40" width="6" height="10" fill="none" stroke="currentColor" stroke-width="1.2"/><rect x="56" y="40" width="6" height="10" fill="none" stroke="currentColor" stroke-width="1.2"/><rect x="28" y="56" width="8" height="10" fill="none" stroke="currentColor" stroke-width="1.4"/><rect x="44" y="56" width="8" height="10" fill="none" stroke="currentColor" stroke-width="1.4"/></svg>`,
  potl: `<svg viewBox="0 0 80 80" xmlns="http://www.w3.org/2000/svg" aria-hidden="true"><rect x="18" y="36" width="44" height="30" fill="var(--bg-warm)" stroke="currentColor" stroke-width="2"/><path d="M12 40 L40 18 L68 40 Z" fill="var(--bg-warm)" stroke="currentColor" stroke-width="2" stroke-linejoin="round"/><rect x="34" y="48" width="12" height="18" fill="none" stroke="currentColor" stroke-width="1.5"/><path d="M2 68 L 78 68" stroke="currentColor" stroke-width="1.4" stroke-dasharray="3,3" opacity="0.6"/><text x="72" y="76" font-size="7" fill="currentColor" opacity="0.55" text-anchor="end">shared road</text></svg>`,
  vacantland: `<svg viewBox="0 0 80 80" xmlns="http://www.w3.org/2000/svg" aria-hidden="true"><rect x="20" y="38" width="40" height="28" fill="var(--bg-warm)" stroke="currentColor" stroke-width="2"/><path d="M14 42 L40 22 L66 42 Z" fill="var(--bg-warm)" stroke="currentColor" stroke-width="2" stroke-linejoin="round"/><rect x="34" y="48" width="12" height="18" fill="none" stroke="currentColor" stroke-width="1.4"/><rect x="4" y="30" width="16" height="10" fill="none" stroke="currentColor" stroke-width="1" stroke-dasharray="2,2" opacity="0.6"/><rect x="60" y="30" width="16" height="10" fill="none" stroke="currentColor" stroke-width="1" stroke-dasharray="2,2" opacity="0.6"/><text x="12" y="52" font-size="7" fill="currentColor" opacity="0.55" text-anchor="middle">lot</text><text x="68" y="52" font-size="7" fill="currentColor" opacity="0.55" text-anchor="middle">lot</text></svg>`,
  leasehold: `<svg viewBox="0 0 80 80" xmlns="http://www.w3.org/2000/svg" aria-hidden="true"><rect x="18" y="36" width="44" height="30" fill="var(--bg-warm)" stroke="currentColor" stroke-width="2"/><path d="M12 40 L40 18 L68 40 Z" fill="var(--bg-warm)" stroke="currentColor" stroke-width="2" stroke-linejoin="round"/><rect x="34" y="48" width="12" height="18" fill="none" stroke="currentColor" stroke-width="1.5"/><path d="M6 68 L 74 68" stroke="currentColor" stroke-width="2" opacity="0.5"/><text x="40" y="76" font-size="8" fill="currentColor" opacity="0.65" text-anchor="middle">LAND LEASED</text></svg>`,
  coop: `<svg viewBox="0 0 80 80" xmlns="http://www.w3.org/2000/svg" aria-hidden="true"><rect x="20" y="14" width="40" height="52" fill="var(--bg-warm)" stroke="currentColor" stroke-width="2"/><line x1="20" y1="26" x2="60" y2="26" stroke="currentColor" stroke-width="1.6"/><line x1="20" y1="38" x2="60" y2="38" stroke="currentColor" stroke-width="1.6"/><line x1="20" y1="50" x2="60" y2="50" stroke="currentColor" stroke-width="1.6"/><rect x="35" y="56" width="10" height="10" fill="none" stroke="currentColor" stroke-width="1.4"/><text x="40" y="22" font-size="6" fill="currentColor" opacity="0.65" text-anchor="middle">SHARES</text><text x="40" y="34" font-size="6" fill="currentColor" opacity="0.65" text-anchor="middle">SHARES</text><text x="40" y="46" font-size="6" fill="currentColor" opacity="0.65" text-anchor="middle">SHARES</text></svg>`,
  loft: `<svg viewBox="0 0 80 80" xmlns="http://www.w3.org/2000/svg" aria-hidden="true"><rect x="14" y="20" width="52" height="48" fill="var(--bg-warm)" stroke="currentColor" stroke-width="2"/><line x1="14" y1="42" x2="66" y2="42" stroke="currentColor" stroke-width="1.4"/><rect x="20" y="26" width="8" height="12" fill="none" stroke="currentColor" stroke-width="1.2"/><line x1="24" y1="26" x2="24" y2="38" stroke="currentColor" stroke-width="0.8"/><line x1="20" y1="32" x2="28" y2="32" stroke="currentColor" stroke-width="0.8"/><rect x="34" y="26" width="8" height="12" fill="none" stroke="currentColor" stroke-width="1.2"/><line x1="38" y1="26" x2="38" y2="38" stroke="currentColor" stroke-width="0.8"/><line x1="34" y1="32" x2="42" y2="32" stroke="currentColor" stroke-width="0.8"/><rect x="48" y="26" width="8" height="12" fill="none" stroke="currentColor" stroke-width="1.2"/><line x1="52" y1="26" x2="52" y2="38" stroke="currentColor" stroke-width="0.8"/><line x1="48" y1="32" x2="56" y2="32" stroke="currentColor" stroke-width="0.8"/><rect x="33" y="52" width="14" height="16" fill="none" stroke="currentColor" stroke-width="1.4"/></svg>`,
};
---
<BaseLayout
  title={`${articleTitle} | Peter Law`}
  description={articleDescription}
  bodyClass="guide-page article-page"
  hreflangAlternates={hreflangAlternates}
>
  <TopBar />
  <Header active="blog" />

  <article>
    <section class="page-hero">
      <div class="wrap">
        <div class="eyebrow"><a href="/blog" class="back-link"><svg width="11" height="11" viewBox="0 0 14 14" fill="none" style="vertical-align:-1px;margin-right:5px;" aria-hidden="true"><path d="M13 7H1M6 12L1 7l5-5" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/></svg>Blog</a> · Buyer Guide · Condos</div>
        <h1>{articleTitle}</h1>
        <p class="article-lead">When you buy a condo, you buy two things: your unit, and a share of the building. You are not just buying a home — you are joining a corporation and taking on a share of its bills, its rules, and its problems. This guide shows you how to check that corporation before you commit.</p>
        <div class="article-byline">
          <span>By <a href="/about">Peter Law</a></span>
          <span class="dot">·</span>
          <time datetime={publishedDate}>September 8, 2026</time>
          <span class="dot">·</span>
          <span>16 min read</span>
        </div>
      </div>
    </section>

    <!-- ====== QUICK STAT CARDS ====== -->
    <section class="fh-stats-wrap">
      <div class="wrap">
        <div class="fh-stats-grid">
          <div class="fh-stat"><div class="fh-stat-num">10 days</div><div class="fh-stat-label">Cooling-off period</div><div class="fh-stat-sub">Pre-construction only</div></div>
          <div class="fh-stat"><div class="fh-stat-num">$100</div><div class="fh-stat-label">Status certificate cap</div><div class="fh-stat-sub">Delivered within 10 days</div></div>
          <div class="fh-stat"><div class="fh-stat-num">50%</div><div class="fh-stat-label">Of condo fee counts</div><div class="fh-stat-sub">Against your mortgage ratios</div></div>
          <div class="fh-stat"><div class="fh-stat-num">15–25 yr</div><div class="fh-stat-label">Awkward age</div><div class="fh-stat-sub">Big repairs cluster here</div></div>
        </div>
      </div>
    </section>

    <section class="major" style="padding-top:32px;">
      <div class="wrap">
        <div class="prose-grid">
          <aside class="prose-side">
            <h4>On this page</h4>
            <ul>
              <li><a href="#types">Types of condos</a></li>
              <li><a href="#afford">What you can afford</a></li>
              <li><a href="#programs">Government programs</a></li>
              <li><a href="#status">The status certificate</a></li>
              <li><a href="#reserve">Reserve fund &amp; special assessments</a></li>
              <li><a href="#fees">Condo fees</a></li>
              <li><a href="#parking">Parking, lockers &amp; what you own</a></li>
              <li><a href="#rules">The rules you'll live under</a></li>
              <li><a href="#insurance">Insurance — two policies</a></li>
              <li><a href="#resale">Buying a resale condo</a></li>
              <li><a href="#preconstruction">Buying a pre-construction condo</a></li>
              <li><a href="#international">For international buyers</a></li>
              <li><a href="#redflags">Red flags</a></li>
              <li><a href="#mistakes">10 common mistakes</a></li>
              <li><a href="#checklist">Full checklist</a></li>
            </ul>
          </aside>

          <div class="prose-body">

            <!-- ============================================================
                 PART 1 — TYPES
                 ============================================================ -->
            <h2 id="types">Part 1 · Types of condos in Ontario</h2>
            <p>Not all condos are apartments. Nine common types below — and one of them is not a condo at all.</p>

            <div class="fh-house-grid">
              <div class="fh-house-card">
                <div class="fh-house-icon" set:html={condoIcons.highrise} />
                <div class="fh-house-title">Standard condo</div>
                <p>High-rise or low-rise apartment. You own your unit. The corporation owns and maintains everything else. The most common type.</p>
              </div>
              <div class="fh-house-card">
                <div class="fh-house-icon" set:html={condoIcons.condotown} />
                <div class="fh-house-title">Condo townhouse</div>
                <p>You own the inside. The corporation handles roof, exterior walls, lawn, and snow. You pay monthly fees.</p>
              </div>
              <div class="fh-house-card">
                <div class="fh-house-icon" set:html={condoIcons.stacked} />
                <div class="fh-house-title">Stacked townhouse</div>
                <p>Two or three levels stacked, often with separate entrances. Cheaper than regular townhouse. Noise between units and stairs everywhere.</p>
              </div>
              <div class="fh-house-card">
                <div class="fh-house-icon" set:html={condoIcons.back2back} />
                <div class="fh-house-title">Back-to-back townhouse</div>
                <p>Shares side walls AND the rear wall. No backyard. Cheapest form. Harder to resell.</p>
              </div>
              <div class="fh-house-card">
                <div class="fh-house-icon" set:html={condoIcons.potl} />
                <div class="fh-house-title">Common elements (POTL)</div>
                <p>You own the land and house outright — <strong>freehold</strong>. But you pay a monthly fee for shared items like a private road or park. Fees are small but real, and they can rise.</p>
              </div>
              <div class="fh-house-card">
                <div class="fh-house-icon" set:html={condoIcons.vacantland} />
                <div class="fh-house-title">Vacant land condo</div>
                <p>You own the lot and build or own the house on it. Shared roads and services handled by the corporation. Common in newer suburban developments.</p>
              </div>
              <div class="fh-house-card">
                <div class="fh-house-icon" set:html={condoIcons.leasehold} />
                <div class="fh-house-title">Leasehold condo</div>
                <p>You don't own the land — you lease it (often from a university or hospital) for a set number of years. Cheaper for a reason. <strong>Financing and resale get harder as the lease shrinks.</strong></p>
              </div>
              <div class="fh-house-card">
                <div class="fh-house-icon" set:html={condoIcons.coop} />
                <div class="fh-house-title">Co-op (NOT a condo)</div>
                <p>You buy shares in a corporation that owns the building — not real estate. Many lenders won't finance them. The board can refuse your buyer when you sell. Only consider if you fully understand the trade-offs.</p>
              </div>
              <div class="fh-house-card">
                <div class="fh-house-icon" set:html={condoIcons.loft} />
                <div class="fh-house-title">Loft (hard or soft)</div>
                <p><strong>Hard loft</strong> = real old industrial building. <strong>Soft loft</strong> = new building built to look old. Hard lofts often have quirks: poor insulation, noise, odd layouts, higher heating.</p>
              </div>
            </div>

            <!-- ============================================================
                 PART 2 — AFFORDABILITY
                 ============================================================ -->
            <h2 id="afford" style="margin-top:48px;">Part 2 · What you can afford</h2>

            <h3>The stress test</h3>
            <p>Lenders won't approve you at the rate they offer. You must qualify at whichever is <strong>higher</strong>:</p>

            <div class="fh-formula" aria-label="Stress test formula">
              <div class="fh-formula-cell">
                <div class="fh-formula-label">Contract rate</div>
                <div class="fh-formula-value">4.5%</div>
                <div class="fh-formula-sub">example</div>
              </div>
              <div class="fh-formula-op">+</div>
              <div class="fh-formula-cell">
                <div class="fh-formula-label">Stress buffer</div>
                <div class="fh-formula-value">2%</div>
              </div>
              <div class="fh-formula-op">or</div>
              <div class="fh-formula-cell">
                <div class="fh-formula-label">Floor</div>
                <div class="fh-formula-value">5.25%</div>
              </div>
              <div class="fh-formula-op">→</div>
              <div class="fh-formula-cell fh-formula-result">
                <div class="fh-formula-label">Qualify at whichever is HIGHER</div>
                <div class="fh-formula-value">6.5%</div>
              </div>
            </div>

            <h3 style="margin-top:26px;">Condo fees reduce how much you can borrow</h3>
            <p>Most first-time buyers miss this.</p>
            <p>When a lender checks your ratios, they count <strong>50% of your monthly condo fee</strong> as a housing cost. So a $700 fee eats about $350/month of your borrowing power — <em>before</em> you've paid a cent of mortgage.</p>

            <div class="callout" style="border-left: 3px solid var(--ink); padding-left: 22px;">
              <strong>Rule of thumb:</strong> two condos at the same price can qualify very differently based on fees alone. High fees lower your approval amount AND your resale price.
            </div>

            <h3 style="margin-top:26px;">Down payment minimums</h3>
            <div class="fh-dp-chart" role="img" aria-label="Minimum down payment by purchase price bracket">
              <div class="fh-dp-row">
                <div class="fh-dp-label">Up to $500,000</div>
                <div class="fh-dp-bar-wrap"><div class="fh-dp-bar" style="width: 20%;"></div><span class="fh-dp-pct">5%</span></div>
                <div class="fh-dp-example">$500K → $25K</div>
              </div>
              <div class="fh-dp-row">
                <div class="fh-dp-label">$500,001–$1,499,999</div>
                <div class="fh-dp-bar-wrap"><div class="fh-dp-bar" style="width: 35%;"></div><span class="fh-dp-pct">5% + 10% blend</span></div>
                <div class="fh-dp-example">$700K → $45K</div>
              </div>
              <div class="fh-dp-row">
                <div class="fh-dp-label">$1,500,000 and up</div>
                <div class="fh-dp-bar-wrap"><div class="fh-dp-bar" style="width: 100%;"></div><span class="fh-dp-pct">20%</span></div>
                <div class="fh-dp-example">$1.5M → $300K</div>
              </div>
            </div>
            <p style="margin-top:12px;font-size:14px;color:var(--ink-mute);">Under 20% down = mortgage default insurance (~2.8%–4% of the mortgage, rolled into the loan). Ontario 8% PST on the premium is due in cash on closing day.</p>

            <h3 style="margin-top:26px;">Your real monthly cost</h3>
            <div class="fh-closing-stack">
              <div class="fh-closing-row"><span>Mortgage payment</span><span>Principal + interest</span></div>
              <div class="fh-closing-row"><span>+ Condo fee</span><span>Building maintenance</span></div>
              <div class="fh-closing-row"><span>+ Property tax</span><span>Always separate from fees</span></div>
              <div class="fh-closing-row"><span>+ Condo unit insurance</span><span>Your own policy</span></div>
              <div class="fh-closing-row"><span>+ Utilities not in the fee</span><span>Hydro, internet, cable</span></div>
              <div class="fh-closing-row fh-closing-row-total"><span><strong>= Your actual monthly cost</strong></span><span>Run this before you fall in love</span></div>
            </div>

            <p style="margin-top:14px;"><strong>Try it live:</strong> <a href="/payment-calculator">Mortgage Calculator</a> · <a href="/rent-vs-buy-calculator">Rent vs Buy Calculator</a>.</p>

            <!-- ============================================================
                 PART 3 — PROGRAMS
                 ============================================================ -->
            <h2 id="programs" style="margin-top:48px;">Part 3 · Government programs that stack</h2>
            <p>Use these. They are the biggest easy wins.</p>

            <div class="fh-program-grid">
              <div class="fh-program-card">
                <div class="fh-program-tag">Savings</div>
                <div class="fh-program-title">FHSA</div>
                <p><strong>$8,000/year, $40,000 lifetime.</strong> Lowers your taxable income going in. Comes out tax-free for your first home. You never repay it. Max in any one year: <strong>$16,000</strong>. <a href="/blog/fhsa">Full guide.</a></p>
              </div>
              <div class="fh-program-card">
                <div class="fh-program-tag">RRSP</div>
                <div class="fh-program-title">Home Buyers' Plan</div>
                <p>Up to <strong>$60,000 per person</strong> ($120K per couple). Repayable over 15 years. Money must sit in the RRSP <strong>90 days</strong> before withdrawal. Use the FHSA first.</p>
              </div>
              <div class="fh-program-card">
                <div class="fh-program-tag">Tax credit</div>
                <div class="fh-program-title">FTHB Tax Credit</div>
                <p><strong>$1,500</strong> back at tax time. Small but automatic. Claim it on your next return after closing.</p>
              </div>
              <div class="fh-program-card">
                <div class="fh-program-tag">LTT rebate</div>
                <div class="fh-program-title">Land Transfer Tax rebate</div>
                <p>Ontario up to <strong>$4,000</strong>. Toronto an extra <strong>$4,475</strong>. Combined ceiling <strong>$8,475</strong>. Must never have owned a home anywhere in the world.</p>
              </div>
            </div>

            <details class="b60-section-toggle" style="margin-top:22px;">
              <summary class="b60-section-toggle-summary">New builds only: HST rebates (up to $130,000 combined)</summary>
              <div class="b60-section-body">
                <p>Resale condos have no HST. Brand-new condos from a builder do.</p>
                <ul class="bullets">
                  <li><strong>Federal FTHB rebate:</strong> up to <strong>$50,000</strong> on qualifying homes.</li>
                  <li><strong>Ontario temporary program:</strong> up to <strong>$80,000</strong>. Current window requires the agreement to be signed by <strong>March 31, 2027</strong>.</li>
                  <li><strong>Combined ceiling:</strong> up to <strong>$130,000</strong>.</li>
                </ul>
                <p><strong>The stacking rules are complex.</strong> Ask your lawyer and accountant before signing anything. Also see the <a href="/blog/fthb-rebate">FTHB rebate deep-dive</a>.</p>
              </div>
            </details>

            <!-- ============================================================
                 PART 4 — STATUS CERTIFICATE
                 ============================================================ -->
            <h2 id="status" style="margin-top:48px;">Part 4 · The status certificate — do NOT skip this</h2>
            <p>The single most important document in a condo purchase.</p>

            <div class="fh-formula" style="justify-content: flex-start; flex-wrap: wrap;">
              <div class="fh-formula-cell">
                <div class="fh-formula-label">Delivery</div>
                <div class="fh-formula-value">10 days</div>
                <div class="fh-formula-sub">from your written request</div>
              </div>
              <div class="fh-formula-op">·</div>
              <div class="fh-formula-cell">
                <div class="fh-formula-label">Fee (capped by law)</div>
                <div class="fh-formula-value">$100</div>
                <div class="fh-formula-sub">including tax</div>
              </div>
              <div class="fh-formula-op">·</div>
              <div class="fh-formula-cell fh-formula-result">
                <div class="fh-formula-label">Who reviews it</div>
                <div class="fh-formula-value" style="font-size:20px;">YOUR LAWYER</div>
                <div class="fh-formula-sub">not you</div>
              </div>
            </div>

            <h3 style="margin-top:22px;">What's inside</h3>
            <ul class="bullets">
              <li>The <strong>reserve fund</strong> balance + latest reserve fund study</li>
              <li>The current <strong>budget</strong> and current <strong>condo fee</strong> for your unit</li>
              <li>Any <strong>special assessment</strong> approved or coming</li>
              <li>The <strong>declaration, by-laws, and rules</strong></li>
              <li>The <strong>insurance certificate</strong></li>
              <li>Any <strong>lawsuits</strong> involving the corporation</li>
              <li>Whether the current owner <strong>owes money</strong> on the unit</li>
            </ul>

            <div class="callout" style="border-left: 3px solid var(--ink); padding-left: 22px;">
              <strong>Your offer must be conditional on your lawyer's review of the status certificate.</strong> Give yourself enough days to actually get it and read it. This is exactly what you're paying a lawyer for.
            </div>

            <!-- ============================================================
                 PART 5 — RESERVE FUND
                 ============================================================ -->
            <h2 id="reserve" style="margin-top:48px;">Part 5 · Reserve fund &amp; special assessments</h2>
            <p>The reserve fund is the building's savings account for big repairs — roof, elevators, windows, garage, boilers. Every owner contributes through their monthly fee.</p>

            <div class="callout" style="border-left: 3px solid #b8002e; padding-left: 22px;">
              <strong>Why this matters more than anything else:</strong> if the reserve fund is too small when a big repair comes due, the corporation bills the owners directly. That is a <strong>special assessment</strong>. It can be thousands or tens of thousands per unit, due on short notice, with no way to opt out. If you own on the day it's levied, you owe it.
            </div>

            <h3 style="margin-top:22px;">How to check</h3>
            <ul class="bullets">
              <li>Read the <strong>reserve fund study</strong>. It projects future repairs and whether the fund can cover them.</li>
              <li>Look at the <strong>fee history</strong>. Fees that never rise are a warning sign, not a good sign — costs go up, and a corporation that refuses to raise fees is often underfunding the reserve.</li>
              <li>Ask whether any <strong>major work</strong> is planned in the next five years.</li>
            </ul>

            <h3 style="margin-top:22px;">The awkward age</h3>
            <p>Buildings roughly <strong>15 to 25 years old</strong> often hit their first wave of major repairs at once: windows, balconies, garage membrane, elevators. Look very closely at the reserve fund on buildings in that range.</p>

            <!-- ============================================================
                 PART 6 — CONDO FEES
                 ============================================================ -->
            <h2 id="fees" style="margin-top:48px;">Part 6 · Condo fees</h2>

            <div class="fh-before-after" style="grid-template-columns: 1fr 1fr;">
              <div class="fh-ba-col fh-ba-do">
                <div class="fh-ba-title">What fees USUALLY cover</div>
                <ul>
                  <li>Building maintenance</li>
                  <li>Insurance for the building</li>
                  <li>Amenities (pool, gym, party room)</li>
                  <li>Staff, snow &amp; landscaping</li>
                  <li>Reserve fund contributions</li>
                  <li>Often water and heat</li>
                </ul>
              </div>
              <div class="fh-ba-col fh-ba-dont">
                <div class="fh-ba-title">What fees usually DON'T cover</div>
                <ul>
                  <li>Your own unit's repairs</li>
                  <li>Your own condo insurance</li>
                  <li>Hydro (in many buildings)</li>
                  <li>Internet and cable (in most)</li>
                  <li>Property tax — always separate</li>
                </ul>
              </div>
            </div>

            <p style="margin-top:14px;"><strong>High fees aren't always bad.</strong> A building with a pool, gym, concierge, and party room costs more to run. What matters is whether the fee is reasonable for what you get, and whether the reserve is properly funded.</p>

            <p><strong>Low fees plus a weak reserve fund is the dangerous combination.</strong> Plan for fees to rise every year — ask for the last five years of history.</p>

            <!-- ============================================================
                 PART 7 — PARKING
                 ============================================================ -->
            <h2 id="parking" style="margin-top:48px;">Part 7 · Parking, lockers &amp; what you actually own</h2>
            <p>Three arrangements — they're not the same.</p>

            <div class="fh-program-grid" style="grid-template-columns: repeat(3, 1fr);">
              <div class="fh-program-card">
                <div class="fh-program-tag">Best</div>
                <div class="fh-program-title">Owned (deeded)</div>
                <p>You own it. It appears on title. In some buildings you can sell it separately.</p>
              </div>
              <div class="fh-program-card">
                <div class="fh-program-tag">OK</div>
                <div class="fh-program-title">Exclusive use</div>
                <p>Belongs to the corporation but only you may use it. You usually can't sell it separately.</p>
              </div>
              <div class="fh-program-card" style="border-left-color: #b8002e;">
                <div class="fh-program-tag" style="color: #b8002e;">Risky</div>
                <div class="fh-program-title">Rented</div>
                <p>Belongs to someone else. Stops being yours when the lease ends.</p>
              </div>
            </div>

            <div class="callout" style="border-left: 3px solid var(--ink); padding-left: 22px; margin-top:18px;">
              <strong>Confirm which one in writing before you go firm.</strong> Buyers regularly find out after closing that the spot they toured isn't included. Also confirm: big enough for your car? Where is it? A spot on P5 at the far end is not the same as one by the elevator.
            </div>

            <!-- ============================================================
                 PART 8 — RULES
                 ============================================================ -->
            <h2 id="rules" style="margin-top:48px;">Part 8 · The rules you'll be living under</h2>
            <p>Condo rules are enforceable. Read them BEFORE you buy, not after.</p>

            <ul class="bullets">
              <li><strong>Pets.</strong> Weight limits, breed limits, or outright bans are common.</li>
              <li><strong>Short-term rentals.</strong> Most buildings now ban them (no Airbnb).</li>
              <li><strong>Long-term rentals.</strong> Some buildings restrict how many units can be leased.</li>
              <li><strong>Smoking.</strong> Many buildings are now smoke-free, including cannabis, including on balconies.</li>
              <li><strong>Renovations.</strong> You usually need board approval for flooring, plumbing, and anything structural. <strong>Hardwood is banned</strong> in many buildings above the ground floor.</li>
              <li><strong>Balcony use.</strong> Barbecues, storage, and screens are often restricted.</li>
              <li><strong>Moving.</strong> Elevator bookings, deposits, and time windows are normal.</li>
            </ul>

            <!-- ============================================================
                 PART 9 — INSURANCE
                 ============================================================ -->
            <h2 id="insurance" style="margin-top:48px;">Part 9 · Insurance — the part nobody explains</h2>
            <p>There are TWO policies, and you need to understand both.</p>

            <div class="fh-before-after" style="grid-template-columns: 1fr 1fr;">
              <div class="fh-ba-col fh-ba-after">
                <div class="fh-ba-title">The corporation's policy</div>
                <ul>
                  <li>Covers the building</li>
                  <li>Covers common areas (lobby, halls, elevators, roof)</li>
                  <li>Paid from your condo fees</li>
                </ul>
              </div>
              <div class="fh-ba-col fh-ba-do">
                <div class="fh-ba-title">YOUR policy (unit owner)</div>
                <ul>
                  <li>Covers your contents</li>
                  <li>Covers your upgrades</li>
                  <li>Covers your liability</li>
                  <li>Covers living costs if you're forced out</li>
                </ul>
              </div>
            </div>

            <h3 style="margin-top:22px;">The deductible trap</h3>
            <div class="callout" style="border-left: 3px solid #b8002e; padding-left: 22px;">
              If damage starts in your unit — a burst hose, an overflowing tub — the corporation can charge its insurance deductible back to you. Those deductibles are often <strong>$25,000 to $100,000 or more</strong>.
            </div>
            <p style="margin-top:14px;">Your personal condo policy needs specific coverage for this. It's usually cheap to add. <strong>Ask your insurance broker for it by name</strong>, and give them a copy of the status certificate so they can match the amount.</p>

            <!-- ============================================================
                 PART 10 — RESALE
                 ============================================================ -->
            <h2 id="resale" style="margin-top:48px;">Part 10 · Buying a resale condo — what to look at</h2>

            <details class="b60-section-toggle">
              <summary class="b60-section-toggle-summary">The unit — floor, exposure, light, noise, layout</summary>
              <div class="b60-section-body">
                <ul class="bullets">
                  <li><strong>Floor and exposure.</strong> South and west get more light and more heat. North is dark and cooler. East is bright in the morning.</li>
                  <li><strong>What's outside your window.</strong> Check whether a lot next door is empty or approved for a tower. Your view can disappear.</li>
                  <li><strong>Noise.</strong> Elevator shafts, garbage chutes, mechanical rooms, party rooms, street-level bars. Visit at night.</li>
                  <li><strong>Layout.</strong> Long narrow units and units with no bedroom windows are harder to resell.</li>
                  <li><strong>Real size.</strong> Ask for the builder floor plan. Listing sizes vary.</li>
                  <li><strong>Heating and cooling.</strong> Older buildings often have seasonal switchover, which means no air conditioning in early fall.</li>
                </ul>
              </div>
            </details>

            <details class="b60-section-toggle">
              <summary class="b60-section-toggle-summary">The building — elevators, cleanliness, listings, renter ratio</summary>
              <div class="b60-section-body">
                <ul class="bullets">
                  <li><strong>Elevator ratio.</strong> Too few elevators for too many units = long waits every day.</li>
                  <li><strong>Cleanliness of common areas.</strong> A well-kept lobby usually means a well-run corporation.</li>
                  <li><strong>Number of units for sale.</strong> Many at once can signal a problem.</li>
                  <li><strong>Percentage of renters.</strong> Very high renter ratios can affect financing and building care.</li>
                  <li><strong>Talk to the concierge or a resident.</strong> They'll tell you things no listing will.</li>
                </ul>
              </div>
            </details>

            <!-- ============================================================
                 PART 11 — PRE-CONSTRUCTION
                 ============================================================ -->
            <h2 id="preconstruction" style="margin-top:48px;">Part 11 · Buying a pre-construction condo</h2>
            <p>Different process, different risks. Read carefully if you're considering it.</p>

            <div class="callout" style="border-left: 3px solid #1a6b32; padding-left: 22px;">
              <strong>The 10-day cooling-off period.</strong> Under the Condominium Act, you have <strong>10 calendar days</strong> after signing to cancel and get your full deposit back (includes weekends). <strong>Use every one of those days.</strong> Have a lawyer experienced in pre-construction review the agreement, disclosure statement, budget, and Tarion addendum. This is your only window to negotiate. (<em>Resale condos and freehold homes have NO cooling-off period.</em>)
            </div>

            <details class="b60-section-toggle">
              <summary class="b60-section-toggle-summary">Deposits &amp; interim occupancy — the misunderstood part</summary>
              <div class="b60-section-body">
                <p><strong>Deposits.</strong> Usually 15%–20% of the price, paid in installments over months. Condo deposits must be held in trust under the Condominium Act.</p>
                <p><strong>Interim occupancy.</strong> When your unit is ready but the building isn't registered yet, you can move in without owning it. You pay a monthly <strong>occupancy fee</strong> to the builder covering estimated interest on the unpaid price, estimated property tax, and estimated condo fees.</p>
                <div class="callout" style="border-left: 3px solid #b8002e; padding-left: 22px;">
                  <strong>This is NOT a mortgage payment. It builds you no equity. You cannot deduct it.</strong> Interim occupancy commonly lasts 3 to 18 months. On a large project, longer. Budget for it as an extra rent payment on top of everything else.
                </div>
              </div>
            </details>

            <details class="b60-section-toggle">
              <summary class="b60-section-toggle-summary">Development levies, assignment, and the HST trap</summary>
              <div class="b60-section-body">
                <ul class="bullets">
                  <li><strong>Development levies.</strong> New condo closing costs are much higher than resale. Expect development and education levies, utility hookups, Tarion enrolment, legal fees — total 3–5% of the price. <strong>Negotiate a cap on development levies</strong> during your 10-day cooling-off. Uncapped levies can run tens of thousands. This is one of the most valuable things your lawyer can do.</li>
                  <li><strong>Assignment.</strong> Selling your contract before closing. Many builders restrict it, charge large fees, or ban it. If flexibility matters, check this clause before signing.</li>
                  <li><strong>The HST trap.</strong> The new-condo HST rebate is for people who <em>move in</em>. If you buy intending to live there and then rent it out on closing, the builder's credited rebate can be clawed back — you may owe a large sum on closing day. There's a separate rebate for landlords with different rules. Don't guess — ask your accountant.</li>
                </ul>
              </div>
            </details>

            <details class="b60-section-toggle">
              <summary class="b60-section-toggle-summary">Tarion warranty (1 / 2 / 7 years)</summary>
              <div class="b60-section-body">
                <p>New condos come with warranty coverage in three stages:</p>
                <div class="fh-formula" style="justify-content: space-around;">
                  <div class="fh-formula-cell">
                    <div class="fh-formula-label">Workmanship</div>
                    <div class="fh-formula-value">1 yr</div>
                  </div>
                  <div class="fh-formula-cell">
                    <div class="fh-formula-label">Water, electrical, plumbing, heating</div>
                    <div class="fh-formula-value">2 yr</div>
                  </div>
                  <div class="fh-formula-cell fh-formula-result">
                    <div class="fh-formula-label">Major structural</div>
                    <div class="fh-formula-value">7 yr</div>
                  </div>
                </div>
                <p>There are also protections for deposits, delayed occupancy, and project cancellation. Deadlines to file claims are strict. Do your <strong>Pre-Delivery Inspection</strong> carefully — it's your one chance to document defects on the record.</p>
              </div>
            </details>

            <details class="b60-section-toggle">
              <summary class="b60-section-toggle-summary">The honest risk</summary>
              <div class="b60-section-body">
                <p>Projects get delayed by years. Some get cancelled. Your finances must stay stable the entire time, because your mortgage is approved near the end, not at the start. If your income drops or rates rise, you can be stuck.</p>
              </div>
            </details>

            <!-- ============================================================
                 PART 12 — INTERNATIONAL BUYERS
                 ============================================================ -->
            <h2 id="international" style="margin-top:48px;">Part 12 · For international buyers</h2>
            <p>If you are not a Canadian citizen or permanent resident, your rules are different. Read this section BEFORE you shop.</p>

            <div class="callout" style="border-left: 3px solid #b8002e; padding-left: 22px;">
              <strong>Federal Foreign Buyer Ban.</strong> Under the Prohibition on the Purchase of Residential Property by Non-Canadians Act, non-Canadians are currently banned from buying most residential property (extended through at least January 1, 2027). There are limited exceptions — international students, work-permit holders meeting specific conditions, refugees, and some diplomats. <strong>Confirm your eligibility with a Canadian real estate lawyer before you sign anything.</strong> See my <a href="/blog/foreign-buyer-ban">full deep-dive on the ban</a>.
            </div>

            <h3 style="margin-top:22px;">Non-Resident Speculation Tax (NRST)</h3>
            <p>If you fall inside a legal exception to the ban and are able to buy, Ontario also charges a <strong>25% Non-Resident Speculation Tax</strong> on the purchase price for non-citizens and non-permanent-residents. That's due on closing day, in addition to Land Transfer Tax. There are limited rebates (for example, if you later become a permanent resident within a set window).</p>

            <h3 style="margin-top:22px;">Practical checklist for international buyers</h3>
            <ul class="bullets">
              <li><strong>Confirm eligibility first.</strong> A Canadian real estate lawyer must review your immigration status against the federal ban BEFORE you make an offer. Don't rely on a builder or a Realtor.</li>
              <li><strong>Open a Canadian bank account.</strong> You'll need one to hold your deposit and closing funds. Some Canadian banks have "newcomer" programs for people relocating.</li>
              <li><strong>Expect a bigger down payment.</strong> For most non-resident borrowers, lenders require 35%+ down. Some require 50%. Insured mortgages are generally not available.</li>
              <li><strong>Source-of-funds documentation.</strong> Under Canadian anti-money-laundering rules (FINTRAC), you'll be asked to document where your down payment came from. Bank statements going back 3–12 months, letters from employers, tax returns from your home country, and gift letters if funds came from family. Start collecting these early.</li>
              <li><strong>Currency risk.</strong> If your income and savings are in another currency, the exchange rate can shift 5–15% between offer and closing. Consider a forward contract with a Canadian FX firm to lock the rate.</li>
              <li><strong>Tax obligations.</strong> Non-residents who own Canadian real estate have withholding tax rules on rental income, and on the eventual sale. Talk to a Canadian accountant with cross-border experience.</li>
              <li><strong>Legal representation.</strong> Hire a Canadian real estate lawyer independent of the builder. If you're buying pre-construction, hire one experienced in pre-construction condos specifically.</li>
              <li><strong>ID and identity verification.</strong> Under Ontario's real estate rules, your realtor must verify your identity with government-issued ID. Have your passport and immigration documents ready.</li>
              <li><strong>Property management.</strong> If you plan to rent the unit out from abroad, budget 8–12% of gross rent for a property manager, and make sure the building allows long-term rentals (many buildings restrict them).</li>
              <li><strong>Emergency contact and mail address.</strong> You'll need a Canadian mailing address for property tax bills, condo notices, and municipal correspondence. Some property managers provide this as a service.</li>
            </ul>

            <div class="callout" style="border-left: 3px solid var(--ink); padding-left: 22px;">
              <strong>My honest take:</strong> if you are a non-Canadian in 2026–2027, the safest path is to (1) confirm eligibility in writing with a lawyer, (2) budget for NRST + higher down + higher closing costs, and (3) get comfortable that this is a 5+ year commitment. Buying and quickly flipping a Canadian condo as a non-resident is not a viable strategy under current rules.
            </div>

            <!-- ============================================================
                 RED FLAGS
                 ============================================================ -->
            <h2 id="redflags" style="margin-top:48px;">Red flags — slow down if you see these</h2>
            <ul class="bullets">
              <li>Reserve fund study says the fund is underfunded</li>
              <li>A special assessment approved, discussed, or "being considered"</li>
              <li>Condo fees that haven't risen in many years</li>
              <li>Active lawsuits involving the corporation</li>
              <li>Ongoing major repairs with no clear funding plan</li>
              <li>Frequent turnover of property management companies</li>
              <li>A high number of units for sale at the same time</li>
              <li>Known building-wide problems: leaks, cladding, garage membrane, plumbing</li>
              <li>Any pressure to <strong>waive the status certificate condition</strong></li>
            </ul>

            <!-- ============================================================
                 COMMON MISTAKES
                 ============================================================ -->
            <h2 id="mistakes" style="margin-top:48px;">The 10 most common condo-buyer mistakes</h2>
            <ol class="bullets" style="list-style: decimal; padding-left: 20px;">
              <li><strong>Skipping or rushing the status certificate.</strong> The most expensive mistake in condo buying.</li>
              <li><strong>Ignoring the reserve fund.</strong> Special assessments have no ceiling.</li>
              <li><strong>Forgetting condo fees reduce your mortgage approval.</strong></li>
              <li><strong>Assuming the parking spot or locker is included.</strong> Confirm in writing.</li>
              <li><strong>Not reading the rules.</strong> Then finding out about the pet or flooring ban after closing.</li>
              <li><strong>Buying without the right insurance</strong> for the corporation's deductible.</li>
              <li><strong>Not checking what can be built next door.</strong> Views are not protected.</li>
              <li><strong>Not visiting at night or on a weekend.</strong></li>
              <li><strong>Treating pre-construction like resale.</strong> Occupancy fees and levies catch people off guard.</li>
              <li><strong>Wasting the 10-day cooling-off period.</strong> It's the only leverage you get on a new build.</li>
            </ol>

            <!-- ============================================================
                 CHECKLIST
                 ============================================================ -->
            <h2 id="checklist" style="margin-top:48px;">Your full checklist</h2>

            <details class="b60-section-toggle" open>
              <summary class="b60-section-toggle-summary">Before you shop</summary>
              <div class="b60-section-body">
                <ul class="fh-check">
                  <li>Open an FHSA</li>
                  <li>Get pre-approved and understand how condo fees affect your number</li>
                  <li>Choose a real estate lawyer who does condo work</li>
                  <li>Decide your maximum comfortable monthly cost, including the fee</li>
                  <li><strong>International buyers:</strong> confirm eligibility under the federal ban FIRST</li>
                </ul>
              </div>
            </details>

            <details class="b60-section-toggle">
              <summary class="b60-section-toggle-summary">When you view</summary>
              <div class="b60-section-body">
                <ul class="fh-check">
                  <li>Note floor, exposure, and what's outside the window</li>
                  <li>Check noise sources — elevators, chutes, mechanical rooms, streets</li>
                  <li>Visit the building at night and on a weekend</li>
                  <li>Look at the condition of the halls, garage, and lobby</li>
                  <li>Confirm what the fee includes</li>
                  <li>Confirm parking and locker status</li>
                </ul>
              </div>
            </details>

            <details class="b60-section-toggle">
              <summary class="b60-section-toggle-summary">When you offer</summary>
              <div class="b60-section-body">
                <ul class="fh-check">
                  <li>Include a status certificate condition with enough days</li>
                  <li>Include a financing condition</li>
                  <li>Order the status certificate immediately</li>
                  <li>Send it to your lawyer the day it arrives</li>
                </ul>
              </div>
            </details>

            <details class="b60-section-toggle">
              <summary class="b60-section-toggle-summary">Before you go firm</summary>
              <div class="b60-section-body">
                <ul class="fh-check">
                  <li>Lawyer has reviewed and explained the status certificate</li>
                  <li>Reserve fund reviewed</li>
                  <li>No pending special assessment</li>
                  <li>Rules checked against how you actually live</li>
                  <li>Insurance quoted, including deductible coverage</li>
                </ul>
              </div>
            </details>

            <details class="b60-section-toggle">
              <summary class="b60-section-toggle-summary">Before closing</summary>
              <div class="b60-section-body">
                <ul class="fh-check">
                  <li>Final approval confirmed with lender</li>
                  <li>Insurance in place</li>
                  <li>Closing costs confirmed with your lawyer</li>
                  <li>Elevator booked for moving day</li>
                  <li>Nothing changed in your finances</li>
                </ul>
              </div>
            </details>

            <!-- ============================================================
                 DISCLAIMER
                 ============================================================ -->
            <p class="calc-disclaimer" style="margin-top:44px;">
              <strong>Disclaimer.</strong> I am a licensed real estate salesperson. I am NOT a mortgage broker, financial advisor, accountant, lawyer, insurance broker, or home inspector, and nothing in this guide is mortgage, financial, tax, legal, or insurance advice. This guide is general information only. It is not advice for your situation and does not create a client relationship. Condo law, government programs, tax rules, immigration rules, and rebate deadlines change. Every building and every corporation is different. Eligibility for anything described here depends on facts unique to you. Before making any decision, do your own due diligence and get advice from the right licensed professionals — a real estate lawyer to review the status certificate, Agreement of Purchase and Sale, and any builder agreement; a mortgage broker or lender for financing and what you qualify for; an accountant or tax professional for FHSA, RRSP, HST rebate, cross-border tax and NRST questions; a qualified home inspector for the condition of the unit; and an insurance broker for the coverage you actually need, including the corporation's deductible. Do not rely on this guide alone. Verify everything that affects your money with someone licensed to advise you on it.
            </p>

          </div>
        </div>
      </div>
    </section>
  </article>

