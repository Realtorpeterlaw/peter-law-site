---
import BaseLayout from '../../layouts/BaseLayout.astro';
import TopBar from '../../components/TopBar.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import CTASection from '../../components/CTASection.astro';

export const prerender = true;

const publishedDate = '2026-10-06';
const articleTitle = 'Feng Shui: For Beginners';
const articleDescription = 'A simple, room-by-room feng shui guide for new homeowners and renters in Toronto. The front door, the bedroom, the kitchen, the five elements, the bagua map, and the things buyers often hear.';
const articleUrl = 'https://www.realtorpeterlaw.com/blog/feng-shui-for-beginners';

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: articleTitle,
  description: articleDescription,
  author: { '@type': 'Person', name: 'Peter Law', url: 'https://www.realtorpeterlaw.com/about' },
  publisher: {
    '@type': 'Organization',
    name: 'Peter Law, Toronto Real Estate',
    logo: { '@type': 'ImageObject', url: 'https://www.realtorpeterlaw.com/photos/peter-cn-tower.jpg', width: 1500, height: 1887 },
  },
  datePublished: publishedDate,
  dateModified: publishedDate,
  mainEntityOfPage: { '@type': 'WebPage', '@id': articleUrl },
  keywords: 'feng shui for beginners, feng shui Toronto, feng shui new home, feng shui front door, feng shui bedroom bed placement, feng shui kitchen stove, five elements feng shui, bagua map, western bagua, feng shui condo Toronto, number 4 floor condo, T-junction house feng shui, poison arrow feng shui, feng shui home buying',
};

const hreflangAlternates = [
  { hreflang: 'en-CA', href: 'https://www.realtorpeterlaw.com/blog/feng-shui-for-beginners' },
  { hreflang: 'zh-CN', href: 'https://www.realtorpeterlaw.com/chinese/blog/feng-shui-for-beginners' },
  { hreflang: 'fr-CA', href: 'https://www.realtorpeterlaw.com/french/blog/feng-shui-for-beginners' },
  { hreflang: 'x-default', href: 'https://www.realtorpeterlaw.com/blog/feng-shui-for-beginners' },
];

const quickWins = [
  { title: 'Declutter.', text: 'Less stuff means energy moves freely. It also just feels better.' },
  { title: 'Clean your windows.', text: 'Open the curtains in the day. Close them at night.' },
  { title: 'Fix what is broken.', text: 'A dead bulb, a cracked tile, a door that sticks.' },
  { title: 'Add plants.', text: 'Healthy ones. Remove dead or dying plants right away.' },
  { title: 'Check your mirrors.', text: 'They should reflect light or a nice view. Not your front door, and not your bed.' },
];

const elements = [
  { key: 'wood',  glyph: '木', name: 'Wood',  color: '#2f7d4a', how: 'Plants, wooden furniture, green colours.' },
  { key: 'fire',  glyph: '火', name: 'Fire',  color: '#c0392b', how: 'Candles, a fireplace, red or orange accents, good lighting.' },
  { key: 'earth', glyph: '土', name: 'Earth', color: '#b07a3c', how: 'Clay pots, stone, beige and brown tones.' },
  { key: 'metal', glyph: '金', name: 'Metal', color: '#7f8a94', how: 'Metal frames, grey and white, round shapes.' },
  { key: 'water', glyph: '水', name: 'Water', color: '#2c5f8a', how: 'A small fountain, a mirror, blue or black accents.' },
];

const bagua = [
  { name: 'Wealth', hint: 'Plants, fountain, purple and gold' },
  { name: 'Fame & Reputation', hint: 'Awards, diplomas, red accents' },
  { name: 'Love', hint: 'Pairs of things, pink, red, white' },
  { name: 'Family & Health', hint: 'Family photos, plants, green' },
  { name: 'Centre', hint: 'Keep clear and tidy' },
  { name: 'Children & Creativity', hint: 'Artwork, music, pastels' },
  { name: 'Knowledge', hint: 'Books, desk, blue and green' },
  { name: 'Career', hint: 'Water feature, black, dark blue' },
  { name: 'Helpful People', hint: 'Travel photos, white and grey' },
];

const hear = [
  { term: 'Numbers', meaning: 'The number 4 sounds like the word for "death" in Cantonese and Mandarin, so some buyers avoid it. The number 8 sounds like "wealth" and is popular. Many Toronto condo buildings skip floors with a 4 in them.' },
  { term: 'T-junctions', meaning: 'A home at the end of a T-shaped intersection is often avoided. Energy and traffic come straight at it. There is a practical side too: headlights, noise, and the small risk of a car running the stop.' },
  { term: 'Slope', meaning: 'Flat ground means stability. A gentle rise behind the home is seen as good support. Steep downhill lots are less favoured.' },
  { term: 'Nearby buildings', meaning: 'Some buyers avoid homes right beside a hospital, a funeral home, or a cemetery.' },
  { term: 'Sharp corners', meaning: 'A neighbouring roofline or building corner pointed straight at your front door is called a "poison arrow." A plant, a hedge, or a screen softens it.' },
];

const checklist = [
  'Clear the path to your front door',
  'Clean the windows',
  'Check your bed placement. Can you see the door?',
  'Close bathroom doors and put toilet lids down',
  'Fix any dripping tap',
  'Check that all stove burners work',
  'Remove any dead plants',
  'Clear the centre of your home',
  'Check where your mirrors point',
  'Unpack one more box',
];
---
<BaseLayout
  title={`${articleTitle} | Peter Law`}
  description={articleDescription}
  bodyClass="guide-page article-page"
  hreflangAlternates={hreflangAlternates}
>
  <TopBar />
  <Header active="blog" />

  <article>
    <section class="page-hero">
      <div class="wrap">
        <div class="eyebrow"><a href="/blog" class="back-link"><svg width="11" height="11" viewBox="0 0 14 14" fill="none" style="vertical-align:-1px;margin-right:5px;" aria-hidden="true"><path d="M13 7H1M6 12L1 7l5-5" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/></svg>Blog</a> · Home &amp; Living</div>
        <h1>{articleTitle}</h1>
        <p class="article-lead">Feng shui is an old Chinese practice for making a home feel balanced and calm. You do not need to believe in energy to use it.</p>
        <div class="article-byline">
          <span>By <a href="/about">Peter Law</a></span>
          <span class="dot">·</span>
          <time datetime={publishedDate}>October 6, 2026</time>
          <span class="dot">·</span>
          <span>7 min read</span>
        </div>
      </div>
    </section>

    <section class="major" style="padding-top:32px;">
      <div class="wrap">
        <div class="prose-grid">
          <aside class="prose-side">
            <h2 class="side-h">On this page</h2>
            <ul>
              <li><a href="#meaning">What feng shui actually means</a></li>
              <li><a href="#five-things">If you only do five things</a></li>
              <li><a href="#front-door">The front door</a></li>
              <li><a href="#bedroom">The bedroom</a></li>
              <li><a href="#kitchen">The kitchen</a></li>
              <li><a href="#bathroom">The bathroom</a></li>
              <li><a href="#living-room">The living room</a></li>
              <li><a href="#elements">The five elements</a></li>
              <li><a href="#bagua">The bagua map</a></li>
              <li><a href="#hear">Things you may hear</a></li>
              <li><a href="#checklist">Your first weekend</a></li>
              <li><a href="#honest">Honest note</a></li>
            </ul>
          </aside>

          <div class="prose-body">

            <p>Many people in Toronto follow feng shui. Many others just like the ideas, because they make a home feel better to live in. This guide walks you through it one room at a time.</p>

            <details class="b60-section-toggle" id="meaning">
              <summary class="b60-section-toggle-summary">What feng shui actually means</summary>
              <div class="b60-section-body">
                <p>Feng shui (<span lang="zh-Hans">风水</span>) means "wind and water."</p>
                <p>The idea is simple. Energy, called <strong>chi</strong> or <strong>qi</strong>, moves through your home like air or water. You want it to flow smoothly. You do not want it blocked. You do not want it rushing through too fast.</p>
                <p>That is the whole concept. Everything in this guide comes from it.</p>
              </div>
            </details>

            <!-- ============================================================
                 FIVE THINGS
                 ============================================================ -->
            <section class="fs-quick" id="five-things" aria-labelledby="fs-quick-h">
              <h2 class="fs-quick-h" id="fs-quick-h">If you only do five things</h2>
              <ol class="fs-habits">
                {quickWins.map((q, i) => (
                  <li>
                    <span class="fs-habit-num" aria-hidden="true">{i + 1}</span>
                    <div><strong>{q.title}</strong> {q.text}</div>
                  </li>
                ))}
              </ol>
            </section>

            <!-- ============================================================
                 FRONT DOOR
                 ============================================================ -->
            <h2 id="front-door">The front door</h2>
            <p>The front door matters most. Feng shui calls it the "mouth of chi." It is where energy enters your home.</p>

            <div class="fs-dodont">
              <div class="fs-col fs-do">
                <h3 class="fs-col-h">Do this</h3>
                <ul>
                  <li>Keep the path to your door clear. Trim bushes and move clutter.</li>
                  <li>Make sure the door opens fully. It should not bump into anything.</li>
                  <li>Keep it clean. Fix a squeaky hinge or a broken handle.</li>
                  <li>Add good light so the entry is bright at night.</li>
                  <li>Put a healthy plant or fresh flowers near the door.</li>
                </ul>
              </div>
              <div class="fs-col fs-dont">
                <h3 class="fs-col-h">Watch out for</h3>
                <ul>
                  <li><strong>A front door that lines up with the back door.</strong> Energy comes in and goes right out. Place a plant, a screen, or a rug between them to slow it down.</li>
                  <li><strong>A mirror facing the front door.</strong> It pushes energy back out. Hang it on a side wall instead.</li>
                  <li><strong>A bathroom right across from the front door.</strong> Keep that door closed.</li>
                </ul>
              </div>
            </div>

            <div class="callout fs-tip"><strong>Living in a condo?</strong> Your suite door is your front door. The same rules apply. Check your condo rules before you change anything on the door itself, your balcony, or any common area.</div>

            <!-- ============================================================
                 BEDROOM
                 ============================================================ -->
            <h2 id="bedroom">The bedroom</h2>
            <p>This is where you rest. It should feel safe and calm.</p>

            <div class="fs-dodont">
              <div class="fs-col fs-do">
                <h3 class="fs-col-h">Bed placement</h3>
                <ul>
                  <li>You should be able to see the bedroom door from your bed.</li>
                  <li>Do not line your bed up directly with the door. Off to one side is better.</li>
                  <li>Put the head of your bed against a solid wall. Not a window.</li>
                  <li>Use a solid headboard. Wood or metal works well.</li>
                  <li>Leave space on both sides. Put a nightstand on each side.</li>
                  <li>Do not store things under the bed. Energy needs to move through.</li>
                </ul>
              </div>
              <div class="fs-col fs-dont">
                <h3 class="fs-col-h">Also avoid</h3>
                <ul>
                  <li>Heavy art or a large frame above your head.</li>
                  <li>A mirror facing the bed directly.</li>
                  <li>Work in the bedroom, if you can help it. No desk, no files.</li>
                </ul>
              </div>
            </div>

            <!-- ============================================================
                 KITCHEN
                 ============================================================ -->
            <h2 id="kitchen">The kitchen</h2>
            <p>The kitchen stands for health and wealth.</p>
            <ul class="bullets">
              <li><strong>Keep the stove clean and working.</strong> All burners should light.</li>
              <li><strong>The cook should not have their back to the room.</strong> If the stove faces a wall, hang a small mirror or a metal panel so you can see behind you.</li>
              <li><strong>Do not put the stove right beside the sink.</strong> Fire and water clash. If they already sit side by side, put something wooden between them, like a cutting board.</li>
              <li><strong>Keep the fridge and pantry stocked.</strong> Empty shelves feel like scarcity.</li>
              <li><strong>Fix any dripping tap.</strong> In feng shui, dripping water means money leaking away.</li>
            </ul>

            <!-- ============================================================
                 BATHROOM
                 ============================================================ -->
            <h2 id="bathroom">The bathroom</h2>
            <p>Bathrooms drain energy. That is just how feng shui sees them. Two fixes cover almost all of it.</p>

            <ol class="fs-steps">
              <li><span class="fs-step-num" aria-hidden="true">1</span><span>Keep the bathroom door closed.</span></li>
              <li><span class="fs-step-num" aria-hidden="true">2</span><span>Keep the toilet lid down.</span></li>
            </ol>

            <p>Beyond that, fix leaks and keep the room clean and dry. Add a plant if there is light.</p>

            <!-- ============================================================
                 LIVING ROOM
                 ============================================================ -->
            <h2 id="living-room">The living room</h2>
            <p>This is where people gather.</p>
            <ul class="bullets">
              <li><strong>Arrange seating so people can see each other.</strong> A circle or a square works better than a row.</li>
              <li><strong>Nobody should sit with their back to the main door.</strong></li>
              <li><strong>Leave clear paths to walk through.</strong> Do not make people squeeze past furniture.</li>
              <li><strong>Round or soft-edged tables are better</strong> than sharp corners pointed at seats.</li>
              <li><strong>Make sure the room has good light.</strong></li>
            </ul>

            <!-- ============================================================
                 FIVE ELEMENTS
                 ============================================================ -->
            <h2 id="elements">The five elements</h2>
            <p>Feng shui uses five elements: <strong>wood, fire, earth, metal, and water</strong>. The goal is balance. A room with all five feels complete. Too much of one feels off.</p>

            <ul class="fs-elements" aria-label="The five elements and easy ways to add them">
              {elements.map((el) => (
                <li class="fs-el" style={`--el:${el.color}`}>
                  <div class="fs-el-top">
                    <span class="fs-el-glyph" lang="zh-Hans" aria-hidden="true">{el.glyph}</span>
                    <span class="fs-el-name">{el.name}</span>
                  </div>
                  <p>{el.how}</p>
                </li>
              ))}
            </ul>

            <p>You do not need all five in every room. Look around and see what is missing. If you cannot add the real thing, a picture of it works.</p>
            <div class="callout fs-tip"><strong>Do not overdo one element.</strong> Too much water can feel heavy. Too much fire can feel tense. Too much earth can feel sluggish. Balance is the whole point.</div>

            <!-- ============================================================
                 BAGUA
                 ============================================================ -->
            <h2 id="bagua">The bagua map</h2>
            <p>The bagua is an energy map. You lay it over your floor plan. It splits your home into nine areas, each tied to a part of life. There are two common versions.</p>
            <ul class="bullets">
              <li><strong>Western bagua (the easy one).</strong> Line the grid up with the wall your front door is on. Your door falls in one of the bottom three squares. This is the usual choice for condos and apartments.</li>
              <li><strong>Classic bagua.</strong> This uses a compass reading taken at your front door. It takes more practice.</li>
            </ul>
            <p>Here is the Western grid, with easy ways to support each area.</p>

            <div class="fs-bagua-wrap">
              <ol class="fs-bagua" aria-label="Western bagua map, nine areas">
                {bagua.map((cell, i) => (
                  <li class={`fs-bagua-cell${i === 4 ? ' fs-bagua-centre' : ''}`}>
                    <span class="fs-bagua-name">{cell.name}</span>
                    <span class="fs-bagua-hint">{cell.hint}</span>
                  </li>
                ))}
              </ol>
              <div class="fs-bagua-door"><svg width="14" height="14" viewBox="0 0 14 14" fill="none" aria-hidden="true"><path d="M7 1v12M2 8l5 5 5-5" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/></svg> The wall with your front door</div>
            </div>

            <div class="callout fs-tip"><strong>Start small.</strong> Pick one or two areas that matter to you right now. You do not have to do all nine.</div>

            <!-- ============================================================
                 THINGS YOU MAY HEAR
                 ============================================================ -->
            <h2 id="hear">Things you may hear</h2>
            <p>Some feng shui ideas come up when people shop for a home. Here is what they mean.</p>

            <div class="fs-table-wrap">
              <table class="fs-table">
                <thead>
                  <tr>
                    <th scope="col">What people say</th>
                    <th scope="col">What it means</th>
                  </tr>
                </thead>
                <tbody>
                  {hear.map((row) => (
                    <tr>
                      <th scope="row">{row.term}</th>
                      <td>{row.meaning}</td>
                    </tr>
                  ))}
                </tbody>
              </table>
            </div>

            <div class="callout fs-tip"><strong>If your home has one of these, do not panic.</strong> Many of them can be softened with simple changes. And plenty of buyers do not follow feng shui at all.</div>

            <!-- ============================================================
                 CHECKLIST
                 ============================================================ -->
            <h2 id="checklist">Your first weekend</h2>
            <p>Ten things you can do before the boxes are even unpacked. Tick them off as you go.</p>
            <ul class="fs-checklist">
              {checklist.map((item, i) => (
                <li>
                  <input type="checkbox" id={`fs-check-${i + 1}`} />
                  <label for={`fs-check-${i + 1}`}>{item}</label>
                </li>
              ))}
            </ul>

            <!-- ============================================================
                 HONEST NOTE
                 ============================================================ -->
            <h2 id="honest">Honest note:</h2>
            <div class="fs-honest">
              <p>Feng shui is a tradition, not a science. There is no proof it changes your luck, your health, or your home's value.</p>
              <p>What it does do is push you toward a home that is clean, bright, uncluttered, and easy to move through. That is worth doing on its own.</p>
              <p><strong>Use the parts that make sense to you. Skip the rest.</strong></p>
            </div>

            <div class="fs-disclaimer">
              <h3>Disclaimer</h3>
              <p>I am a licensed real estate salesperson. I am not a feng shui practitioner, interior designer, contractor, or home inspector.</p>
              <p>This guide is general information about a cultural tradition. It is not advice about the value, condition, or suitability of any property, and it does not create a client relationship. Feng shui is a belief practice. Nothing here is a claim that it affects property values, resale, health, or finances.</p>
              <p>Before making changes to your home, speak with the right professional: a contractor for anything structural, a qualified home inspector for condition, and a certified feng shui consultant if you want a full reading of your space. If you live in a condominium, check your corporation's declaration, by-laws, and rules before changing anything on your door, balcony, or any common element.</p>
            </div>

            <div class="seo-tags" role="group" aria-label="Keywords">
              <h2 class="seo-tags-h">Keywords</h2>
              <ul>
                <li>Feng shui for beginners</li>
                <li>Feng shui new home</li>
                <li>Feng shui Toronto</li>
                <li>Front door feng shui</li>
                <li>Bedroom bed placement</li>
                <li>Kitchen stove and sink</li>
                <li>Five elements</li>
                <li>Bagua map</li>
                <li>Feng shui condo</li>
                <li>Number 4 floors</li>
                <li>T-junction house</li>
                <li>Poison arrow</li>
              </ul>
            </div>

          </div>
        </div>
      </div>
    </section>
  </article>

  <CTASection heading="Shopping with feng shui in mind?" lead="If a floor number, a street layout, or a bed-to-door line matters to you or your family, tell me up front. I will screen listings for it before we ever book a showing. No pressure, no pitch." />
  <Footer />

  <script type="application/ld+json" is:inline set:html={JSON.stringify(jsonLd)} />
</BaseLayout>

<style>
  /* Quick-start panel */
  .fs-quick { background: var(--surface); border: 1px solid var(--rule); border-left: 3px solid var(--accent); border-radius: 6px; padding: 18px 22px 6px; margin: 28px 0 8px; max-width: 760px; }
  .prose-body .fs-quick-h { font-family: 'Fraunces', 'Fraunces Fallback', Georgia, serif; font-weight: 500; font-size: 22px; margin: 0 0 4px; color: var(--ink); }
  .fs-quick .fs-habits { margin: 0; max-width: none; }
  .fs-quick .fs-habits li { padding: 12px 0; font-size: 15px; }
  .fs-quick .fs-habit-num { flex: 0 0 32px; font-size: 28px; }

  /* Do / Watch-out columns */
  .fs-dodont { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 14px; margin: 18px 0 20px; max-width: 760px; }
  .fs-col { background: var(--surface); border: 1px solid var(--rule); border-radius: 6px; padding: 18px 20px; }
  .fs-col-h { font-family: 'Fraunces', 'Fraunces Fallback', Georgia, serif; font-weight: 500; font-size: 17px; margin: 0 0 10px; padding-bottom: 8px; border-bottom: 1px solid var(--rule); color: var(--ink); }
  .fs-col ul { list-style: none; padding: 0; margin: 0; }
  .fs-col li { position: relative; padding: 5px 0 5px 22px; font-size: 14.5px; line-height: 1.5; color: var(--ink-soft); }
  .fs-col li strong { color: var(--ink); font-weight: 600; }
  .fs-col li::before { position: absolute; left: 0; top: 5px; font-weight: 700; }
  .fs-do li::before { content: "✓"; color: #1a6b32; }
  .fs-dont li::before { content: "✕"; color: #b8002e; }
  @media (max-width: 640px) { .fs-dodont { grid-template-columns: 1fr; } }

  .fs-tip { border-left: 3px solid var(--accent); }

  /* Two-step list (bathroom) */
  .fs-steps { list-style: none; padding: 0; margin: 14px 0 18px; display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 12px; max-width: 660px; }
  .fs-steps li { display: flex; align-items: center; gap: 12px; background: var(--surface); border: 1px solid var(--rule); border-radius: 6px; padding: 14px 16px; font-size: 15px; font-weight: 600; color: var(--ink); }
  .fs-step-num { flex: 0 0 34px; width: 34px; height: 34px; border-radius: 50%; background: var(--ink); color: var(--bg); display: inline-flex; align-items: center; justify-content: center; font-family: 'Fraunces', 'Fraunces Fallback', Georgia, serif; font-size: 17px; font-weight: 500; }
  @media (max-width: 480px) { .fs-steps { grid-template-columns: 1fr; } }

  /* Five elements */
  .fs-elements { list-style: none; padding: 0; margin: 18px 0 20px; display: grid; grid-template-columns: repeat(5, minmax(0, 1fr)); gap: 12px; max-width: 760px; }
  .fs-el { background: var(--surface); border: 1px solid var(--rule); border-top: 4px solid var(--el); border-radius: 6px; padding: 14px 14px 12px; min-width: 0; }
  .fs-el-top { display: flex; align-items: baseline; gap: 8px; margin-bottom: 6px; }
  .fs-el-glyph { font-size: 22px; line-height: 1; color: var(--el); font-weight: 500; }
  .fs-el-name { font-family: 'Fraunces', 'Fraunces Fallback', Georgia, serif; font-size: 18px; font-weight: 500; color: var(--ink); }
  .fs-el p { font-size: 13px; line-height: 1.5; color: var(--ink-soft); margin: 0; }
  @media (max-width: 900px) { .fs-elements { grid-template-columns: repeat(3, minmax(0, 1fr)); } }
  @media (max-width: 560px) { .fs-elements { grid-template-columns: repeat(2, minmax(0, 1fr)); } }

  /* Bagua 3x3 */
  .fs-bagua-wrap { max-width: 620px; margin: 18px 0 8px; }
  .fs-bagua { list-style: none; padding: 0; margin: 0; display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 6px; }
  .fs-bagua-cell { display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 5px; text-align: center; min-height: 112px; padding: 12px 10px; background: var(--surface); border: 1px solid var(--rule); border-radius: 6px; min-width: 0; overflow-wrap: anywhere; }
  .fs-bagua-name { font-family: 'Fraunces', 'Fraunces Fallback', Georgia, serif; font-size: 16px; line-height: 1.2; color: var(--ink); }
  .fs-bagua-hint { font-size: 12px; line-height: 1.35; color: var(--ink-soft); }
  .fs-bagua-centre { background: var(--bg-warm); border-color: var(--ink); }
  .fs-bagua-door { display: flex; align-items: center; justify-content: center; gap: 6px; margin-top: 8px; padding: 8px; border: 1px dashed var(--ink-mute); border-radius: 6px; font-size: 11.5px; letter-spacing: 0.14em; text-transform: uppercase; color: var(--ink-mute); font-weight: 600; }
  @media (max-width: 480px) {
    .fs-bagua-cell { min-height: 104px; padding: 10px 5px; gap: 4px; }
