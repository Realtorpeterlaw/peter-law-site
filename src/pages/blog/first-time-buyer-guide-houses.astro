---
import BaseLayout from '../../layouts/BaseLayout.astro';
import TopBar from '../../components/TopBar.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import CTASection from '../../components/CTASection.astro';

export const prerender = true;

const publishedDate = '2026-09-08';
const articleTitle = "First-Time HOUSE Buyer's Guide (Ontario)";
const articleDescription = "Every type of house in Ontario, what to check before you buy, government programs that stack, and the closing costs first-time buyers forget. With visual charts, calculators, and a full pre-closing checklist.";
const articleUrl = 'https://www.realtorpeterlaw.com/blog/first-time-buyer-guide-houses';

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: articleTitle,
  description: articleDescription,
  author: { '@type': 'Person', name: 'Peter Law', url: 'https://www.realtorpeterlaw.com/about' },
  publisher: {
    '@type': 'Organization',
    name: 'Peter Law — Toronto Real Estate',
    logo: { '@type': 'ImageObject', url: 'https://www.realtorpeterlaw.com/favicon.svg' },
  },
  datePublished: publishedDate,
  dateModified: publishedDate,
  mainEntityOfPage: { '@type': 'WebPage', '@id': articleUrl },
  keywords: 'first time home buyer Ontario, house buyer guide Toronto, types of houses Ontario, detached vs semi, freehold townhouse, link home, bungalow, century home Ontario, rural home well septic, cottage waterfront Ontario, FHSA HBP FTHB rebate, land transfer tax Toronto, HST rebate new build Ontario, home inspection, closing costs first-time buyer',
};

const hreflangAlternates = [
  { hreflang: 'en-CA', href: 'https://www.realtorpeterlaw.com/blog/first-time-buyer-guide-houses/' },
  { hreflang: 'zh-CN', href: 'https://www.realtorpeterlaw.com/chinese/blog/first-time-buyer-guide-houses/' },
  { hreflang: 'fr-CA', href: 'https://www.realtorpeterlaw.com/french/blog/first-time-buyer-guide-houses/' },
  { hreflang: 'x-default', href: 'https://www.realtorpeterlaw.com/blog/first-time-buyer-guide-houses/' },
];

// House-type icons (small silhouettes)
const houseIcons = {
  detached: `<svg viewBox="0 0 80 80" xmlns="http://www.w3.org/2000/svg" aria-hidden="true"><rect x="18" y="36" width="44" height="30" fill="var(--bg-warm)" stroke="currentColor" stroke-width="2"/><path d="M12 40 L40 18 L68 40 Z" fill="var(--bg-warm)" stroke="currentColor" stroke-width="2" stroke-linejoin="round"/><rect x="34" y="48" width="12" height="18" fill="none" stroke="currentColor" stroke-width="1.5"/><rect x="24" y="46" width="6" height="6" fill="none" stroke="currentColor" stroke-width="1"/><rect x="50" y="46" width="6" height="6" fill="none" stroke="currentColor" stroke-width="1"/></svg>`,
  semi: `<svg viewBox="0 0 80 80" xmlns="http://www.w3.org/2000/svg" aria-hidden="true"><rect x="10" y="38" width="30" height="28" fill="var(--bg-warm)" stroke="currentColor" stroke-width="2"/><rect x="40" y="38" width="30" height="28" fill="var(--bg-warm)" stroke="currentColor" stroke-width="2"/><path d="M6 42 L25 24 L44 42 Z" fill="var(--bg-warm)" stroke="currentColor" stroke-width="2" stroke-linejoin="round"/><path d="M36 42 L55 24 L74 42 Z" fill="var(--bg-warm)" stroke="currentColor" stroke-width="2" stroke-linejoin="round"/><rect x="18" y="48" width="6" height="14" fill="none" stroke="currentColor" stroke-width="1.4"/><rect x="48" y="48" width="6" height="14" fill="none" stroke="currentColor" stroke-width="1.4"/><line x1="40" y1="38" x2="40" y2="66" stroke="currentColor" stroke-width="2"/></svg>`,
  town: `<svg viewBox="0 0 80 80" xmlns="http://www.w3.org/2000/svg" aria-hidden="true"><rect x="8" y="34" width="20" height="32" fill="var(--bg-warm)" stroke="currentColor" stroke-width="1.8"/><rect x="28" y="34" width="20" height="32" fill="var(--bg-warm)" stroke="currentColor" stroke-width="1.8"/><rect x="48" y="34" width="20" height="32" fill="var(--bg-warm)" stroke="currentColor" stroke-width="1.8"/><path d="M8 34 L18 22 L28 34" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round"/><path d="M28 34 L38 22 L48 34" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round"/><path d="M48 34 L58 22 L68 34" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round"/><rect x="14" y="48" width="6" height="12" fill="none" stroke="currentColor" stroke-width="1.4"/><rect x="34" y="48" width="6" height="12" fill="none" stroke="currentColor" stroke-width="1.4"/><rect x="54" y="48" width="6" height="12" fill="none" stroke="currentColor" stroke-width="1.4"/></svg>`,
  bungalow: `<svg viewBox="0 0 80 80" xmlns="http://www.w3.org/2000/svg" aria-hidden="true"><rect x="14" y="42" width="52" height="24" fill="var(--bg-warm)" stroke="currentColor" stroke-width="2"/><path d="M8 46 L40 22 L72 46 Z" fill="var(--bg-warm)" stroke="currentColor" stroke-width="2" stroke-linejoin="round"/><rect x="34" y="50" width="12" height="16" fill="none" stroke="currentColor" stroke-width="1.5"/><rect x="20" y="50" width="8" height="8" fill="none" stroke="currentColor" stroke-width="1.3"/><rect x="52" y="50" width="8" height="8" fill="none" stroke="currentColor" stroke-width="1.3"/></svg>`,
  century: `<svg viewBox="0 0 80 80" xmlns="http://www.w3.org/2000/svg" aria-hidden="true"><rect x="20" y="30" width="40" height="36" fill="var(--bg-warm)" stroke="currentColor" stroke-width="2"/><path d="M14 34 L40 14 L66 34 Z" fill="var(--bg-warm)" stroke="currentColor" stroke-width="2" stroke-linejoin="round"/><rect x="28" y="26" width="24" height="12" fill="var(--bg-warm)" stroke="currentColor" stroke-width="1.5"/><rect x="33" y="30" width="6" height="6" fill="none" stroke="currentColor" stroke-width="1"/><rect x="41" y="30" width="6" height="6" fill="none" stroke="currentColor" stroke-width="1"/><path d="M35 40 Q40 36 45 40 L45 52 L35 52 Z" fill="none" stroke="currentColor" stroke-width="1.4"/><rect x="24" y="40" width="6" height="8" fill="none" stroke="currentColor" stroke-width="1.2"/><rect x="50" y="40" width="6" height="8" fill="none" stroke="currentColor" stroke-width="1.2"/></svg>`,
  multi: `<svg viewBox="0 0 80 80" xmlns="http://www.w3.org/2000/svg" aria-hidden="true"><rect x="18" y="18" width="44" height="48" fill="var(--bg-warm)" stroke="currentColor" stroke-width="2"/><line x1="18" y1="34" x2="62" y2="34" stroke="currentColor" stroke-width="1.6"/><line x1="18" y1="50" x2="62" y2="50" stroke="currentColor" stroke-width="1.6"/><rect x="24" y="22" width="7" height="8" fill="none" stroke="currentColor" stroke-width="1.2"/><rect x="49" y="22" width="7" height="8" fill="none" stroke="currentColor" stroke-width="1.2"/><rect x="24" y="38" width="7" height="8" fill="none" stroke="currentColor" stroke-width="1.2"/><rect x="49" y="38" width="7" height="8" fill="none" stroke="currentColor" stroke-width="1.2"/><rect x="34" y="54" width="12" height="12" fill="none" stroke="currentColor" stroke-width="1.5"/></svg>`,
  rural: `<svg viewBox="0 0 80 80" xmlns="http://www.w3.org/2000/svg" aria-hidden="true"><rect x="22" y="38" width="36" height="28" fill="var(--bg-warm)" stroke="currentColor" stroke-width="2"/><path d="M16 42 L40 22 L64 42 Z" fill="var(--bg-warm)" stroke="currentColor" stroke-width="2" stroke-linejoin="round"/><rect x="36" y="48" width="10" height="18" fill="none" stroke="currentColor" stroke-width="1.4"/><path d="M4 66 Q20 60 40 62 T76 66" stroke="currentColor" stroke-width="1.4" fill="none"/><circle cx="10" cy="30" r="3" fill="currentColor" opacity="0.5"/><circle cx="72" cy="26" r="4" fill="currentColor" opacity="0.5"/><path d="M4 66 L 76 66" stroke="currentColor" stroke-width="0.8" opacity="0.5"/></svg>`,
  cottage: `<svg viewBox="0 0 80 80" xmlns="http://www.w3.org/2000/svg" aria-hidden="true"><path d="M14 44 L40 22 L66 44 L66 60 L14 60 Z" fill="var(--bg-warm)" stroke="currentColor" stroke-width="2" stroke-linejoin="round"/><rect x="34" y="46" width="12" height="14" fill="none" stroke="currentColor" stroke-width="1.4"/><path d="M4 66 Q15 62 25 66 T45 66 T65 66 T80 66" stroke="currentColor" stroke-width="1.6" fill="none"/><path d="M4 70 Q15 66 25 70 T45 70 T65 70 T80 70" stroke="currentColor" stroke-width="1.2" fill="none" opacity="0.6"/></svg>`,
  luxury: `<svg viewBox="0 0 80 80" xmlns="http://www.w3.org/2000/svg" aria-hidden="true"><rect x="10" y="34" width="60" height="32" fill="var(--bg-warm)" stroke="currentColor" stroke-width="2"/><path d="M6 38 L20 22 L34 38 Z" fill="var(--bg-warm)" stroke="currentColor" stroke-width="2" stroke-linejoin="round"/><path d="M46 38 L60 22 L74 38 Z" fill="var(--bg-warm)" stroke="currentColor" stroke-width="2" stroke-linejoin="round"/><rect x="34" y="46" width="12" height="20" fill="none" stroke="currentColor" stroke-width="1.4"/><rect x="15" y="44" width="8" height="10" fill="none" stroke="currentColor" stroke-width="1.2"/><rect x="57" y="44" width="8" height="10" fill="none" stroke="currentColor" stroke-width="1.2"/><path d="M20 22 L20 15 L23 18" fill="none" stroke="currentColor" stroke-width="1.4"/></svg>`,
  new: `<svg viewBox="0 0 80 80" xmlns="http://www.w3.org/2000/svg" aria-hidden="true"><rect x="18" y="36" width="44" height="30" fill="var(--bg-warm)" stroke="currentColor" stroke-width="2"/><path d="M12 40 L40 18 L68 40 Z" fill="var(--bg-warm)" stroke="currentColor" stroke-width="2" stroke-linejoin="round"/><rect x="30" y="44" width="20" height="22" fill="none" stroke="currentColor" stroke-width="1.4" stroke-dasharray="3,3"/><path d="M52 20 L54 26 L60 28 L54 30 L52 36 L50 30 L44 28 L50 26 Z" fill="currentColor" opacity="0.7"/></svg>`,
};
---
<BaseLayout
  title={`${articleTitle} | Peter Law`}
  description={articleDescription}
  bodyClass="guide-page article-page"
  hreflangAlternates={hreflangAlternates}
>
  <TopBar />
  <Header active="blog" />

  <article>
    <section class="page-hero">
      <div class="wrap">
        <div class="eyebrow"><a href="/blog" class="back-link"><svg width="11" height="11" viewBox="0 0 14 14" fill="none" style="vertical-align:-1px;margin-right:5px;" aria-hidden="true"><path d="M13 7H1M6 12L1 7l5-5" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/></svg>Blog</a> · Buyer Guide · Houses</div>
        <h1>{articleTitle}</h1>
        <p class="article-lead">Every type of house in Ontario, and what to check before you buy one. When you buy a house, you own the building <em>and</em> the land it sits on. Nobody fixes your roof. Nobody plows your driveway. Nobody warns you the furnace is 22 years old. That freedom is the whole appeal. It is also the whole risk.</p>
        <div class="article-byline">
          <span>By <a href="/about">Peter Law</a></span>
          <span class="dot">·</span>
          <time datetime={publishedDate}>September 8, 2026</time>
          <span class="dot">·</span>
          <span>15 min read</span>
        </div>
      </div>
    </section>

    <!-- ====== QUICK STAT CARDS ====== -->
    <section class="fh-stats-wrap">
      <div class="wrap">
        <div class="fh-stats-grid">
          <div class="fh-stat"><div class="fh-stat-num">5–20%</div><div class="fh-stat-label">Down payment range</div><div class="fh-stat-sub">by purchase price</div></div>
          <div class="fh-stat"><div class="fh-stat-num">$40K</div><div class="fh-stat-label">FHSA lifetime cap</div><div class="fh-stat-sub">$8K per year, tax-deductible</div></div>
          <div class="fh-stat"><div class="fh-stat-num">$8,475</div><div class="fh-stat-label">Land-transfer rebate</div><div class="fh-stat-sub">Toronto FTHB (ON + Toronto)</div></div>
          <div class="fh-stat"><div class="fh-stat-num">1–1.5%</div><div class="fh-stat-label">Annual maintenance</div><div class="fh-stat-sub">of home value, per year</div></div>
        </div>
      </div>
    </section>

    <section class="major" style="padding-top:32px;">
      <div class="wrap">
        <div class="prose-grid">
          <aside class="prose-side">
            <h4>On this page</h4>
            <ul>
              <li><a href="#types">Types of houses in Ontario</a></li>
              <li><a href="#afford">What you can afford</a></li>
              <li><a href="#programs">Government programs</a></li>
              <li><a href="#check">What to check in any house</a></li>
              <li><a href="#rural">Rural, cottage &amp; farm</a></li>
              <li><a href="#offer">The offer &amp; the inspection</a></li>
              <li><a href="#closing">Closing costs</a></li>
              <li><a href="#before-after">Before &amp; after closing</a></li>
              <li><a href="#mistakes">10 common mistakes</a></li>
              <li><a href="#checklist">The full checklist</a></li>
            </ul>
          </aside>

          <div class="prose-body">

            <!-- ============================================================
                 PART 1 — TYPES OF HOUSES
                 ============================================================ -->
            <h2 id="types">Part 1 · Types of houses in Ontario</h2>
            <p>Not every "house" is the same product. Two buildings that look identical from the street can have completely different ownership, monthly costs, and resale risk. Here's every kind you'll see.</p>

            <div class="fh-house-grid">
              <div class="fh-house-card">
                <div class="fh-house-icon" set:html={houseIcons.detached} />
                <div class="fh-house-title">Detached</div>
                <p>Standalone on its own lot. No shared walls. Most privacy, most control, highest price, most maintenance.</p>
              </div>
              <div class="fh-house-card">
                <div class="fh-house-icon" set:html={houseIcons.semi} />
                <div class="fh-house-title">Semi-detached</div>
                <p>Two houses joined by one shared wall. Usually 10–20% cheaper than a comparable detached. Ask about the shared roof, eaves, or driveway.</p>
              </div>
              <div class="fh-house-card">
                <div class="fh-house-icon" set:html={houseIcons.detached} />
                <div class="fh-house-title">Link home</div>
                <p>Looks detached from the street, but the foundations (or garages) are joined below ground. Cheaper than true detached — <strong>always check the survey</strong>.</p>
              </div>
              <div class="fh-house-card">
                <div class="fh-house-icon" set:html={houseIcons.town} />
                <div class="fh-house-title">Row / townhouse</div>
                <p>Three flavours: <strong>freehold</strong> (own land, no fee), <strong>condo</strong> (fee, corporation maintains), or <strong>common-element / POTL</strong> (own land, small fee for shared roads). Ask which.</p>
              </div>
              <div class="fh-house-card">
                <div class="fh-house-icon" set:html={houseIcons.bungalow} />
                <div class="fh-house-title">Bungalow &amp; raised bungalow</div>
                <p>Everything on one level. Raised versions have partly above-ground basements — easier for legal basement apartments.</p>
              </div>
              <div class="fh-house-card">
                <div class="fh-house-icon" set:html={houseIcons.century} />
                <div class="fh-house-title">Century home</div>
                <p>100+ years old. Character and craftsmanship, but budget for old wiring, plumbing, insulation, possible asbestos or lead. Insurance can be harder.</p>
              </div>
              <div class="fh-house-card">
                <div class="fh-house-icon" set:html={houseIcons.multi} />
                <div class="fh-house-title">Duplex / triplex / fourplex</div>
                <p>Live in one, rent the others. Is it <strong>legally</strong> a duplex or just a house with a second kitchen? Tenants (and their rents) transfer with the property.</p>
              </div>
              <div class="fh-house-card">
                <div class="fh-house-icon" set:html={houseIcons.rural} />
                <div class="fh-house-title">Rural / acreage</div>
                <p>Private well, private septic, often propane or oil heat. Underground problems dominate. See Part 5.</p>
              </div>
              <div class="fh-house-card">
                <div class="fh-house-icon" set:html={houseIcons.cottage} />
                <div class="fh-house-title">Cottage / waterfront</div>
                <p>Extra rules from the conservation authority. Watch for the shore road allowance, water access only, and seasonality.</p>
              </div>
              <div class="fh-house-card">
                <div class="fh-house-icon" set:html={houseIcons.luxury} />
                <div class="fh-house-title">Estate / luxury</div>
                <p>Over $1.5M = mandatory 20% down, no CMHC insurance. Toronto Municipal LTT jumps at $3M. Appraisals get harder.</p>
              </div>
              <div class="fh-house-card">
                <div class="fh-house-icon" set:html={houseIcons.new} />
                <div class="fh-house-title">New build (freehold)</div>
                <p><strong>No cooling-off period</strong> on freehold pre-construction. Tarion warranty applies. Cap development levies before signing.</p>
              </div>
            </div>

            <details class="b60-section-toggle">
              <summary class="b60-section-toggle-summary">More formats: back-to-back, stacked, side/back-splits, modular, mobile, ADU</summary>
              <div class="b60-section-body">
                <ul class="bullets">
                  <li><strong>Back-to-back townhouse:</strong> shares side walls AND the rear wall. No backyard. Cheapest, hardest to resell.</li>
                  <li><strong>Stacked townhouse:</strong> units on top of each other with separate entrances. Almost always condo. Lots of stairs.</li>
                  <li><strong>1.5 storey:</strong> a storey and a half with sloped ceilings upstairs. Charming, but often insulation and headroom issues.</li>
                  <li><strong>Two-storey:</strong> the standard family home. Bedrooms upstairs, living space down.</li>
                  <li><strong>Side-split / back-split:</strong> multiple levels offset by half-flights. Common in 1950s–70s Ontario. Great separation, stairs everywhere.</li>
                  <li><strong>Modular / prefab:</strong> factory-built and assembled on site. On a permanent foundation, treated like any other house.</li>
                  <li><strong>Mobile / park model:</strong> often on leased land. Financing is difficult. Understand exactly what you own vs rent.</li>
                  <li><strong>Garden suite / laneway / ADU:</strong> Ontario has expanded what's allowed, but rules vary by city. <strong>Confirm in writing with the municipality</strong> before you buy on that assumption.</li>
                  <li><strong>Hobby farm vs working farm:</strong> hobby farms are valued as homes with land. Working farms bring zoning, tile drainage, tenant leases, and often need agricultural lenders.</li>
                </ul>
              </div>
            </details>

            <!-- ============================================================
                 PART 2 — AFFORDABILITY
                 ============================================================ -->
            <h2 id="afford" style="margin-top:48px;">Part 2 · What you can afford</h2>

            <div class="fh-formula" aria-label="Stress test formula">
              <div class="fh-formula-cell">
                <div class="fh-formula-label">Contract rate</div>
                <div class="fh-formula-value">4.5%</div>
                <div class="fh-formula-sub">example</div>
              </div>
              <div class="fh-formula-op">+</div>
              <div class="fh-formula-cell">
                <div class="fh-formula-label">Stress buffer</div>
                <div class="fh-formula-value">2%</div>
              </div>
              <div class="fh-formula-op">=</div>
              <div class="fh-formula-cell">
                <div class="fh-formula-label">Or floor</div>
                <div class="fh-formula-value">5.25%</div>
              </div>
              <div class="fh-formula-op">→</div>
              <div class="fh-formula-cell fh-formula-result">
                <div class="fh-formula-label">Qualify at whichever is HIGHER</div>
                <div class="fh-formula-value">6.5%</div>
              </div>
            </div>

            <h3 style="margin-top:26px;">The debt ratios</h3>
            <p>Two numbers your lender will care about:</p>
            <ul class="bullets">
              <li><strong>GDS (Gross Debt Service):</strong> housing costs under about <strong>39%</strong> of gross income.</li>
              <li><strong>TDS (Total Debt Service):</strong> all debts under about <strong>44%</strong>.</li>
            </ul>
            <div class="callout"><strong>Real leverage:</strong> paying off a car loan or credit card before you apply can raise your approval by more than saving another $10,000 for down payment.</div>

            <h3 style="margin-top:26px;">Down payment minimums</h3>
            <div class="fh-dp-chart" role="img" aria-label="Minimum down payment by purchase price bracket">
              <div class="fh-dp-row">
                <div class="fh-dp-label">Up to $500,000</div>
                <div class="fh-dp-bar-wrap"><div class="fh-dp-bar" style="width: 20%;"></div><span class="fh-dp-pct">5%</span></div>
                <div class="fh-dp-example">$500K → $25K</div>
              </div>
              <div class="fh-dp-row">
                <div class="fh-dp-label">$500,001–$1,499,999</div>
                <div class="fh-dp-bar-wrap"><div class="fh-dp-bar" style="width: 35%;"></div><span class="fh-dp-pct">5% + 10% blend</span></div>
                <div class="fh-dp-example">$700K → $45K</div>
              </div>
              <div class="fh-dp-row">
                <div class="fh-dp-label">$1,500,000 and up</div>
                <div class="fh-dp-bar-wrap"><div class="fh-dp-bar" style="width: 100%;"></div><span class="fh-dp-pct">20%</span></div>
                <div class="fh-dp-example">$1.5M → $300K</div>
              </div>
            </div>
            <p style="margin-top:12px;font-size:14px;color:var(--ink-mute);">Under 20% down = mortgage default insurance (~2.8%–4% of the mortgage, rolled into the loan). Ontario 8% PST on that premium is due in cash on closing day.</p>

            <h3 style="margin-top:26px;">Big-ticket replacement costs</h3>
            <p>What people forget: houses eat capital in irregular lumps. Plan for it.</p>
            <div class="fh-cost-chart" role="img" aria-label="Typical replacement cost ranges for major house systems">
              <div class="fh-cost-row"><span class="fh-cost-item">Roof</span><div class="fh-cost-bar-wrap"><div class="fh-cost-bar" style="width:40%;"></div></div><span class="fh-cost-range">$8K–$20K+</span></div>
              <div class="fh-cost-row"><span class="fh-cost-item">Furnace</span><div class="fh-cost-bar-wrap"><div class="fh-cost-bar" style="width:20%;"></div></div><span class="fh-cost-range">$5K–$10K</span></div>
              <div class="fh-cost-row"><span class="fh-cost-item">Windows</span><div class="fh-cost-bar-wrap"><div class="fh-cost-bar" style="width:60%;"></div></div><span class="fh-cost-range">$10K–$30K+</span></div>
              <div class="fh-cost-row"><span class="fh-cost-item">Foundation repair</span><div class="fh-cost-bar-wrap"><div class="fh-cost-bar fh-cost-bar-hot" style="width:100%;"></div></div><span class="fh-cost-range">$10K–$50K+</span></div>
              <div class="fh-cost-row"><span class="fh-cost-item">Septic replacement</span><div class="fh-cost-bar-wrap"><div class="fh-cost-bar fh-cost-bar-hot" style="width:90%;"></div></div><span class="fh-cost-range">$20K–$45K+</span></div>
            </div>

            <p style="margin-top:14px;"><strong>Ongoing budget:</strong> 1–1.5% of home value per year in maintenance. On an $800K house, that's <strong>$8K–$12K/year</strong>. Not "maybe someday" — plan for it every year.</p>

            <p style="margin-top:14px;"><strong>Try it live:</strong> plug your numbers into the <a href="/payment-calculator">Mortgage Calculator</a> and see three scenarios side by side.</p>

            <!-- ============================================================
                 PART 3 — GOVERNMENT PROGRAMS
                 ============================================================ -->
            <h2 id="programs" style="margin-top:48px;">Part 3 · Government programs that stack</h2>
            <p>First-time buyers get more help than most people realize. The four below stack — you can use all of them.</p>

            <div class="fh-program-grid">
              <div class="fh-program-card">
                <div class="fh-program-tag">Savings</div>
                <div class="fh-program-title">FHSA</div>
                <p><strong>$8,000/year, $40,000 lifetime.</strong> Deductible going in, tax-free coming out, never repaid. Carry-forward capped at $8K, so max in any one year is <strong>$16,000</strong>. <a href="/blog/fhsa">Full FHSA guide.</a></p>
              </div>
              <div class="fh-program-card">
                <div class="fh-program-tag">RRSP</div>
                <div class="fh-program-title">Home Buyers' Plan</div>
                <p>Up to <strong>$60,000 per person</strong>. Repayable over 15 years, starting the second year after withdrawal. Money must sit in the RRSP for <strong>90 days</strong> before you withdraw. Use the FHSA first.</p>
              </div>
              <div class="fh-program-card">
                <div class="fh-program-tag">Tax credit</div>
                <div class="fh-program-title">FTHB Tax Credit</div>
                <p><strong>$1,500 back at tax time.</strong> Small but automatic — claim it on your next return after closing.</p>
              </div>
              <div class="fh-program-card">
                <div class="fh-program-tag">LTT rebate</div>
                <div class="fh-program-title">Land Transfer Tax rebate</div>
                <p>Ontario up to <strong>$4,000</strong>. Toronto an extra <strong>$4,475</strong>. Toronto buyers get both — combined <strong>up to $8,475</strong>. Must never have owned a home anywhere in the world.</p>
              </div>
            </div>

            <details class="b60-section-toggle" style="margin-top:22px;">
              <summary class="b60-section-toggle-summary">New builds only: HST rebates (up to $130,000 combined)</summary>
              <div class="b60-section-body">
                <p>Resale houses have no HST. New houses from a builder do.</p>
                <ul class="bullets">
                  <li><strong>Federal FTHB rebate:</strong> up to <strong>$50,000</strong> on qualifying homes.</li>
                  <li><strong>Ontario temporary program:</strong> up to <strong>$80,000</strong>. Current window requires the agreement to be signed by <strong>March 31, 2027</strong>.</li>
                  <li><strong>Combined ceiling:</strong> up to <strong>$130,000</strong> on qualifying purchases.</li>
                </ul>
                <p><strong>Confirm with your lawyer and accountant.</strong> The stacking rules are complicated and the money is large. Also see <a href="/blog/fthb-rebate">the FTHB rebate deep-dive</a>.</p>
              </div>
            </details>

            <!-- ============================================================
                 PART 4 — WHAT TO CHECK
                 ============================================================ -->
            <h2 id="check" style="margin-top:48px;">Part 4 · What to check in any house</h2>
            <p>Four layers, from bones to paperwork to street. Skip a layer and you skip the problem hiding in it.</p>

            <details class="b60-section-toggle">
              <summary class="b60-section-toggle-summary">1. The bones — foundation, roof, water, drainage</summary>
              <div class="b60-section-body">
                <ul class="bullets">
                  <li><strong>Foundation.</strong> Look for cracks. <strong>Horizontal cracks are serious</strong> — they can mean bowing walls. Small vertical cracks are usually minor. White chalky residue on basement walls = past water entry.</li>
                  <li><strong>Roof.</strong> Ask its age. Look for curling / missing shingles and ceiling stains inside.</li>
                  <li><strong>Water.</strong> The most expensive problem in any house. Check under every sink, around every window, in the basement, in the attic. Musty smells matter. Spongy floors matter.</li>
                  <li><strong>Grading &amp; drainage.</strong> The ground should slope AWAY from the house. Downspouts should discharge well clear of the foundation.</li>
                </ul>
              </div>
            </details>

            <details class="b60-section-toggle">
              <summary class="b60-section-toggle-summary">2. The systems — HVAC, electrical, plumbing, windows</summary>
              <div class="b60-section-body">
                <ul class="bullets">
                  <li><strong>Furnace, AC, water heater.</strong> Find model + serial numbers and look up the age. Furnaces last 15–25 years. Water heaters 7–15.</li>
                  <li><strong>Electrical red flags:</strong>
                    <ul class="bullets" style="margin-top:4px;">
                      <li><strong>Knob-and-tube wiring</strong> — many insurers refuse coverage or demand replacement.</li>
                      <li><strong>Aluminum wiring</strong> (mid-1960s to late 1970s) — insurable, but usually requires certified connectors + an inspection.</li>
                    </ul>
                  </li>
                  <li><strong>Panel size.</strong> 100 amps is the practical minimum; 60-amp service will need upgrading.</li>
                  <li><strong>Plumbing.</strong> Galvanized pipes = near end of life. <strong>Kitec</strong> plumbing (mid-1990s to mid-2000s) is known to fail and can affect insurance.</li>
                  <li><strong>Windows.</strong> Fogging between the panes = seal failure.</li>
                </ul>
              </div>
            </details>

            <details class="b60-section-toggle">
              <summary class="b60-section-toggle-summary">3. The paperwork — rentals, permits, survey, environmental</summary>
              <div class="b60-section-body">
                <ul class="bullets">
                  <li><strong>Rented equipment.</strong> Ontario homes very often have <strong>rented water heaters, furnaces, ACs, or water softeners</strong> on contracts that transfer to you. Some are long and expensive to break. Ask what's rented, get the contract, put it in the offer.</li>
                  <li><strong>Permits.</strong> Most cities let you search building permits online for free. Check any addition, finished basement, or deck. Unpermitted work can mean insurance problems and orders to remove it.</li>
                  <li><strong>Survey.</strong> Ask the seller for one. Shows actual lot lines, easements, and encroachments.</li>
                  <li><strong>Special situations to ask about:</strong> underground / above-ground <strong>oil tanks</strong>, <strong>UFFI</strong> insulation, <strong>asbestos</strong> and <strong>vermiculite</strong> in older homes, and any history as a grow op.</li>
                </ul>
              </div>
            </details>

            <details class="b60-section-toggle">
              <summary class="b60-section-toggle-summary">4. The location — the thing you can never renovate</summary>
              <div class="b60-section-body">
                <ul class="bullets">
                  <li>Drive the street on a weekday morning, a weeknight, and a weekend.</li>
                  <li>Check what's planned for empty land nearby.</li>
                  <li>Check flood plain, landfill, rail lines, hydro corridors, and flight paths.</li>
                  <li>Talk to a neighbour if you can. <strong>You can fix a house. You cannot fix bad neighbours.</strong></li>
                </ul>
              </div>
            </details>

            <!-- ============================================================
                 PART 5 — RURAL
                 ============================================================ -->
            <h2 id="rural" style="margin-top:48px;">Part 5 · Rural, cottage &amp; farm — the extra homework</h2>
            <p>City buyers underestimate this. Rural problems are underground and in the outbuildings.</p>

            <details class="b60-section-toggle">
              <summary class="b60-section-toggle-summary">Well water — never skip this</summary>
              <div class="b60-section-body">
                <p>A visual look at the well cap is <strong>not a test</strong>. Make your offer conditional on:</p>
                <ul class="bullets">
                  <li><strong>Water quality test</strong> — minimum total coliform, E. coli, and nitrates.</li>
                  <li><strong>Flow rate test</strong> — a well that runs dry in August is a serious problem.</li>
                  <li><strong>Well record</strong> from Ontario's registry — look it up.</li>
                </ul>
                <p>Also check the well's distance from the septic bed and from neighbouring farm operations.</p>
              </div>
            </details>

            <details class="b60-section-toggle">
              <summary class="b60-section-toggle-summary">Septic system — separate inspector required</summary>
              <div class="b60-section-body">
                <p>Make your offer conditional on a <strong>septic inspection by a qualified septic inspector</strong>, not the general home inspector. Ask for:</p>
                <ul class="bullets">
                  <li>Age of the system and last pump-out date.</li>
                  <li>Location of the tank and leaching bed.</li>
                  <li>Original permit and drawings from the municipality.</li>
                </ul>
                <div class="callout" style="border-left: 3px solid #b8002e; padding-left: 22px;"><strong>If it fails after closing, it is your problem.</strong> There is no small fix. Replacement runs tens of thousands. Watch for greener/wetter strips of grass, spongy ground, or sewage smells.</div>
              </div>
            </details>

            <details class="b60-section-toggle">
              <summary class="b60-section-toggle-summary">Wood stoves, heating fuel, access &amp; services</summary>
              <div class="b60-section-body">
                <ul class="bullets">
                  <li><strong>Wood stoves / fireplaces:</strong> get a <strong>WETT inspection</strong>. Most insurers require one.</li>
                  <li><strong>Heating fuel:</strong> propane, oil, or electric all cost more than natural gas. Get the last 12 months of bills. Oil tanks have insurance rules and age limits.</li>
                  <li><strong>Road:</strong> municipally maintained year-round, or private and seasonal? Who plows, and what does it cost?</li>
                  <li><strong>Right of way:</strong> is it across someone else's land? Is it registered on title?</li>
                  <li><strong>Internet and cell:</strong> check on site, not on a coverage map.</li>
                  <li><strong>Garbage:</strong> pickup or dump run?</li>
                </ul>
              </div>
            </details>

            <details class="b60-section-toggle">
              <summary class="b60-section-toggle-summary">Cottage-specific — shore road allowance, water access, insurance</summary>
              <div class="b60-section-body">
                <ul class="bullets">
                  <li><strong>Shore road allowance.</strong> Many Ontario waterfront properties have a strip of land along the water still owned by the municipality. If it hasn't been purchased and closed, you may not own down to the waterline. Your lawyer must check.</li>
                  <li><strong>Water access only.</strong> No road = harder financing, insurance, and resale.</li>
                  <li><strong>Season.</strong> Confirm winterization and year-round road / water usability.</li>
                  <li><strong>Conservation authority.</strong> Docks, boathouses, shoreline work, and additions often need approval. Check what already exists is legal.</li>
                  <li><strong>Insurance.</strong> Seasonal and water-access properties cost more to insure and some carriers won't write them.</li>
                </ul>
              </div>
            </details>

            <details class="b60-section-toggle">
              <summary class="b60-section-toggle-summary">Farm-specific — zoning, MDS, HST, tenant farmers</summary>
              <div class="b60-section-body">
                <ul class="bullets">
                  <li><strong>Zoning.</strong> Confirm with the municipality what you may actually do.</li>
                  <li><strong>Minimum Distance Separation (MDS).</strong> Governs how close homes and livestock barns can be.</li>
                  <li><strong>HST.</strong> Farmland is often subject to HST on the farm portion; the house portion may not be. Get tax advice <strong>before</strong> you sign.</li>
                  <li><strong>Farm property tax class.</strong> A lower rate is available for eligible farms — but you must apply and qualify.</li>
                  <li><strong>Tenant farmers / crop-share leases.</strong> These can survive your purchase.</li>
                  <li><strong>Tile drainage.</strong> Ask for maps and any outstanding drainage loans (they can transfer).</li>
                  <li><strong>Financing.</strong> Agricultural lenders may be a better fit than a bank.</li>
                  <li><strong>Environmental.</strong> Old fuel tanks, chemical storage, and dumps are real risks. Consider an environmental assessment.</li>
                </ul>
              </div>
            </details>

            <!-- ============================================================
                 PART 6 — OFFER + INSPECTION
                 ============================================================ -->
            <h2 id="offer" style="margin-top:48px;">Part 6 · The offer and the inspection</h2>

            <div class="callout" style="border-left: 3px solid var(--ink); padding-left: 22px;">
              <strong>Once both sides sign, it is binding. There is no cooling-off period on a resale house in Ontario.</strong> Every counter-offer cancels the one before it.
            </div>

            <h3 style="margin-top:22px;">Conditions worth writing in</h3>
            <ul class="bullets">
              <li><strong>Financing.</strong></li>
              <li><strong>Home inspection.</strong></li>
              <li><strong>Well water quality &amp; flow</strong> (rural).</li>
              <li><strong>Septic inspection</strong> (rural).</li>
              <li><strong>WETT inspection</strong> (wood stove).</li>
              <li><strong>Zoning / due diligence</strong> (rural, farm, or if changing use).</li>
              <li><strong>Lawyer review</strong> (recommended for farms and unusual properties).</li>
            </ul>
            <p>In a competitive market buyers sometimes drop conditions to win. Understand exactly what you're giving up first — a failed financing condition without protection can cost you your entire deposit.</p>

            <h3 style="margin-top:22px;">The inspection</h3>
            <p><strong>Get one. Choose your own inspector.</strong> Someone with a trade or construction background, who gives you a written report. Attend the inspection and walk through with them at the end.</p>
            <p>Findings usually fall into four buckets:</p>
            <ol class="bullets" style="list-style: decimal; padding-left: 20px;">
              <li>Deal breakers.</li>
              <li>Things that should reduce the price.</li>
              <li>Things to fix soon.</li>
              <li>Things to watch over the years.</li>
            </ol>
            <p><strong>Inspectors don't open walls.</strong> If they flag something serious, bring in a specialist before you go firm.</p>

            <h3 style="margin-top:22px;">The deposit</h3>
            <p>Shows you're serious. Comes off the price at closing. Once the deal is firm, you can't get it back just because you changed your mind — releasing it requires both sides to agree in writing, or a court order. Keep the money liquid; you may need a bank draft on short notice.</p>

            <!-- ============================================================
                 PART 7 — CLOSING COSTS
                 ============================================================ -->
            <h2 id="closing" style="margin-top:48px;">Part 7 · Closing costs</h2>
            <p>Budget <strong>1.5% to 4%</strong> of the price, in cash, on top of your down payment.</p>

            <div class="fh-closing-stack">
              <div class="fh-closing-row"><span>Land transfer tax</span><span>Doubled in Toronto</span></div>
              <div class="fh-closing-row"><span>Lawyer's fees &amp; disbursements</span><span>~$1.5K–$2.5K</span></div>
              <div class="fh-closing-row"><span>Title insurance</span><span>~$300–$500</span></div>
              <div class="fh-closing-row"><span>Home inspection</span><span>$500–$900</span></div>
              <div class="fh-closing-row"><span>Well / septic / WETT inspections</span><span>Rural: several hundred to $1K+</span></div>
              <div class="fh-closing-row"><span>Appraisal</span><span>If required by lender</span></div>
              <div class="fh-closing-row"><span>PST on mortgage insurance</span><span>If under 20% down</span></div>
              <div class="fh-closing-row"><span>Moving costs</span><span>Varies</span></div>
              <div class="fh-closing-row"><span>Adjustments</span><span>Property tax or fuel seller prepaid</span></div>
              <div class="fh-closing-row fh-closing-row-total"><span><strong>Plus a cushion for</strong></span><span>Locks, blinds, first repairs, furniture</span></div>
            </div>

            <p style="margin-top:14px;"><strong>Run the numbers:</strong> <a href="/land-transfer-tax">Land Transfer Tax calculator</a> · <a href="/closing-costs">Closing Costs page</a> · <a href="/cmhc-insurance-calculator">CMHC premium calculator</a>.</p>

            <!-- ============================================================
                 PART 8 — BEFORE + AFTER CLOSING
                 ============================================================ -->
            <h2 id="before-after" style="margin-top:48px;">Part 8 · Before &amp; after closing</h2>

            <div class="fh-before-after">
              <div class="fh-ba-col fh-ba-dont">
                <div class="fh-ba-title">Before closing — DON'T</div>
                <ul>
                  <li>Change jobs</li>
                  <li>Buy or lease a car</li>
                  <li>Open new credit</li>
                  <li>Miss a payment</li>
                </ul>
                <p class="fh-ba-note">Lenders re-check your file.</p>
              </div>
              <div class="fh-ba-col fh-ba-do">
                <div class="fh-ba-title">Before closing — DO</div>
                <ul>
                  <li>Final walkthrough as close to closing as possible</li>
                  <li>Arrange home insurance (lender requires proof)</li>
                  <li>Avoid closing on a Friday if you can</li>
                  <li>Confirm the closing figure with your lawyer</li>
                </ul>
              </div>
              <div class="fh-ba-col fh-ba-after">
                <div class="fh-ba-title">After closing</div>
                <ul>
                  <li>Change the locks</li>
                  <li>Find your water shutoff and electrical panel</li>
                  <li>Claim the $1,500 FTHB tax credit at tax time</li>
                  <li>Confirm your LTT rebates were applied</li>
                  <li>Start your maintenance fund</li>
                </ul>
              </div>
            </div>

            <!-- ============================================================
                 COMMON MISTAKES
                 ============================================================ -->
            <h2 id="mistakes" style="margin-top:48px;">The 10 most common house-buyer mistakes</h2>
            <ol class="bullets" style="list-style: decimal; padding-left: 20px;">
              <li><strong>Budgeting only for the mortgage.</strong> Maintenance alone can be $10K/year.</li>
              <li><strong>Skipping the inspection to win a bidding war.</strong></li>
              <li><strong>Skipping well and septic testing on a rural property.</strong> Most expensive rural mistake there is.</li>
              <li><strong>Not asking what equipment is rented.</strong> Water heater contracts follow the house.</li>
              <li><strong>Assuming a basement apartment is legal.</strong> Often it isn't.</li>
              <li><strong>Not checking permits</strong> on additions and finished basements.</li>
              <li><strong>Buying a farm or waterfront property without specialist advice</strong> on HST, zoning, and shore road allowance.</li>
              <li><strong>Forgetting closing costs.</strong> They're cash, due on closing day.</li>
              <li><strong>Changing your finances before closing.</strong></li>
              <li><strong>Rushing.</strong> Impatience causes every other mistake on this list.</li>
            </ol>

            <!-- ============================================================
                 CHECKLIST
                 ============================================================ -->
            <h2 id="checklist" style="margin-top:48px;">Your full checklist</h2>

            <details class="b60-section-toggle" open>
              <summary class="b60-section-toggle-summary">Before you shop</summary>
              <div class="b60-section-body">
                <ul class="fh-check">
                  <li>Open an FHSA</li>
                  <li>Pay down debts</li>
                  <li>Get pre-approved</li>
                  <li>Choose a lawyer — one with rural / farm experience if that's your target</li>
                  <li>Set your <strong>comfortable</strong> monthly payment, not your maximum</li>
                </ul>
              </div>
            </details>

            <details class="b60-section-toggle">
              <summary class="b60-section-toggle-summary">When you view</summary>
              <div class="b60-section-body">
                <ul class="fh-check">
                  <li>Note the ages of roof, furnace, AC, water heater</li>
                  <li>Check the basement for water signs and foundation cracks</li>
                  <li>Run taps, flush toilets, test outlets</li>
                  <li>Ask what is rented</li>
                  <li>Visit the street at different times</li>
                </ul>
              </div>
            </details>

            <details class="b60-section-toggle">
              <summary class="b60-section-toggle-summary">When you offer</summary>
              <div class="b60-section-body">
                <ul class="fh-check">
                  <li>Financing condition</li>
                  <li>Inspection condition</li>
                  <li>Rural: well quality, well flow, septic, WETT, zoning</li>
                  <li>Written warranties on well, septic, and equipment condition</li>
                  <li>Read the WHOLE agreement before signing</li>
                </ul>
              </div>
            </details>

            <details class="b60-section-toggle">
              <summary class="b60-section-toggle-summary">Before you go firm</summary>
              <div class="b60-section-body">
                <ul class="fh-check">
                  <li>Inspection done and reviewed</li>
                  <li>Specialist follow-ups completed</li>
                  <li>Permits and survey checked</li>
                  <li>Insurance quoted and confirmed available</li>
                  <li>Lawyer has reviewed anything unusual</li>
                </ul>
              </div>
            </details>

            <details class="b60-section-toggle">
              <summary class="b60-section-toggle-summary">Before closing</summary>
              <div class="b60-section-body">
                <ul class="fh-check">
                  <li>Final lender approval</li>
                  <li>Insurance in place</li>
                  <li>Closing costs confirmed</li>
                  <li>Final walkthrough done</li>
                  <li>Nothing changed in your finances</li>
                </ul>
              </div>
            </details>

            <!-- ============================================================
                 DISCLAIMER
                 ============================================================ -->
            <p class="calc-disclaimer" style="margin-top:44px;">
              <strong>Disclaimer.</strong> I am a licensed real estate salesperson. I am NOT a mortgage broker, financial advisor, accountant, lawyer, insurance broker, home inspector, septic or well specialist, or agrologist, and nothing in this guide is mortgage, financial, tax, legal, insurance, or technical advice. This guide is general information only. It is not advice for your situation and does not create a client relationship. Government programs, tax rules, mortgage rules, zoning, and rebate deadlines change. Every property is different, and rural, waterfront, and farm properties in particular carry risks that require specialists. Before making any decision, do your own due diligence and get advice from the right licensed professionals — a real estate lawyer, mortgage broker or lender, accountant or tax professional, qualified home inspector plus separate well / septic / WETT specialists where they apply, the municipality and conservation authority, and your insurance provider. Do not rely on this guide alone. Verify everything that affects your money with someone licensed to advise you on it.
            </p>

          </div>
        </div>
      </div>
    </section>
