---
import RecentDeals from '../components/RecentDeals.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import TopBar from '../components/TopBar.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import CTASection from '../components/CTASection.astro';
import RentalQuestionnaire from '../components/RentalQuestionnaire.astro';
const BOOKING_URL = "https://cal.com/peter-law-c5lm9q";
---
<BaseLayout
  title="Toronto Rental Realtor, Peter Law | Bilingual Real Estate"
  description="Toronto rental realtor helping tenants get approved and moved in: full-service, search to keys. Trilingual (EN · 中文 · Français). RECO-registered · 647-888-8472."
  hreflangAlternates={[
    { hreflang: 'x-default', href: 'https://www.realtorpeterlaw.com/' },
    { hreflang: 'en-CA', href: 'https://www.realtorpeterlaw.com/' },
    { hreflang: 'zh-CN', href: 'https://www.realtorpeterlaw.com/chinese' },
    { hreflang: 'fr-CA', href: 'https://www.realtorpeterlaw.com/french' },
  ]}
>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@graph": [
        {
          "@type": "RealEstateAgent",
          "@id": "https://www.realtorpeterlaw.com/#agent",
          "name": "Peter Law",
          "jobTitle": "Sales Representative",
          "url": "https://www.realtorpeterlaw.com/",
          "image": "https://www.realtorpeterlaw.com/photos/peter-portrait.webp",
          "telephone": "+1-647-888-8472",
          "email": "Admin@RealtorPeterLaw.com",
          "priceRange": "$$-$$$",
          "knowsLanguage": ["English", "Chinese", "French"],
          "areaServed": [
            { "@type": "City", "name": "Toronto" },
            { "@type": "AdministrativeArea", "name": "Greater Toronto Area" },
            { "@type": "City", "name": "Markham" }
          ],
          "sameAs": [
            "https://www.realtor.ca/agent/2071856/peter-law-3601-hwy-7-215-markham-ontario-l3r0m3",
            "https://www.instagram.com/realtorpeterlaw",
            "https://www.facebook.com/RealtorPeterLaw",
            "https://www.linkedin.com/in/peter-law-5053a6192"
          ],
          "worksFor": {
            "@type": "RealEstateAgent",
            "name": "HomeLife Golconda Realty Inc., Brokerage",
            "address": {
              "@type": "PostalAddress",
              "streetAddress": "215 - 3601 HWY 7 East",
              "addressLocality": "Markham",
              "addressRegion": "ON",
              "postalCode": "L3R 0M3",
              "addressCountry": "CA"
            }
          }
        },
        {
          "@type": "WebSite",
          "@id": "https://www.realtorpeterlaw.com/#website",
          "url": "https://www.realtorpeterlaw.com/",
          "name": "Peter Law, Toronto Rental Realtor",
          "publisher": { "@id": "https://www.realtorpeterlaw.com/#agent" },
          "inLanguage": ["en-CA", "zh-CN"]
        },
        {
          "@type": "LocalBusiness",
          "@id": "https://www.realtorpeterlaw.com/#brokerage",
          "name": "Peter Law, HomeLife Golconda Realty Inc., Brokerage",
          "url": "https://www.realtorpeterlaw.com/",
          "telephone": "+1-647-888-8472",
          "email": "Admin@RealtorPeterLaw.com",
          "image": "https://www.realtorpeterlaw.com/photos/peter-portrait.webp",
          "address": {
            "@type": "PostalAddress",
            "streetAddress": "215 - 3601 HWY 7 East",
            "addressLocality": "Markham",
            "addressRegion": "ON",
            "postalCode": "L3R 0M3",
            "addressCountry": "CA"
          },
          "areaServed": [
            { "@type": "City", "name": "Toronto" },
            { "@type": "AdministrativeArea", "name": "Greater Toronto Area" }
          ]
        }
      ]
    })} />
  </Fragment>

  <TopBar />
  <Header />

    <section class="proof-bar">
    <div class="wrap proof-grid">
      <div class="proof-item"><div class="proof-num"><a class="proof-num-link" href="/past-deals">Sales History</a></div><div class="proof-lbl">6 Years FULL-TIME</div></div>
      <div class="proof-item"><div class="proof-num"><a class="proof-num-link" href="/chinese">EN · 中文</a></div><div class="proof-lbl">English <span class="nocase">l</span> Chinese</div></div>
      <div class="proof-item"><div class="proof-num">RECO</div><div class="proof-lbl">Registered, Ontario</div></div>
      <a class="proof-item proof-link" href="https://www.homelifegolconda.com/" target="_blank" rel="noopener"><div class="proof-num">HomeLife</div><div class="proof-lbl">Golconda Realty Inc.</div></a>
    </div>
  </section>

  <section class="hero">
    <div class="wrap">
      <div class="hero-headline-block">
        <div class="eyebrow">Toronto · Downtown · Waterfront</div>
        <h1 class="hero-h">Toronto rentals, <em>handled the RIGHT way.</em></h1>
      </div>
      <div class="hero-grid">
      <div>
      <RentalQuestionnaire />
      </div>
      <div>
        <div class="hero-photo hero-video">
          <video controls playsinline preload="none" poster="/videos/renting-in-toronto-7-steps-poster.webp" width="806" height="1291" aria-label="Video: Peter Law explains the 7 steps to renting in Toronto (English with Chinese captions)">
            <source src="/videos/renting-in-toronto-7-steps.mp4" type="video/mp4" />
            <a href="/videos/renting-in-toronto-7-steps.mp4">Video: Peter Law explains the 7 steps to renting in Toronto (English with Chinese captions)</a>
          </video>
        </div>
      </div>
      </div>
    </div>
  </section>


  <section class="boc-widget" aria-label="Bank of Canada interest rate and Ontario rent increase guideline">
    <div class="wrap">
      <div class="boc-widget-grid">
        <div class="boc-cell">
          <span class="boc-cell-label">Bank of Canada policy rate</span>
          <span class="boc-cell-value">2.25<span class="pct">%</span></span>
        </div>
        <div class="boc-divider" aria-hidden="true"></div>
        <div class="boc-cell">
          <span class="boc-cell-label">Next announcement</span>
          <span class="boc-cell-value" style="font-size:21px;">October 29, 2026</span>
        </div>
        <div class="boc-divider" aria-hidden="true"></div>
        <a class="boc-source" href="https://www.bankofcanada.ca/core-functions/monetary-policy/key-interest-rate/" target="_blank" rel="noopener">Source: bankofcanada.ca ↗</a>
        <hr class="boc-row-rule" aria-hidden="true" />
        <div class="boc-cell">
          <span class="boc-cell-label">Ontario rent increase (2027)</span>
          <span class="boc-cell-value">1.9<span class="pct">%</span></span>
        </div>
        <div class="boc-divider" aria-hidden="true"></div>
        <div class="boc-cell">
          <span class="boc-cell-label">Next announcement</span>
          <span class="boc-cell-value" style="font-size:21px;">December 2027</span>
        </div>
        <div class="boc-divider" aria-hidden="true"></div>
        <a class="boc-source" href="https://www.ontario.ca/page/residential-rent-increases" target="_blank" rel="noopener">Source: ontario.ca ↗</a>
      </div>
    </div>
  </section>

  <RecentDeals />

  <section class="major newsletter">
    <div class="wrap">
      <div class="newsletter-inner">
        <div class="section-eyebrow">Monthly Market Report</div>
        <h2 class="section-h">What's actually happening with Toronto Real Estate.</h2>
        <p class="section-lead">Information is important. Rental & Sales Report.<br />Stay ahead by subscribing below.</p>
        <form class="newsletter-form" method="POST" action="https://peters-newsletter-469474.beehiiv.com/subscribe">
            <label for="newsletter-email" class="sr-only">Email address</label>
            <input id="newsletter-email" type="email" name="email" placeholder="your@email.com" required autocomplete="email" />
            <button type="submit" class="btn-primary">Subscribe
              <svg width="14" height="14" viewBox="0 0 14 14" fill="none"><path d="M1 7h12M8 2l5 5-5 5" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/></svg>
            </button>
          </form>
        <p class="newsletter-trust">Unsubscribe anytime. Your email isn't shared with anyone.</p>
      </div>
    </div>
  </section>

  <CTASection />

  <Footer />

</BaseLayout>

<style>
  /* Tighten homepage vertical rhythm, only affects this page */
  .hero { padding-bottom: 40px; padding-top: 56px; }
  .boc-widget + section.major { padding-top: 56px; }

  /* New full-width headline above the hero-grid */
  .hero-headline-block { max-width: 760px; margin-bottom: 40px; }
  .hero-headline-block .eyebrow { margin-bottom: 18px; }
  .hero-headline-block .hero-h { margin: 0; }

  /* Make photo column match form column height, stretch instead of center align */
  .hero-grid { align-items: start; }
  .hero-photo.hero-video {
    aspect-ratio: 806 / 1291;
    height: auto;
    min-height: 0;
    background: #000;
    box-shadow: 0 0 0 4px rgba(198, 150, 65, 0.10), 0 10px 32px -14px rgba(198, 150, 65, 0.32);
  }
  .hero-video video { display: block; width: 100%; height: 100%; object-fit: cover; }

  @media (max-width: 900px) {
    .hero { padding-bottom: 28px; padding-top: 36px; }
    .hero-headline-block { margin-bottom: 28px; }
    .hero-photo.hero-video { aspect-ratio: 806 / 1291; }
    /* Phones: show the video before the questionnaire */
    .hero-grid > div:last-child { order: -1; }
    .hero-photo.hero-video { max-width: 420px; margin: 0 auto; }
  }
  @media (max-width: 720px) {
    .boc-widget + section.major { padding-top: 40px; }
  }
</style>
