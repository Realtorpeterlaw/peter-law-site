---
import RecentDeals from '../../components/RecentDeals.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import ChineseTopBar from '../../components/ChineseTopBar.astro';
import ChineseHeader from '../../components/ChineseHeader.astro';
import ChineseFooter from '../../components/ChineseFooter.astro';
import ChineseCTASection from '../../components/ChineseCTASection.astro';
import ChineseRentalQuestionnaire from '../../components/ChineseRentalQuestionnaire.astro';
const BOOKING_URL = "https://cal.com/peter-law-c5lm9q";
---
<BaseLayout
  title="Peter Law，多伦多租房与地产 | 双语房地产代表"
  description="Peter Law | 多伦多双语租房与地产代表。协助租客获批并顺利入住:从搜寻到拿钥匙的全程服务。英语与中文双语。RECO 注册 · HomeLife Golconda · 致电 647-888-8472。"
  zh={true}
  hreflangAlternates={[
    { hreflang: 'x-default', href: 'https://www.realtorpeterlaw.com/' },
    { hreflang: 'en-CA', href: 'https://www.realtorpeterlaw.com/' },
    { hreflang: 'zh-CN', href: 'https://www.realtorpeterlaw.com/chinese' },
    { hreflang: 'fr-CA', href: 'https://www.realtorpeterlaw.com/french' },
  ]}
>

  <ChineseTopBar />
  <ChineseHeader />

    <section class="proof-bar">
    <div class="wrap proof-grid">
      <div class="proof-item"><div class="proof-num"><a class="proof-num-link" href="/chinese/past-deals">销售记录</a></div><div class="proof-lbl">5+ 年从业经验</div></div>
      <div class="proof-item"><div class="proof-num"><a class="proof-num-link" href="/">EN · 中文</a></div><div class="proof-lbl">英文 <span class="nocase">l</span> 中文</div></div>
      <div class="proof-item"><div class="proof-num">RECO</div><div class="proof-lbl">安省注册</div></div>
      <a class="proof-item proof-link" href="https://www.homelifegolconda.com/" target="_blank" rel="noopener"><div class="proof-num">HomeLife</div><div class="proof-lbl">Golconda Realty Inc.</div></a>
    </div>
  </section>

  <section class="hero">
    <div class="wrap">
      <div class="hero-headline-block">
        <div class="eyebrow">多伦多 · 市中心 · 湖滨</div>
        <h1 class="hero-h">多伦多租房，<em>用对的方式办对的事。</em></h1>
      </div>
      <div class="hero-grid">
      <div>
      <ChineseRentalQuestionnaire />
      </div>
      <div><div class="hero-photo hero-video">
          <video controls playsinline preload="none" poster="/videos/renting-in-toronto-7-steps-poster.webp" width="806" height="1291" aria-label="视频：Peter Law 讲解多伦多租房的 7 个步骤（英文讲解，中文字幕）">
            <source src="/videos/renting-in-toronto-7-steps.mp4" type="video/mp4" />
            <a href="/videos/renting-in-toronto-7-steps.mp4">视频：Peter Law 讲解多伦多租房的 7 个步骤（英文讲解，中文字幕）</a>
          </video>
        </div></div>
      </div>
    </div>
  </section>


  <section class="boc-widget" aria-label="加拿大银行利率与安大略省租金上涨指导线">
    <div class="wrap">
      <div class="boc-widget-grid">
        <div class="boc-cell">
          <span class="boc-cell-label">加拿大银行政策利率</span>
          <span class="boc-cell-value">2.25<span class="pct">%</span></span>
        </div>
        <div class="boc-divider" aria-hidden="true"></div>
        <div class="boc-cell">
          <span class="boc-cell-label">下次公告</span>
          <span class="boc-cell-value" style="font-size:21px;">2026 年 10 月 29 日</span>
        </div>
        <div class="boc-divider" aria-hidden="true"></div>
        <a class="boc-source" href="https://www.bankofcanada.ca/core-functions/monetary-policy/key-interest-rate/" target="_blank" rel="noopener">来源：bankofcanada.ca ↗</a>
        <hr class="boc-row-rule" aria-hidden="true" />
        <div class="boc-cell">
          <span class="boc-cell-label">安大略省租金上涨指导线 (2026)</span>
          <span class="boc-cell-value">1.9<span class="pct">%</span></span>
        </div>
        <div class="boc-divider" aria-hidden="true"></div>
        <div class="boc-cell">
          <span class="boc-cell-label">下次公告</span>
          <span class="boc-cell-value" style="font-size:21px;">2027 年 12 月</span>
        </div>
        <div class="boc-divider" aria-hidden="true"></div>
        <a class="boc-source" href="https://www.ontario.ca/page/residential-rent-increases" target="_blank" rel="noopener">来源：ontario.ca ↗</a>
      </div>
    </div>
  </section>

  <RecentDeals zh={true} />

  <section class="major newsletter">
    <div class="wrap">
      <div class="newsletter-inner">
        <div class="section-eyebrow">每月市场报告</div>
        <h2 class="section-h">多伦多房地产的真实情况。</h2>
        <p class="section-lead">信息很重要。租赁与销售月报。<br />在下方订阅，保持领先。</p>
        <form class="newsletter-form" method="POST" action="https://peters-newsletter-469474.beehiiv.com/subscribe">
          <label for="newsletter-email" class="sr-only">电子邮件</label>
          <input id="newsletter-email" type="email" name="email" placeholder="your@email.com" required autocomplete="email" />
          <button type="submit" class="btn-primary">订阅
            <svg width="14" height="14" viewBox="0 0 14 14" fill="none"><path d="M1 7h12M8 2l5 5-5 5" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/></svg>
          </button>
        </form>
        <p class="newsletter-trust">随时取消订阅。您的电子邮件不会与任何人共享。</p>
      </div>
    </div>
  </section>

  <ChineseCTASection />

  <ChineseFooter />

</BaseLayout>

<style>
  /* Tighten homepage vertical rhythm, only affects this page */
  .hero { padding-bottom: 40px; padding-top: 56px; }
  .boc-widget + section.major { padding-top: 56px; }
  .hero-headline-block { max-width: 760px; margin-bottom: 40px; }
  .hero-headline-block .eyebrow { margin-bottom: 18px; }
  .hero-headline-block .hero-h { margin: 0; }
  .hero-grid { align-items: start; }
  .hero-photo.hero-video {
    aspect-ratio: 806 / 1291;
    height: auto;
    min-height: 0;
    background: #000;
    box-shadow: 0 0 0 4px rgba(198, 150, 65, 0.10), 0 10px 32px -14px rgba(198, 150, 65, 0.32);
  }
  .hero-video video { display: block; width: 100%; height: 100%; object-fit: cover; }
  @media (max-width: 900px) {
    .hero { padding-bottom: 28px; padding-top: 36px; }
    .hero-headline-block { margin-bottom: 28px; }
    .hero-photo.hero-video { aspect-ratio: 806 / 1291; }
    /* Phones: show the video before the questionnaire */
    .hero-grid > div:last-child { order: -1; }
    .hero-photo.hero-video { max-width: 420px; margin: 0 auto; }
  }
  @media (max-width: 720px) {
    .boc-widget + section.major { padding-top: 40px; }
  }
</style>
