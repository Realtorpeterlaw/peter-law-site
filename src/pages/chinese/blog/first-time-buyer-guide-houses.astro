---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import ChineseTopBar from '../../../components/ChineseTopBar.astro';
import ChineseHeader from '../../../components/ChineseHeader.astro';
import ChineseFooter from '../../../components/ChineseFooter.astro';
import ChineseCTASection from '../../../components/ChineseCTASection.astro';

export const prerender = true;

const publishedDate = '2026-09-08';
const articleTitle = '首次购房者独立屋指南(安省)';
const articleDescription = '安省各类独立屋、买房前该检查什么、可以叠加使用的政府补贴,以及首次购房者常常漏算的交接成本。附图表、计算器和完整的交接前检查清单。';
const articleUrl = 'https://www.realtorpeterlaw.com/chinese/blog/first-time-buyer-guide-houses';

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  inLanguage: 'zh-CN',
  headline: articleTitle,
  description: articleDescription,
  author: { '@type': 'Person', name: 'Peter Law', url: 'https://www.realtorpeterlaw.com/chinese/about' },
  publisher: {
    '@type': 'Organization',
    name: 'Peter Law — 多伦多房地产',
    logo: { '@type': 'ImageObject', url: 'https://www.realtorpeterlaw.com/favicon.svg' },
  },
  datePublished: publishedDate,
  dateModified: publishedDate,
  mainEntityOfPage: { '@type': 'WebPage', '@id': articleUrl },
  keywords: '安省首次购房者, 多伦多买房指南, 安省房屋类型, 独立屋 vs 半独立屋, 永久产权镇屋, 连接屋, 平房, 安省百年老宅, 乡村自建井和化粪池, 安省水岸度假屋, FHSA HBP FTHB 退税, 多伦多土地转让税, 安省新建房 HST 退税, 验房, 首次购房者交接成本',
};

const hreflangAlternates = [
  { hreflang: 'en-CA', href: 'https://www.realtorpeterlaw.com/blog/first-time-buyer-guide-houses/' },
  { hreflang: 'zh-CN', href: 'https://www.realtorpeterlaw.com/chinese/blog/first-time-buyer-guide-houses/' },
  { hreflang: 'fr-CA', href: 'https://www.realtorpeterlaw.com/french/blog/first-time-buyer-guide-houses/' },
  { hreflang: 'x-default', href: 'https://www.realtorpeterlaw.com/blog/first-time-buyer-guide-houses/' },
];

// House-type icons (small silhouettes)
const houseIcons = {
  detached: `<svg viewBox="0 0 80 80" xmlns="http://www.w3.org/2000/svg" aria-hidden="true"><rect x="18" y="36" width="44" height="30" fill="var(--bg-warm)" stroke="currentColor" stroke-width="2"/><path d="M12 40 L40 18 L68 40 Z" fill="var(--bg-warm)" stroke="currentColor" stroke-width="2" stroke-linejoin="round"/><rect x="34" y="48" width="12" height="18" fill="none" stroke="currentColor" stroke-width="1.5"/><rect x="24" y="46" width="6" height="6" fill="none" stroke="currentColor" stroke-width="1"/><rect x="50" y="46" width="6" height="6" fill="none" stroke="currentColor" stroke-width="1"/></svg>`,
  semi: `<svg viewBox="0 0 80 80" xmlns="http://www.w3.org/2000/svg" aria-hidden="true"><rect x="10" y="38" width="30" height="28" fill="var(--bg-warm)" stroke="currentColor" stroke-width="2"/><rect x="40" y="38" width="30" height="28" fill="var(--bg-warm)" stroke="currentColor" stroke-width="2"/><path d="M6 42 L25 24 L44 42 Z" fill="var(--bg-warm)" stroke="currentColor" stroke-width="2" stroke-linejoin="round"/><path d="M36 42 L55 24 L74 42 Z" fill="var(--bg-warm)" stroke="currentColor" stroke-width="2" stroke-linejoin="round"/><rect x="18" y="48" width="6" height="14" fill="none" stroke="currentColor" stroke-width="1.4"/><rect x="48" y="48" width="6" height="14" fill="none" stroke="currentColor" stroke-width="1.4"/><line x1="40" y1="38" x2="40" y2="66" stroke="currentColor" stroke-width="2"/></svg>`,
  town: `<svg viewBox="0 0 80 80" xmlns="http://www.w3.org/2000/svg" aria-hidden="true"><rect x="8" y="34" width="20" height="32" fill="var(--bg-warm)" stroke="currentColor" stroke-width="1.8"/><rect x="28" y="34" width="20" height="32" fill="var(--bg-warm)" stroke="currentColor" stroke-width="1.8"/><rect x="48" y="34" width="20" height="32" fill="var(--bg-warm)" stroke="currentColor" stroke-width="1.8"/><path d="M8 34 L18 22 L28 34" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round"/><path d="M28 34 L38 22 L48 34" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round"/><path d="M48 34 L58 22 L68 34" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round"/><rect x="14" y="48" width="6" height="12" fill="none" stroke="currentColor" stroke-width="1.4"/><rect x="34" y="48" width="6" height="12" fill="none" stroke="currentColor" stroke-width="1.4"/><rect x="54" y="48" width="6" height="12" fill="none" stroke="currentColor" stroke-width="1.4"/></svg>`,
  bungalow: `<svg viewBox="0 0 80 80" xmlns="http://www.w3.org/2000/svg" aria-hidden="true"><rect x="14" y="42" width="52" height="24" fill="var(--bg-warm)" stroke="currentColor" stroke-width="2"/><path d="M8 46 L40 22 L72 46 Z" fill="var(--bg-warm)" stroke="currentColor" stroke-width="2" stroke-linejoin="round"/><rect x="34" y="50" width="12" height="16" fill="none" stroke="currentColor" stroke-width="1.5"/><rect x="20" y="50" width="8" height="8" fill="none" stroke="currentColor" stroke-width="1.3"/><rect x="52" y="50" width="8" height="8" fill="none" stroke="currentColor" stroke-width="1.3"/></svg>`,
  century: `<svg viewBox="0 0 80 80" xmlns="http://www.w3.org/2000/svg" aria-hidden="true"><rect x="20" y="30" width="40" height="36" fill="var(--bg-warm)" stroke="currentColor" stroke-width="2"/><path d="M14 34 L40 14 L66 34 Z" fill="var(--bg-warm)" stroke="currentColor" stroke-width="2" stroke-linejoin="round"/><rect x="28" y="26" width="24" height="12" fill="var(--bg-warm)" stroke="currentColor" stroke-width="1.5"/><rect x="33" y="30" width="6" height="6" fill="none" stroke="currentColor" stroke-width="1"/><rect x="41" y="30" width="6" height="6" fill="none" stroke="currentColor" stroke-width="1"/><path d="M35 40 Q40 36 45 40 L45 52 L35 52 Z" fill="none" stroke="currentColor" stroke-width="1.4"/><rect x="24" y="40" width="6" height="8" fill="none" stroke="currentColor" stroke-width="1.2"/><rect x="50" y="40" width="6" height="8" fill="none" stroke="currentColor" stroke-width="1.2"/></svg>`,
  multi: `<svg viewBox="0 0 80 80" xmlns="http://www.w3.org/2000/svg" aria-hidden="true"><rect x="18" y="18" width="44" height="48" fill="var(--bg-warm)" stroke="currentColor" stroke-width="2"/><line x1="18" y1="34" x2="62" y2="34" stroke="currentColor" stroke-width="1.6"/><line x1="18" y1="50" x2="62" y2="50" stroke="currentColor" stroke-width="1.6"/><rect x="24" y="22" width="7" height="8" fill="none" stroke="currentColor" stroke-width="1.2"/><rect x="49" y="22" width="7" height="8" fill="none" stroke="currentColor" stroke-width="1.2"/><rect x="24" y="38" width="7" height="8" fill="none" stroke="currentColor" stroke-width="1.2"/><rect x="49" y="38" width="7" height="8" fill="none" stroke="currentColor" stroke-width="1.2"/><rect x="34" y="54" width="12" height="12" fill="none" stroke="currentColor" stroke-width="1.5"/></svg>`,
  rural: `<svg viewBox="0 0 80 80" xmlns="http://www.w3.org/2000/svg" aria-hidden="true"><rect x="22" y="38" width="36" height="28" fill="var(--bg-warm)" stroke="currentColor" stroke-width="2"/><path d="M16 42 L40 22 L64 42 Z" fill="var(--bg-warm)" stroke="currentColor" stroke-width="2" stroke-linejoin="round"/><rect x="36" y="48" width="10" height="18" fill="none" stroke="currentColor" stroke-width="1.4"/><path d="M4 66 Q20 60 40 62 T76 66" stroke="currentColor" stroke-width="1.4" fill="none"/><circle cx="10" cy="30" r="3" fill="currentColor" opacity="0.5"/><circle cx="72" cy="26" r="4" fill="currentColor" opacity="0.5"/><path d="M4 66 L 76 66" stroke="currentColor" stroke-width="0.8" opacity="0.5"/></svg>`,
  cottage: `<svg viewBox="0 0 80 80" xmlns="http://www.w3.org/2000/svg" aria-hidden="true"><path d="M14 44 L40 22 L66 44 L66 60 L14 60 Z" fill="var(--bg-warm)" stroke="currentColor" stroke-width="2" stroke-linejoin="round"/><rect x="34" y="46" width="12" height="14" fill="none" stroke="currentColor" stroke-width="1.4"/><path d="M4 66 Q15 62 25 66 T45 66 T65 66 T80 66" stroke="currentColor" stroke-width="1.6" fill="none"/><path d="M4 70 Q15 66 25 70 T45 70 T65 70 T80 70" stroke="currentColor" stroke-width="1.2" fill="none" opacity="0.6"/></svg>`,
  luxury: `<svg viewBox="0 0 80 80" xmlns="http://www.w3.org/2000/svg" aria-hidden="true"><rect x="10" y="34" width="60" height="32" fill="var(--bg-warm)" stroke="currentColor" stroke-width="2"/><path d="M6 38 L20 22 L34 38 Z" fill="var(--bg-warm)" stroke="currentColor" stroke-width="2" stroke-linejoin="round"/><path d="M46 38 L60 22 L74 38 Z" fill="var(--bg-warm)" stroke="currentColor" stroke-width="2" stroke-linejoin="round"/><rect x="34" y="46" width="12" height="20" fill="none" stroke="currentColor" stroke-width="1.4"/><rect x="15" y="44" width="8" height="10" fill="none" stroke="currentColor" stroke-width="1.2"/><rect x="57" y="44" width="8" height="10" fill="none" stroke="currentColor" stroke-width="1.2"/><path d="M20 22 L20 15 L23 18" fill="none" stroke="currentColor" stroke-width="1.4"/></svg>`,
  new: `<svg viewBox="0 0 80 80" xmlns="http://www.w3.org/2000/svg" aria-hidden="true"><rect x="18" y="36" width="44" height="30" fill="var(--bg-warm)" stroke="currentColor" stroke-width="2"/><path d="M12 40 L40 18 L68 40 Z" fill="var(--bg-warm)" stroke="currentColor" stroke-width="2" stroke-linejoin="round"/><rect x="30" y="44" width="20" height="22" fill="none" stroke="currentColor" stroke-width="1.4" stroke-dasharray="3,3"/><path d="M52 20 L54 26 L60 28 L54 30 L52 36 L50 30 L44 28 L50 26 Z" fill="currentColor" opacity="0.7"/></svg>`,
};
---
<BaseLayout
  title={`${articleTitle} | Peter Law`}
  description={articleDescription}
  bodyClass="guide-page article-page"
  zh={true}
  hreflangAlternates={hreflangAlternates}
>
  <ChineseTopBar />
  <ChineseHeader active="blog" />

  <article>
    <section class="page-hero">
      <div class="wrap">
        <div class="eyebrow"><a href="/chinese/blog" class="back-link"><svg width="11" height="11" viewBox="0 0 14 14" fill="none" style="vertical-align:-1px;margin-right:5px;" aria-hidden="true"><path d="M13 7H1M6 12L1 7l5-5" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/></svg>博客</a> · 买家指南 · 独立屋</div>
        <h1>{articleTitle}</h1>
        <p class="article-lead">安省各类独立屋,以及买房前该检查什么。买独立屋,您买下的不只是房子,还有它坐落的那块地。没人替您修屋顶。没人替您铲车道的雪。也没人提醒您炉子已经用了 22 年。这份自由正是它最大的吸引力。同时也是它最大的风险。</p>
        <div class="article-byline">
          <span>作者 <a href="/chinese/about">Peter Law</a></span>
          <span class="dot">·</span>
          <time datetime={publishedDate}>2026 年 9 月 8 日</time>
          <span class="dot">·</span>
          <span>阅读 15 分钟</span>
        </div>
      </div>
    </section>

    <!-- ====== QUICK STAT CARDS ====== -->
    <section class="fh-stats-wrap">
      <div class="wrap">
        <div class="fh-stats-grid">
          <div class="fh-stat"><div class="fh-stat-num">5–20%</div><div class="fh-stat-label">首付比例区间</div><div class="fh-stat-sub">按购房价格档位</div></div>
          <div class="fh-stat"><div class="fh-stat-num">$40K</div><div class="fh-stat-label">FHSA 终身上限</div><div class="fh-stat-sub">每年 $8K,供款可抵税</div></div>
          <div class="fh-stat"><div class="fh-stat-num">$8,475</div><div class="fh-stat-label">土地转让税退税</div><div class="fh-stat-sub">多伦多首次购房者(省 + 市)</div></div>
          <div class="fh-stat"><div class="fh-stat-num">1–1.5%</div><div class="fh-stat-label">每年维护费</div><div class="fh-stat-sub">占房屋价值的比例</div></div>
        </div>
      </div>
    </section>

    <section class="major" style="padding-top:32px;">
      <div class="wrap">
        <div class="prose-grid">
          <aside class="prose-side">
            <h4>本页内容</h4>
            <ul>
              <li><a href="#types">安省的房屋类型</a></li>
              <li><a href="#afford">您能负担多少</a></li>
              <li><a href="#programs">政府补贴项目</a></li>
              <li><a href="#check">任何房屋都该检查什么</a></li>
              <li><a href="#rural">乡村、度假屋与农场</a></li>
              <li><a href="#offer">出价与验房</a></li>
              <li><a href="#closing">交接成本</a></li>
              <li><a href="#before-after">交接前后</a></li>
              <li><a href="#mistakes">10 个常见错误</a></li>
              <li><a href="#checklist">完整检查清单</a></li>
            </ul>
          </aside>

          <div class="prose-body">

            <!-- ============================================================
                 PART 1 — TYPES OF HOUSES
                 ============================================================ -->
            <h2 id="types">第 1 部分 · 安省的房屋类型</h2>
            <p>不是所有"房子"都是同一种产品。两栋从街上看一模一样的建筑,产权方式、每月成本和转售风险可能完全不同。以下是您会遇到的每一种类型。</p>

            <div class="fh-house-grid">
              <div class="fh-house-card">
                <div class="fh-house-icon" set:html={houseIcons.detached} />
                <div class="fh-house-title">独立屋</div>
                <p>独自占地一块,不与任何人共用墙壁。隐私最好、自主权最大、价格最高、维护也最多。</p>
              </div>
              <div class="fh-house-card">
                <div class="fh-house-icon" set:html={houseIcons.semi} />
                <div class="fh-house-title">半独立屋</div>
                <p>两栋房子共用一面墙。通常比同等的独立屋便宜 10–20%。记得问清楚共用屋顶、排水槽或车道的情况。</p>
              </div>
              <div class="fh-house-card">
                <div class="fh-house-icon" set:html={houseIcons.detached} />
                <div class="fh-house-title">连接屋(Link Home)</div>
                <p>从街上看像独立屋,但地基(或车库)在地下相连。比真正的独立屋便宜 —— <strong>务必核实测量图(survey)</strong>。</p>
              </div>
              <div class="fh-house-card">
                <div class="fh-house-icon" set:html={houseIcons.town} />
                <div class="fh-house-title">联排屋 / 镇屋</div>
                <p>三种产权:<strong>永久产权(freehold)</strong>(自己拥有土地,无管理费)、<strong>公寓产权(condo)</strong>(有管理费,由公寓公司维护)、或<strong>公共部分产权(common-element / POTL)</strong>(自己拥有土地,共用道路收取少量费用)。务必问清楚是哪一种。</p>
              </div>
              <div class="fh-house-card">
                <div class="fh-house-icon" set:html={houseIcons.bungalow} />
                <div class="fh-house-title">平房与高地基平房</div>
                <p>所有房间都在同一层。高地基版本的地下室部分露出地面 —— 更容易改建成合法地下室套房。</p>
              </div>
              <div class="fh-house-card">
                <div class="fh-house-icon" set:html={houseIcons.century} />
                <div class="fh-house-title">百年老宅</div>
                <p>房龄 100 年以上。有历史感和工艺,但要为老旧的电线、管道、隔热层,以及可能存在的石棉或铅预留预算。保险也可能更难买。</p>
              </div>
              <div class="fh-house-card">
                <div class="fh-house-icon" set:html={houseIcons.multi} />
                <div class="fh-house-title">双拼 / 三拼 / 四拼房屋</div>
                <p>自住一户,出租其他几户。它<strong>合法</strong>登记为多户住宅,还是只是加了个厨房的普通房子?租客(以及他们的租金)会随房产一起转移给您。</p>
              </div>
              <div class="fh-house-card">
                <div class="fh-house-icon" set:html={houseIcons.rural} />
                <div class="fh-house-title">乡村 / 大地块</div>
                <p>自用井水、自用化粪池,通常靠丙烷或燃油取暖。问题大多藏在地下。详见第 5 部分。</p>
              </div>
              <div class="fh-house-card">
                <div class="fh-house-icon" set:html={houseIcons.cottage} />
                <div class="fh-house-title">度假屋 / 水岸物业</div>
                <p>会有额外的保育局(conservation authority)规定。留意"临水道路预留地"(shore road allowance)、仅限水路进入,以及季节性使用限制。</p>
              </div>
              <div class="fh-house-card">
                <div class="fh-house-icon" set:html={houseIcons.luxury} />
                <div class="fh-house-title">豪宅 / 高端物业</div>
                <p>超过 $1.5M 必须首付 20%,不能购买 CMHC 保险。多伦多市级土地转让税(MLTT)在 $3M 会跳档。评估也更难做。</p>
              </div>
              <div class="fh-house-card">
                <div class="fh-house-icon" set:html={houseIcons.new} />
                <div class="fh-house-title">全新永久产权新建房</div>
                <p>永久产权(freehold)的期房<strong>没有冷静期</strong>。适用 Tarion 保修。签约前先把开发费用(development levies)封顶。</p>
              </div>
            </div>

            <details class="b60-section-toggle">
              <summary class="b60-section-toggle-summary">更多类型:背对背镇屋、叠拼、边分层/背分层、模块化、活动屋、附属住宅单元</summary>
              <div class="b60-section-body">
                <ul class="bullets">
                  <li><strong>背对背镇屋:</strong>侧墙和后墙都与邻居共用。没有后院。价格最低,也最难转售。</li>
                  <li><strong>叠拼镇屋:</strong>单元上下叠放,各有独立入口。几乎都是公寓产权。楼梯很多。</li>
                  <li><strong>一层半:</strong>楼上是斜顶天花板的半层。有味道,但楼上常有隔热和层高问题。</li>
                  <li><strong>两层楼:</strong>最标准的家庭住宅。卧室在楼上,生活空间在楼下。</li>
                  <li><strong>边分层 / 背分层:</strong>多个楼层错半层排列。1950–70 年代的安省很常见。空间分隔好,但到处都是楼梯。</li>
                  <li><strong>模块化 / 预制房:</strong>工厂建造,现场组装。建在永久地基上,和其他房子一样对待。</li>
                  <li><strong>活动屋 / 房车营地房:</strong>常建在租用的土地上。融资难度较大。务必弄清楚您到底拥有什么、租用什么。</li>
                  <li><strong>花园套房 / 巷屋 / 附属住宅单元(ADU):</strong>安省已放宽相关规定,但各市规则不同。<strong>在按这个假设买房之前,请向市政府书面确认</strong>。</li>
                  <li><strong>业余农场 vs 经营性农场:</strong>业余农场按"带地皮的住宅"估价。经营性农场涉及分区规划、地下排水管、租户租约,通常需要农业贷款机构。</li>
                </ul>
              </div>
            </details>

            <!-- ============================================================
                 PART 2 — AFFORDABILITY
                 ============================================================ -->
            <h2 id="afford" style="margin-top:48px;">第 2 部分 · 您能负担多少</h2>

            <div class="fh-formula" aria-label="Stress test formula">
              <div class="fh-formula-cell">
                <div class="fh-formula-label">合同利率</div>
                <div class="fh-formula-value">4.5%</div>
                <div class="fh-formula-sub">示例</div>
              </div>
              <div class="fh-formula-op">+</div>
              <div class="fh-formula-cell">
                <div class="fh-formula-label">压力测试缓冲</div>
                <div class="fh-formula-value">2%</div>
              </div>
              <div class="fh-formula-op">=</div>
              <div class="fh-formula-cell">
                <div class="fh-formula-label">或最低门槛</div>
                <div class="fh-formula-value">5.25%</div>
              </div>
              <div class="fh-formula-op">→</div>
              <div class="fh-formula-cell fh-formula-result">
                <div class="fh-formula-label">按两者中较高者审核</div>
                <div class="fh-formula-value">6.5%</div>
              </div>
            </div>

            <h3 style="margin-top:26px;">两个债务比率</h3>
            <p>放贷机构会关心两个数字:</p>
            <ul class="bullets">
              <li><strong>GDS(总债务偿还比率):</strong>住房相关支出控制在税前收入的约 <strong>39%</strong> 以内。</li>
              <li><strong>TDS(总债务偿还比率,含所有负债):</strong>所有债务控制在约 <strong>44%</strong> 以内。</li>
            </ul>
            <div class="callout"><strong>真正有用的杠杆:</strong>申请前先还清一笔车贷或信用卡欠款,对批贷额度的提升,可能比多存 $10,000 首付更有效。</div>

            <h3 style="margin-top:26px;">最低首付要求</h3>
            <div class="fh-dp-chart" role="img" aria-label="Minimum down payment by purchase price bracket">
              <div class="fh-dp-row">
                <div class="fh-dp-label">$500,000 以内</div>
                <div class="fh-dp-bar-wrap"><div class="fh-dp-bar" style="width: 20%;"></div><span class="fh-dp-pct">5%</span></div>
                <div class="fh-dp-example">$500K → $25K</div>
              </div>
              <div class="fh-dp-row">
                <div class="fh-dp-label">$500,001–$1,499,999</div>
                <div class="fh-dp-bar-wrap"><div class="fh-dp-bar" style="width: 35%;"></div><span class="fh-dp-pct">5% + 10% 混合</span></div>
                <div class="fh-dp-example">$700K → $45K</div>
              </div>
              <div class="fh-dp-row">
                <div class="fh-dp-label">$1,500,000 以上</div>
                <div class="fh-dp-bar-wrap"><div class="fh-dp-bar" style="width: 100%;"></div><span class="fh-dp-pct">20%</span></div>
                <div class="fh-dp-example">$1.5M → $300K</div>
              </div>
            </div>
            <p style="margin-top:12px;font-size:14px;color:var(--ink-mute);">首付低于 20% 需要购买房贷违约保险(约为贷款金额的 2.8%–4%,滚入贷款本金)。安省对该保费另收 8% PST,须在交接日以现金支付。</p>

            <h3 style="margin-top:26px;">大额更换成本</h3>
            <p>很多人容易忽略:房子的支出常常以不规律的大笔金额出现。提前做好准备。</p>
            <div class="fh-cost-chart" role="img" aria-label="Typical replacement cost ranges for major house systems">
              <div class="fh-cost-row"><span class="fh-cost-item">屋顶</span><div class="fh-cost-bar-wrap"><div class="fh-cost-bar" style="width:40%;"></div></div><span class="fh-cost-range">$8K–$20K+</span></div>
              <div class="fh-cost-row"><span class="fh-cost-item">炉子</span><div class="fh-cost-bar-wrap"><div class="fh-cost-bar" style="width:20%;"></div></div><span class="fh-cost-range">$5K–$10K</span></div>
              <div class="fh-cost-row"><span class="fh-cost-item">窗户</span><div class="fh-cost-bar-wrap"><div class="fh-cost-bar" style="width:60%;"></div></div><span class="fh-cost-range">$10K–$30K+</span></div>
              <div class="fh-cost-row"><span class="fh-cost-item">地基维修</span><div class="fh-cost-bar-wrap"><div class="fh-cost-bar fh-cost-bar-hot" style="width:100%;"></div></div><span class="fh-cost-range">$10K–$50K+</span></div>
              <div class="fh-cost-row"><span class="fh-cost-item">化粪池更换</span><div class="fh-cost-bar-wrap"><div class="fh-cost-bar fh-cost-bar-hot" style="width:90%;"></div></div><span class="fh-cost-range">$20K–$45K+</span></div>
            </div>

            <p style="margin-top:14px;"><strong>长期预算:</strong>每年维护费约为房屋价值的 1–1.5%。一套 $800K 的房子,也就是<strong>每年 $8K–$12K</strong>。这不是"以后再说"的事 —— 每年都要预留出来。</p>

            <p style="margin-top:14px;"><strong>动手算一算:</strong>把您的数字输入<a href="/chinese/payment-calculator">房贷计算器</a>,并排对比三种方案。</p>

            <!-- ============================================================
                 PART 3 — GOVERNMENT PROGRAMS
                 ============================================================ -->
            <h2 id="programs" style="margin-top:48px;">第 3 部分 · 可以叠加使用的政府补贴项目</h2>
            <p>首次购房者能拿到的帮助,比大多数人以为的要多。下面这四项可以叠加 —— 您可以全部用上。</p>

            <div class="fh-program-grid">
              <div class="fh-program-card">
                <div class="fh-program-tag">储蓄</div>
                <div class="fh-program-title">FHSA</div>
                <p><strong>每年 $8,000,终身 $40,000。</strong>供款抵税,提取免税,永不用还。结转额度上限为每年 $8K,所以任何一年最多可供 <strong>$16,000</strong>。<a href="/chinese/blog/fhsa">完整 FHSA 指南。</a></p>
              </div>
              <div class="fh-program-card">
                <div class="fh-program-tag">RRSP</div>
                <div class="fh-program-title">RRSP 购房计划(HBP)</div>
                <p>每人最多 <strong>$60,000</strong>。提取后第二年开始,分 15 年偿还。资金须在 RRSP 内存放满 <strong>90 天</strong>才能提取。建议先用满 FHSA。</p>
              </div>
              <div class="fh-program-card">
                <div class="fh-program-tag">税务抵免</div>
                <div class="fh-program-title">FTHB 税务抵免</div>
                <p><strong>报税时退还 $1,500。</strong>金额不大,但自动适用 —— 在交接后的下一次报税时申领即可。</p>
              </div>
              <div class="fh-program-card">
                <div class="fh-program-tag">土地转让税退税</div>
                <div class="fh-program-title">土地转让税(LTT)退税</div>
                <p>安省省级最高 <strong>$4,000</strong>。多伦多市级另加 <strong>$4,475</strong>。多伦多买家两项都能拿 —— 合计<strong>最高 $8,475</strong>。前提是您在全世界范围内都从未拥有过住宅。</p>
              </div>
            </div>

            <details class="b60-section-toggle" style="margin-top:22px;">
              <summary class="b60-section-toggle-summary">仅限新建房:HST 退税(合计最高 $130,000)</summary>
              <div class="b60-section-body">
                <p>二手房不含 HST。开发商销售的新建房则要缴 HST。</p>
                <ul class="bullets">
                  <li><strong>联邦 FTHB 退税:</strong>符合条件的房屋最高 <strong>$50,000</strong>。</li>
                  <li><strong>安省临时补贴:</strong>最高 <strong>$80,000</strong>。当前窗口要求购房协议须在 <strong>2027 年 3 月 31 日</strong>前签订。</li>
                  <li><strong>合并上限:</strong>符合条件的购房合计最高 <strong>$130,000</strong>。</li>
                </ul>
                <p><strong>请与您的律师和会计师核实。</strong>叠加规则相当复杂,涉及金额也很大。另请参阅<a href="/chinese/blog/fthb-rebate">FTHB 退税深度解析</a>。</p>
              </div>
            </details>

            <!-- ============================================================
                 PART 4 — WHAT TO CHECK
                 ============================================================ -->
            <h2 id="check" style="margin-top:48px;">第 4 部分 · 任何房屋都该检查什么</h2>
            <p>四个层面,从房屋结构到文件手续,再到街区环境。跳过任何一层,就等于跳过了藏在那一层里的问题。</p>

            <details class="b60-section-toggle">
              <summary class="b60-section-toggle-summary">1. 房屋结构 —— 地基、屋顶、水、排水</summary>
              <div class="b60-section-body">
                <ul class="bullets">
                  <li><strong>地基。</strong>留意裂缝。<strong>横向裂缝比较严重</strong> —— 可能意味着墙体外鼓。细小的竖向裂缝通常问题不大。地下室墙上的白色粉状痕迹 = 曾经渗过水。</li>
                  <li><strong>屋顶。</strong>问清楚房龄。留意瓦片是否卷边或缺失,以及室内天花板是否有水渍。</li>
                  <li><strong>水。</strong>任何房子里最昂贵的问题。检查每个水槽下方、每扇窗户周围、地下室以及阁楼。霉味要留意,地板发软也要留意。</li>
                  <li><strong>地面坡度与排水。</strong>地面应该向远离房屋的方向倾斜。落水管的出水口应该离地基有足够距离。</li>
                </ul>
              </div>
            </details>

            <details class="b60-section-toggle">
              <summary class="b60-section-toggle-summary">2. 房屋系统 —— 暖通空调、电路、管道、窗户</summary>
              <div class="b60-section-body">
                <ul class="bullets">
                  <li><strong>炉子、空调、热水器。</strong>找到型号和序列号,查一下使用年限。炉子一般能用 15–25 年,热水器 7–15 年。</li>
                  <li><strong>电路方面的警示信号:</strong>
                    <ul class="bullets" style="margin-top:4px;">
                      <li><strong>管式布线(knob-and-tube wiring)</strong> —— 很多保险公司拒保,或要求更换。</li>
                      <li><strong>铝线</strong>(1960 年代中期到 1970 年代末)—— 可以投保,但通常需要专用认证接头并通过检测。</li>
                    </ul>
                  </li>
                  <li><strong>电箱容量。</strong>100 安培是实用下限;60 安培的电路需要升级。</li>
                  <li><strong>管道。</strong>镀锌管接近使用寿命末期。<strong>Kitec</strong> 管材(1990 年代中期到 2000 年代中期)已知会出问题,也可能影响投保。</li>
                  <li><strong>窗户。</strong>双层玻璃之间出现雾气 = 密封失效。</li>
                </ul>
              </div>
            </details>

            <details class="b60-section-toggle">
              <summary class="b60-section-toggle-summary">3. 文件手续 —— 租赁设备、许可证、测量图、环境问题</summary>
              <div class="b60-section-body">
                <ul class="bullets">
                  <li><strong>租赁设备。</strong>安省的房子经常有<strong>租用的热水器、炉子、空调或软水器</strong>,合同会随房产转移给您。有些合同期限长、解约成本高。问清楚哪些是租的,拿到合同,并写进出价条件里。</li>
                  <li><strong>许可证。</strong>大多数城市都能免费在线查询建筑许可记录。检查任何加建、装修好的地下室或露台。未经许可的施工可能引发保险问题,甚至被要求拆除。</li>
                  <li><strong>测量图(survey)。</strong>向卖家索要一份。它能显示真实的地界、地役权和越界情况。</li>
                  <li><strong>需要特别留意的情况:</strong>地下 / 地上<strong>油罐</strong>、<strong>UFFI</strong> 尿素甲醛泡沫隔热材料、老房子里的<strong>石棉</strong>和<strong>蛭石</strong>,以及是否曾被用作大麻种植场。</li>
                </ul>
              </div>
            </details>

            <details class="b60-section-toggle">
              <summary class="b60-section-toggle-summary">4. 地段 —— 唯一无法翻新的东西</summary>
              <div class="b60-section-body">
                <ul class="bullets">
                  <li>在工作日早上、平日晚上和周末,分别开车经过这条街看看。</li>
                  <li>了解附近空地未来的规划用途。</li>
                  <li>检查是否位于洪泛区、垃圾填埋场附近、铁路沿线、高压电走廊或航线下方。</li>
                  <li>如果可以,和邻居聊一聊。<strong>房子可以修,邻居没法修。</strong></li>
                </ul>
              </div>
            </details>

            <!-- ============================================================
                 PART 5 — RURAL
                 ============================================================ -->
            <h2 id="rural" style="margin-top:48px;">第 5 部分 · 乡村、度假屋与农场 —— 额外要做的功课</h2>
            <p>城市买家常常低估这一点。乡村的问题大多藏在地下和附属建筑里。</p>

            <details class="b60-section-toggle">
              <summary class="b60-section-toggle-summary">井水 —— 千万不能省略</summary>
              <div class="b60-section-body">
                <p>只看一眼井盖<strong>不能算作检测</strong>。请把以下几项写成出价的附加条件:</p>
                <ul class="bullets">
                  <li><strong>水质检测</strong> —— 至少检测总大肠菌群、大肠杆菌和硝酸盐。</li>
                  <li><strong>出水量测试</strong> —— 一口到了 8 月就干涸的井是严重问题。</li>
                  <li><strong>井记录</strong> —— 到安省的注册系统里查询。</li>
                </ul>
                <p>同时检查井与化粪池、以及与邻近农场作业之间的距离。</p>
              </div>
            </details>

            <details class="b60-section-toggle">
              <summary class="b60-section-toggle-summary">化粪系统 —— 需要单独的检测人员</summary>
              <div class="b60-section-body">
                <p>把出价条件设为<strong>由合格的化粪系统检测员进行检测</strong>,而不是普通验房师。请对方提供:</p>
                <ul class="bullets">
                  <li>系统使用年限和最近一次清掏日期。</li>
                  <li>化粪池和渗滤田的位置。</li>
                  <li>市政府的原始许可证和图纸。</li>
                </ul>
                <div class="callout" style="border-left: 3px solid #b8002e; padding-left: 22px;"><strong>如果交接后系统出问题,那就是您的问题。</strong>没有小修小补这回事。更换费用动辄数万元。留意草地上颜色更绿、更潮湿的条状区域,松软的地面,或者污水异味。</div>
              </div>
            </details>

            <details class="b60-section-toggle">
              <summary class="b60-section-toggle-summary">木柴炉、取暖燃料、通行与市政服务</summary>
              <div class="b60-section-body">
                <ul class="bullets">
                  <li><strong>木柴炉 / 壁炉:</strong>做一次 <strong>WETT 检测</strong>。大多数保险公司都要求。</li>
                  <li><strong>取暖燃料:</strong>丙烷、燃油或电力都比天然气贵。索要最近 12 个月的账单。油罐有相关保险规定和使用年限限制。</li>
                  <li><strong>道路:</strong>是市政全年维护,还是私人道路且仅季节性通行?谁负责铲雪,费用是多少?</li>
                  <li><strong>通行权(right of way):</strong>是否要经过别人的土地?是否已在产权上登记?</li>
                  <li><strong>网络和手机信号:</strong>要实地测试,不要只看覆盖地图。</li>
                  <li><strong>垃圾处理:</strong>有上门收运,还是要自己送去垃圾场?</li>
                </ul>
              </div>
            </details>

            <details class="b60-section-toggle">
              <summary class="b60-section-toggle-summary">度假屋专属 —— 临水道路预留地、水路进入、保险</summary>
              <div class="b60-section-body">
                <ul class="bullets">
                  <li><strong>临水道路预留地(shore road allowance)。</strong>安省很多水岸物业,沿水一条带状土地其实仍归市政府所有。如果这条地没有被购买并完成过户(closed),您可能并不拥有直到水边的全部土地。务必让律师核实。</li>
                  <li><strong>仅限水路进入。</strong>没有公路 = 融资、保险和转售都更难。</li>
                  <li><strong>季节性使用。</strong>确认冬季保温情况,以及道路 / 水路是否全年可用。</li>
                  <li><strong>保育局(conservation authority)。</strong>码头、船屋、沿岸施工和加建通常都需要审批。核实现有设施是否合法。</li>
                  <li><strong>保险。</strong>季节性和仅限水路进入的物业保费更高,有些保险公司干脆不承保。</li>
                </ul>
              </div>
            </details>

            <details class="b60-section-toggle">
              <summary class="b60-section-toggle-summary">农场专属 —— 分区规划、MDS、HST、租户农户</summary>
              <div class="b60-section-body">
                <ul class="bullets">
                  <li><strong>分区规划(zoning)。</strong>向市政府确认您实际能做什么用途。</li>
                  <li><strong>最小间距要求(MDS)。</strong>规定住宅与牲畜棚之间必须保持的最小距离。</li>
                  <li><strong>HST。</strong>农场用地部分往往需要缴 HST;住宅部分可能不需要。签约<strong>前</strong>务必咨询税务专业人士。</li>
                  <li><strong>农场地税类别。</strong>符合条件的农场可享受较低税率 —— 但需要主动申请并通过审核。</li>
                  <li><strong>租户农户 / 分成租约。</strong>这些安排可能在您买房后依然有效。</li>
                  <li><strong>地下排水管(tile drainage)。</strong>索要图纸,以及任何尚未还清的排水贷款(这类贷款可能会随房产转移)。</li>
                  <li><strong>融资。</strong>农业贷款机构可能比银行更合适。</li>
                  <li><strong>环境问题。</strong>老旧燃油罐、化学品仓储和垃圾堆放是真实存在的风险。可以考虑做一次环境评估。</li>
                </ul>
              </div>
            </details>

            <!-- ============================================================
                 PART 6 — OFFER + INSPECTION
                 ============================================================ -->
            <h2 id="offer" style="margin-top:48px;">第 6 部分 · 出价与验房</h2>

            <div class="callout" style="border-left: 3px solid var(--ink); padding-left: 22px;">
              <strong>双方一旦签字,合同即具有约束力。安省二手房买卖没有冷静期。</strong>每一次反报价都会取消之前的那一份。
            </div>

            <h3 style="margin-top:22px;">值得写进合同的附加条件</h3>
            <ul class="bullets">
              <li><strong>贷款条件。</strong></li>
              <li><strong>验房条件。</strong></li>
              <li><strong>井水水质与出水量</strong>(乡村物业)。</li>
              <li><strong>化粪系统检测</strong>(乡村物业)。</li>
              <li><strong>WETT 检测</strong>(木柴炉)。</li>
              <li><strong>分区规划 / 尽职调查</strong>(乡村、农场,或改变用途时)。</li>
              <li><strong>律师审阅</strong>(建议用于农场及特殊物业)。</li>
            </ul>
            <p>在竞争激烈的市场中,买家有时会为了赢下房子而放弃附加条件。请先弄清楚自己到底放弃了什么 —— 没有保护条款的贷款条件一旦失败,可能让您损失全部定金。</p>

            <h3 style="margin-top:22px;">验房</h3>
            <p><strong>一定要做验房,并自己挑选验房师。</strong>选一位有建筑或相关行业背景、会出具书面报告的人。全程陪同验房,结束时和验房师一起走一遍。</p>
            <p>验房发现的问题通常分为四类:</p>
            <ol class="bullets" style="list-style: decimal; padding-left: 20px;">
              <li>直接放弃这套房子的问题。</li>
              <li>应该拿来压价的问题。</li>
              <li>近期需要修的问题。</li>
              <li>需要长期留意的问题。</li>
            </ol>
            <p><strong>验房师不会打开墙壁。</strong>如果他们指出严重问题,在您决定去除条件前,先请专项技师来看一看。</p>

            <h3 style="margin-top:22px;">定金</h3>
            <p>定金表明您是认真的买家。交接时会从房价中扣除。合同一旦无条件生效,不能因为您改变主意就把定金要回来 —— 退还定金需要双方书面同意,或者法院裁定。请保持这笔钱的流动性;您可能需要在短时间内准备一张银行本票。</p>

            <!-- ============================================================
                 PART 7 — CLOSING COSTS
                 ============================================================ -->
            <h2 id="closing" style="margin-top:48px;">第 7 部分 · 交接成本</h2>
            <p>请在首付之外,另外预留房价的 <strong>1.5% 到 4%</strong> 现金。</p>

            <div class="fh-closing-stack">
              <div class="fh-closing-row"><span>土地转让税</span><span>在多伦多要双倍缴纳</span></div>
              <div class="fh-closing-row"><span>律师费及杂项支出</span><span>约 $1.5K–$2.5K</span></div>
              <div class="fh-closing-row"><span>产权保险</span><span>约 $300–$500</span></div>
              <div class="fh-closing-row"><span>验房费</span><span>$500–$900</span></div>
              <div class="fh-closing-row"><span>井水 / 化粪系统 / WETT 检测</span><span>乡村物业:几百元到 $1K+</span></div>
              <div class="fh-closing-row"><span>评估费</span><span>如贷款机构有要求</span></div>
              <div class="fh-closing-row"><span>房贷保险的 PST</span><span>如首付低于 20%</span></div>
              <div class="fh-closing-row"><span>搬家费用</span><span>视情况而定</span></div>
              <div class="fh-closing-row"><span>费用调整(adjustments)</span><span>卖家预付的地税或燃料费</span></div>
              <div class="fh-closing-row fh-closing-row-total"><span><strong>再加一笔缓冲金,用于</strong></span><span>换锁、窗帘、初期维修、添置家具</span></div>
            </div>

            <p style="margin-top:14px;"><strong>动手算一算:</strong><a href="/chinese/land-transfer-tax">土地转让税计算器</a> · <a href="/chinese/closing-costs">交接成本页面</a> · <a href="/chinese/cmhc-insurance-calculator">CMHC 保费计算器</a>。</p>

            <!-- ============================================================
                 PART 8 — BEFORE + AFTER CLOSING
                 ============================================================ -->
            <h2 id="before-after" style="margin-top:48px;">第 8 部分 · 交接前后</h2>

            <div class="fh-before-after">
              <div class="fh-ba-col fh-ba-dont">
                <div class="fh-ba-title">交接前 —— 不要做</div>
                <ul>
                  <li>换工作</li>
                  <li>买车或租车</li>
                  <li>开新的信用额度</li>
                  <li>漏还任何账单</li>
                </ul>
                <p class="fh-ba-note">放贷机构会重新核查您的资料。</p>
              </div>
              <div class="fh-ba-col fh-ba-do">
                <div class="fh-ba-title">交接前 —— 要做</div>
                <ul>
                  <li>尽量安排在最接近交接日时做最终验房(final walkthrough)</li>
                  <li>安排好房屋保险(贷款机构会要求证明)</li>
                  <li>如果可以,避免选周五交接</li>
                  <li>与您的律师确认最终交接金额</li>
                </ul>
              </div>
              <div class="fh-ba-col fh-ba-after">
                <div class="fh-ba-title">交接之后</div>
                <ul>
                  <li>更换门锁</li>
                  <li>找到水阀总开关和电箱位置</li>
                  <li>报税时申领 $1,500 的 FTHB 税务抵免</li>
                  <li>确认您的土地转让税退税已经到账</li>
                  <li>开始建立维护基金</li>
                </ul>
              </div>
            </div>

            <!-- ============================================================
                 COMMON MISTAKES
                 ============================================================ -->
            <h2 id="mistakes" style="margin-top:48px;">购房者最常犯的 10 个错误</h2>
            <ol class="bullets" style="list-style: decimal; padding-left: 20px;">
              <li><strong>只按房贷预算,不算别的。</strong>光是维护费,一年就可能高达 $10K。</li>
              <li><strong>为了赢下抢价大战而跳过验房。</strong></li>
              <li><strong>乡村物业跳过井水和化粪系统检测。</strong>这是乡村购房中代价最高的一种错误。</li>
              <li><strong>没问清楚哪些设备是租的。</strong>热水器租赁合同会随房子一起转移给您。</li>
              <li><strong>默认地下室套房是合法的。</strong>很多时候并不是。</li>
              <li><strong>没有核查加建和装修好的地下室的许可证。</strong></li>
              <li><strong>没有专项建议就买农场或水岸物业。</strong>涉及 HST、分区规划和临水道路预留地这些专业问题。</li>
              <li><strong>忘算交接成本。</strong>这些是现金支出,交接日当天就要付。</li>
              <li><strong>交接前改变自己的财务状况。</strong></li>
              <li><strong>操之过急。</strong>不耐烦是这份清单上其他所有错误的根源。</li>
            </ol>

