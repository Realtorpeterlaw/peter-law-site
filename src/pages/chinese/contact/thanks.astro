---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import ChineseTopBar from '../../../components/ChineseTopBar.astro';
import ChineseHeader from '../../../components/ChineseHeader.astro';
import ChineseFooter from '../../../components/ChineseFooter.astro';
---
<BaseLayout title="讯息已发送 — Peter Law" description="感谢您的联系。" zh={true}>

  <ChineseTopBar />
  <ChineseHeader />

  <section class="page-hero" style="padding-bottom:120px;">
    <div class="wrap" style="text-align:center;">
      <div class="eyebrow">讯息已收到</div>
      <h1 style="margin:0 auto 20px;">谢谢 —— 我会尽快联系您。</h1>
      <p style="margin:0 auto 36px;">大多数讯息会在工作时间内几小时内得到回复。如属紧急,请短信或来电 <a href="tel:+16478888472" style="text-decoration:underline;text-underline-offset:3px;">647-888-8472</a>(可通过 WhatsApp 联系)。</p>
      <div class="hero-ctas" style="justify-content:center;">
        <a href="/chinese/" class="btn-primary">返回首页
          <svg width="14" height="14" viewBox="0 0 14 14" fill="none"><path d="M1 7h12M8 2l5 5-5 5" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/></svg>
        </a>
      </div>
    </div>
  </section>

  <ChineseFooter />
</BaseLayout>
