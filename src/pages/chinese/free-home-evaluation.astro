---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ChineseTopBar from '../../components/ChineseTopBar.astro';
import ChineseHeader from '../../components/ChineseHeader.astro';
import ChineseFooter from '../../components/ChineseFooter.astro';
const BOOKING_URL = "https://cal.com/peter-law-c5lm9q";
const FORMSPREE_ENDPOINT = "https://formspree.io/f/xnjrzgda";

const hreflangAlternates = [
  { hreflang: 'en-CA', href: 'https://www.realtorpeterlaw.com/free-home-evaluation' },
  { hreflang: 'zh-CN', href: 'https://www.realtorpeterlaw.com/chinese/free-home-evaluation' },
  { hreflang: 'fr-CA', href: 'https://www.realtorpeterlaw.com/french/free-home-evaluation' },
  { hreflang: 'x-default', href: 'https://www.realtorpeterlaw.com/free-home-evaluation' },
];
---
<BaseLayout
  title="免费房屋估值：您的多伦多房产现在值多少？ | Peter Law"
  description="获取一份免费、无义务的多伦多房产市场估值。由熟悉您所在社区的经纪在 48 小时内提供详细 CMA 报告。"
  bodyClass="calc-page"
  zh={true}
  hreflangAlternates={hreflangAlternates}
>
  <ChineseTopBar />
  <ChineseHeader active="sellers" ctaLabel="或预约通话" />

  <section class="page-hero">
    <div class="wrap">
      <div class="eyebrow">免费房屋估值</div>
      <h1>您的房子今天到底值多少？</h1>
      <p>由熟悉您所在社区的多伦多经纪出具的详细市场比对分析（CMA）。免费，无义务，48 小时内送达。</p>
    </div>
  </section>

  <section class="major" style="padding-top:32px;">
    <div class="wrap">
      <div class="prose-grid">
        <aside class="prose-side">
          <h2 class="side-h">本页内容</h2>
          <ul>
            <li><a href="#what">您会拿到什么</a></li>
            <li><a href="#how">流程是怎样的</a></li>
            <li><a href="#why">为什么选择我</a></li>
            <li><a href="#form">提交估值申请</a></li>
          </ul>
        </aside>
        <div class="prose-body">
          <h2 id="what">您会拿到什么</h2>
          <ul class="bullets">
            <li><strong>一份详细的 CMA（市场比对分析）</strong>：您所在 1 公里范围内近期可比房源的成交数据，按面积、状况、配套调整</li>
            <li><strong>一个切实可参考的价格区间</strong>：保守价、预期价、进取价，基于当前市场动态</li>
            <li><strong>提升价值的具体建议</strong>：该修什么、该如何陈设、什么不必动</li>
            <li><strong>诚实的时间预期</strong>：类似房产近期的成交速度，分价格段说明</li>
          </ul>

          <h2 id="how">流程是怎样的</h2>
          <ol class="bullets" style="list-style: decimal;">
            <li>您填写下方表格，大约 3 分钟</li>
            <li>我调取 TRREB 的成交数据和您所在区域的活跃挂牌</li>
            <li>我做一次实地或线上看房（您选），通常 24 小时内完成</li>
            <li>您在提交申请的 48 小时内收到书面估值（PDF + 邮件概要）</li>
          </ol>

          <h2 id="why">为什么选择我</h2>
          <p>多伦多市中心、湖滨、大多伦多地区的每一份估值都是我亲自做。从 A 到 Z 全程亲力亲为，专注每一步。</p>

          <h2 id="form">提交估值申请</h2>
          <div class="calc">
            <form method="POST" action={FORMSPREE_ENDPOINT}>
              <div class="calc-fields">
                <h3 class="fhe-h calc-field-full">房产信息</h3>
                <div class="calc-field calc-field-full">
                  <label for="fhe-address">地址 <span class="hint">*</span></label>
                  <input id="fhe-address" name="address" type="text" required autocomplete="street-address" placeholder="123 Main St">
                </div>
                <div class="calc-field">
                  <label for="fhe-suite">单位号</label>
                  <input id="fhe-suite" name="suite" type="text" placeholder="例如 1205">
                </div>
                <div class="calc-field">
                  <label for="fhe-city">城市</label>
                  <input id="fhe-city" name="city" type="text" autocomplete="address-level2" placeholder="Toronto">
                </div>
                <div class="calc-field">
                  <label for="fhe-type">房产类型</label>
                  <select id="fhe-type" name="property_type">
                    <option value="">请选择</option>
                    <option value="Condo apartment">公寓（Condo）</option>
                    <option value="Condo townhouse">Condo 镇屋</option>
                    <option value="Loft">Loft 公寓</option>
                    <option value="Freehold townhouse">永久产权镇屋</option>
                    <option value="Semi-detached house">半独立屋</option>
                    <option value="Detached house">独立屋</option>
                    <option value="Pre-construction / assignment">楼花 / 转让</option>
                    <option value="Other">其他</option>
                  </select>
                </div>
                <div class="calc-field">
                  <label for="fhe-for">估值用途</label>
                  <select id="fhe-for" name="evaluation_for">
                    <option value="">请选择</option>
                    <option value="Sale / Assignment">出售 / 转让</option>
                    <option value="Rent / Lease">出租</option>
                    <option value="Rent / Lease with Property Management">出租并委托物业管理</option>
                    <option value="Both Sale and Rent / Lease">出售与出租都考虑</option>
                  </select>
                </div>
                <div class="calc-field">
                  <label for="fhe-beds">卧室</label>
                  <select id="fhe-beds" name="bedrooms">
                    <option value="">请选择</option>
                    <option value="Bachelor / Studio">开间（Studio）</option>
                    <option value="1 Bedroom">1 卧</option>
                    <option value="1 Bedroom + Den / Solarium / Study">1 卧 + 书房 / 阳光房</option>
                    <option value="2 Bedroom">2 卧</option>
                    <option value="2 Bedroom + Den / Solarium / Study">2 卧 + 书房 / 阳光房</option>
                    <option value="3 Bedroom">3 卧</option>
                    <option value="4 Bedroom +">4 卧及以上</option>
                  </select>
                </div>
                <div class="calc-field">
                  <label for="fhe-baths">卫生间</label>
                  <select id="fhe-baths" name="bathrooms">
                    <option value="">请选择</option>
                    <option value="1">1</option>
                    <option value="2">2</option>
                    <option value="3">3</option>
                    <option value="4+">4+</option>
                  </select>
                </div>
                <div class="calc-field">
                  <label for="fhe-sqft">大约面积（平方英尺）</label>
                  <input id="fhe-sqft" name="sqft" type="number" min="100" step="10" placeholder="例如 750" inputmode="numeric">
                </div>
                <div class="calc-field">
                  <label for="fhe-condition">单位状况</label>
                  <select id="fhe-condition" name="condition">
                    <option value="">请选择</option>
                    <option value="Excellent">极好</option>
                    <option value="Good">良好</option>
                    <option value="Fair">一般</option>
                  </select>
                </div>
                <div class="calc-field">
                  <label for="fhe-occupancy">房产目前</label>
                  <select id="fhe-occupancy" name="occupancy">
                    <option value="">请选择</option>
                    <option value="Owner occupied">业主自住</option>
                    <option value="Tenant occupied">租客居住</option>
                    <option value="Vacant or unoccupied">空置</option>
                  </select>
                </div>
                <div class="fhe-spacer" aria-hidden="true"></div>
                <fieldset class="fhe-group calc-field-full fhe-half">
                  <legend>是否拥有车位？</legend>
                  <div class="fhe-opts">
                    <label class="fhe-opt"><input type="radio" name="parking" value="Yes"> 是</label>
                    <label class="fhe-opt"><input type="radio" name="parking" value="No"> 否</label>
                  </div>
                </fieldset>
                <fieldset class="fhe-group calc-field-full fhe-half">
                  <legend>是否拥有储物柜？</legend>
                  <div class="fhe-opts">
                    <label class="fhe-opt"><input type="radio" name="locker" value="Yes"> 是</label>
                    <label class="fhe-opt"><input type="radio" name="locker" value="No"> 否</label>
                  </div>
                </fieldset>
                <div class="calc-field calc-field-full">
                  <label for="fhe-notes">其他有用信息 <span class="hint">（近期装修、升级、景观等）</span></label>
                  <textarea id="fhe-notes" name="notes" rows="3"></textarea>
                </div>
                <h3 class="fhe-h calc-field-full">个人信息</h3>
                <div class="calc-field">
                  <label for="fhe-name">姓名 <span class="hint">*</span></label>
                  <input id="fhe-name" name="name" type="text" required autocomplete="name">
                </div>
                <div class="calc-field">
                  <label for="fhe-phone">电话 <span class="hint">*</span></label>
                  <input id="fhe-phone" name="phone" type="tel" required autocomplete="tel">
                </div>
                <div class="calc-field">
                  <label for="fhe-email">邮箱 <span class="hint">*</span></label>
                  <input id="fhe-email" name="email" type="email" required autocomplete="email">
                </div>
                <div class="calc-field">
                  <label for="fhe-timeline">计划搬出时间</label>
                  <select id="fhe-timeline" name="timeline">
                    <option value="Just curious">只是了解一下</option>
                    <option value="Within 3 months">3 个月内</option>
                    <option value="3 to 6 months">3 至 6 个月</option>
                    <option value="6 to 12 months">6 至 12 个月</option>
                    <option value="12 months +">12 个月以上</option>
                  </select>
                </div>
                <fieldset class="fhe-group calc-field-full">
                  <legend>联系方式（可多选）</legend>
                  <div class="fhe-opts">
                    <label class="fhe-opt"><input type="checkbox" name="contact_by[]" value="Email"> 邮件</label>
                    <label class="fhe-opt"><input type="checkbox" name="contact_by[]" value="Schedule a personal meeting"> 预约面谈</label>
                  </div>
                </fieldset>
                <div class="calc-field calc-field-full">
                  <label for="fhe-heard">您是如何知道我的？</label>
                  <input id="fhe-heard" name="heard_from" type="text" placeholder="例如：朋友推荐、小红书、Instagram、传单">
                </div>
                <fieldset class="fhe-group calc-field-full">
                  <legend class="visually-hidden">更新</legend>
                  <p class="fhe-small">我会不时向您发送有关我的推广、服务或资讯更新。如您希望接收，请勾选下方选项。</p>
                  <div class="fhe-opts fhe-stack">
                    <label class="fhe-opt"><input type="checkbox" name="consent_correspondence" value="Yes"> 我同意接收与您的服务相关的后续通讯。</label>
                    <label class="fhe-opt"><input type="checkbox" name="monthly_sales_statistics" value="Yes"> 将我加入每月销售数据（Monthly Sales Statistics）邮件列表</label>
                  </div>
                </fieldset>
                <div class="hp-field" aria-hidden="true">
                  <label for="fhe-gotcha">请勿填写</label>
                  <input id="fhe-gotcha" name="_gotcha" type="text" tabindex="-1" autocomplete="off">
                </div>
                <input type="hidden" name="_subject" value="新免费房屋估值申请 (中文版)">
                <input type="hidden" name="_next" value="https://www.realtorpeterlaw.com/chinese/contact/thanks">
              </div>
              <button type="submit" class="btn-primary" style="margin-top: 24px;">
                点击这里，了解我的房屋价值
                <svg width="14" height="14" viewBox="0 0 14 14" fill="none"><path d="M1 7h12M8 2l5 5-5 5" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/></svg>
              </button>
            </form>
          </div>
        </div>
      </div>
    </div>
  </section>

  <ChineseFooter />
</BaseLayout>
<style>
  .fhe-h { font-size: 17px; margin: 12px 0 -6px; padding-top: 14px; border-top: 1px solid var(--rule); }
  .fhe-h:first-child { border-top: 0; padding-top: 0; margin-top: 0; }
  .fhe-group { border: 0; margin: 0; padding: 0; min-width: 0; }
  .fhe-group legend { font-size: 13px; font-weight: 500; color: var(--ink-soft); letter-spacing: 0.02em; margin-bottom: 8px; padding: 0; }
  .fhe-half { grid-column: auto; }
  .fhe-opts { display: flex; flex-wrap: wrap; gap: 8px; }
  .fhe-stack { flex-direction: column; }
  .fhe-opt { display: inline-flex; align-items: center; gap: 8px; padding: 8px 12px; border: 1px solid var(--rule); border-radius: 6px; background: #fff; font-size: 14px; color: var(--ink); cursor: pointer; line-height: 1.3; }
  .fhe-opt:hover { border-color: var(--ink-mute); }
  .fhe-opt:has(input:checked) { border-color: var(--ink); background: var(--surface); }
  .fhe-opt input { margin: 0; accent-color: var(--ink); flex: none; }
  .fhe-small { font-size: 12.5px; color: var(--ink-mute); margin: 0 0 8px; line-height: 1.45; }
  .calc-field textarea { width: 100%; box-sizing: border-box; font-family: inherit; font-size: 16px; padding: 10px 14px; border: 1px solid var(--rule); border-radius: 4px; background: var(--surface); color: var(--ink); resize: vertical; }
  .calc-field textarea:focus { outline: none; border-color: var(--ink); }
  .visually-hidden { position: absolute; width: 1px; height: 1px; overflow: hidden; clip: rect(0 0 0 0); white-space: nowrap; }
  @media (max-width: 720px) { .fhe-spacer { display: none; } }
</style>
