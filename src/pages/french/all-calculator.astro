---
import BaseLayout from '../../layouts/BaseLayout.astro';
import FrenchTopBar from '../../components/FrenchTopBar.astro';
import FrenchHeader from '../../components/FrenchHeader.astro';
import FrenchFooter from '../../components/FrenchFooter.astro';
import FrenchCTASection from '../../components/FrenchCTASection.astro';

export const prerender = true;

const hreflangAlternates = [
  { hreflang: 'en-CA', href: 'https://www.realtorpeterlaw.com/all-calculator/' },
  { hreflang: 'zh-CN', href: 'https://www.realtorpeterlaw.com/chinese/all-calculator/' },
  { hreflang: 'fr-CA', href: 'https://www.realtorpeterlaw.com/french/all-calculator/' },
  { hreflang: 'x-default', href: 'https://www.realtorpeterlaw.com/all-calculator/' },
];
---
<BaseLayout
  title="Calculateur ACHAT complet | Peter Law"
  description="Une seule page pour l'achat : paiement hypothécaire mensuel, droits de mutation immobilière, assurance SCHL, frais de clôture et liquidités à la clôture. Fini de jongler avec cinq calculateurs."
  lang="fr"
  bodyClass="fr calc-page"
  hreflangAlternates={hreflangAlternates}
>
  <FrenchTopBar />
  <FrenchHeader active="buyers" />

  <section class="page-hero">
    <div class="wrap">
      <div class="eyebrow">Calculateur ACHAT</div>
      <h1>Générateur de calcul simple et facile</h1>
      <p>Contactez Peter pour plus d'information sur l'achat et le financement. Parler à un courtier hypothécaire est recommandé.</p>
    </div>
  </section>

  <section class="major" style="padding-top: 24px;">
    <div class="wrap">
      <div class="ac-shell">

        <!-- BLOC D'ENTRÉE -->
        <div class="ac-inputs">
          <div class="ac-input-group">
            <label>1. Combien gagnez-vous par année ? <span class="hint">Avant impôts.</span></label>
            <div class="input-prefix"><input type="number" id="ac-income" value="250000" min="0" step="1000" inputmode="decimal" /></div>
          </div>

          <div class="ac-input-group">
            <label>2. Prix d'achat ACCEPTÉ <span class="hint">Condo, maison en rangée ou maison.</span></label>
            <div class="input-prefix"><input type="number" id="ac-price" value="1000000" min="0" step="5000" inputmode="decimal" /></div>
          </div>

          <div class="ac-input-group">
            <label>3. Mise de fonds <span class="hint">Idéalement 20 à 25 % du prix d'achat.</span></label>
            <div class="input-prefix"><input type="number" id="ac-savings" value="100000" min="0" step="1000" inputmode="decimal" /></div>
          </div>

          <div class="ac-input-group ac-checkbox-group">
            <label class="ac-checkbox">
              <input type="checkbox" id="ac-fthb" checked />
              <span class="ac-checkbox-text">Je suis un premier acheteur <span class="hint">Vous donne droit à un remboursement des droits de mutation.</span></span>
            </label>
          </div>

          <div class="ac-input-group">
            <label>4. Type de propriété <span class="hint">Change les coûts mensuels qui s'appliquent.</span></label>
            <select id="ac-proptype">
              <option value="freehold" selected>Propriété franche (Maison)</option>
              <option value="freehold-hoa">Propriété franche avec HOA</option>
              <option value="condo">Condo</option>
            </select>
          </div>

          <div class="ac-input-group" id="ac-tax-row">
            <label>5. Taxes foncières <span class="hint">Par mois. Laissez vide pour une estimation automatique à 0,7 % du prix par année.</span></label>
            <div class="input-prefix"><input type="number" id="ac-proptax" value="" min="0" step="5" placeholder="ex. 400" inputmode="decimal" /></div>
          </div>

          <div class="ac-input-group" id="ac-fee-row" style="display:none;">
            <label id="ac-fee-label">6. Frais HOA <span class="hint">Par mois.</span></label>
            <div class="input-prefix"><input type="number" id="ac-fee" value="" min="0" step="5" placeholder="ex. 150" inputmode="decimal" /></div>
          </div>

          <details class="ac-more">
            <summary>Plus d'options (facultatif)</summary>
            <div class="ac-more-body">
              <div class="ac-input-group">
                <label>Taux hypothécaire <span class="hint">5 % est normal en 2026.</span></label>
                <div class="input-suffix"><input type="number" id="ac-rate" value="5.0" min="0" step="0.05" inputmode="decimal" /></div>
              </div>
              <div class="ac-input-group">
                <label>Amortissement <span class="hint">Combien d'années pour tout rembourser. La plupart des gens choisissent 25 ans.</span></label>
                <select id="ac-amort">
                  <option value="20">20 ans</option>
                  <option value="25" selected>25 ans</option>
                  <option value="30">30 ans (seulement si &lt;20 % de mise de fonds et première maison)</option>
                </select>
              </div>
              <div class="ac-input-group">
                <label>Où se trouve la propriété ?</label>
                <select id="ac-location">
                  <option value="toronto" selected>Ville de Toronto</option>
                  <option value="ontario">Reste de l'Ontario</option>
                </select>
              </div>
            </div>
          </details>
        </div>

        <!-- BLOC DE RÉSULTATS -->
        <div class="ac-results">
          <div class="ac-headline">
            <div class="ac-headline-item">
              <div class="ac-headline-label">Votre paiement mensuel</div>
              <div class="ac-headline-value" id="ac-monthly">0 $</div>
              <div class="ac-headline-sub" id="ac-monthly-sub">Hypothèque seulement. Voir la répartition pour le coût mensuel total.</div>
            </div>
            <div class="ac-headline-item">
              <div class="ac-headline-label">Liquidités nécessaires à la clôture</div>
              <div class="ac-headline-value" id="ac-cash">0 $</div>
              <div class="ac-headline-sub" id="ac-cash-sub">Mise de fonds + droits de mutation + avocat + ajustements.</div>
            </div>
          </div>

          <div class="ac-verdict" id="ac-verdict">
            <span class="ac-verdict-dot"></span>
            <div>
              <div class="ac-verdict-title" id="ac-verdict-title">Entrez vos chiffres ci-dessus.</div>
              <div class="ac-verdict-sub" id="ac-verdict-sub">La banque regarde quelle part de votre revenu va au logement. Sous 32 % est sécuritaire. Au-dessus de 39 % et la banque dit probablement non.</div>
            </div>
          </div>

          <h3 class="ac-section-h">Où va l'argent</h3>
          <div class="ac-breakdown">
            <div class="ac-row"><span>Mise de fonds</span><strong id="ac-down">0 $</strong></div>
            <div class="ac-row"><span>Hypothèque totale</span><strong id="ac-mortgage">0 $</strong></div>
            <div class="ac-row"><span>Assurance SCHL / assurance prêt <em class="ac-note" id="ac-cmhc-note"></em></span><strong id="ac-cmhc">0 $</strong></div>
            <div class="ac-row"><span>Droits de mutation immobilière de l'Ontario</span><strong id="ac-ltt-on">0 $</strong></div>
            <div class="ac-row" id="ac-ltt-mltt-row"><span>Droits de mutation immobilière de Toronto</span><strong id="ac-ltt-mltt">0 $</strong></div>
            <div class="ac-row" id="ac-ltt-rebate-row" style="display:none;"><span>Remboursement pour premier acheteur</span><strong id="ac-ltt-rebate">−0 $</strong></div>
            <div class="ac-row" id="ac-mo-taxrow"><span>Taxes foncières mensuelles estimées</span><strong id="ac-mo-tax">0 $</strong></div>
            <div class="ac-row" id="ac-mo-feerow" style="display:none;"><span id="ac-mo-feelbl">Frais HOA / entretien mensuels</span><strong id="ac-mo-fee">0 $</strong></div>
            <div class="ac-row"><span>Frais juridiques + titre + ajustements <em class="ac-note">approximatif</em></span><strong id="ac-legal">0 $</strong></div>
            <div class="ac-row ac-row-total"><span>Liquidités totales approx. à la clôture</span><strong id="ac-total-cash">~0 $</strong></div>
          </div>

          <h3 class="ac-section-h">Test de réalité</h3>
          <div class="ac-checks">
            <div class="ac-check">
              <div class="ac-check-label">Mise de fonds minimale pour ce prix</div>
              <div class="ac-check-value" id="ac-mindown">0 $</div>
              <div class="ac-check-sub" id="ac-mindown-sub">Vous mettez actuellement 0 $ (0 %).</div>
            </div>
            <div class="ac-check">
              <div class="ac-check-label">Paiement au test de résistance</div>
              <div class="ac-check-value" id="ac-stress">0 $/mois</div>
              <div class="ac-check-sub">La banque vous teste au plus élevé entre votre taux + 2 % ou 5,25 %. Si cela entre dans votre revenu, vous êtes approuvé.</div>
            </div>
            <div class="ac-check">
              <div class="ac-check-label">Logement en % de votre revenu</div>
              <div class="ac-check-value" id="ac-gds">0 %</div>
              <div class="ac-check-sub">Utilise le paiement au test de résistance + taxes estimées + chauffage. Sous 32 % est la cible de la banque.</div>
            </div>
            <div class="ac-check">
              <div class="ac-check-label">Intérêts totaux sur la durée du prêt</div>
              <div class="ac-check-value" id="ac-interest">0 $</div>
              <div class="ac-check-sub">Si vous ne payez jamais plus et que le taux ne change jamais.</div>
            </div>
          </div>

          <p class="calc-disclaimer">Chiffres à titre indicatif. Les hypothèques canadiennes sont composées semi-annuellement. Les primes SCHL présentées sont les tiers standards actuels (4,00 % / 3,10 % / 2,80 %) pour les propriétés occupées par le propriétaire de moins de 1,5 M$. Le test de résistance fédéral utilise le plus élevé entre (votre taux + 2 %) ou 5,25 %. L'estimation des taxes foncières est de 0,7 % du prix par année (moyenne de Toronto) et le chauffage est de 150 $/mois — la banque utilise des chiffres approximatifs similaires pour le ratio ATD. Les frais juridiques + titre + ajustements par défaut de 2 500 $ sont typiques pour un achat de revente à Toronto. Les chiffres réels dépendent de votre crédit, du prêteur, de la propriété et des détails de clôture. Confirmez toujours avec un courtier hypothécaire, un avocat et un comptable avant de signer quoi que ce soit. Voir l'<a href="/french/disclaimer#calculators">Avis de non-responsabilité</a> pour le détail complet.</p>
        </div>
      </div>
    </div>
  </section>

  <FrenchCTASection heading="Voulez-vous que je vous guide avec des chiffres réels ?" lead="Apportez votre revenu et le quartier que vous visez. 15 minutes au téléphone et vous saurez exactement quelle fourchette de prix vous convient — et ce qui ne convient pas." />

  <FrenchFooter />

  <script is:inline>
    // ============================================================
    // CALCULATEUR ACHAT COMPLET — hypothèque + LTT + SCHL + frais de clôture
    // ============================================================
    (function() {
      function fmtCAD(n, dp) {
        if (dp === undefined) dp = 0;
        if (!isFinite(n) || isNaN(n)) return '0 $';
        return n.toLocaleString('fr-CA', { style: 'currency', currency: 'CAD', maximumFractionDigits: dp, minimumFractionDigits: dp });
      }

      function periodicRate(annualRatePct, paymentsPerYear) {
        const semiAnnual = annualRatePct / 200;
        return Math.pow(1 + semiAnnual, 2 / paymentsPerYear) - 1;
      }
      function monthlyPayment(principal, annualRatePct, amortYears) {
        if (principal <= 0 || amortYears <= 0) return 0;
        const r = periodicRate(annualRatePct, 12);
        const n = amortYears * 12;
        if (r === 0) return principal / n;
        return principal * r / (1 - Math.pow(1 + r, -n));
      }

      function cmhcPremiumRate(ltv) {
        if (ltv > 95) return null;
        if (ltv > 90) return 0.0400;
        if (ltv > 85) return 0.0310;
        if (ltv > 80) return 0.0280;
        return 0;
      }
      function minDownPayment(price) {
        if (price > 1500000) return price * 0.20;
        if (price <= 500000) return price * 0.05;
        return 500000 * 0.05 + (price - 500000) * 0.10;
      }

      function ontarioLTT(price) {
        if (price <= 0) return 0;
        let t = 0;
        const brackets = [[55000, 0.005], [250000, 0.010], [400000, 0.015], [2000000, 0.020]];
        let lower = 0;
        for (const [upper, rate] of brackets) {
          if (price > lower) {
            const taxable = Math.min(price, upper) - lower;
            if (taxable > 0) t += taxable * rate;
          }
          lower = upper;
        }
        if (price > 2000000) t += (price - 2000000) * 0.025;
        return t;
      }
      function torontoMLTT(price) {
        if (price <= 0) return 0;
        let t = 0;
        const brackets = [[55000, 0.005], [250000, 0.010], [400000, 0.015], [2000000, 0.020]];
        let lower = 0;
        for (const [upper, rate] of brackets) {
          if (price > lower) {
            const taxable = Math.min(price, upper) - lower;
            if (taxable > 0) t += taxable * rate;
          }
          lower = upper;
        }
        if (price > 2000000) {
          const luxury = [[3000000, 0.025], [4000000, 0.035], [5000000, 0.045], [10000000, 0.055], [20000000, 0.065]];
          let lo = 2000000;
          for (const [up, rate] of luxury) {
            if (price > lo) {
              const inB = Math.min(price, up) - lo;
              if (inB > 0) t += inB * rate;
            }
            lo = up;
          }
          if (price > 20000000) t += (price - 20000000) * 0.075;
        }
        return t;
      }
      const FTHB_ONT_REBATE = 4000;
      const FTHB_TOR_REBATE = 4475;

      const $ = (id) => document.getElementById(id);
      const inputs = ['ac-income', 'ac-price', 'ac-savings', 'ac-rate', 'ac-amort', 'ac-location', 'ac-fthb', 'ac-proptype', 'ac-proptax', 'ac-fee'];
      inputs.forEach((id) => {
        const el = $(id);
        if (!el) return;
        el.addEventListener('input', recompute);
        el.addEventListener('change', recompute);
      });

      function recompute() {
        const income   = Math.max(0, parseFloat($('ac-income').value)  || 0);
        const price    = Math.max(0, parseFloat($('ac-price').value)   || 0);
        const savings  = Math.max(0, parseFloat($('ac-savings').value) || 0);
        const rate     = Math.max(0, parseFloat($('ac-rate').value)    || 0);
        const amort    = parseInt($('ac-amort').value, 10) || 25;
        const loc      = $('ac-location').value;
        const isFTHB   = $('ac-fthb').checked;
        const propType = $('ac-proptype').value;
        const proptaxRaw = parseFloat($('ac-proptax').value);
        const feeRaw     = parseFloat($('ac-fee').value);

        const feeRow = $('ac-fee-row');
        const feeLabel = $('ac-fee-label');
        if (propType === 'freehold') {
          feeRow.style.display = 'none';
        } else if (propType === 'freehold-hoa') {
          feeRow.style.display = '';
          feeLabel.innerHTML = '6. Frais HOA <span class="hint">Par mois.</span>';
        } else if (propType === 'condo') {
          feeRow.style.display = '';
          feeLabel.innerHTML = '6. Frais de copropriété <span class="hint">Par mois. Demandez avant de signer — certains incluent le chauffage, l\'eau ou l\'électricité.</span>';
        }

        const minDown = minDownPayment(price);
        const downFromSavings = Math.min(savings, price);
        const shortfall = Math.max(0, minDown - downFromSavings);
        const actualDown = downFromSavings;
        const ltv = price > 0 ? (price - actualDown) / price * 100 : 0;
        const premiumRate = cmhcPremiumRate(ltv);
        const baseLoan = Math.max(0, price - actualDown);
        const cmhcPremium = (premiumRate !== null && premiumRate > 0) ? baseLoan * premiumRate : 0;
        const totalMortgage = baseLoan + cmhcPremium;

        const monthly = monthlyPayment(totalMortgage, rate, amort);

        const lttOnt = ontarioLTT(price);
        const lttMltt = loc === 'toronto' ? torontoMLTT(price) : 0;
        let rebate = 0;
        if (isFTHB) {
          rebate = Math.min(lttOnt, FTHB_ONT_REBATE);
          if (loc === 'toronto') rebate += Math.min(lttMltt, FTHB_TOR_REBATE);
        }
        const totalLTT = Math.max(0, lttOnt + lttMltt - rebate);

        const legalEtc = 2500;
        const cashToClose = actualDown + totalLTT + legalEtc;

        const stressRate = Math.max(rate + 2, 5.25);
        const stressPayment = monthlyPayment(totalMortgage, stressRate, amort);

        const monthlyIncome = income / 12;
        const propTaxMo = (isFinite(proptaxRaw) && proptaxRaw >= 0) ? proptaxRaw : (price * 0.007 / 12);
        const ownershipFeeMo = (isFinite(feeRaw) && feeRaw >= 0 && propType !== 'freehold') ? feeRaw : 0;
        const heatMo = propType === 'condo' ? 0 : 150;
        const gds = monthlyIncome > 0 ? (stressPayment + propTaxMo + ownershipFeeMo + heatMo) / monthlyIncome * 100 : 0;

        const totalInterest = monthly * amort * 12 - totalMortgage;

        $('ac-monthly').textContent = fmtCAD(monthly, 0);
        $('ac-cash').textContent = fmtCAD(cashToClose, 0);

        $('ac-down').textContent = fmtCAD(actualDown, 0);
        $('ac-mortgage').textContent = fmtCAD(totalMortgage, 0);
        $('ac-cmhc').textContent = fmtCAD(cmhcPremium, 0);
        $('ac-cmhc-note').textContent = premiumRate === null
          ? '(non autorisé — il faut au moins 5 % de plus)'
          : premiumRate === 0
            ? '(vous avez 20 %+ de mise de fonds — pas d\'assurance requise)'
            : '(' + (premiumRate * 100).toFixed(2) + ' % du prêt)';
        $('ac-ltt-on').textContent = fmtCAD(lttOnt, 0);
        $('ac-ltt-mltt').textContent = fmtCAD(lttMltt, 0);
        $('ac-ltt-mltt-row').style.display = loc === 'toronto' ? '' : 'none';
        if (rebate > 0) {
          $('ac-ltt-rebate-row').style.display = '';
          $('ac-ltt-rebate').textContent = '−' + fmtCAD(rebate, 0);
        } else {
          $('ac-ltt-rebate-row').style.display = 'none';
        }
        $('ac-mo-tax').textContent = fmtCAD(propTaxMo, 0) + '/mois';
        const feeRowB = $('ac-mo-feerow');
        if (propType === 'freehold') {
          feeRowB.style.display = 'none';
        } else {
          feeRowB.style.display = '';
          $('ac-mo-feelbl').textContent = propType === 'condo' ? 'Frais de copropriété mensuels' : 'Frais HOA mensuels';
          $('ac-mo-fee').textContent = fmtCAD(ownershipFeeMo, 0) + '/mois';
        }

        $('ac-legal').textContent = fmtCAD(legalEtc, 0);
        $('ac-total-cash').textContent = '~' + fmtCAD(cashToClose, 0);

        $('ac-mindown').textContent = fmtCAD(minDown, 0);
        const downPct = price > 0 ? (actualDown / price * 100) : 0;
        $('ac-mindown-sub').textContent = 'Vous avez ' + Math.round(savings).toLocaleString('fr-CA') + ' $'
          + '. Vous mettez ' + downPct.toFixed(1).replace('.', ',') + ' % du prix.'
          + (shortfall > 0 ? ' Il vous manque ' + fmtCAD(shortfall, 0) + ' — il faut plus d\'épargne avant que la banque approuve.' : '');
        $('ac-stress').textContent = fmtCAD(stressPayment, 0) + '/mois';
        $('ac-gds').textContent = gds.toFixed(1).replace('.', ',') + ' %';
        $('ac-interest').textContent = fmtCAD(totalInterest, 0);

        let vTitle = '';
        let vSub = '';
        let vClass = 'ac-verdict-neutral';
        if (income <= 0 || price <= 0) {
          vTitle = 'Entrez vos chiffres ci-dessus.';
          vSub = 'La banque regarde quelle part de votre revenu va au logement. Sous 32 % est sécuritaire. Au-dessus de 39 % et la banque dit probablement non.';
        } else if (premiumRate === null) {
          vTitle = 'Vous avez besoin de plus d\'épargne pour ce prix.';
          vSub = 'La mise de fonds minimale pour une maison de plus de 1,5 M$ est de 20 % du prix. Vous êtes en dessous. Épargnez plus, ou visez un prix plus bas.';
          vClass = 'ac-verdict-red';
        } else if (shortfall > 0) {
          vTitle = 'Vous manquez de mise de fonds.';
          vSub = 'Il vous faut ' + fmtCAD(minDown, 0) + ' minimum pour une maison de ' + fmtCAD(price, 0) + '. C\'est ' + fmtCAD(shortfall, 0) + ' de plus que ce que vous avez épargné. La banque n\'approuvera pas l\'hypothèque encore.';
          vClass = 'ac-verdict-red';
        } else if (gds > 39) {
          vTitle = 'La banque n\'approuvera probablement pas.';
          vSub = 'À ' + gds.toFixed(1).replace('.', ',') + ' % du revenu, le logement mange trop. Essayez un prix plus bas, plus de mise de fonds, ou assurez-vous que votre preuve de revenu est solide.';
          vClass = 'ac-verdict-red';
        } else if (gds > 32) {
          vTitle = 'Tendu. Faisable, mais vous le sentirez.';
          vSub = 'À ' + gds.toFixed(1).replace('.', ',') + ' % du revenu, vous êtes sous la limite dure de la banque (39 %) mais au-dessus de la zone confortable (32 %). Vacances, épargne et sorties au restaurant seront plus serrées.';
          vClass = 'ac-verdict-yellow';
        } else {
          vTitle = 'Vous pouvez vous permettre cela.';
          vSub = 'À ' + gds.toFixed(1).replace('.', ',') + ' % du revenu, le logement est bien dans la zone sûre. Vous aurez de la place pour l\'épargne, les urgences et le plaisir.';
          vClass = 'ac-verdict-green';
        }
        const v = $('ac-verdict');
        v.classList.remove('ac-verdict-neutral', 'ac-verdict-green', 'ac-verdict-yellow', 'ac-verdict-red');
        v.classList.add(vClass);
        $('ac-verdict-title').textContent = vTitle;
        $('ac-verdict-sub').textContent = vSub;
      }

      recompute();
    })();
  </script>

</BaseLayout>
