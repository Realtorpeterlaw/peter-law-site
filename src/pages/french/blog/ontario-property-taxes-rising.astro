---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import TopBar from '../../../components/FrenchTopBar.astro';
import Header from '../../../components/FrenchHeader.astro';
import Footer from '../../../components/FrenchFooter.astro';
import CTASection from '../../../components/FrenchCTASection.astro';

export const prerender = true;

const publishedDate = '2026-07-24';
const articleTitle = "ONTARIO : la taxe foncière en hausse";
const articleDescription = "Explication en français simple de la raison pour laquelle les taxes foncières dans les villes de l'Ontario grimpent plus vite que la valeur des maisons. Ce que le Fraser Institute a trouvé, quelles villes paient le plus, et ce que cela veut dire si vous achetez, louez ou possédez déjà.";
const articleUrl = 'https://www.realtorpeterlaw.com/french/blog/ontario-property-taxes-rising';
const enUrl = 'https://www.realtorpeterlaw.com/blog/ontario-property-taxes-rising';

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: articleTitle,
  description: articleDescription,
  author: { '@type': 'Person', name: 'Peter Law', url: 'https://www.realtorpeterlaw.com/french/about' },
  publisher: {
    '@type': 'Organization',
    name: 'Peter Law — Immobilier à Toronto',
    logo: { '@type': 'ImageObject', url: 'https://www.realtorpeterlaw.com/favicon.svg' },
  },
  inLanguage: 'fr-CA',
  datePublished: publishedDate,
  dateModified: publishedDate,
  mainEntityOfPage: { '@type': 'WebPage', '@id': articleUrl },
  keywords: "taxe foncière Ontario, taxe foncière Toronto, taxe foncière Pickering, taxe foncière Milton, rapport Fraser Institute taxes foncières, taxe municipale Ontario 2026, taxe foncière par personne Ontario, évaluation MPAC 2016, croissance taxe foncière Ontario",
  citation: {
    '@type': 'CreativeWork',
    name: 'Property taxes growing quickly in Ontario municipalities',
    author: 'Livio Di Matteo',
    publisher: 'Fraser Institute',
    datePublished: '2026-06-02',
    url: 'https://www.fraserinstitute.org/',
  },
  translationOfWork: { '@type': 'Article', '@id': enUrl },
};

const hreflangAlternates = [
  { hreflang: 'en-CA', href: 'https://www.realtorpeterlaw.com/blog/ontario-property-taxes-rising/' },
  { hreflang: 'zh-CN', href: 'https://www.realtorpeterlaw.com/chinese/blog/ontario-property-taxes-rising/' },
  { hreflang: 'fr-CA', href: 'https://www.realtorpeterlaw.com/french/blog/ontario-property-taxes-rising/' },
  { hreflang: 'x-default', href: 'https://www.realtorpeterlaw.com/blog/ontario-property-taxes-rising/' },
];

// ── Données de graphique ────────────────────────────────────────────
// Figure 1 : Taxe municipale par habitant, 2025 (tranche du haut + bas)
const chart1_top = [
  { city: 'Pickering', val: 2300 },
  { city: 'Niagara Falls', val: 2180 },
  { city: 'Whitby', val: 2160 },
  { city: 'Grand Sudbury', val: 2104 },
  { city: 'Burlington', val: 2098 },
  { city: 'Thunder Bay', val: 2066 },
];
const chart1_bottom = [
  { city: 'Toronto', val: 1807 },
  { city: 'Kitchener', val: 1560 },
  { city: 'Brampton', val: 1516 },
  { city: 'Milton', val: 1230 },
];
const chart1_max = 2500;

// Figure 2 : Évaluation imposable non pondérée par habitant, 2025 ($)
const chart2_top = [
  { city: 'Richmond Hill', val: 291142 },
  { city: 'Vaughan', val: 288109 },
  { city: 'Markham', val: 279236 },
  { city: 'Oakville', val: 274298 },
  { city: 'Caledon', val: 242676 },
  { city: 'Toronto', val: 237835 },
];
const chart2_bottom = [
  { city: 'Sault Ste. Marie', val: 96028 },
  { city: 'Timmins', val: 85122 },
  { city: 'Windsor', val: 68193 },
];
const chart2_max = 300000;

// Figure 3 : Comparaison de croissance sur 10 ans (2015 → 2025)
const chart3 = [
  { label: 'Croissance taxe par personne (moy.)', val: 35, color: '#c05a4a' },
  { label: 'Croissance évaluation par personne (moy.)', val: 21, color: '#9ea88d' },
  { label: 'Croissance population (Ontario)', val: 20, color: '#c3b28d' },
  { label: 'Croissance revenu médian des familles', val: 14, color: '#8ba0a8' },
];
const chart3_max = 40;

function fmt(n: number): string { return n.toLocaleString('fr-CA'); }
---
<BaseLayout
  title={`${articleTitle} | Peter Law — Blogue Immobilier Toronto`}
  description={articleDescription}
  lang="fr"
  bodyClass="fr guide-page article-page"
  hreflangAlternates={hreflangAlternates}
>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  </Fragment>

  <TopBar />
  <Header active="blog" />

  <article>
    <section class="page-hero">
      <div class="wrap">
        <div class="eyebrow"><a href="/french/blog" class="back-link"><svg width="11" height="11" viewBox="0 0 14 14" fill="none" style="vertical-align:-1px;margin-right:5px;" aria-hidden="true"><path d="M13 7H1M6 12L1 7l5-5" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/></svg>Blogue</a> · Propriétaires en Ontario · Politique</div>
        <h1>{articleTitle}</h1>
        <p class="article-lead">Les taxes foncières dans les villes de l'Ontario grimpent plus vite que la valeur des maisons, plus vite que les revenus des familles, et plus vite que l'économie en général. Voici ce que les chiffres disent vraiment — en français simple.</p>
        <div class="article-byline">
          <span>Par <a href="/french/about">Peter Law</a></span>
          <span class="dot">·</span>
          <time datetime={publishedDate}>24 juillet 2026</time>
          <span class="dot">·</span>
          <span>7 min de lecture</span>
        </div>
      </div>
    </section>

    <section class="major" style="padding-top:32px;">
      <div class="wrap">
        <div class="prose-grid">
          <aside class="prose-side">
            <h4>Sur cette page</h4>
            <ul>
              <li><a href="#quick">Faits rapides</a></li>
              <li><a href="#what">Qu'est-ce qu'une taxe foncière ?</a></li>
              <li><a href="#big">La vue d'ensemble</a></li>
              <li><a href="#chart1">Graphique 1 — Qui paie le plus ?</a></li>
              <li><a href="#chart2">Graphique 2 — Où est la richesse ?</a></li>
              <li><a href="#chart3">Graphique 3 — Taxes vs le reste</a></li>
              <li><a href="#why">Pourquoi ça arrive ?</a></li>
              <li><a href="#means">Ce que ça veut dire pour vous</a></li>
              <li><a href="#disclaimer">Avis</a></li>
            </ul>
          </aside>

          <div class="prose-body">

            <div id="quick" class="qf-card">
              <div class="qf-row"><span class="qf-label">Villes en Ontario</span><span class="qf-val">444 municipalités</span></div>
              <div class="qf-row"><span class="qf-label">Revenus taxe foncière (2015 → 2025)</span><span class="qf-val">19 G$ → 27 G$ (+42 %)</span></div>
              <div class="qf-row"><span class="qf-label">Base d'évaluation (par personne, moy. 10 ans)</span><span class="qf-val">+21 %</span></div>
              <div class="qf-row"><span class="qf-label">Facture de taxe (par personne, moy. 10 ans)</span><span class="qf-val">+35 %</span></div>
              <div class="qf-row"><span class="qf-label">Croissance du revenu familial sur la période</span><span class="qf-val">+14 %</span></div>
              <div class="qf-row"><span class="qf-label">Valeurs de maison utilisées pour le calcul</span><span class="qf-val">Figées aux prix de 2016</span></div>
            </div>

            <h2 id="what">Qu'est-ce qu'une taxe foncière ?</h2>
            <p>Une <strong>taxe foncière</strong> est l'argent que votre ville vous facture chaque année pour posséder une maison, un condo ou un terrain. La ville utilise cet argent pour payer des choses comme la collecte des ordures, le déneigement, les routes, les bibliothèques, les parcs, et une partie du budget des services de police et d'incendie.</p>
            <p>La facture est calculée avec deux chiffres : <strong>le taux de taxe</strong> (un pourcentage que la ville fixe chaque année) et <strong>la valeur de votre propriété</strong> (appelée l'évaluation). En Ontario, la partie évaluation est un peu bizarre — la valeur utilisée par la province est <strong>figée à la valeur de votre maison en 2016</strong>. Elle n'a pas été mise à jour depuis dix ans. Ça veut dire que la récente flambée immobilière n'est pas dans les chiffres.</p>

            <h2 id="big">La vue d'ensemble</h2>
            <p>L'Ontario a 444 villes et villages. Les taxes foncières sont leur plus grande source unique d'argent — <strong>44,1 % de ce qu'ils collectent chaque année</strong>. Sur les dix dernières années, cet argent a beaucoup augmenté :</p>
            <ul>
              <li>En <strong>2015</strong>, les villes de l'Ontario ont collecté environ <strong>19 milliards $</strong> en taxes foncières.</li>
              <li>En <strong>2025</strong>, elles ont collecté environ <strong>27 milliards $</strong>.</li>
              <li>C'est un <strong>bond de 42 %</strong> en dix ans.</li>
            </ul>
            <p>Sur la même période, les revenus des familles en Ontario n'ont augmenté que d'environ 14 %. La facture de taxe a donc augmenté environ <strong>2,5 fois plus vite</strong> que ce que les gens gagnaient.</p>

            <!-- ─── GRAPHIQUE 1 ─── -->
            <h2 id="chart1">Graphique 1 — Qui paie le plus ? (2025)</h2>
            <p>C'est <strong>combien de taxe chaque personne paie</strong> dans une ville, en moyenne, en 2025. Le haut de la liste est où la facture par personne est la plus grosse. Le bas de la liste est où elle est la plus petite.</p>
            <figure class="bar-chart" aria-labelledby="c1-cap">
              <figcaption id="c1-cap">Prélèvement municipal net par habitant, 2025 — 6 du haut vs 4 du bas des 35 grandes villes de l'Ontario.</figcaption>
              <div class="bar-group">
                <div class="bar-group-label">Taxe par personne la plus élevée</div>
                {chart1_top.map((r) => (
                  <div class="bar-row">
                    <span class="bar-city">{r.city}</span>
                    <div class="bar-track"><span class="bar-fill bar-fill-red" style={`width:${(r.val / chart1_max) * 100}%`}></span></div>
                    <span class="bar-val">{fmt(r.val)} $</span>
                  </div>
                ))}
              </div>
              <div class="bar-group">
                <div class="bar-group-label">Taxe par personne la plus basse</div>
                {chart1_bottom.map((r) => (
                  <div class="bar-row">
                    <span class="bar-city">{r.city}</span>
                    <div class="bar-track"><span class="bar-fill bar-fill-green" style={`width:${(r.val / chart1_max) * 100}%`}></span></div>
                    <span class="bar-val">{fmt(r.val)} $</span>
                  </div>
                ))}
              </div>
              <p class="chart-note">Source : Rapport municipal BMA 2025 via Fraser Institute. Barres à l'échelle de 2 500 $ max.</p>
            </figure>
            <p><strong>Ce que ça dit :</strong> si vous habitez Pickering, votre ville prend environ <strong>2 300 $ par personne</strong> en moyenne, en taxe municipale. Si vous habitez Milton, elle prend environ <strong>1 230 $</strong>. Même province, environ le double de facture.</p>

            <!-- ─── GRAPHIQUE 2 ─── -->
            <h2 id="chart2">Graphique 2 — Où est la richesse ? (2025)</h2>
            <p>C'est <strong>la valeur de l'immobilier</strong> dans chaque ville, par personne. Les villes du haut ont des propriétés très chères. Celles du bas ont des propriétés moins chères. Une ville avec une plus grosse base fiscale devrait, en théorie, avoir besoin d'un taux plus bas pour lever la même somme — parce qu'il y a plus de valeur à taxer.</p>
            <figure class="bar-chart" aria-labelledby="c2-cap">
              <figcaption id="c2-cap">Évaluation imposable non pondérée par habitant, 2025 — 6 du haut vs 3 du bas.</figcaption>
              <div class="bar-group">
                <div class="bar-group-label">Base fiscale par personne la plus riche</div>
                {chart2_top.map((r) => (
                  <div class="bar-row">
                    <span class="bar-city">{r.city}</span>
                    <div class="bar-track"><span class="bar-fill bar-fill-blue" style={`width:${(r.val / chart2_max) * 100}%`}></span></div>
                    <span class="bar-val">{fmt(r.val)} $</span>
                  </div>
                ))}
              </div>
              <div class="bar-group">
                <div class="bar-group-label">Base fiscale par personne la plus petite</div>
                {chart2_bottom.map((r) => (
                  <div class="bar-row">
                    <span class="bar-city">{r.city}</span>
                    <div class="bar-track"><span class="bar-fill bar-fill-tan" style={`width:${(r.val / chart2_max) * 100}%`}></span></div>
                    <span class="bar-val">{fmt(r.val)} $</span>
                  </div>
                ))}
              </div>
              <p class="chart-note">Source : Rapport municipal BMA 2025 via Fraser Institute. Barres à l'échelle de 300 000 $ max.</p>
            </figure>
            <p><strong>Ce que ça dit :</strong> Richmond Hill a plus de <strong>quatre fois</strong> la valeur imposable par personne comparée à Windsor. Pourtant, comme le montre le graphique 1, la facture par personne de Windsor n'est pas quatre fois plus basse. Quelque chose d'autre se passe.</p>

            <!-- ─── GRAPHIQUE 3 ─── -->
            <h2 id="chart3">Graphique 3 — Taxes vs le reste (2015-2025)</h2>
            <p>C'est le graphique le plus important. Il compare la vitesse à laquelle quatre choses ont augmenté sur dix ans, en moyenne, dans 35 grandes villes de l'Ontario.</p>
            <figure class="bar-chart" aria-labelledby="c3-cap">
              <figcaption id="c3-cap">Croissance moyenne sur 10 ans (2015 → 2025), 35 grandes villes de l'Ontario.</figcaption>
              <div class="bar-group">
                {chart3.map((r) => (
                  <div class="bar-row">
                    <span class="bar-city">{r.label}</span>
                    <div class="bar-track"><span class="bar-fill" style={`width:${(r.val / chart3_max) * 100}%;background:${r.color}`}></span></div>
                    <span class="bar-val">+{r.val} %</span>
                  </div>
                ))}
              </div>
              <p class="chart-note">Source : Rapport municipal BMA 2025, Statistique Canada, via analyse du Fraser Institute. Barres à l'échelle de +40 % max.</p>
            </figure>
            <p><strong>Ce que ça dit :</strong> la facture par personne grimpe <strong>plus vite que tout le reste</strong>. Plus vite que la population. Plus vite que la valeur des propriétés taxées. Et beaucoup plus vite que ce que les familles gagnent.</p>
            <p>En termes simples : <strong>la tarte grossit, mais la part que chaque personne paie grossit encore plus vite</strong>.</p>

            <h2 id="why">Pourquoi ça arrive ?</h2>
            <p>Le rapport du Fraser Institute propose quelques raisons. En termes de secondaire :</p>
            <ul>
              <li><strong>La province donne moins d'argent aux villes qu'avant</strong>, donc les villes vous facturent plus pour combler la différence.</li>
              <li><strong>Tout coûte plus cher après la pandémie.</strong> Réparer une route, faire fonctionner un centre récréatif ou payer un pompier coûte tout plus cher.</li>
              <li><strong>La province a transféré des programmes</strong> (santé, services sociaux) que les villes paient maintenant.</li>
              <li><strong>Ou</strong> — et c'est vers celle-ci que le rapport penche — <strong>les villes dépensent simplement plus, sur plus de choses, sans se demander si le contribuable peut suivre</strong>.</li>
            </ul>
            <p>Le rapport termine en disant : ce n'est peut-être pas un problème de revenu. C'est peut-être un problème de dépenses.</p>

            <details class="means-collapse" id="means">
              <summary>Ce que ça veut dire pour vous</summary>
              <div class="means-body">
                <div class="callout">
                  <strong>Si vous êtes déjà propriétaire :</strong> la taxe foncière est un vrai coût récurrent qui augmente presque chaque année. Prévoyez-le au budget. Si vous achetez, demandez la facture de l'année en cours — pas juste celle d'il y a deux ans.
                </div>
                <div class="callout">
                  <strong>Si vous achetez :</strong> ne regardez pas juste le prix. Une maison moins chère dans une ville à taxe par personne élevée (comme Pickering, Whitby, Sudbury) peut finir par coûter plus par mois qu'une maison un peu plus chère dans une ville à taux plus bas (Milton, Brampton, Kitchener). J'inclus la taxe foncière dans les scénarios que je fais pour mes clients.
                </div>
                <div class="callout">
                  <strong>Si vous louez :</strong> les propriétaires transfèrent la hausse de la taxe foncière au loyer, mais lentement et sous les règles du contrôle des loyers (le plafond de l'Ontario est fixé chaque année). C'est une des raisons discrètes pour lesquelles le loyer monte même sans changement de bail.
                </div>
                <div class="callout">
                  <strong>Si vous votez :</strong> les élections municipales ont lieu cet automne. La taxe foncière est <em>le</em> levier que le conseil municipal peut tirer. Demandez aux candidats ce qu'ils veulent faire de votre facture.
                </div>
              </div>
            </details>

            <h2 id="disclaimer">Avis</h2>
            <p style="font-size: 13.5px; color: var(--ink-mute); line-height: 1.6; border-top: 1px dashed #d6d1c8; padding-top: 16px; font-style: italic;">Cet article résume et reformule en français simple un commentaire intitulé <em>« Property taxes growing quickly in Ontario municipalities »</em> par Livio Di Matteo, professeur d'économie à l'Université Lakehead, publié par le Fraser Institute le 2 juin 2026. Tous les chiffres, pourcentages et données par ville proviennent de ce rapport et du Rapport municipal BMA 2025 qu'il cite. La formulation et l'analyse dans ce billet sont le résumé de Peter Law écrit pour un lecteur général — ce ne sont pas des citations directes et ne devraient pas être traités comme telles. Rien dans cet article n'est un avis juridique, fiscal ou financier, et Peter Law est un représentant commercial immobilier inscrit (RECO), pas un fiscaliste. Les taux de taxe foncière, les règles d'évaluation et les budgets municipaux changent chaque année ; consultez toujours les renseignements à jour sur le site Web de votre municipalité ou auprès d'un conseiller fiscal autorisé avant de prendre une décision basée sur ce contenu. Sources : Fraser Institute (fraserinstitute.org), Rapport municipal BMA 2025.</p>

          </div>
        </div>
      </div>
    </section>
  </article>

  <CTASection heading="Vous achetez ou louez dans une ville précise ?" lead="Parlez-moi des quartiers que vous considérez. J'inclus la taxe foncière et les coûts de possession mensuels dans chaque scénario que je fais pour un client — la sélection que vous obtenez tient donc déjà compte de ce que chaque ville coûte vraiment pour y vivre." />
  <Footer />

  <style>
    /* Carte faits rapides */
    .qf-card {
      background: #fff;
      border: 1px solid var(--line, #e6e2dc);
      border-radius: 14px;
      padding: 18px 20px;
      margin: 0 0 32px;
      display: grid;
      gap: 10px;
    }
    .qf-row {
      display: grid;
      grid-template-columns: 55% 1fr;
      gap: 14px;
      align-items: baseline;
      padding-bottom: 8px;
      border-bottom: 1px dashed #eee;
    }
    .qf-row:last-child { border-bottom: 0; padding-bottom: 0; }
    .qf-label { color: #666; font-size: 0.92rem; }
    .qf-val { color: #1a1a1a; font-weight: 600; font-size: 0.95rem; }

    /* Graphique à barres */
    .bar-chart {
      margin: 22px 0 28px;
      padding: 20px 22px 16px;
      background: #fafaf7;
      border: 1px solid var(--line, #e6e2dc);
      border-radius: 12px;
    }
    .bar-chart figcaption {
      font-family: 'Fraunces', Georgia, serif;
      font-size: 15px;
      font-style: italic;
      color: var(--ink-soft);
      margin-bottom: 14px;
    }
    .bar-group + .bar-group { margin-top: 18px; }
    .bar-group-label {
      font-size: 11px;
      letter-spacing: 0.12em;
      text-transform: uppercase;
      color: var(--ink-mute);
      font-weight: 700;
      margin-bottom: 8px;
    }
    .bar-row {
      display: grid;
      grid-template-columns: 130px 1fr 90px;
      gap: 10px;
      align-items: center;
      padding: 6px 0;
    }
    .bar-city {
      font-size: 13.5px;
      color: var(--ink);
      font-weight: 500;
      text-align: right;
    }
    .bar-track {
      background: #ece7dd;
      height: 22px;
      border-radius: 4px;
      overflow: hidden;
    }
    .bar-fill {
      display: block;
      height: 100%;
      border-radius: 4px;
      transition: width 0.4s ease;
    }
    .bar-fill-red { background: linear-gradient(90deg, #c86a5c, #a04a3c); }
    .bar-fill-green { background: linear-gradient(90deg, #9ea88d, #7c8b6a); }
    .bar-fill-blue { background: linear-gradient(90deg, #6b8ea6, #4d6f88); }
    .bar-fill-tan { background: linear-gradient(90deg, #c3b28d, #a49470); }
    .bar-val {
      font-size: 13px;
      font-weight: 600;
      color: var(--ink);
      font-variant-numeric: tabular-nums;
    }
    .chart-note {
      font-size: 11.5px;
      color: var(--ink-mute);
      margin-top: 14px !important;
      font-style: italic;
      text-align: right;
    }
    @media (max-width: 640px) {
      .bar-row { grid-template-columns: 100px 1fr 70px; gap: 6px; }
      .bar-city { font-size: 12px; }
      .bar-val { font-size: 12px; }
    }

    /* Repliable « Ce que ça veut dire pour vous » */
    .means-collapse {
      margin: 24px 0 28px;
      background: #fafaf7;
      border: 1px solid var(--line, #e6e2dc);
      border-radius: 14px;
    }
    .means-collapse > summary {
      cursor: pointer;
      list-style: none;
      padding: 18px 22px;
      font-family: 'Fraunces', Georgia, serif;
      font-weight: 500;
      font-size: 22px;
      color: var(--ink, #1a1a1a);
      display: flex;
      justify-content: space-between;
      align-items: center;
    }
    .means-collapse > summary::-webkit-details-marker { display: none; }
    .means-collapse > summary::after {
      content: '+';
      font-size: 24px;
      color: var(--ink-mute);
      font-weight: 300;
      transition: transform 0.15s;
    }
    .means-collapse[open] > summary::after { content: '−'; }
    .means-collapse > summary:hover { background: rgba(0,0,0,0.02); border-radius: 14px 14px 0 0; }
    .means-body {
      padding: 4px 22px 22px;
      display: grid;
      gap: 14px;
    }
  </style>
</BaseLayout>
