const articleTitle = 'Taxe sur les logements vacants (Toronto)';
const articleDescription = "Un guide simple de la taxe sur les logements vacants de Toronto. Ce que c'est, pourquoi ça compte, comment la Ville décide si votre logement est « occupé » ou « vacant », les exonérations et les pénalités si vous manquez la déclaration.";
const articleUrl = 'https://www.realtorpeterlaw.com/french/blog/vacant-home-tax';
