---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import TopBar from '../../../components/FrenchTopBar.astro';
import Header from '../../../components/FrenchHeader.astro';
import Footer from '../../../components/FrenchFooter.astro';
import LCTA from '../../../components/FrenchCTASection.astro';

export const prerender = true;

const publishedDate = '2026-10-06';
const articleTitle = 'Feng shui : pour débutants';
const articleDescription = "Un guide feng shui simple, pièce par pièce, pour les nouveaux propriétaires et les locataires de Toronto : la porte d'entrée, la chambre, la cuisine, les cinq éléments, la carte bagua et ce que les acheteurs entendent souvent.";
const articleUrl = 'https://www.realtorpeterlaw.com/french/blog/feng-shui-for-beginners';

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: articleTitle,
  description: articleDescription,
  inLanguage: 'fr-CA',
  author: { '@type': 'Person', name: 'Peter Law', url: 'https://www.realtorpeterlaw.com/french/about' },
  publisher: {
    '@type': 'Organization',
    name: 'Peter Law, Toronto Real Estate',
    logo: { '@type': 'ImageObject', url: 'https://www.realtorpeterlaw.com/photos/peter-cn-tower.jpg', width: 1500, height: 1887 },
  },
  datePublished: publishedDate,
  dateModified: publishedDate,
  mainEntityOfPage: { '@type': 'WebPage', '@id': articleUrl },
  keywords: "feng shui pour débutants, feng shui nouvelle maison, feng shui Toronto, feng shui porte d'entrée, position du lit feng shui, cuisinière et évier feng shui, cinq éléments, carte bagua, bagua occidental, feng shui condo Toronto, étage avec un 4, maison intersection en T, flèche empoisonnée feng shui, achat immobilier Ontario",
};

const hreflangAlternates = [
  { hreflang: 'en-CA', href: 'https://www.realtorpeterlaw.com/blog/feng-shui-for-beginners/' },
  { hreflang: 'zh-CN', href: 'https://www.realtorpeterlaw.com/chinese/blog/feng-shui-for-beginners/' },
  { hreflang: 'fr-CA', href: 'https://www.realtorpeterlaw.com/french/blog/feng-shui-for-beginners/' },
  { hreflang: 'x-default', href: 'https://www.realtorpeterlaw.com/blog/feng-shui-for-beginners/' },
];

const quickWins = [
  { title: 'Désencombrez.', text: 'Moins d\'objets, c\'est une énergie qui circule librement. Et c\'est tout simplement plus agréable.' },
  { title: 'Lavez vos fenêtres.', text: 'Ouvrez les rideaux le jour. Fermez-les le soir.' },
  { title: 'Réparez ce qui est brisé.', text: 'Une ampoule grillée, une tuile fissurée, une porte qui coince.' },
  { title: 'Ajoutez des plantes.', text: 'Des plantes en santé. Retirez tout de suite celles qui sont mortes ou mourantes.' },
  { title: 'Vérifiez vos miroirs.', text: 'Ils doivent refléter la lumière ou une belle vue. Pas votre porte d\'entrée, et pas votre lit.' },
];

const elements = [
  { key: 'wood',  glyph: '木', name: 'Bois',  color: '#2f7d4a', how: 'Plantes, meubles en bois, tons de vert.' },
  { key: 'fire',  glyph: '火', name: 'Feu',   color: '#c0392b', how: 'Chandelles, un foyer, touches de rouge ou d\'orange, bon éclairage.' },
  { key: 'earth', glyph: '土', name: 'Terre', color: '#b07a3c', how: 'Pots en argile, pierre, tons beiges et bruns.' },
  { key: 'metal', glyph: '金', name: 'Métal', color: '#7f8a94', how: 'Cadres en métal, gris et blanc, formes rondes.' },
  { key: 'water', glyph: '水', name: 'Eau',   color: '#2c5f8a', how: 'Une petite fontaine, un miroir, touches de bleu ou de noir.' },
];

const bagua = [
  { name: 'Richesse', hint: 'Plantes, fontaine, violet et doré' },
  { name: 'Renommée et réputation', hint: 'Prix, diplômes, touches de rouge' },
  { name: 'Amour', hint: 'Objets par paires, rose, rouge, blanc' },
  { name: 'Famille et santé', hint: 'Photos de famille, plantes, vert' },
  { name: 'Centre', hint: 'Dégagé et en ordre' },
  { name: 'Enfants et créativité', hint: 'Œuvres d\'art, musique, pastels' },
  { name: 'Savoir', hint: 'Livres, bureau, bleu et vert' },
  { name: 'Carrière', hint: 'Élément d\'eau, noir, bleu foncé' },
  { name: 'Personnes aidantes', hint: 'Photos de voyage, blanc et gris' },
];

const hear = [
  { term: 'Les chiffres', meaning: 'En cantonais et en mandarin, le chiffre 4 se prononce comme le mot « mort », alors certains acheteurs l\'évitent. Le chiffre 8 se prononce comme « richesse » et il est très prisé. Beaucoup de tours de condos à Toronto sautent les étages qui contiennent un 4.' },
  { term: 'Les intersections en T', meaning: 'Une maison au bout d\'une intersection en T est souvent évitée. L\'énergie et la circulation foncent droit dessus. Il y a aussi un côté pratique : les phares, le bruit et le petit risque qu\'une voiture brûle l\'arrêt.' },
  { term: 'La pente', meaning: 'Un terrain plat signifie la stabilité. Une légère élévation derrière la maison est vue comme un bon appui. Les terrains en forte pente descendante sont moins recherchés.' },
  { term: 'Les bâtiments voisins', meaning: 'Certains acheteurs évitent les maisons situées juste à côté d\'un hôpital, d\'un salon funéraire ou d\'un cimetière.' },
  { term: 'Les angles vifs', meaning: 'Un toit voisin ou le coin d\'un bâtiment pointé droit vers votre porte d\'entrée s\'appelle une « flèche empoisonnée ». Une plante, une haie ou un paravent l\'adoucit.' },
];

const checklist = [
  'Dégager le chemin vers la porte d\'entrée',
  'Laver les fenêtres',
  'Vérifier la position du lit : voyez-vous la porte?',
  'Fermer les portes de salle de bain et baisser les couvercles de toilette',
  'Réparer tout robinet qui goutte',
  'Vérifier que tous les brûleurs de la cuisinière fonctionnent',
  'Retirer les plantes mortes',
  'Dégager le centre de la maison',
  'Vérifier où pointent les miroirs',
  'Déballer une boîte de plus',
];
---
<BaseLayout
  title={`${articleTitle} | Peter Law`}
  description={articleDescription}
  lang="fr"
  bodyClass="fr guide-page article-page"
  hreflangAlternates={hreflangAlternates}
>
  <TopBar />
  <Header active="blog" />

  <article>
    <section class="page-hero">
      <div class="wrap">
        <div class="eyebrow"><a href="/french/blog" class="back-link"><svg width="11" height="11" viewBox="0 0 14 14" fill="none" style="vertical-align:-1px;margin-right:5px;" aria-hidden="true"><path d="M13 7H1M6 12L1 7l5-5" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/></svg>Blogue</a> · Maison et vie</div>
        <h1>{articleTitle}</h1>
        <p class="article-lead">Le feng shui est une ancienne pratique chinoise pour rendre un chez-soi équilibré et apaisant. Pas besoin de croire à l'énergie pour l'utiliser.</p>
        <div class="article-byline">
          <span>Par <a href="/french/about">Peter Law</a></span>
          <span class="dot">·</span>
          <time datetime={publishedDate}>6 octobre 2026</time>
          <span class="dot">·</span>
          <span>7 min de lecture</span>
        </div>
      </div>
    </section>

    <section class="major" style="padding-top:32px;">
      <div class="wrap">
        <div class="prose-grid">
          <aside class="prose-side">
            <h2 class="side-h">Sur cette page</h2>
            <ul>
              <li><a href="#meaning">Ce que feng shui veut vraiment dire</a></li>
              <li><a href="#five-things">Si vous ne faites que cinq choses</a></li>
              <li><a href="#front-door">La porte d'entrée</a></li>
              <li><a href="#bedroom">La chambre</a></li>
              <li><a href="#kitchen">La cuisine</a></li>
              <li><a href="#bathroom">La salle de bain</a></li>
              <li><a href="#living-room">Le salon</a></li>
              <li><a href="#elements">Les cinq éléments</a></li>
              <li><a href="#bagua">La carte bagua</a></li>
              <li><a href="#hear">Ce que vous entendrez peut-être</a></li>
              <li><a href="#checklist">Votre première fin de semaine</a></li>
              <li><a href="#honest">Note honnête</a></li>
            </ul>
          </aside>

          <div class="prose-body">

            <p>À Toronto, beaucoup de gens suivent le feng shui. Beaucoup d'autres aiment simplement ses idées, parce qu'elles rendent une maison plus agréable à vivre. Ce guide vous accompagne une pièce à la fois.</p>

            <details class="b60-section-toggle" id="meaning">
              <summary class="b60-section-toggle-summary">Ce que feng shui veut vraiment dire</summary>
              <div class="b60-section-body">
                <p>Feng shui (<span lang="zh-Hans">风水</span>) signifie « vent et eau ».</p>
                <p>L'idée est simple. Une énergie, appelée <strong>chi</strong> ou <strong>qi</strong>, circule dans votre maison comme l'air ou l'eau. Vous voulez qu'elle circule en douceur. Pas bloquée. Pas trop vite non plus.</p>
                <p>C'est tout le concept. Tout ce guide en découle.</p>
              </div>
            </details>

            <!-- ============================================================
                 FIVE THINGS
                 ============================================================ -->
            <section class="fs-quick" id="five-things" aria-labelledby="fs-quick-h">
              <h2 class="fs-quick-h" id="fs-quick-h">Si vous ne faites que cinq choses</h2>
              <ol class="fs-habits">
                {quickWins.map((q, i) => (
                  <li>
                    <span class="fs-habit-num" aria-hidden="true">{i + 1}</span>
                    <div><strong>{q.title}</strong> {q.text}</div>
                  </li>
                ))}
              </ol>
            </section>

            <!-- ============================================================
                 FRONT DOOR
                 ============================================================ -->
            <h2 id="front-door">La porte d'entrée</h2>
            <p>La porte d'entrée est ce qui compte le plus. Le feng shui l'appelle la « bouche du chi ». C'est par là que l'énergie entre chez vous.</p>

            <div class="fs-dodont">
              <div class="fs-col fs-do">
                <h3 class="fs-col-h">À faire</h3>
                <ul>
                  <li>Gardez le chemin vers la porte dégagé. Taillez les arbustes et enlevez ce qui encombre.</li>
                  <li>Assurez-vous que la porte s'ouvre complètement, sans rien heurter.</li>
                  <li>Gardez-la propre. Réparez une charnière qui grince ou une poignée brisée.</li>
                  <li>Ajoutez un bon éclairage pour que l'entrée soit lumineuse le soir.</li>
                  <li>Placez une plante en santé ou des fleurs fraîches près de la porte.</li>
                </ul>
              </div>
              <div class="fs-col fs-dont">
                <h3 class="fs-col-h">À surveiller</h3>
                <ul>
                  <li><strong>Une porte d'entrée alignée avec la porte arrière.</strong> L'énergie entre et ressort aussitôt. Placez une plante, un paravent ou un tapis entre les deux pour la ralentir.</li>
                  <li><strong>Un miroir face à la porte d'entrée.</strong> Il renvoie l'énergie dehors. Accrochez-le plutôt sur un mur latéral.</li>
                  <li><strong>Une salle de bain juste en face de la porte d'entrée.</strong> Gardez cette porte fermée.</li>
                </ul>
              </div>
            </div>

            <div class="callout fs-tip"><strong>Vous habitez en condo?</strong> La porte de votre unité est votre porte d'entrée. Les mêmes règles s'appliquent. Vérifiez les règlements de votre condo avant de modifier quoi que ce soit à la porte elle-même, à votre balcon ou à une aire commune.</div>

            <!-- ============================================================
                 BEDROOM
                 ============================================================ -->
            <h2 id="bedroom">La chambre</h2>
            <p>C'est là que vous vous reposez. Elle doit sembler sûre et calme.</p>

            <div class="fs-dodont">
              <div class="fs-col fs-do">
                <h3 class="fs-col-h">Position du lit</h3>
                <ul>
                  <li>Vous devriez voir la porte de la chambre depuis votre lit.</li>
                  <li>N'alignez pas le lit directement avec la porte. Légèrement décalé, c'est mieux.</li>
                  <li>Placez la tête du lit contre un mur plein. Pas contre une fenêtre.</li>
                  <li>Utilisez une tête de lit solide. Le bois ou le métal conviennent bien.</li>
                  <li>Laissez de l'espace des deux côtés. Mettez une table de chevet de chaque côté.</li>
                  <li>Ne rangez rien sous le lit. L'énergie a besoin de circuler.</li>
                </ul>
              </div>
              <div class="fs-col fs-dont">
                <h3 class="fs-col-h">À éviter aussi</h3>
                <ul>
                  <li>Une œuvre lourde ou un grand cadre au-dessus de votre tête.</li>
                  <li>Un miroir qui fait directement face au lit.</li>
                  <li>Le travail dans la chambre, si possible. Pas de bureau, pas de dossiers.</li>
                </ul>
              </div>
            </div>

            <!-- ============================================================
                 KITCHEN
                 ============================================================ -->
            <h2 id="kitchen">La cuisine</h2>
            <p>La cuisine représente la santé et la richesse.</p>
            <ul class="bullets">
              <li><strong>Gardez la cuisinière propre et en bon état.</strong> Tous les brûleurs doivent s'allumer.</li>
              <li><strong>La personne qui cuisine ne doit pas tourner le dos à la pièce.</strong> Si la cuisinière fait face à un mur, accrochez un petit miroir ou un panneau métallique pour voir derrière vous.</li>
              <li><strong>Ne placez pas la cuisinière juste à côté de l'évier.</strong> Le feu et l'eau s'opposent. S'ils sont déjà côte à côte, mettez un objet en bois entre les deux, comme une planche à découper.</li>
              <li><strong>Gardez le frigo et le garde-manger bien garnis.</strong> Des tablettes vides évoquent le manque.</li>
              <li><strong>Réparez tout robinet qui goutte.</strong> En feng shui, l'eau qui goutte, c'est de l'argent qui fuit.</li>
            </ul>

            <!-- ============================================================
                 BATHROOM
                 ============================================================ -->
            <h2 id="bathroom">La salle de bain</h2>
            <p>Les salles de bain drainent l'énergie. C'est ainsi que le feng shui les voit. Deux gestes règlent presque tout.</p>

            <ol class="fs-steps">
              <li><span class="fs-step-num" aria-hidden="true">1</span><span>Gardez la porte de la salle de bain fermée.</span></li>
              <li><span class="fs-step-num" aria-hidden="true">2</span><span>Gardez le couvercle de la toilette baissé.</span></li>
            </ol>

            <p>Pour le reste, réparez les fuites et gardez la pièce propre et sèche. Ajoutez une plante s'il y a de la lumière.</p>

            <!-- ============================================================
                 LIVING ROOM
                 ============================================================ -->
            <h2 id="living-room">Le salon</h2>
            <p>C'est là que les gens se rassemblent.</p>
            <ul class="bullets">
              <li><strong>Disposez les sièges pour que les gens puissent se voir.</strong> Un cercle ou un carré fonctionne mieux qu'une rangée.</li>
              <li><strong>Personne ne devrait s'asseoir dos à la porte principale.</strong></li>
              <li><strong>Laissez des passages dégagés.</strong> Les gens ne devraient pas avoir à se faufiler entre les meubles.</li>
              <li><strong>Les tables rondes ou aux coins arrondis valent mieux</strong> que des angles vifs pointés vers les sièges.</li>
              <li><strong>Assurez-vous que la pièce est bien éclairée.</strong></li>
            </ul>

            <!-- ============================================================
                 FIVE ELEMENTS
                 ============================================================ -->
            <h2 id="elements">Les cinq éléments</h2>
            <p>Le feng shui utilise cinq éléments : <strong>le bois, le feu, la terre, le métal et l'eau</strong>. L'objectif est l'équilibre. Une pièce qui contient les cinq semble complète. Trop d'un seul, et quelque chose cloche.</p>

            <ul class="fs-elements" aria-label="Les cinq éléments et des façons simples de les ajouter">
              {elements.map((el) => (
                <li class="fs-el" style={`--el:${el.color}`}>
                  <div class="fs-el-top">
                    <span class="fs-el-glyph" lang="zh-Hans" aria-hidden="true">{el.glyph}</span>
                    <span class="fs-el-name">{el.name}</span>
                  </div>
                  <p>{el.how}</p>
                </li>
              ))}
            </ul>

            <p>Vous n'avez pas besoin des cinq dans chaque pièce. Regardez autour de vous et voyez ce qui manque. Si vous ne pouvez pas ajouter l'objet lui-même, une image fait l'affaire.</p>
            <div class="callout fs-tip"><strong>N'abusez pas d'un seul élément.</strong> Trop d'eau peut sembler lourd. Trop de feu peut sembler tendu. Trop de terre peut sembler pesant. L'équilibre, c'est tout l'enjeu.</div>

            <!-- ============================================================
                 BAGUA
                 ============================================================ -->
            <h2 id="bagua">La carte bagua</h2>
            <p>Le bagua est une carte énergétique. Vous la posez sur votre plan d'étage. Elle divise la maison en neuf zones, chacune liée à un aspect de la vie. Il en existe deux versions courantes.</p>
            <ul class="bullets">
              <li><strong>Bagua occidental (le plus simple).</strong> Alignez la grille sur le mur où se trouve votre porte d'entrée. Votre porte tombe dans l'une des trois cases du bas. C'est le choix habituel pour les condos et les appartements.</li>
              <li><strong>Bagua classique.</strong> Il repose sur une lecture à la boussole prise à la porte d'entrée. Il demande plus de pratique.</li>
            </ul>
            <p>Voici la grille occidentale, avec des façons simples de soutenir chaque zone.</p>

            <div class="fs-bagua-wrap">
              <ol class="fs-bagua" aria-label="Carte bagua occidentale, neuf zones">
                {bagua.map((cell, i) => (
                  <li class={`fs-bagua-cell${i === 4 ? ' fs-bagua-centre' : ''}`}>
                    <span class="fs-bagua-name">{cell.name}</span>
                    <span class="fs-bagua-hint">{cell.hint}</span>
                  </li>
                ))}
              </ol>
              <div class="fs-bagua-door"><svg width="14" height="14" viewBox="0 0 14 14" fill="none" aria-hidden="true"><path d="M7 1v12M2 8l5 5 5-5" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/></svg> Le mur de votre porte d'entrée</div>
            </div>

            <div class="callout fs-tip"><strong>Commencez petit.</strong> Choisissez une ou deux zones qui comptent pour vous en ce moment. Vous n'êtes pas obligé de faire les neuf.</div>

            <!-- ============================================================
                 THINGS YOU MAY HEAR
                 ============================================================ -->
            <h2 id="hear">Ce que vous entendrez peut-être</h2>
            <p>Certaines idées du feng shui reviennent quand les gens magasinent une propriété. Voici ce qu'elles veulent dire.</p>

            <div class="fs-table-wrap">
              <table class="fs-table">
                <thead>
                  <tr>
                    <th scope="col">Ce qu'on dit</th>
                    <th scope="col">Ce que ça veut dire</th>
                  </tr>
                </thead>
                <tbody>
                  {hear.map((row) => (
                    <tr>
                      <th scope="row">{row.term}</th>
                      <td>{row.meaning}</td>
                    </tr>
                  ))}
                </tbody>
              </table>
            </div>

            <div class="callout fs-tip"><strong>Si votre maison présente l'un de ces cas, pas de panique.</strong> Plusieurs peuvent être atténués par de simples changements. Et bien des acheteurs ne suivent pas le feng shui du tout.</div>

            <!-- ============================================================
                 CHECKLIST
                 ============================================================ -->
            <h2 id="checklist">Votre première fin de semaine</h2>
            <p>Dix choses à faire avant même d'avoir déballé les boîtes. Cochez-les au fur et à mesure.</p>
            <ul class="fs-checklist">
              {checklist.map((item, i) => (
                <li>
                  <input type="checkbox" id={`fs-check-${i + 1}`} />
                  <label for={`fs-check-${i + 1}`}>{item}</label>
                </li>
              ))}
            </ul>

            <!-- ============================================================
                 HONEST NOTE
                 ============================================================ -->
            <h2 id="honest">Note honnête :</h2>
            <div class="fs-honest">
              <p>Le feng shui est une tradition, pas une science. Rien ne prouve qu'il change votre chance, votre santé ou la valeur de votre propriété.</p>
              <p>Ce qu'il fait, c'est vous pousser vers un chez-soi propre, lumineux, dégagé et facile à traverser. Ça vaut la peine en soi.</p>
              <p><strong>Gardez ce qui a du sens pour vous. Laissez le reste.</strong></p>
            </div>

            <div class="fs-disclaimer">
              <h3>Avis de non-responsabilité</h3>
              <p>Je suis représentant commercial immobilier inscrit. Je ne suis ni praticien du feng shui, ni designer d'intérieur, ni entrepreneur, ni inspecteur en bâtiment.</p>
              <p>Ce guide est de l'information générale sur une tradition culturelle. Il ne constitue pas un avis sur la valeur, l'état ou la convenance d'une propriété, et il ne crée aucune relation client. Le feng shui est une pratique fondée sur des croyances. Rien ici ne prétend qu'il influence la valeur des propriétés, la revente, la santé ou les finances.</p>
              <p>Avant de modifier votre maison, consultez le bon professionnel : un entrepreneur pour tout ce qui est structurel, un inspecteur en bâtiment qualifié pour l'état des lieux, et un consultant en feng shui certifié si vous voulez une lecture complète de votre espace. Si vous habitez en condominium, vérifiez la déclaration, les règlements administratifs et les règles de votre association condominiale avant de modifier quoi que ce soit à votre porte, à votre balcon ou à toute partie commune.</p>
            </div>

            <div class="seo-tags" role="group" aria-label="Mots-clés">
              <h2 class="seo-tags-h">Mots-clés</h2>
              <ul>
                <li>Feng shui pour débutants</li>
                <li>Feng shui nouvelle maison</li>
                <li>Feng shui Toronto</li>
                <li>Porte d'entrée</li>
                <li>Position du lit</li>
                <li>Cuisinière et évier</li>
                <li>Cinq éléments</li>
                <li>Carte bagua</li>
                <li>Feng shui en condo</li>
                <li>Étages avec un 4</li>
                <li>Maison en intersection en T</li>
                <li>Flèche empoisonnée</li>
              </ul>
            </div>

          </div>
        </div>
      </div>
    </section>
  </article>

  <LCTA heading="Vous magasinez avec le feng shui en tête?" lead="Si un numéro d'étage, la configuration d'une rue ou l'alignement du lit et de la porte compte pour vous ou votre famille, dites-le-moi dès le départ. Je filtrerai les inscriptions en conséquence avant même de réserver une visite. Aucune pression, aucun argumentaire." />
  <Footer />

  <script type="application/ld+json" is:inline set:html={JSON.stringify(jsonLd)} />
</BaseLayout>

<style>
  /* Quick-start panel */
  .fs-quick { background: var(--surface); border: 1px solid var(--rule); border-left: 3px solid var(--accent); border-radius: 6px; padding: 18px 22px 6px; margin: 28px 0 8px; max-width: 760px; }
  .prose-body .fs-quick-h { font-family: 'Fraunces', 'Fraunces Fallback', Georgia, serif; font-weight: 500; font-size: 22px; margin: 0 0 4px; color: var(--ink); }
  .fs-quick .fs-habits { margin: 0; max-width: none; }
  .fs-quick .fs-habits li { padding: 12px 0; font-size: 15px; }
  .fs-quick .fs-habit-num { flex: 0 0 32px; font-size: 28px; }

  /* Do / Watch-out columns */
