---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import TopBar from '../../../components/FrenchTopBar.astro';
import Header from '../../../components/FrenchHeader.astro';
import Footer from '../../../components/FrenchFooter.astro';
import CTASection from '../../../components/FrenchCTASection.astro';

export const prerender = true;

const publishedDate = '2026-06-09';
const articleTitle = "2026 : interdiction d'achat pour non-Canadiens";
const articleDescription = "Un guide en français simple sur la Loi sur l'interdiction d'achat d'immeubles résidentiels par des non-Canadiens — qui est visé, quels immeubles sont couverts,…";
const articleUrl = 'https://www.realtorpeterlaw.com/french/blog/foreign-buyer-ban';
const enUrl = 'https://www.realtorpeterlaw.com/blog/foreign-buyer-ban';

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: articleTitle,
  description: articleDescription,
  author: { '@type': 'Person', name: 'Peter Law', url: 'https://www.realtorpeterlaw.com/french/about' },
  publisher: {
    '@type': 'Organization',
    name: 'Peter Law — Immobilier à Toronto',
    logo: { '@type': 'ImageObject', url: 'https://www.realtorpeterlaw.com/favicon.svg' },
  },
  inLanguage: 'fr-CA',
  datePublished: publishedDate,
  dateModified: publishedDate,
  mainEntityOfPage: { '@type': 'WebPage', '@id': articleUrl },
  keywords: "interdiction d'achat pour non-Canadiens, Loi sur l'interdiction d'achat d'immeubles résidentiels, interdiction acheteur étranger Toronto, prolongation 2026, permis de travail achat immobilier Canada, achat de condo non-Canadien, exceptions interdiction acheteur étranger, pénalité interdiction achat étranger, immobilier Toronto non-résident",
  translationOfWork: { '@type': 'Article', '@id': enUrl },
};

const hreflangAlternates = [
  { hreflang: 'en-CA', href: 'https://www.realtorpeterlaw.com/blog/foreign-buyer-ban/' },
  { hreflang: 'zh-CN', href: 'https://www.realtorpeterlaw.com/chinese/blog/foreign-buyer-ban/' },
  { hreflang: 'fr-CA', href: 'https://www.realtorpeterlaw.com/french/blog/foreign-buyer-ban/' },
  { hreflang: 'x-default', href: 'https://www.realtorpeterlaw.com/blog/foreign-buyer-ban/' },
];
---
<BaseLayout
  title={`${articleTitle} | Peter Law`}
  description={articleDescription}
  lang="fr"
  bodyClass="fr guide-page article-page"
  hreflangAlternates={hreflangAlternates}
>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  </Fragment>

  <TopBar />
  <Header active="blog" />

  <article>
    <section class="page-hero">
      <div class="wrap">
        <div class="eyebrow"><a href="/french/blog" class="back-link"><svg width="11" height="11" viewBox="0 0 14 14" fill="none" style="vertical-align:-1px;margin-right:5px;" aria-hidden="true"><path d="M13 7H1M6 12L1 7l5-5" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/></svg>Blogue</a> · Réglementation fédérale</div>
        <h1>{articleTitle}</h1>
        <p class="article-lead">L'interdiction canadienne d'achat pour non-Canadiens est en vigueur depuis le 1<sup>er</sup> janvier 2023 et reste en place jusqu'au 31 décembre 2026. Les règles sont plus étroites que le titre le laisse croire — et les exceptions comptent. Voici à qui l'interdiction s'applique réellement, quels immeubles sont couverts, et les exceptions qui permettent à plusieurs titulaires de permis de travail, réfugiés et conjoints de Canadiens d'acheter.</p>
        <div class="article-byline">
          <span>Par <a href="/french/about">Peter Law</a></span>
          <span class="dot">·</span>
          <time datetime={publishedDate}>9 juin 2026</time>
          <span class="dot">·</span>
          <span>9 min de lecture</span>
        </div>
      </div>
    </section>

    <section class="major" style="padding-top:32px;">
      <div class="wrap">
        <div class="prose-grid">
          <aside class="prose-side">
            <h4>Sur cette page</h4>
            <ul>
              <li><a href="#what">Ce que la loi interdit vraiment</a></li>
              <li><a href="#who">Qui compte comme « non-Canadien »</a></li>
              <li><a href="#what-property">Quels immeubles sont couverts</a></li>
              <li><a href="#exceptions">Les exceptions qui comptent</a></li>
              <li><a href="#work-permit">Titulaires de permis de travail</a></li>
              <li><a href="#penalties">Pénalités et conséquences</a></li>
              <li><a href="#sale-valid">La vente est-elle valide ?</a></li>
              <li><a href="#agents">Si vous êtes courtier ou avocat</a></li>
              <li><a href="#mistakes">Erreurs fréquentes</a></li>
            </ul>
          </aside>

          <div class="prose-body">
            <p><strong>Réponse rapide :</strong> la <em>Loi sur l'interdiction d'achat d'immeubles résidentiels par des non-Canadiens</em> interdit à la plupart des non-Canadiens d'acheter un immeuble résidentiel au Canada. Elle est entrée en vigueur le <strong>1<sup>er</sup> janvier 2023</strong>, était à l'origine une mesure de 2 ans, et a été prolongée par le gouvernement fédéral jusqu'au <strong>31 décembre 2026</strong>. L'interdiction est ciblée : elle vise les immeubles résidentiels de 3 unités de logement ou moins (maisons, jumelées, maisons en rangée, condos), et seulement à l'intérieur des régions métropolitaines de recensement (RMR) et des agglomérations de recensement (AR). Elle ne s'applique <em>pas</em> aux propriétés récréatives hors zones urbaines, aux terrains vacants zonés résidentiels, aux grands immeubles multirésidentiels, ni aux achats faits avec un conjoint canadien. Les titulaires de permis de travail avec au moins 183 jours restants sur leur permis peuvent acheter un immeuble résidentiel. L'amende pour infraction va jusqu'à <strong>10 000 $</strong> — et elle touche non seulement l'acheteur non-Canadien, mais aussi toute personne qui, en connaissance de cause, conseille, incite ou aide à l'achat.</p>

            <div class="callout"><strong>À qui s'adresse cet article :</strong> aux acheteurs, vendeurs et professionnels de l'immobilier de Toronto qui ont besoin d'un texte clair et pratique sur ce que l'interdiction fédérale couvre — et ne couvre pas. Si vous êtes résident temporaire envisageant un achat, un Canadien dont le conjoint n'est pas citoyen, ou un courtier qui représente un acheteur au statut incertain — commencez ici.</div>

            <details class="b60-section-toggle" id="what">
              <summary class="b60-section-toggle-summary">Ce que la loi interdit vraiment</summary>
              <div class="b60-section-body">
                <p>La <em>Loi sur l'interdiction d'achat d'immeubles résidentiels par des non-Canadiens</em> (Lois du Canada 2022, chapitre 10, article 235) est une loi fédérale qui interdit aux non-Canadiens d'acheter un immeuble résidentiel au Canada, directement ou indirectement. Elle a reçu la sanction royale le 23 juin 2022, est entrée en vigueur le 1<sup>er</sup> janvier 2023, et devait initialement expirer après deux ans. En février 2024, le gouvernement fédéral a prolongé l'interdiction de deux années supplémentaires — elle expire maintenant le <strong>1<sup>er</sup> janvier 2027</strong> (c'est-à-dire qu'elle couvre les achats jusqu'à la fin de 2026).</p>
                <p>Deux choses à comprendre dès le départ :</p>
                <ul class="bullets">
                  <li><strong>C'est une loi fédérale, pas une taxe.</strong> La Taxe de spéculation des non-résidents de l'Ontario (NRST, actuellement 25 %) est une mesure provinciale distincte qui touche un groupe plus large d'acheteurs et continue de s'appliquer parallèlement à l'interdiction fédérale. Les deux peuvent s'appliquer à la même transaction.</li>
                  <li><strong>La loi est courte ; ce sont les règlements qui font le gros du travail.</strong> La Loi elle-même n'a que huit articles. Les exceptions sur lesquelles la plupart des acheteurs s'appuient — pour les titulaires de permis de travail, les terrains vacants, les propriétés récréatives — se trouvent dans le <em>Règlement</em> pris par le gouverneur en conseil, y compris les modifications importantes de mars 2023 qui ont élargi plusieurs catégories.</li>
                </ul>
              </div>
            </details>

            <details class="b60-section-toggle" id="who">
              <summary class="b60-section-toggle-summary">Qui compte comme « non-Canadien »</summary>
              <div class="b60-section-body">
                <p>La Loi définit un non-Canadien de quatre façons. Vous êtes un non-Canadien si vous êtes :</p>
                <ul class="bullets">
                  <li><strong>Une personne qui n'est pas</strong> un citoyen canadien, une personne inscrite en vertu de la <em>Loi sur les Indiens</em>, ni un résident permanent du Canada.</li>
                  <li><strong>Une société constituée hors du Canada ou d'une province canadienne.</strong></li>
                  <li><strong>Une société canadienne à capital fermé</strong> (dont les actions ne sont pas cotées à une bourse canadienne désignée) qui est <em>contrôlée</em> par un particulier non-Canadien ou une société étrangère.</li>
                  <li><strong>Toute autre personne ou entité désignée par règlement.</strong></li>
                </ul>
                <p>Le mot clé ici est <strong>« contrôlée »</strong>. Le Règlement fixe le seuil à <strong>10 %</strong> — la détention directe ou indirecte de 10 % ou plus de la valeur des capitaux propres, ou des droits de vote, fait d'une société canadienne un « non-Canadien » au sens de la Loi. Ce seuil a été abaissé lors des modifications de mars 2023 et est nettement plus strict que la plupart des gens ne le pensent. Une société canadienne à numéro dont un seul actionnaire à 10 % est étranger est visée.</p>
                <p>Concrètement : les résidents permanents ne sont <strong>pas</strong> soumis à l'interdiction. Les citoyens non plus. Les personnes inscrites en vertu de la <em>Loi sur les Indiens</em> non plus. Toutes les autres personnes doivent entrer dans une des exceptions ci-dessous.</p>
              </div>
            </details>

            <details class="b60-section-toggle" id="what-property">
              <summary class="b60-section-toggle-summary">Quels immeubles sont couverts</summary>
              <div class="b60-section-body">
                <p>La notion d'« immeuble résidentiel » dans la Loi est plus étroite que la plupart des gens le pensent. Cela signifie un bien immeuble au Canada qui est :</p>
                <ul class="bullets">
                  <li><strong>Une maison isolée ou un bâtiment similaire contenant 3 unités de logement ou moins</strong> (avec le terrain raisonnablement nécessaire à son usage résidentiel) ; ou</li>
                  <li><strong>Une partie d'un bâtiment</strong> — jumelée, maison en rangée, unité de condominium résidentiel ou similaire — détenue ou destinée à être détenue séparément des autres unités.</li>
                </ul>
                <p>La maison isolée, la jumelée, la maison de ville ou l'unité de condo typique à Toronto est donc visée. Mais il y a deux exceptions importantes, géographiques et structurelles, dans le Règlement :</p>
                <div class="callout">
                  <strong>Non couverts (selon le Règlement) :</strong>
                  <ul class="bullets" style="margin-top:8px;margin-bottom:0;">
                    <li><strong>Les bâtiments de 4 unités de logement ou plus</strong> — l'interdiction cible le logement occupé par le propriétaire, pas les grands immeubles multirésidentiels.</li>
                    <li><strong>Les immeubles résidentiels hors d'une région métropolitaine de recensement (RMR) ou d'une agglomération de recensement (AR)</strong> — c'est-à-dire les chalets et propriétés récréatives en zones non urbaines. Statistique Canada définit les régions admissibles ; la majeure partie du « pays des chalets » se trouve hors des limites urbaines.</li>
                    <li><strong>Les terrains vacants zonés résidentiels ou à usage mixte</strong> — cette exemption a été ajoutée par les modifications du 27 mars 2023. Les non-Canadiens peuvent maintenant acheter des terrains vacants résidentiels ou à usage mixte, y compris pour y construire.</li>
                    <li><strong>Les achats aux fins de développement</strong> — également ajoutés en mars 2023 : les sociétés non-Canadiennes peuvent acquérir un immeuble résidentiel pour construire plus de logements.</li>
                  </ul>
                </div>
                <p>L'exception géographique est importante : la région du Grand Toronto est une seule grande RMR, donc presque tout achat résidentiel dans la région de Toronto est visé. Mais un non-Canadien qui achète un chalet au lac of Bays ou dans Muskoka, hors des limites d'une AR, ne l'est généralement pas.</p>
              </div>
            </details>

            <details class="b60-section-toggle" id="exceptions">
              <summary class="b60-section-toggle-summary">Les exceptions qui comptent</summary>
              <div class="b60-section-body">
                <p>Le paragraphe 4(2) de la Loi et le Règlement excluent ensemble plusieurs catégories d'acheteurs qui peuvent quand même acheter, même s'ils compteraient autrement comme non-Canadiens :</p>
                <ul class="bullets">
                  <li><strong>Les résidents temporaires ayant un statut valide</strong> qui remplissent les conditions du Règlement — surtout les titulaires de permis de travail (voir la section suivante).</li>
                  <li><strong>Les personnes protégées et réfugiés</strong> — toute personne à qui la protection ou le statut de personne protégée a été accordé en vertu de la <em>Loi sur l'immigration et la protection des réfugiés</em> peut acheter.</li>
                  <li><strong>Les non-Canadiens qui achètent avec un conjoint ou conjoint de fait admissible.</strong> Si un non-Canadien et son conjoint achètent ensemble un immeuble résidentiel, et que le conjoint est citoyen canadien, personne inscrite en vertu de la <em>Loi sur les Indiens</em>, résident permanent, ou résident temporaire admissible, l'achat est permis. La Loi définit le conjoint de fait comme ayant cohabité dans une relation conjugale pendant au moins un an.</li>
                  <li><strong>Les États étrangers achetant à des fins diplomatiques ou consulaires</strong> — ambassades, consulats, etc.</li>
                  <li><strong>Toute personne devenue liée par un contrat d'achat avant le 1<sup>er</sup> janvier 2023</strong> — les transactions existantes sont protégées par droits acquis.</li>
                </ul>
                <p>L'exception conjugale est la plus souvent mal comprise. Il ne suffit <em>pas</em> que l'acheteur non-Canadien soit marié à un Canadien ; les deux conjoints doivent être au titre. Un non-Canadien qui achète seul avec la bénédiction de son conjoint canadien — mais pas au titre — est toujours en infraction.</p>
              </div>
            </details>

            <details class="b60-section-toggle" id="work-permit">
              <summary class="b60-section-toggle-summary">Titulaires de permis de travail : la voie pratique</summary>
              <div class="b60-section-body">
                <p>C'est l'exception sur laquelle la plupart des acheteurs de Toronto s'appuient réellement. Depuis les modifications de mars 2023, le Règlement permet à un titulaire de permis de travail d'acheter un immeuble résidentiel s'il respecte un seul critère :</p>
                <div class="heloc-formula" aria-label="Exigence d'achat pour permis de travail">
                  <div class="heloc-formula-cell">
                    <div class="heloc-formula-label">Permis de travail valide</div>
                    <div class="heloc-formula-number">183+</div>
                    <div class="heloc-formula-sub">jours de validité restants à l'achat</div>
                  </div>
                  <div class="heloc-formula-op" aria-hidden="true">→</div>
                  <div class="heloc-formula-cell heloc-formula-result">
                    <div class="heloc-formula-label">Permis</div>
                    <div class="heloc-formula-number">1</div>
                    <div class="heloc-formula-sub">immeuble résidentiel</div>
                  </div>
                </div>
                <p><strong>Les points clés :</strong></p>
                <ul class="bullets">
                  <li>Le permis doit être un permis de travail ou une autorisation de travail délivré en vertu du <em>Règlement sur l'immigration et la protection des réfugiés</em>.</li>
                  <li>Il doit avoir <strong>183 jours ou plus</strong> de validité restants à la date d'achat — mesurée à la date de clôture, pas à la date de l'offre.</li>
                  <li>L'acheteur ne doit pas déjà posséder d'immeuble résidentiel au Canada.</li>
                  <li>C'est <strong>un seul immeuble par titulaire</strong>. Un deuxième achat est une infraction.</li>
                </ul>
                <p>La version antérieure de 2023 de cette règle exigeait des déclarations fiscales dans 3 des 4 années précédentes et un historique d'emploi canadien important — ces conditions ont été supprimées par les modifications du 27 mars 2023. Un acheteur qui suit de vieux conseils de janvier ou février 2023 peut croire qu'il n'est pas admissible alors qu'il l'est.</p>
                <p>Les titulaires de permis d'études ne sont <strong>généralement pas</strong> visés par cette exception depuis les modifications de mars 2023 — ils ont été retirés de la catégorie exemptée.</p>
              </div>
            </details>

            <h2 id="penalties">Pénalités et conséquences</h2>
            <p>Il y a deux conséquences distinctes en cas d'infraction — et la deuxième est celle que les acheteurs oublient souvent.</p>

            <details class="b60-section-toggle">
              <summary class="b60-section-toggle-summary">L'amende de 10 000 $</summary>
              <div class="b60-section-body">
                <p>L'article 6 de la Loi crée une infraction punissable sur déclaration sommaire de culpabilité. L'amende maximale est de <strong>10 000 $</strong>. Élément essentiel : l'infraction touche deux groupes :</p>
                <ul class="bullets">
                  <li><strong>L'acheteur non-Canadien</strong>, et</li>
                  <li><strong>Toute personne ou entité</strong> qui conseille, incite, aide ou encourage — ou tente de conseiller, inciter, aider ou encourager — un non-Canadien à acheter un immeuble résidentiel, <em>en sachant</em> que le non-Canadien est visé par l'interdiction.</li>
                </ul>
                <p>Ce deuxième groupe comprend les courtiers immobiliers, les avocats en droit immobilier, les courtiers hypothécaires, les prêteurs, les membres de la famille, et les dirigeants et administrateurs de sociétés. Le mot « en connaissance de cause » est la soupape de sécurité — un professionnel qui croyait raisonnablement que l'acheteur était admissible n'est pas visé — mais cela impose une véritable obligation de vérifier le statut avant d'agir.</p>
              </div>
            </details>

            <details class="b60-section-toggle">
              <summary class="b60-section-toggle-summary">Revente forcée par le tribunal, sans profit</summary>
              <div class="b60-section-body">
                <p>L'article 7 de la Loi est la conséquence la plus sérieuse. Si un non-Canadien est déclaré coupable d'avoir enfreint l'article 4, la cour supérieure de la province où se trouve l'immeuble peut — sur demande du ministre — ordonner la revente de l'immeuble. Le Règlement exige que l'ordonnance prévoie que <strong>le non-Canadien ne reçoit pas plus que le prix qu'il a payé à l'origine</strong>. Toute appréciation entre l'achat et la revente forcée revient à la Couronne, pas à l'acheteur.</p>
                <p>L'exposition réelle pour un non-Canadien qui achète un condo de 1,2 M$ à Toronto en infraction, le conserve pendant que la valeur monte, puis est forcé de le revendre à 1,4 M$ est donc : perdre les 200 000 $ d'appréciation, plus les frais juridiques, plus l'amende de 10 000 $. La logique financière est simple — il n'y a aucun avantage à prendre le risque.</p>
              </div>
            </details>

            <details class="b60-section-toggle" id="sale-valid">
              <summary class="b60-section-toggle-summary">La vente est-elle valide ?</summary>
              <div class="b60-section-body">
                <p>L'article 5 de la Loi est l'une de ses dispositions discrètes les plus importantes : une infraction à l'interdiction <strong>n'affecte pas la validité de la vente</strong>. La transaction elle-même n'est pas nulle. Le titre est transféré. Le vendeur garde l'argent. C'était un choix de conception délibéré — l'objectif est de dissuader les acheteurs non-Canadiens et de punir la chaîne autour d'eux, pas de mettre les vendeurs à risque de voir une transaction close annulée.</p>
                <p>Pour les vendeurs et les courtiers inscripteurs, c'est le message pratique : si votre acheteur se révèle en infraction, la vente tient et vous gardez le produit. Le risque juridique est du côté de l'acheteur et de tout conseiller qui a facilité l'achat en connaissance de cause.</p>
              </div>
            </details>

            <details class="b60-section-toggle" id="agents">
              <summary class="b60-section-toggle-summary">Si vous êtes courtier ou avocat</summary>
              <div class="b60-section-body">
                <p>Les mots « conseille, incite, aide ou encourage » de l'article 6 sont larges. Voici mes garde-fous pratiques sur chaque transaction :</p>
                <ul class="bullets">
                  <li><strong>Posez la question de statut à l'accueil, pas à l'offre.</strong> Vérifier la citoyenneté, le statut de RP ou les détails du permis de travail avant d'avoir bâti un dossier vous donne le temps de planifier ; le faire la veille de la signature force les raccourcis.</li>
                  <li><strong>Pour les résidents temporaires, demandez le document réel.</strong> Pas une capture d'écran d'il y a des mois. La fenêtre de 183 jours est mesurée à la clôture — vérifiez donc l'expiration par rapport à la date de clôture projetée, pas à aujourd'hui.</li>
                  <li><strong>Si les deux conjoints doivent être au titre, mettez-le dans l'offre.</strong> Ajouter un conjoint canadien au titre en amendement de dernière minute une semaine avant la clôture est fragile. Intégrez-le à l'offre.</li>
                  <li><strong>Utilisez l'entente de représentation pour documenter ce que l'acheteur vous a dit.</strong> Si un acheteur ment sur son statut, l'exception « en connaissance de cause » de l'article 6 ne vous protège que si votre enquête de bonne foi est au dossier.</li>
                  <li><strong>Parlez à l'avocat avant la date de l'offre.</strong> Les avocats en droit immobilier de Toronto sont la deuxième ligne de défense sur ce sujet ; ils vérifient le statut dans le cadre du dossier de clôture. Les impliquer tôt sur les dossiers limites fait économiser argent et stress.</li>
                </ul>
              </div>
            </details>

            <details class="b60-section-toggle" id="mistakes">
              <summary class="b60-section-toggle-summary">Erreurs fréquentes en 2026</summary>
              <div class="b60-section-body">
                <ul class="bullets">
                  <li><strong>« Les résidents permanents sont visés par l'interdiction. »</strong> Non. Les RP peuvent acheter normalement.</li>
                  <li><strong>« Mon conjoint est citoyen, donc je suis correct. »</strong> Seulement si vous êtes tous les deux au titre. Le mariage seul ne satisfait pas au paragraphe 4(2)c).</li>
                  <li><strong>« Mon permis de travail a 4 mois restants, je vais fermer avant l'expiration. »</strong> Le critère est <strong>183 jours restants à la clôture</strong>, pas « encore valide ». Quatre mois sont bien en dessous du seuil.</li>
                  <li><strong>« C'est une société que je détiens à travers une société de portefeuille canadienne, c'est donc un acheteur canadien. »</strong> Si la détention non-Canadienne de la société de portefeuille atteint 10 % — directement ou indirectement — l'acheteur corporatif est un non-Canadien au sens de la Loi.</li>
                  <li><strong>« L'interdiction a expiré à la fin de 2024. »</strong> Elle a été prolongée en février 2024 jusqu'au 31 décembre 2026. Toute personne qui se fie à de vieux conseils va avoir une surprise.</li>
                  <li><strong>« Ça vaut le risque — au pire, ils me mettront 10 000 $ d'amende. »</strong> Faux. L'amende de 10 000 $ est le chiffre visible ; la vraie exposition est la revente forcée sans profit, avec appréciation confisquée.</li>
                  <li><strong>« Une propriété récréative au nord compte. »</strong> Généralement pas, si elle est hors d'une RMR ou d'une AR. Vérifiez la limite de Statistique Canada avant de présumer.</li>
                </ul>
              </div>
            </details>

            <h2>En bref</h2>
            <p>Le titre — « interdiction d'achat pour non-Canadiens » — est trompeur. C'est une interdiction fédérale ciblée avec des exceptions importantes pour les titulaires de permis de travail, les réfugiés, les conjoints de Canadiens, les propriétés récréatives, les terrains vacants et les immeubles multirésidentiels. La plupart des acheteurs pris au dépourvu ne le sont pas parce que la règle est injuste, mais parce qu'ils n'ont pas vérifié le statut correctement à l'accueil ou n'ont pas lu les modifications de mars 2023. Si vous êtes un acheteur torontois dont le statut est autre que « citoyen canadien » ou « résident permanent », le travail se fait au début de la transaction — rassembler les documents, confirmer les jours restants, structurer le titre — pas à la table de clôture.</p>
            <p>Si vous ne savez pas où vous vous situez, demandez. <a href="/french/contact">Envoyez-moi une note rapide</a> avec votre situation et je vous dirai s'il faut impliquer un avocat, ou si la voie est simple.</p>

            <p class="article-source"><strong>Source principale :</strong> ministère de la Justice du Canada — <a href="https://laws-lois.justice.gc.ca/fra/lois/P-25.2/page-1.html" target="_blank" rel="noopener noreferrer"><em>Loi sur l'interdiction d'achat d'immeubles résidentiels par des non-Canadiens</em></a> (L.C. 2022, ch. 10, art. 235), et le <em>Règlement sur l'interdiction d'achat d'immeubles résidentiels par des non-Canadiens</em> associé. La prolongation de la date d'expiration a été annoncée par le ministère des Finances en février 2024.</p>
            <p class="article-disclaimer"><em>Cet article est à titre d'information générale et ne constitue pas un avis juridique. La Loi, le Règlement et les modifications sont techniques ; le statut d'un acheteur admissible devrait toujours être confirmé par un avocat en droit immobilier avant la clôture.</em></p>

