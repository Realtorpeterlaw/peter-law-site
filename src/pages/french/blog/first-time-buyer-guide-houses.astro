---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import TopBar from '../../../components/FrenchTopBar.astro';
import Header from '../../../components/FrenchHeader.astro';
import Footer from '../../../components/FrenchFooter.astro';
import LCTA from '../../../components/FrenchCTASection.astro';

export const prerender = true;

const publishedDate = '2026-09-08';
const articleTitle = "Guide de l'acheteur d'une PREMIÈRE MAISON (Ontario)";
const articleDescription = "Tous les types de maisons en Ontario, ce qu'il faut vérifier avant d'acheter, les programmes gouvernementaux cumulables, et les frais de clôture que les premiers acheteurs oublient. Avec des graphiques visuels, des calculatrices et une liste de vérification complète avant la clôture.";
const articleUrl = 'https://www.realtorpeterlaw.com/french/blog/first-time-buyer-guide-houses';
const enUrl = 'https://www.realtorpeterlaw.com/blog/first-time-buyer-guide-houses';

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: articleTitle,
  description: articleDescription,
  author: { '@type': 'Person', name: 'Peter Law', url: 'https://www.realtorpeterlaw.com/french/about' },
  publisher: {
    '@type': 'Organization',
    name: 'Peter Law — Immobilier à Toronto',
    logo: { '@type': 'ImageObject', url: 'https://www.realtorpeterlaw.com/favicon.svg' },
  },
  inLanguage: 'fr-CA',
  datePublished: publishedDate,
  dateModified: publishedDate,
  url: articleUrl,
  mainEntityOfPage: { '@type': 'WebPage', '@id': articleUrl },
  keywords: "premier acheteur maison Ontario, guide acheteur maison Toronto, types de maisons Ontario, détachée vs semi-détachée, maison en rangée en propriété franche, link home, bungalow, maison centenaire Ontario, maison rurale puits fosse septique, chalet bord de l'eau Ontario, CELIAPP RAP crédit premier acheteur, droits de mutation immobilière Toronto, remise TVH construction neuve Ontario, inspection de maison, frais de clôture premier acheteur",
  translationOfWork: { '@type': 'Article', '@id': enUrl },
};

const hreflangAlternates = [
  { hreflang: 'en-CA', href: 'https://www.realtorpeterlaw.com/blog/first-time-buyer-guide-houses/' },
  { hreflang: 'zh-CN', href: 'https://www.realtorpeterlaw.com/chinese/blog/first-time-buyer-guide-houses/' },
  { hreflang: 'fr-CA', href: 'https://www.realtorpeterlaw.com/french/blog/first-time-buyer-guide-houses/' },
  { hreflang: 'x-default', href: 'https://www.realtorpeterlaw.com/blog/first-time-buyer-guide-houses/' },
];

// House-type icons (small silhouettes)
const houseIcons = {
  detached: `<svg viewBox="0 0 80 80" xmlns="http://www.w3.org/2000/svg" aria-hidden="true"><rect x="18" y="36" width="44" height="30" fill="var(--bg-warm)" stroke="currentColor" stroke-width="2"/><path d="M12 40 L40 18 L68 40 Z" fill="var(--bg-warm)" stroke="currentColor" stroke-width="2" stroke-linejoin="round"/><rect x="34" y="48" width="12" height="18" fill="none" stroke="currentColor" stroke-width="1.5"/><rect x="24" y="46" width="6" height="6" fill="none" stroke="currentColor" stroke-width="1"/><rect x="50" y="46" width="6" height="6" fill="none" stroke="currentColor" stroke-width="1"/></svg>`,
  semi: `<svg viewBox="0 0 80 80" xmlns="http://www.w3.org/2000/svg" aria-hidden="true"><rect x="10" y="38" width="30" height="28" fill="var(--bg-warm)" stroke="currentColor" stroke-width="2"/><rect x="40" y="38" width="30" height="28" fill="var(--bg-warm)" stroke="currentColor" stroke-width="2"/><path d="M6 42 L25 24 L44 42 Z" fill="var(--bg-warm)" stroke="currentColor" stroke-width="2" stroke-linejoin="round"/><path d="M36 42 L55 24 L74 42 Z" fill="var(--bg-warm)" stroke="currentColor" stroke-width="2" stroke-linejoin="round"/><rect x="18" y="48" width="6" height="14" fill="none" stroke="currentColor" stroke-width="1.4"/><rect x="48" y="48" width="6" height="14" fill="none" stroke="currentColor" stroke-width="1.4"/><line x1="40" y1="38" x2="40" y2="66" stroke="currentColor" stroke-width="2"/></svg>`,
  town: `<svg viewBox="0 0 80 80" xmlns="http://www.w3.org/2000/svg" aria-hidden="true"><rect x="8" y="34" width="20" height="32" fill="var(--bg-warm)" stroke="currentColor" stroke-width="1.8"/><rect x="28" y="34" width="20" height="32" fill="var(--bg-warm)" stroke="currentColor" stroke-width="1.8"/><rect x="48" y="34" width="20" height="32" fill="var(--bg-warm)" stroke="currentColor" stroke-width="1.8"/><path d="M8 34 L18 22 L28 34" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round"/><path d="M28 34 L38 22 L48 34" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round"/><path d="M48 34 L58 22 L68 34" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round"/><rect x="14" y="48" width="6" height="12" fill="none" stroke="currentColor" stroke-width="1.4"/><rect x="34" y="48" width="6" height="12" fill="none" stroke="currentColor" stroke-width="1.4"/><rect x="54" y="48" width="6" height="12" fill="none" stroke="currentColor" stroke-width="1.4"/></svg>`,
  bungalow: `<svg viewBox="0 0 80 80" xmlns="http://www.w3.org/2000/svg" aria-hidden="true"><rect x="14" y="42" width="52" height="24" fill="var(--bg-warm)" stroke="currentColor" stroke-width="2"/><path d="M8 46 L40 22 L72 46 Z" fill="var(--bg-warm)" stroke="currentColor" stroke-width="2" stroke-linejoin="round"/><rect x="34" y="50" width="12" height="16" fill="none" stroke="currentColor" stroke-width="1.5"/><rect x="20" y="50" width="8" height="8" fill="none" stroke="currentColor" stroke-width="1.3"/><rect x="52" y="50" width="8" height="8" fill="none" stroke="currentColor" stroke-width="1.3"/></svg>`,
  century: `<svg viewBox="0 0 80 80" xmlns="http://www.w3.org/2000/svg" aria-hidden="true"><rect x="20" y="30" width="40" height="36" fill="var(--bg-warm)" stroke="currentColor" stroke-width="2"/><path d="M14 34 L40 14 L66 34 Z" fill="var(--bg-warm)" stroke="currentColor" stroke-width="2" stroke-linejoin="round"/><rect x="28" y="26" width="24" height="12" fill="var(--bg-warm)" stroke="currentColor" stroke-width="1.5"/><rect x="33" y="30" width="6" height="6" fill="none" stroke="currentColor" stroke-width="1"/><rect x="41" y="30" width="6" height="6" fill="none" stroke="currentColor" stroke-width="1"/><path d="M35 40 Q40 36 45 40 L45 52 L35 52 Z" fill="none" stroke="currentColor" stroke-width="1.4"/><rect x="24" y="40" width="6" height="8" fill="none" stroke="currentColor" stroke-width="1.2"/><rect x="50" y="40" width="6" height="8" fill="none" stroke="currentColor" stroke-width="1.2"/></svg>`,
  multi: `<svg viewBox="0 0 80 80" xmlns="http://www.w3.org/2000/svg" aria-hidden="true"><rect x="18" y="18" width="44" height="48" fill="var(--bg-warm)" stroke="currentColor" stroke-width="2"/><line x1="18" y1="34" x2="62" y2="34" stroke="currentColor" stroke-width="1.6"/><line x1="18" y1="50" x2="62" y2="50" stroke="currentColor" stroke-width="1.6"/><rect x="24" y="22" width="7" height="8" fill="none" stroke="currentColor" stroke-width="1.2"/><rect x="49" y="22" width="7" height="8" fill="none" stroke="currentColor" stroke-width="1.2"/><rect x="24" y="38" width="7" height="8" fill="none" stroke="currentColor" stroke-width="1.2"/><rect x="49" y="38" width="7" height="8" fill="none" stroke="currentColor" stroke-width="1.2"/><rect x="34" y="54" width="12" height="12" fill="none" stroke="currentColor" stroke-width="1.5"/></svg>`,
  rural: `<svg viewBox="0 0 80 80" xmlns="http://www.w3.org/2000/svg" aria-hidden="true"><rect x="22" y="38" width="36" height="28" fill="var(--bg-warm)" stroke="currentColor" stroke-width="2"/><path d="M16 42 L40 22 L64 42 Z" fill="var(--bg-warm)" stroke="currentColor" stroke-width="2" stroke-linejoin="round"/><rect x="36" y="48" width="10" height="18" fill="none" stroke="currentColor" stroke-width="1.4"/><path d="M4 66 Q20 60 40 62 T76 66" stroke="currentColor" stroke-width="1.4" fill="none"/><circle cx="10" cy="30" r="3" fill="currentColor" opacity="0.5"/><circle cx="72" cy="26" r="4" fill="currentColor" opacity="0.5"/><path d="M4 66 L 76 66" stroke="currentColor" stroke-width="0.8" opacity="0.5"/></svg>`,
  cottage: `<svg viewBox="0 0 80 80" xmlns="http://www.w3.org/2000/svg" aria-hidden="true"><path d="M14 44 L40 22 L66 44 L66 60 L14 60 Z" fill="var(--bg-warm)" stroke="currentColor" stroke-width="2" stroke-linejoin="round"/><rect x="34" y="46" width="12" height="14" fill="none" stroke="currentColor" stroke-width="1.4"/><path d="M4 66 Q15 62 25 66 T45 66 T65 66 T80 66" stroke="currentColor" stroke-width="1.6" fill="none"/><path d="M4 70 Q15 66 25 70 T45 70 T65 70 T80 70" stroke="currentColor" stroke-width="1.2" fill="none" opacity="0.6"/></svg>`,
  luxury: `<svg viewBox="0 0 80 80" xmlns="http://www.w3.org/2000/svg" aria-hidden="true"><rect x="10" y="34" width="60" height="32" fill="var(--bg-warm)" stroke="currentColor" stroke-width="2"/><path d="M6 38 L20 22 L34 38 Z" fill="var(--bg-warm)" stroke="currentColor" stroke-width="2" stroke-linejoin="round"/><path d="M46 38 L60 22 L74 38 Z" fill="var(--bg-warm)" stroke="currentColor" stroke-width="2" stroke-linejoin="round"/><rect x="34" y="46" width="12" height="20" fill="none" stroke="currentColor" stroke-width="1.4"/><rect x="15" y="44" width="8" height="10" fill="none" stroke="currentColor" stroke-width="1.2"/><rect x="57" y="44" width="8" height="10" fill="none" stroke="currentColor" stroke-width="1.2"/><path d="M20 22 L20 15 L23 18" fill="none" stroke="currentColor" stroke-width="1.4"/></svg>`,
  new: `<svg viewBox="0 0 80 80" xmlns="http://www.w3.org/2000/svg" aria-hidden="true"><rect x="18" y="36" width="44" height="30" fill="var(--bg-warm)" stroke="currentColor" stroke-width="2"/><path d="M12 40 L40 18 L68 40 Z" fill="var(--bg-warm)" stroke="currentColor" stroke-width="2" stroke-linejoin="round"/><rect x="30" y="44" width="20" height="22" fill="none" stroke="currentColor" stroke-width="1.4" stroke-dasharray="3,3"/><path d="M52 20 L54 26 L60 28 L54 30 L52 36 L50 30 L44 28 L50 26 Z" fill="currentColor" opacity="0.7"/></svg>`,
};
---
<BaseLayout
  title={`${articleTitle} | Peter Law`}
  description={articleDescription}
  lang="fr"
  bodyClass="fr guide-page article-page"
  hreflangAlternates={hreflangAlternates}
>
  <TopBar />
  <Header active="blog" />

  <article>
    <section class="page-hero">
      <div class="wrap">
        <div class="eyebrow"><a href="/french/blog" class="back-link"><svg width="11" height="11" viewBox="0 0 14 14" fill="none" style="vertical-align:-1px;margin-right:5px;" aria-hidden="true"><path d="M13 7H1M6 12L1 7l5-5" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/></svg>Blogue</a> · Guide acheteur · Maisons</div>
        <h1>{articleTitle}</h1>
        <p class="article-lead">Tous les types de maisons en Ontario, et ce qu'il faut vérifier avant d'en acheter une. Quand vous achetez une maison, vous êtes propriétaire du bâtiment <em>et</em> du terrain sur lequel il repose. Personne ne répare votre toit. Personne ne déneige votre entrée. Personne ne vous avertit que la fournaise a 22 ans. Cette liberté, c'est tout l'attrait. C'est aussi tout le risque.</p>
        <div class="article-byline">
          <span>Par <a href="/french/about">Peter Law</a></span>
          <span class="dot">·</span>
          <time datetime={publishedDate}>8 septembre 2026</time>
          <span class="dot">·</span>
          <span>15 min de lecture</span>
        </div>
      </div>
    </section>

    <!-- ====== QUICK STAT CARDS ====== -->
    <section class="fh-stats-wrap">
      <div class="wrap">
        <div class="fh-stats-grid">
          <div class="fh-stat"><div class="fh-stat-num">5–20%</div><div class="fh-stat-label">Fourchette de mise de fonds</div><div class="fh-stat-sub">selon le prix d'achat</div></div>
          <div class="fh-stat"><div class="fh-stat-num">40K$</div><div class="fh-stat-label">Plafond à vie du CELIAPP</div><div class="fh-stat-sub">8K$ par année, déductible d'impôt</div></div>
          <div class="fh-stat"><div class="fh-stat-num">8 475 $</div><div class="fh-stat-label">Remise des droits de mutation</div><div class="fh-stat-sub">Premier acheteur Toronto (ON + Toronto)</div></div>
          <div class="fh-stat"><div class="fh-stat-num">1–1,5%</div><div class="fh-stat-label">Entretien annuel</div><div class="fh-stat-sub">de la valeur de la maison, par année</div></div>
        </div>
      </div>
    </section>

    <section class="major" style="padding-top:32px;">
      <div class="wrap">
        <div class="prose-grid">
          <aside class="prose-side">
            <h4>Sur cette page</h4>
            <ul>
              <li><a href="#types">Types de maisons en Ontario</a></li>
              <li><a href="#afford">Ce que vous pouvez vous permettre</a></li>
              <li><a href="#programs">Programmes gouvernementaux</a></li>
              <li><a href="#check">Quoi vérifier dans n'importe quelle maison</a></li>
              <li><a href="#rural">Rural, chalet &amp; ferme</a></li>
              <li><a href="#offer">L'offre &amp; l'inspection</a></li>
              <li><a href="#closing">Frais de clôture</a></li>
              <li><a href="#before-after">Avant &amp; après la clôture</a></li>
              <li><a href="#mistakes">10 erreurs fréquentes</a></li>
              <li><a href="#checklist">La liste de vérification complète</a></li>
            </ul>
          </aside>

          <div class="prose-body">

            <!-- ============================================================
                 PART 1 — TYPES OF HOUSES
                 ============================================================ -->
            <h2 id="types">Partie 1 · Types de maisons en Ontario</h2>
            <p>Toutes les « maisons » ne sont pas le même produit. Deux bâtiments identiques vus de la rue peuvent avoir une propriété, des coûts mensuels et un risque de revente complètement différents. Voici chaque type que vous allez rencontrer.</p>

            <div class="fh-house-grid">
              <div class="fh-house-card">
                <div class="fh-house-icon" set:html={houseIcons.detached} />
                <div class="fh-house-title">Détachée</div>
                <p>Autonome sur son propre terrain. Aucun mur mitoyen. Le plus d'intimité, le plus de contrôle, le prix le plus élevé, le plus d'entretien.</p>
              </div>
              <div class="fh-house-card">
                <div class="fh-house-icon" set:html={houseIcons.semi} />
                <div class="fh-house-title">Semi-détachée</div>
                <p>Deux maisons reliées par un mur mitoyen. Habituellement 10 à 20 % moins chère qu'une détachée comparable. Renseignez-vous sur le toit, les avant-toits ou l'entrée partagés.</p>
              </div>
              <div class="fh-house-card">
                <div class="fh-house-icon" set:html={houseIcons.detached} />
                <div class="fh-house-title">Maison « link »</div>
                <p>Semble détachée depuis la rue, mais les fondations (ou les garages) sont reliées sous le sol. Moins chère qu'une vraie détachée — <strong>vérifiez toujours le certificat de localisation</strong>.</p>
              </div>
              <div class="fh-house-card">
                <div class="fh-house-icon" set:html={houseIcons.town} />
                <div class="fh-house-title">Maison en rangée</div>
                <p>Trois formules : <strong>propriété franche</strong> (terrain à vous, aucuns frais), <strong>copropriété</strong> (frais, entretien par le syndicat), ou <strong>éléments communs / POTL</strong> (terrain à vous, petits frais pour les routes partagées). Renseignez-vous sur laquelle s'applique.</p>
              </div>
              <div class="fh-house-card">
                <div class="fh-house-icon" set:html={houseIcons.bungalow} />
                <div class="fh-house-title">Bungalow &amp; bungalow surélevé</div>
                <p>Tout sur un seul niveau. Les versions surélevées ont un sous-sol partiellement hors sol — plus facile pour un appartement au sous-sol légal.</p>
              </div>
              <div class="fh-house-card">
                <div class="fh-house-icon" set:html={houseIcons.century} />
                <div class="fh-house-title">Maison centenaire</div>
                <p>100 ans ou plus. Du caractère et un savoir-faire artisanal, mais prévoyez un budget pour le câblage, la plomberie et l'isolation vieillissants, et la possibilité d'amiante ou de plomb. L'assurance peut être plus difficile à obtenir.</p>
              </div>
              <div class="fh-house-card">
                <div class="fh-house-icon" set:html={houseIcons.multi} />
                <div class="fh-house-title">Duplex / triplex / quadruplex</div>
                <p>Habitez l'un, louez les autres. Est-ce légalement un duplex, ou simplement une maison avec une deuxième cuisine ? Les locataires (et leurs loyers) sont transférés avec la propriété.</p>
              </div>
              <div class="fh-house-card">
                <div class="fh-house-icon" set:html={houseIcons.rural} />
                <div class="fh-house-title">Rural / grand terrain</div>
                <p>Puits privé, fosse septique privée, souvent chauffage au propane ou au mazout. Les problèmes souterrains dominent. Voir la partie 5.</p>
              </div>
              <div class="fh-house-card">
                <div class="fh-house-icon" set:html={houseIcons.cottage} />
                <div class="fh-house-title">Chalet / bord de l'eau</div>
                <p>Règles supplémentaires de l'office de protection de la nature. Attention à la réserve de chemin de rive, à l'accès par voie d'eau seulement, et à la saisonnalité.</p>
              </div>
              <div class="fh-house-card">
                <div class="fh-house-icon" set:html={houseIcons.luxury} />
                <div class="fh-house-title">Propriété d'exception / luxe</div>
                <p>Plus de 1,5 M$ = 20 % de mise de fonds obligatoire, aucune assurance SCHL. Les droits de mutation municipaux de Toronto bondissent à 3 M$. Les évaluations deviennent plus difficiles.</p>
              </div>
              <div class="fh-house-card">
                <div class="fh-house-icon" set:html={houseIcons.new} />
                <div class="fh-house-title">Construction neuve (propriété franche)</div>
                <p><strong>Aucune période de réflexion</strong> sur le préconstruit en propriété franche. La garantie Tarion s'applique. Plafonnez les redevances d'aménagement avant de signer.</p>
              </div>
            </div>

            <details class="b60-section-toggle">
              <summary class="b60-section-toggle-summary">Autres formats : jumelé arrière, superposée, split latéral/arrière, modulaire, mobile, logement accessoire</summary>
              <div class="b60-section-body">
                <ul class="bullets">
                  <li><strong>Maison en rangée jumelée arrière :</strong> partage les murs latéraux ET le mur arrière. Pas de cour arrière. La moins chère, la plus difficile à revendre.</li>
                  <li><strong>Maison en rangée superposée :</strong> unités empilées les unes sur les autres avec des entrées séparées. Presque toujours en copropriété. Beaucoup d'escaliers.</li>
                  <li><strong>1,5 étage :</strong> un étage et demi avec des plafonds en pente à l'étage. Charmant, mais souvent des problèmes d'isolation et de hauteur libre.</li>
                  <li><strong>Deux étages :</strong> la maison familiale standard. Chambres à l'étage, aires de vie au rez-de-chaussée.</li>
                  <li><strong>Split latéral / arrière :</strong> plusieurs niveaux décalés par demi-volées d'escalier. Courant dans l'Ontario des années 1950 à 1970. Bonne séparation des espaces, des escaliers partout.</li>
                  <li><strong>Modulaire / préfabriqué :</strong> construit en usine et assemblé sur place. Sur une fondation permanente, traité comme n'importe quelle autre maison.</li>
                  <li><strong>Mobile / modèle de parc :</strong> souvent sur un terrain loué. Le financement est difficile. Comprenez exactement ce que vous possédez par rapport à ce que vous louez.</li>
                  <li><strong>Studio de jardin / maison de ruelle / logement accessoire (ADU) :</strong> l'Ontario a élargi ce qui est permis, mais les règles varient selon la ville. <strong>Obtenez une confirmation écrite de la municipalité</strong> avant d'acheter en vous basant sur cette hypothèse.</li>
                  <li><strong>Ferme d'agrément vs ferme active :</strong> les fermes d'agrément sont évaluées comme des maisons avec terrain. Les fermes actives impliquent le zonage, le drainage souterrain, les baux de locataires, et nécessitent souvent des prêteurs agricoles.</li>
                </ul>
              </div>
            </details>

            <!-- ============================================================
                 PART 2 — AFFORDABILITY
                 ============================================================ -->
            <h2 id="afford" style="margin-top:48px;">Partie 2 · Ce que vous pouvez vous permettre</h2>

            <div class="fh-formula" aria-label="Formule du test de résistance">
              <div class="fh-formula-cell">
                <div class="fh-formula-label">Taux contractuel</div>
                <div class="fh-formula-value">4,5%</div>
                <div class="fh-formula-sub">exemple</div>
              </div>
              <div class="fh-formula-op">+</div>
              <div class="fh-formula-cell">
                <div class="fh-formula-label">Marge de test de résistance</div>
                <div class="fh-formula-value">2%</div>
              </div>
              <div class="fh-formula-op">=</div>
              <div class="fh-formula-cell">
                <div class="fh-formula-label">Ou plancher</div>
                <div class="fh-formula-value">5,25%</div>
              </div>
              <div class="fh-formula-op">→</div>
              <div class="fh-formula-cell fh-formula-result">
                <div class="fh-formula-label">Admissibilité au taux le PLUS ÉLEVÉ des deux</div>
                <div class="fh-formula-value">6,5%</div>
              </div>
            </div>

            <h3 style="margin-top:26px;">Les ratios d'endettement</h3>
            <p>Deux chiffres qui importent à votre prêteur :</p>
            <ul class="bullets">
              <li><strong>ABD (Amortissement brut de la dette) :</strong> coûts de logement sous environ <strong>39 %</strong> du revenu brut.</li>
              <li><strong>ATD (Amortissement total de la dette) :</strong> toutes les dettes sous environ <strong>44 %</strong>.</li>
            </ul>
            <div class="callout"><strong>Vrai levier :</strong> rembourser un prêt auto ou une carte de crédit avant de faire une demande peut augmenter votre admissibilité plus qu'épargner 10 000 $ de plus pour la mise de fonds.</div>

            <h3 style="margin-top:26px;">Mises de fonds minimales</h3>
            <div class="fh-dp-chart" role="img" aria-label="Mise de fonds minimale selon la fourchette de prix d'achat">
              <div class="fh-dp-row">
                <div class="fh-dp-label">Jusqu'à 500 000 $</div>
                <div class="fh-dp-bar-wrap"><div class="fh-dp-bar" style="width: 20%;"></div><span class="fh-dp-pct">5%</span></div>
                <div class="fh-dp-example">500K$ → 25K$</div>
              </div>
              <div class="fh-dp-row">
                <div class="fh-dp-label">500 001 $–1 499 999 $</div>
                <div class="fh-dp-bar-wrap"><div class="fh-dp-bar" style="width: 35%;"></div><span class="fh-dp-pct">5% + 10% combiné</span></div>
                <div class="fh-dp-example">700K$ → 45K$</div>
              </div>
              <div class="fh-dp-row">
                <div class="fh-dp-label">1 500 000 $ et plus</div>
                <div class="fh-dp-bar-wrap"><div class="fh-dp-bar" style="width: 100%;"></div><span class="fh-dp-pct">20%</span></div>
                <div class="fh-dp-example">1,5M$ → 300K$</div>
              </div>
            </div>
            <p style="margin-top:12px;font-size:14px;color:var(--ink-mute);">Moins de 20 % de mise de fonds = assurance prêt hypothécaire (environ 2,8 % à 4 % du prêt, intégrée au prêt). La taxe de vente provinciale de l'Ontario (8 %) sur cette prime est due comptant le jour de la clôture.</p>

            <h3 style="margin-top:26px;">Coûts de remplacement majeurs</h3>
            <p>Ce qu'on oublie : une maison engloutit du capital par grosses sommes irrégulières. Prévoyez-le.</p>
            <div class="fh-cost-chart" role="img" aria-label="Fourchettes de coûts de remplacement typiques pour les principaux systèmes de la maison">
              <div class="fh-cost-row"><span class="fh-cost-item">Toit</span><div class="fh-cost-bar-wrap"><div class="fh-cost-bar" style="width:40%;"></div></div><span class="fh-cost-range">8K$–20K$+</span></div>
              <div class="fh-cost-row"><span class="fh-cost-item">Fournaise</span><div class="fh-cost-bar-wrap"><div class="fh-cost-bar" style="width:20%;"></div></div><span class="fh-cost-range">5K$–10K$</span></div>
              <div class="fh-cost-row"><span class="fh-cost-item">Fenêtres</span><div class="fh-cost-bar-wrap"><div class="fh-cost-bar" style="width:60%;"></div></div><span class="fh-cost-range">10K$–30K$+</span></div>
              <div class="fh-cost-row"><span class="fh-cost-item">Réparation de fondation</span><div class="fh-cost-bar-wrap"><div class="fh-cost-bar fh-cost-bar-hot" style="width:100%;"></div></div><span class="fh-cost-range">10K$–50K$+</span></div>
              <div class="fh-cost-row"><span class="fh-cost-item">Remplacement de la fosse septique</span><div class="fh-cost-bar-wrap"><div class="fh-cost-bar fh-cost-bar-hot" style="width:90%;"></div></div><span class="fh-cost-range">20K$–45K$+</span></div>
            </div>

            <p style="margin-top:14px;"><strong>Budget continu :</strong> 1 % à 1,5 % de la valeur de la maison par année en entretien. Sur une maison de 800K$, c'est <strong>8K$–12K$/année</strong>. Ce n'est pas « peut-être un jour » — prévoyez-le chaque année.</p>

            <p style="margin-top:14px;"><strong>Essayez-le en direct :</strong> entrez vos chiffres dans la <a href="/french/payment-calculator">Calculatrice hypothécaire</a> et voyez trois scénarios côte à côte.</p>

            <!-- ============================================================
                 PART 3 — GOVERNMENT PROGRAMS
                 ============================================================ -->
            <h2 id="programs" style="margin-top:48px;">Partie 3 · Programmes gouvernementaux cumulables</h2>
            <p>Les premiers acheteurs reçoivent plus d'aide que la plupart des gens ne le pensent. Les quatre programmes ci-dessous se cumulent — vous pouvez tous les utiliser.</p>

            <div class="fh-program-grid">
              <div class="fh-program-card">
                <div class="fh-program-tag">Épargne</div>
                <div class="fh-program-title">CELIAPP</div>
                <p><strong>8 000 $/année, 40 000 $ à vie.</strong> Déductible à l'entrée, libre d'impôt à la sortie, jamais remboursé. Le report est plafonné à 8 000 $, donc le maximum pour une seule année est de <strong>16 000 $</strong>. <a href="/french/blog/fhsa">Guide complet du CELIAPP.</a></p>
              </div>
              <div class="fh-program-card">
                <div class="fh-program-tag">REER</div>
                <div class="fh-program-title">Régime d'accession à la propriété</div>
                <p>Jusqu'à <strong>60 000 $ par personne</strong>. Remboursable sur 15 ans, à partir de la deuxième année suivant le retrait. L'argent doit rester dans le REER pendant <strong>90 jours</strong> avant le retrait. Utilisez d'abord le CELIAPP.</p>
              </div>
              <div class="fh-program-card">
                <div class="fh-program-tag">Crédit d'impôt</div>
                <div class="fh-program-title">Crédit d'impôt pour premier acheteur</div>
                <p><strong>1 500 $ de retour à l'impôt.</strong> Modeste, mais automatique — réclamez-le dans votre prochaine déclaration après la clôture.</p>
              </div>
              <div class="fh-program-card">
                <div class="fh-program-tag">Remise des droits de mutation</div>
                <div class="fh-program-title">Remise des droits de mutation immobilière</div>
                <p>Ontario jusqu'à <strong>4 000 $</strong>. Toronto ajoute <strong>4 475 $</strong>. Les acheteurs à Toronto obtiennent les deux — <strong>jusqu'à 8 475 $</strong> combinés. Vous ne devez jamais avoir été propriétaire d'une maison, où que ce soit dans le monde.</p>
              </div>
            </div>

            <details class="b60-section-toggle" style="margin-top:22px;">
              <summary class="b60-section-toggle-summary">Constructions neuves seulement : remises de TVH (jusqu'à 130 000 $ combinés)</summary>
              <div class="b60-section-body">
                <p>Les maisons de revente n'ont pas de TVH. Les maisons neuves d'un constructeur, oui.</p>
                <ul class="bullets">
                  <li><strong>Remise fédérale pour premier acheteur :</strong> jusqu'à <strong>50 000 $</strong> sur les maisons admissibles.</li>
                  <li><strong>Programme temporaire de l'Ontario :</strong> jusqu'à <strong>80 000 $</strong>. La période actuelle exige que la convention soit signée d'ici le <strong>31 mars 2027</strong>.</li>
                  <li><strong>Plafond combiné :</strong> jusqu'à <strong>130 000 $</strong> sur les achats admissibles.</li>
                </ul>
                <p><strong>Confirmez avec votre avocat et votre comptable.</strong> Les règles de cumul sont complexes et les sommes en jeu sont importantes. Voir aussi <a href="/french/blog/fthb-rebate">l'analyse approfondie de la remise pour premier acheteur</a>.</p>
              </div>
            </details>

            <!-- ============================================================
                 PART 4 — WHAT TO CHECK
                 ============================================================ -->
            <h2 id="check" style="margin-top:48px;">Partie 4 · Quoi vérifier dans n'importe quelle maison</h2>
            <p>Quatre couches, de la structure aux papiers en passant par la rue. Sautez une couche et vous sautez le problème qui s'y cache.</p>

            <details class="b60-section-toggle">
              <summary class="b60-section-toggle-summary">1. La structure — fondation, toit, eau, drainage</summary>
              <div class="b60-section-body">
                <ul class="bullets">
                  <li><strong>Fondation.</strong> Cherchez des fissures. <strong>Les fissures horizontales sont sérieuses</strong> — elles peuvent indiquer des murs qui s'arquent. Les petites fissures verticales sont habituellement mineures. Un résidu blanc et crayeux sur les murs du sous-sol = infiltration d'eau passée.</li>
                  <li><strong>Toit.</strong> Demandez son âge. Cherchez des bardeaux qui se soulèvent ou manquent, et des taches au plafond à l'intérieur.</li>
                  <li><strong>Eau.</strong> Le problème le plus coûteux dans n'importe quelle maison. Vérifiez sous chaque évier, autour de chaque fenêtre, au sous-sol, au grenier. Les odeurs de moisi comptent. Les planchers spongieux comptent.</li>
                  <li><strong>Nivellement &amp; drainage.</strong> Le sol doit s'incliner À L'OPPOSÉ de la maison. Les descentes pluviales doivent évacuer l'eau bien loin de la fondation.</li>
                </ul>
              </div>
            </details>

            <details class="b60-section-toggle">
              <summary class="b60-section-toggle-summary">2. Les systèmes — CVC, électricité, plomberie, fenêtres</summary>
              <div class="b60-section-body">
                <ul class="bullets">
                  <li><strong>Fournaise, climatiseur, chauffe-eau.</strong> Trouvez les numéros de modèle et de série et vérifiez leur âge. Les fournaises durent 15 à 25 ans. Les chauffe-eau, 7 à 15 ans.</li>
                  <li><strong>Signaux d'alarme électriques :</strong>
                    <ul class="bullets" style="margin-top:4px;">
                      <li><strong>Câblage à tube et à cheville</strong> — plusieurs assureurs refusent la couverture ou exigent son remplacement.</li>
                      <li><strong>Câblage en aluminium</strong> (milieu des années 1960 à fin des années 1970) — assurable, mais exige habituellement des connecteurs certifiés et une inspection.</li>
                    </ul>
                  </li>
                  <li><strong>Taille du panneau.</strong> 100 ampères est le minimum pratique; un service de 60 ampères devra être mis à niveau.</li>
                  <li><strong>Plomberie.</strong> Les tuyaux galvanisés sont près de la fin de leur vie utile. La plomberie <strong>Kitec</strong> (milieu des années 1990 au milieu des années 2000) est reconnue pour ses défaillances et peut affecter l'assurance.</li>
                  <li><strong>Fenêtres.</strong> De la buée entre les vitres = défaillance du joint d'étanchéité.</li>
                </ul>
              </div>
            </details>

            <details class="b60-section-toggle">
              <summary class="b60-section-toggle-summary">3. Les papiers — équipement loué, permis, certificat de localisation, environnement</summary>
              <div class="b60-section-body">
                <ul class="bullets">
                  <li><strong>Équipement loué.</strong> Les maisons ontariennes ont très souvent des <strong>chauffe-eau, fournaises, climatiseurs ou adoucisseurs d'eau loués</strong>, sous des contrats qui vous sont transférés. Certains sont longs et coûteux à résilier. Demandez ce qui est loué, obtenez le contrat, et incluez-le dans l'offre.</li>
                  <li><strong>Permis.</strong> La plupart des villes permettent de rechercher les permis de construction en ligne gratuitement. Vérifiez tout agrandissement, sous-sol fini ou terrasse. Les travaux sans permis peuvent entraîner des problèmes d'assurance et des ordres de démolition.</li>
                  <li><strong>Certificat de localisation.</strong> Demandez-en un au vendeur. Il montre les lignes de terrain réelles, les servitudes et les empiétements.</li>
                  <li><strong>Situations particulières à vérifier :</strong> <strong>réservoirs à mazout</strong> souterrains ou hors sol, isolant <strong>UFFI</strong>, <strong>amiante</strong> et <strong>vermiculite</strong> dans les maisons plus anciennes, et tout antécédent de plantation de cannabis (grow op).</li>
                </ul>
              </div>
            </details>

            <details class="b60-section-toggle">
              <summary class="b60-section-toggle-summary">4. L'emplacement — la seule chose qu'on ne peut jamais rénover</summary>
              <div class="b60-section-body">
                <ul class="bullets">
                  <li>Parcourez la rue un matin de semaine, un soir de semaine et une fin de semaine.</li>
                  <li>Vérifiez ce qui est prévu pour les terrains vacants avoisinants.</li>
                  <li>Vérifiez les plaines inondables, les sites d'enfouissement, les voies ferrées, les corridors électriques et les trajectoires de vol.</li>
                  <li>Parlez à un voisin si possible. <strong>Vous pouvez réparer une maison. Vous ne pouvez pas réparer de mauvais voisins.</strong></li>
                </ul>
              </div>
            </details>

            <!-- ============================================================
                 PART 5 — RURAL
                 ============================================================ -->
            <h2 id="rural" style="margin-top:48px;">Partie 5 · Rural, chalet &amp; ferme — les devoirs supplémentaires</h2>
            <p>Les acheteurs urbains sous-estiment cet aspect. Les problèmes ruraux se cachent sous terre et dans les dépendances.</p>

            <details class="b60-section-toggle">
              <summary class="b60-section-toggle-summary">Eau de puits — ne sautez jamais cette étape</summary>
              <div class="b60-section-body">
                <p>Un simple coup d'œil au capuchon du puits <strong>n'est pas un test</strong>. Rendez votre offre conditionnelle à :</p>
                <ul class="bullets">
                  <li><strong>Un test de qualité de l'eau</strong> — au minimum coliformes totaux, E. coli et nitrates.</li>
                  <li><strong>Un test de débit</strong> — un puits qui s'assèche en août est un problème sérieux.</li>
                  <li><strong>Le dossier du puits</strong> dans le registre de l'Ontario — consultez-le.</li>
                </ul>
                <p>Vérifiez aussi la distance entre le puits et le lit d'épandage septique, ainsi que les exploitations agricoles voisines.</p>
              </div>
            </details>

            <details class="b60-section-toggle">
              <summary class="b60-section-toggle-summary">Fosse septique — inspecteur distinct requis</summary>
              <div class="b60-section-body">
                <p>Rendez votre offre conditionnelle à une <strong>inspection septique par un inspecteur septique qualifié</strong>, et non l'inspecteur en bâtiment général. Demandez :</p>
                <ul class="bullets">
                  <li>L'âge du système et la date de la dernière vidange.</li>
                  <li>L'emplacement de la fosse et du lit d'épandage.</li>
                  <li>Le permis original et les plans de la municipalité.</li>
                </ul>
                <div class="callout" style="border-left: 3px solid #b8002e; padding-left: 22px;"><strong>Si le système tombe en panne après la clôture, c'est votre problème.</strong> Il n'y a pas de petite réparation. Le remplacement coûte des dizaines de milliers de dollars. Surveillez les bandes de gazon plus vertes ou plus humides, le sol spongieux ou les odeurs d'égout.</div>
              </div>
            </details>

            <details class="b60-section-toggle">
              <summary class="b60-section-toggle-summary">Poêles à bois, combustible de chauffage, accès &amp; services</summary>
              <div class="b60-section-body">
                <ul class="bullets">
                  <li><strong>Poêles à bois / foyers :</strong> obtenez une <strong>inspection WETT</strong>. La plupart des assureurs l'exigent.</li>
                  <li><strong>Combustible de chauffage :</strong> le propane, le mazout et l'électricité coûtent tous plus cher que le gaz naturel. Obtenez les factures des 12 derniers mois. Les réservoirs à mazout ont des règles d'assurance et des limites d'âge.</li>
                  <li><strong>Route :</strong> entretenue par la municipalité toute l'année, ou privée et saisonnière ? Qui déneige, et à quel coût ?</li>
                  <li><strong>Droit de passage :</strong> traverse-t-il le terrain de quelqu'un d'autre ? Est-il enregistré au titre ?</li>
                  <li><strong>Internet et cellulaire :</strong> vérifiez sur place, pas sur une carte de couverture.</li>
                  <li><strong>Ordures :</strong> collecte ou dépotoir ?</li>
                </ul>
              </div>
            </details>

            <details class="b60-section-toggle">
              <summary class="b60-section-toggle-summary">Spécifique au chalet — réserve de chemin de rive, accès par voie d'eau, assurance</summary>
              <div class="b60-section-body">
                <ul class="bullets">
                  <li><strong>Réserve de chemin de rive.</strong> Plusieurs propriétés riveraines de l'Ontario ont une bande de terrain le long de l'eau qui appartient encore à la municipalité. Si elle n'a pas été achetée et fermée, vous pourriez ne pas être propriétaire jusqu'à la ligne des hautes eaux. Votre avocat doit vérifier.</li>
                  <li><strong>Accès par voie d'eau seulement.</strong> Aucune route = financement, assurance et revente plus difficiles.</li>
                  <li><strong>Saison.</strong> Confirmez l'hivernisation et l'utilisabilité de la route ou de l'eau à l'année.</li>
                  <li><strong>Office de protection de la nature.</strong> Les quais, les hangars à bateaux, les travaux en bordure de l'eau et les agrandissements nécessitent souvent une approbation. Vérifiez que ce qui existe déjà est légal.</li>
                  <li><strong>Assurance.</strong> Les propriétés saisonnières et à accès par voie d'eau coûtent plus cher à assurer, et certains assureurs refusent de les couvrir.</li>
                </ul>
              </div>
            </details>

            <details class="b60-section-toggle">
              <summary class="b60-section-toggle-summary">Spécifique à la ferme — zonage, DSM, TVH, fermiers locataires</summary>
              <div class="b60-section-body">
                <ul class="bullets">
                  <li><strong>Zonage.</strong> Confirmez avec la municipalité ce que vous pouvez réellement faire.</li>
                  <li><strong>Distance séparatrice minimale (DSM).</strong> Régit la proximité permise entre les maisons et les bâtiments d'élevage.</li>
                  <li><strong>TVH.</strong> Les terres agricoles sont souvent assujetties à la TVH sur la portion agricole; la portion résidentielle peut ne pas l'être. Obtenez des conseils fiscaux <strong>avant</strong> de signer.</li>
                  <li><strong>Catégorie d'impôt foncier agricole.</strong> Un taux réduit est offert pour les fermes admissibles — mais vous devez en faire la demande et être admissible.</li>
                  <li><strong>Fermiers locataires / baux à parts de récolte.</strong> Ceux-ci peuvent survivre à votre achat.</li>
                  <li><strong>Drainage souterrain.</strong> Demandez les plans et tout prêt de drainage impayé (ils peuvent être transférés).</li>
                  <li><strong>Financement.</strong> Les prêteurs agricoles peuvent être mieux adaptés qu'une banque.</li>
                  <li><strong>Environnement.</strong> Les anciens réservoirs de carburant, l'entreposage de produits chimiques et les sites d'enfouissement sont de vrais risques. Envisagez une évaluation environnementale.</li>
                </ul>
              </div>
            </details>

            <!-- ============================================================
                 PART 6 — OFFER + INSPECTION
                 ============================================================ -->
            <h2 id="offer" style="margin-top:48px;">Partie 6 · L'offre et l'inspection</h2>

            <div class="callout" style="border-left: 3px solid var(--ink); padding-left: 22px;">
              <strong>Une fois que les deux parties ont signé, c'est contraignant. Il n'y a aucune période de réflexion sur une maison de revente en Ontario.</strong> Chaque contre-offre annule la précédente.
            </div>

            <h3 style="margin-top:22px;">Conditions à inclure dans l'offre</h3>
            <ul class="bullets">
              <li><strong>Financement.</strong></li>
              <li><strong>Inspection de la maison.</strong></li>
              <li><strong>Qualité et débit de l'eau du puits</strong> (rural).</li>
              <li><strong>Inspection septique</strong> (rural).</li>
              <li><strong>Inspection WETT</strong> (poêle à bois).</li>
              <li><strong>Zonage / vérification diligente</strong> (rural, ferme, ou changement d'usage).</li>
              <li><strong>Révision par un avocat</strong> (recommandé pour les fermes et les propriétés atypiques).</li>
            </ul>
            <p>Dans un marché concurrentiel, les acheteurs abandonnent parfois des conditions pour l'emporter. Comprenez exactement ce que vous abandonnez d'abord — une condition de financement non protégée qui échoue peut vous coûter tout votre dépôt.</p>

            <h3 style="margin-top:22px;">L'inspection</h3>
            <p><strong>Faites-en une. Choisissez votre propre inspecteur.</strong> Quelqu'un avec une formation en métier ou en construction, qui vous remet un rapport écrit. Assistez à l'inspection et faites le tour avec lui à la fin.</p>
            <p>Les constats se répartissent habituellement en quatre catégories :</p>
            <ol class="bullets" style="list-style: decimal; padding-left: 20px;">
              <li>Des motifs de rupture.</li>
              <li>Des éléments qui devraient réduire le prix.</li>
              <li>Des éléments à réparer bientôt.</li>
              <li>Des éléments à surveiller au fil des années.</li>
            </ol>
            <p><strong>Les inspecteurs n'ouvrent pas les murs.</strong> S'ils signalent quelque chose de sérieux, faites appel à un spécialiste avant de lever les conditions.</p>

            <h3 style="margin-top:22px;">Le dépôt</h3>
            <p>Démontre votre sérieux. Il est déduit du prix à la clôture. Une fois la transaction ferme, vous ne pouvez pas le récupérer simplement parce que vous avez changé d'avis — sa libération exige l'accord écrit des deux parties, ou une ordonnance du tribunal. Gardez cet argent liquide; vous pourriez avoir besoin d'une traite bancaire à court préavis.</p>

            <!-- ============================================================
                 PART 7 — CLOSING COSTS
                 ============================================================ -->
            <h2 id="closing" style="margin-top:48px;">Partie 7 · Frais de clôture</h2>
            <p>Prévoyez <strong>1,5 % à 4 %</strong> du prix, comptant, en plus de votre mise de fonds.</p>

            <div class="fh-closing-stack">
              <div class="fh-closing-row"><span>Droits de mutation immobilière</span><span>Doublés à Toronto</span></div>
              <div class="fh-closing-row"><span>Honoraires et débours de l'avocat</span><span>~1,5K$–2,5K$</span></div>
              <div class="fh-closing-row"><span>Assurance titres</span><span>~300$–500$</span></div>
              <div class="fh-closing-row"><span>Inspection de la maison</span><span>500$–900$</span></div>
              <div class="fh-closing-row"><span>Inspections de puits / septique / WETT</span><span>Rural : quelques centaines à 1K$+</span></div>
              <div class="fh-closing-row"><span>Évaluation</span><span>Si exigée par le prêteur</span></div>
              <div class="fh-closing-row"><span>Taxe de vente provinciale sur l'assurance hypothécaire</span><span>Si moins de 20 % de mise de fonds</span></div>
              <div class="fh-closing-row"><span>Frais de déménagement</span><span>Varie</span></div>
              <div class="fh-closing-row"><span>Ajustements</span><span>Impôt foncier ou combustible payé d'avance par le vendeur</span></div>
              <div class="fh-closing-row fh-closing-row-total"><span><strong>Prévoyez aussi une réserve pour</strong></span><span>Serrures, stores, premières réparations, meubles</span></div>
            </div>

            <p style="margin-top:14px;"><strong>Faites le calcul :</strong> <a href="/french/land-transfer-tax">Calculatrice des droits de mutation immobilière</a> · <a href="/french/closing-costs">Page des frais de clôture</a> · <a href="/french/cmhc-insurance-calculator">Calculatrice de la prime SCHL</a>.</p>

            <!-- ============================================================
                 PART 8 — BEFORE + AFTER CLOSING
                 ============================================================ -->
            <h2 id="before-after" style="margin-top:48px;">Partie 8 · Avant &amp; après la clôture</h2>

            <div class="fh-before-after">
              <div class="fh-ba-col fh-ba-dont">
                <div class="fh-ba-title">Avant la clôture — À NE PAS FAIRE</div>
                <ul>
                  <li>Changer d'emploi</li>
                  <li>Acheter ou louer une voiture</li>
                  <li>Ouvrir du nouveau crédit</li>
                  <li>Manquer un paiement</li>
                </ul>
                <p class="fh-ba-note">Les prêteurs revérifient votre dossier.</p>
              </div>
              <div class="fh-ba-col fh-ba-do">
                <div class="fh-ba-title">Avant la clôture — À FAIRE</div>
                <ul>
                  <li>Visite finale le plus près possible de la clôture</li>
                  <li>Organiser l'assurance habitation (le prêteur exige une preuve)</li>
                  <li>Évitez de clôturer un vendredi si possible</li>
                  <li>Confirmer le montant de clôture avec votre avocat</li>
                </ul>
              </div>
              <div class="fh-ba-col fh-ba-after">
                <div class="fh-ba-title">Après la clôture</div>
                <ul>
                  <li>Changer les serrures</li>
                  <li>Repérer le robinet d'arrêt d'eau et le panneau électrique</li>
                  <li>Réclamer le crédit d'impôt de 1 500 $ pour premier acheteur à l'impôt</li>
                  <li>Confirmer que vos remises de droits de mutation ont été appliquées</li>
                  <li>Démarrer votre fonds d'entretien</li>
                </ul>
              </div>
            </div>

            <!-- ============================================================
                 COMMON MISTAKES
                 ============================================================ -->
            <h2 id="mistakes" style="margin-top:48px;">Les 10 erreurs les plus fréquentes des acheteurs de maison</h2>
            <ol class="bullets" style="list-style: decimal; padding-left: 20px;">
              <li><strong>Ne budgéter que pour l'hypothèque.</strong> L'entretien seul peut coûter 10K$/année.</li>
              <li><strong>Sauter l'inspection pour gagner une guerre d'enchères.</strong></li>
              <li><strong>Sauter les tests de puits et de fosse septique sur une propriété rurale.</strong> L'erreur rurale la plus coûteuse qui soit.</li>
