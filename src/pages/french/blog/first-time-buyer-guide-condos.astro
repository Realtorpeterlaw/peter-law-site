---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import TopBar from '../../../components/FrenchTopBar.astro';
import Header from '../../../components/FrenchHeader.astro';
import Footer from '../../../components/FrenchFooter.astro';
import LCTA from '../../../components/FrenchCTASection.astro';

export const prerender = true;

const publishedDate = '2026-09-08';
const articleTitle = "Guide du premier acheteur de CONDO (Ontario)";
const articleDescription = "Un guide en français simple pour acheter votre premier condo en Ontario. Types de condos, certificat d'état, fonds de réserve, frais de copropriété, règles de stationnement, assurance, risques du préconstruction, et une section complète pour les acheteurs internationaux. Avec visuels, graphiques et une liste de vérification avant la clôture.";
const articleUrl = 'https://www.realtorpeterlaw.com/french/blog/first-time-buyer-guide-condos';
const enUrl = 'https://www.realtorpeterlaw.com/blog/first-time-buyer-guide-condos';

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: articleTitle,
  description: articleDescription,
  author: { '@type': 'Person', name: 'Peter Law', url: 'https://www.realtorpeterlaw.com/french/about' },
  publisher: {
    '@type': 'Organization',
    name: 'Peter Law — Immobilier à Toronto',
    logo: { '@type': 'ImageObject', url: 'https://www.realtorpeterlaw.com/favicon.svg' },
  },
  inLanguage: 'fr-CA',
  datePublished: publishedDate,
  dateModified: publishedDate,
  url: articleUrl,
  mainEntityOfPage: { '@type': 'WebPage', '@id': articleUrl },
  keywords: "premier acheteur de condo Ontario, guide condo Toronto, certificat d'état condo, fonds de réserve cotisation spéciale, frais de copropriété approbation hypothécaire, condo préconstruction Ontario, période de réflexion de 10 jours condo, occupation intérimaire, POTL, condo à bail et coopérative, NRST Ontario acheteur étranger, acheteur international Canada condo",
  translationOfWork: { '@type': 'Article', '@id': enUrl },
};

const hreflangAlternates = [
  { hreflang: 'en-CA', href: 'https://www.realtorpeterlaw.com/blog/first-time-buyer-guide-condos/' },
  { hreflang: 'zh-CN', href: 'https://www.realtorpeterlaw.com/chinese/blog/first-time-buyer-guide-condos/' },
  { hreflang: 'fr-CA', href: 'https://www.realtorpeterlaw.com/french/blog/first-time-buyer-guide-condos/' },
  { hreflang: 'x-default', href: 'https://www.realtorpeterlaw.com/blog/first-time-buyer-guide-condos/' },
];

// Condo-type icons (small SVG silhouettes)
const condoIcons = {
  highrise: `<svg viewBox="0 0 80 80" xmlns="http://www.w3.org/2000/svg" aria-hidden="true"><rect x="26" y="10" width="28" height="58" fill="var(--bg-warm)" stroke="currentColor" stroke-width="2"/><rect x="30" y="14" width="5" height="6" fill="currentColor" opacity="0.7"/><rect x="38" y="14" width="5" height="6" fill="currentColor" opacity="0.7"/><rect x="46" y="14" width="5" height="6" fill="currentColor" opacity="0.7"/><rect x="30" y="24" width="5" height="6" fill="currentColor" opacity="0.5"/><rect x="38" y="24" width="5" height="6" fill="currentColor" opacity="0.5"/><rect x="46" y="24" width="5" height="6" fill="currentColor" opacity="0.5"/><rect x="30" y="34" width="5" height="6" fill="currentColor" opacity="0.7"/><rect x="38" y="34" width="5" height="6" fill="currentColor" opacity="0.5"/><rect x="46" y="34" width="5" height="6" fill="currentColor" opacity="0.7"/><rect x="30" y="44" width="5" height="6" fill="currentColor" opacity="0.5"/><rect x="38" y="44" width="5" height="6" fill="currentColor" opacity="0.7"/><rect x="46" y="44" width="5" height="6" fill="currentColor" opacity="0.5"/><rect x="35" y="56" width="10" height="12" fill="none" stroke="currentColor" stroke-width="1.5"/></svg>`,
  condotown: `<svg viewBox="0 0 80 80" xmlns="http://www.w3.org/2000/svg" aria-hidden="true"><rect x="8" y="34" width="20" height="32" fill="var(--bg-warm)" stroke="currentColor" stroke-width="1.8"/><rect x="28" y="34" width="20" height="32" fill="var(--bg-warm)" stroke="currentColor" stroke-width="1.8"/><rect x="48" y="34" width="20" height="32" fill="var(--bg-warm)" stroke="currentColor" stroke-width="1.8"/><path d="M8 34 L18 22 L28 34" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round"/><path d="M28 34 L38 22 L48 34" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round"/><path d="M48 34 L58 22 L68 34" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round"/><rect x="14" y="48" width="6" height="12" fill="none" stroke="currentColor" stroke-width="1.4"/><rect x="34" y="48" width="6" height="12" fill="none" stroke="currentColor" stroke-width="1.4"/><rect x="54" y="48" width="6" height="12" fill="none" stroke="currentColor" stroke-width="1.4"/></svg>`,
  stacked: `<svg viewBox="0 0 80 80" xmlns="http://www.w3.org/2000/svg" aria-hidden="true"><rect x="14" y="18" width="52" height="18" fill="var(--bg-warm)" stroke="currentColor" stroke-width="1.8"/><rect x="14" y="36" width="52" height="18" fill="var(--bg-warm)" stroke="currentColor" stroke-width="1.8"/><rect x="14" y="54" width="52" height="14" fill="var(--bg-warm)" stroke="currentColor" stroke-width="1.8"/><rect x="22" y="22" width="6" height="10" fill="none" stroke="currentColor" stroke-width="1.2"/><rect x="52" y="22" width="6" height="10" fill="none" stroke="currentColor" stroke-width="1.2"/><rect x="22" y="40" width="6" height="10" fill="none" stroke="currentColor" stroke-width="1.2"/><rect x="52" y="40" width="6" height="10" fill="none" stroke="currentColor" stroke-width="1.2"/><rect x="36" y="58" width="8" height="10" fill="none" stroke="currentColor" stroke-width="1.4"/></svg>`,
  back2back: `<svg viewBox="0 0 80 80" xmlns="http://www.w3.org/2000/svg" aria-hidden="true"><rect x="10" y="30" width="60" height="36" fill="var(--bg-warm)" stroke="currentColor" stroke-width="1.8"/><line x1="40" y1="30" x2="40" y2="66" stroke="currentColor" stroke-width="1.6"/><path d="M8 32 L40 12 L72 32" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round"/><rect x="18" y="40" width="6" height="10" fill="none" stroke="currentColor" stroke-width="1.2"/><rect x="56" y="40" width="6" height="10" fill="none" stroke="currentColor" stroke-width="1.2"/><rect x="28" y="56" width="8" height="10" fill="none" stroke="currentColor" stroke-width="1.4"/><rect x="44" y="56" width="8" height="10" fill="none" stroke="currentColor" stroke-width="1.4"/></svg>`,
  potl: `<svg viewBox="0 0 80 80" xmlns="http://www.w3.org/2000/svg" aria-hidden="true"><rect x="18" y="36" width="44" height="30" fill="var(--bg-warm)" stroke="currentColor" stroke-width="2"/><path d="M12 40 L40 18 L68 40 Z" fill="var(--bg-warm)" stroke="currentColor" stroke-width="2" stroke-linejoin="round"/><rect x="34" y="48" width="12" height="18" fill="none" stroke="currentColor" stroke-width="1.5"/><path d="M2 68 L 78 68" stroke="currentColor" stroke-width="1.4" stroke-dasharray="3,3" opacity="0.6"/><text x="72" y="76" font-size="7" fill="currentColor" opacity="0.55" text-anchor="end">shared road</text></svg>`,
  vacantland: `<svg viewBox="0 0 80 80" xmlns="http://www.w3.org/2000/svg" aria-hidden="true"><rect x="20" y="38" width="40" height="28" fill="var(--bg-warm)" stroke="currentColor" stroke-width="2"/><path d="M14 42 L40 22 L66 42 Z" fill="var(--bg-warm)" stroke="currentColor" stroke-width="2" stroke-linejoin="round"/><rect x="34" y="48" width="12" height="18" fill="none" stroke="currentColor" stroke-width="1.4"/><rect x="4" y="30" width="16" height="10" fill="none" stroke="currentColor" stroke-width="1" stroke-dasharray="2,2" opacity="0.6"/><rect x="60" y="30" width="16" height="10" fill="none" stroke="currentColor" stroke-width="1" stroke-dasharray="2,2" opacity="0.6"/><text x="12" y="52" font-size="7" fill="currentColor" opacity="0.55" text-anchor="middle">lot</text><text x="68" y="52" font-size="7" fill="currentColor" opacity="0.55" text-anchor="middle">lot</text></svg>`,
  leasehold: `<svg viewBox="0 0 80 80" xmlns="http://www.w3.org/2000/svg" aria-hidden="true"><rect x="18" y="36" width="44" height="30" fill="var(--bg-warm)" stroke="currentColor" stroke-width="2"/><path d="M12 40 L40 18 L68 40 Z" fill="var(--bg-warm)" stroke="currentColor" stroke-width="2" stroke-linejoin="round"/><rect x="34" y="48" width="12" height="18" fill="none" stroke="currentColor" stroke-width="1.5"/><path d="M6 68 L 74 68" stroke="currentColor" stroke-width="2" opacity="0.5"/><text x="40" y="76" font-size="8" fill="currentColor" opacity="0.65" text-anchor="middle">LAND LEASED</text></svg>`,
  coop: `<svg viewBox="0 0 80 80" xmlns="http://www.w3.org/2000/svg" aria-hidden="true"><rect x="20" y="14" width="40" height="52" fill="var(--bg-warm)" stroke="currentColor" stroke-width="2"/><line x1="20" y1="26" x2="60" y2="26" stroke="currentColor" stroke-width="1.6"/><line x1="20" y1="38" x2="60" y2="38" stroke="currentColor" stroke-width="1.6"/><line x1="20" y1="50" x2="60" y2="50" stroke="currentColor" stroke-width="1.6"/><rect x="35" y="56" width="10" height="10" fill="none" stroke="currentColor" stroke-width="1.4"/><text x="40" y="22" font-size="6" fill="currentColor" opacity="0.65" text-anchor="middle">SHARES</text><text x="40" y="34" font-size="6" fill="currentColor" opacity="0.65" text-anchor="middle">SHARES</text><text x="40" y="46" font-size="6" fill="currentColor" opacity="0.65" text-anchor="middle">SHARES</text></svg>`,
  loft: `<svg viewBox="0 0 80 80" xmlns="http://www.w3.org/2000/svg" aria-hidden="true"><rect x="14" y="20" width="52" height="48" fill="var(--bg-warm)" stroke="currentColor" stroke-width="2"/><line x1="14" y1="42" x2="66" y2="42" stroke="currentColor" stroke-width="1.4"/><rect x="20" y="26" width="8" height="12" fill="none" stroke="currentColor" stroke-width="1.2"/><line x1="24" y1="26" x2="24" y2="38" stroke="currentColor" stroke-width="0.8"/><line x1="20" y1="32" x2="28" y2="32" stroke="currentColor" stroke-width="0.8"/><rect x="34" y="26" width="8" height="12" fill="none" stroke="currentColor" stroke-width="1.2"/><line x1="38" y1="26" x2="38" y2="38" stroke="currentColor" stroke-width="0.8"/><line x1="34" y1="32" x2="42" y2="32" stroke="currentColor" stroke-width="0.8"/><rect x="48" y="26" width="8" height="12" fill="none" stroke="currentColor" stroke-width="1.2"/><line x1="52" y1="26" x2="52" y2="38" stroke="currentColor" stroke-width="0.8"/><line x1="48" y1="32" x2="56" y2="32" stroke="currentColor" stroke-width="0.8"/><rect x="33" y="52" width="14" height="16" fill="none" stroke="currentColor" stroke-width="1.4"/></svg>`,
};
---
<BaseLayout
  title={`${articleTitle} | Peter Law`}
  description={articleDescription}
  lang="fr"
  bodyClass="fr guide-page article-page"
  hreflangAlternates={hreflangAlternates}
>
  <TopBar />
  <Header active="blog" />

  <article>
    <section class="page-hero">
      <div class="wrap">
        <div class="eyebrow"><a href="/french/blog" class="back-link"><svg width="11" height="11" viewBox="0 0 14 14" fill="none" style="vertical-align:-1px;margin-right:5px;" aria-hidden="true"><path d="M13 7H1M6 12L1 7l5-5" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/></svg>Blogue</a> · Guide acheteur · Condos</div>
        <h1>{articleTitle}</h1>
        <p class="article-lead">Quand vous achetez un condo, vous achetez deux choses : votre unité, et une part de l'immeuble. Vous n'achetez pas seulement un chez-vous — vous rejoignez un syndicat de copropriété et prenez en charge une part de ses factures, de ses règles et de ses problèmes. Ce guide vous montre comment vérifier ce syndicat avant de vous engager.</p>
        <div class="article-byline">
          <span>Par <a href="/french/about">Peter Law</a></span>
          <span class="dot">·</span>
          <time datetime={publishedDate}>8 septembre 2026</time>
          <span class="dot">·</span>
          <span>16 min de lecture</span>
        </div>
      </div>
    </section>

    <!-- ====== QUICK STAT CARDS ====== -->
    <section class="fh-stats-wrap">
      <div class="wrap">
        <div class="fh-stats-grid">
          <div class="fh-stat"><div class="fh-stat-num">10 jours</div><div class="fh-stat-label">Période de réflexion</div><div class="fh-stat-sub">Préconstruction seulement</div></div>
          <div class="fh-stat"><div class="fh-stat-num">100 $</div><div class="fh-stat-label">Plafond du certificat d'état</div><div class="fh-stat-sub">Livré dans les 10 jours</div></div>
          <div class="fh-stat"><div class="fh-stat-num">50 %</div><div class="fh-stat-label">Des frais de copropriété comptent</div><div class="fh-stat-sub">Dans vos ratios hypothécaires</div></div>
          <div class="fh-stat"><div class="fh-stat-num">15–25 ans</div><div class="fh-stat-label">L'âge délicat</div><div class="fh-stat-sub">Les grosses réparations s'y concentrent</div></div>
        </div>
      </div>
    </section>

    <section class="major" style="padding-top:32px;">
      <div class="wrap">
        <div class="prose-grid">
          <aside class="prose-side">
            <h4>Sur cette page</h4>
            <ul>
              <li><a href="#types">Types de condos</a></li>
              <li><a href="#afford">Ce que vous pouvez vous permettre</a></li>
              <li><a href="#programs">Programmes gouvernementaux</a></li>
              <li><a href="#status">Le certificat d'état</a></li>
              <li><a href="#reserve">Fonds de réserve &amp; cotisations spéciales</a></li>
              <li><a href="#fees">Frais de copropriété</a></li>
              <li><a href="#parking">Stationnement, casiers &amp; ce que vous possédez</a></li>
              <li><a href="#rules">Les règles sous lesquelles vous vivrez</a></li>
              <li><a href="#insurance">Assurance — deux polices</a></li>
              <li><a href="#resale">Acheter un condo de revente</a></li>
              <li><a href="#preconstruction">Acheter un condo en préconstruction</a></li>
              <li><a href="#international">Pour les acheteurs internationaux</a></li>
              <li><a href="#redflags">Signaux d'alarme</a></li>
              <li><a href="#mistakes">10 erreurs courantes</a></li>
              <li><a href="#checklist">Liste de vérification complète</a></li>
            </ul>
          </aside>

          <div class="prose-body">

            <!-- ============================================================
                 PART 1 — TYPES
                 ============================================================ -->
            <h2 id="types">Partie 1 · Types de condos en Ontario</h2>
            <p>Les condos ne sont pas tous des appartements. Voici neuf types courants — et l'un d'eux n'est même pas un condo.</p>

            <div class="fh-house-grid">
              <div class="fh-house-card">
                <div class="fh-house-icon" set:html={condoIcons.highrise} />
                <div class="fh-house-title">Condo standard</div>
                <p>Immeuble en hauteur ou de faible hauteur. Vous êtes propriétaire de votre unité. Le syndicat de copropriété possède et entretient tout le reste. Le type le plus courant.</p>
              </div>
              <div class="fh-house-card">
                <div class="fh-house-icon" set:html={condoIcons.condotown} />
                <div class="fh-house-title">Maison de ville en copropriété</div>
                <p>Vous êtes propriétaire de l'intérieur. Le syndicat s'occupe du toit, des murs extérieurs, de la pelouse et du déneigement. Vous payez des frais mensuels.</p>
              </div>
              <div class="fh-house-card">
                <div class="fh-house-icon" set:html={condoIcons.stacked} />
                <div class="fh-house-title">Maison de ville superposée</div>
                <p>Deux ou trois niveaux superposés, souvent avec des entrées séparées. Moins cher qu'une maison de ville standard. Du bruit entre les unités, et des escaliers partout.</p>
              </div>
              <div class="fh-house-card">
                <div class="fh-house-icon" set:html={condoIcons.back2back} />
                <div class="fh-house-title">Maison de ville dos à dos</div>
                <p>Partage les murs latéraux ET le mur arrière. Pas de cour arrière. La forme la moins chère. Plus difficile à revendre.</p>
              </div>
              <div class="fh-house-card">
                <div class="fh-house-icon" set:html={condoIcons.potl} />
                <div class="fh-house-title">Éléments communs (POTL)</div>
                <p>Vous êtes propriétaire du terrain et de la maison en toute propriété — <strong>franc-quartier (freehold)</strong>. Mais vous payez des frais mensuels pour des éléments partagés comme une route privée ou un parc. Les frais sont modestes mais bien réels, et ils peuvent augmenter.</p>
              </div>
              <div class="fh-house-card">
                <div class="fh-house-icon" set:html={condoIcons.vacantland} />
                <div class="fh-house-title">Condo sur terrain vacant</div>
                <p>Vous êtes propriétaire du lot et vous construisez ou possédez la maison qui s'y trouve. Les routes et services partagés sont gérés par le syndicat. Courant dans les nouveaux développements de banlieue.</p>
              </div>
              <div class="fh-house-card">
                <div class="fh-house-icon" set:html={condoIcons.leasehold} />
                <div class="fh-house-title">Condo à bail (leasehold)</div>
                <p>Vous n'êtes pas propriétaire du terrain — vous le louez (souvent d'une université ou d'un hôpital) pour un nombre d'années déterminé. Moins cher, pour une raison. <strong>Le financement et la revente deviennent plus difficiles à mesure que le bail se rapproche de son échéance.</strong></p>
              </div>
              <div class="fh-house-card">
                <div class="fh-house-icon" set:html={condoIcons.coop} />
                <div class="fh-house-title">Coopérative (PAS un condo)</div>
                <p>Vous achetez des parts dans une société qui possède l'immeuble — pas un bien immobilier. Beaucoup de prêteurs refusent de les financer. Le conseil d'administration peut refuser votre acheteur au moment de la vente. À considérer seulement si vous comprenez pleinement les compromis.</p>
              </div>
              <div class="fh-house-card">
                <div class="fh-house-icon" set:html={condoIcons.loft} />
                <div class="fh-house-title">Loft (industriel ou moderne)</div>
                <p><strong>Loft industriel</strong> = vrai vieux bâtiment industriel. <strong>Loft moderne</strong> = nouvel immeuble construit pour avoir l'air ancien. Les lofts industriels ont souvent des particularités : mauvaise isolation, bruit, plans inhabituels, chauffage plus coûteux.</p>
              </div>
            </div>

            <!-- ============================================================
                 PART 2 — AFFORDABILITY
                 ============================================================ -->
            <h2 id="afford" style="margin-top:48px;">Partie 2 · Ce que vous pouvez vous permettre</h2>

            <h3>Le test de résistance</h3>
            <p>Les prêteurs ne vous approuvent pas au taux qu'ils vous offrent. Vous devez être admissible au taux le plus <strong>élevé</strong> entre les suivants :</p>

            <div class="fh-formula" aria-label="Formule du test de résistance">
              <div class="fh-formula-cell">
                <div class="fh-formula-label">Taux contractuel</div>
                <div class="fh-formula-value">4,5 %</div>
                <div class="fh-formula-sub">exemple</div>
              </div>
              <div class="fh-formula-op">+</div>
              <div class="fh-formula-cell">
                <div class="fh-formula-label">Marge de test</div>
                <div class="fh-formula-value">2 %</div>
              </div>
              <div class="fh-formula-op">ou</div>
              <div class="fh-formula-cell">
                <div class="fh-formula-label">Plancher</div>
                <div class="fh-formula-value">5,25 %</div>
              </div>
              <div class="fh-formula-op">→</div>
              <div class="fh-formula-cell fh-formula-result">
                <div class="fh-formula-label">Admissible au taux le PLUS ÉLEVÉ</div>
                <div class="fh-formula-value">6,5 %</div>
              </div>
            </div>

            <h3 style="margin-top:26px;">Les frais de copropriété réduisent votre capacité d'emprunt</h3>
            <p>La plupart des premiers acheteurs ne le savent pas.</p>
            <p>Quand un prêteur calcule vos ratios, il compte <strong>50 % de vos frais de copropriété mensuels</strong> comme coût de logement. Donc des frais de 700 $ grugent environ 350 $/mois de votre capacité d'emprunt — <em>avant même</em> que vous ayez payé un sou d'hypothèque.</p>

            <div class="callout" style="border-left: 3px solid var(--ink); padding-left: 22px;">
              <strong>Règle de base :</strong> deux condos au même prix peuvent être admissibles très différemment selon les frais seulement. Des frais élevés réduisent à la fois votre montant d'approbation ET votre prix de revente.
            </div>

            <h3 style="margin-top:26px;">Mise de fonds minimale</h3>
            <div class="fh-dp-chart" role="img" aria-label="Mise de fonds minimale selon la tranche de prix d'achat">
              <div class="fh-dp-row">
                <div class="fh-dp-label">Jusqu'à 500 000 $</div>
                <div class="fh-dp-bar-wrap"><div class="fh-dp-bar" style="width: 20%;"></div><span class="fh-dp-pct">5 %</span></div>
                <div class="fh-dp-example">500 000 $ → 25 000 $</div>
              </div>
              <div class="fh-dp-row">
                <div class="fh-dp-label">500 001 $–1 499 999 $</div>
                <div class="fh-dp-bar-wrap"><div class="fh-dp-bar" style="width: 35%;"></div><span class="fh-dp-pct">5 % + 10 % mixte</span></div>
                <div class="fh-dp-example">700 000 $ → 45 000 $</div>
              </div>
              <div class="fh-dp-row">
                <div class="fh-dp-label">1 500 000 $ et plus</div>
                <div class="fh-dp-bar-wrap"><div class="fh-dp-bar" style="width: 100%;"></div><span class="fh-dp-pct">20 %</span></div>
                <div class="fh-dp-example">1,5 M$ → 300 000 $</div>
              </div>
            </div>
            <p style="margin-top:12px;font-size:14px;color:var(--ink-mute);">Moins de 20 % de mise de fonds = assurance prêt hypothécaire par défaut (SCHL) (environ 2,8 %–4 % de l'hypothèque, intégrée au prêt). La TVP de l'Ontario de 8 % sur la prime est due en argent comptant le jour de la clôture.</p>

            <h3 style="margin-top:26px;">Votre coût mensuel réel</h3>
            <div class="fh-closing-stack">
              <div class="fh-closing-row"><span>Paiement hypothécaire</span><span>Capital + intérêt</span></div>
              <div class="fh-closing-row"><span>+ Frais de copropriété</span><span>Entretien de l'immeuble</span></div>
              <div class="fh-closing-row"><span>+ Impôt foncier</span><span>Toujours séparé des frais</span></div>
              <div class="fh-closing-row"><span>+ Assurance de l'unité</span><span>Votre propre police</span></div>
              <div class="fh-closing-row"><span>+ Services publics non inclus</span><span>Hydro, internet, câble</span></div>
              <div class="fh-closing-row fh-closing-row-total"><span><strong>= Votre coût mensuel réel</strong></span><span>Calculez-le avant de tomber en amour</span></div>
            </div>

            <p style="margin-top:14px;"><strong>Essayez-le en direct :</strong> <a href="/french/payment-calculator">Calculatrice hypothécaire</a> · <a href="/french/rent-vs-buy-calculator">Calculatrice Louer vs Acheter</a>.</p>

            <!-- ============================================================
                 PART 3 — PROGRAMS
                 ============================================================ -->
            <h2 id="programs" style="margin-top:48px;">Partie 3 · Les programmes gouvernementaux qui se cumulent</h2>
            <p>Utilisez-les. Ce sont les plus grosses économies faciles à obtenir.</p>

            <div class="fh-program-grid">
              <div class="fh-program-card">
                <div class="fh-program-tag">Épargne</div>
                <div class="fh-program-title">CELIAPP</div>
                <p><strong>8 000 $/année, 40 000 $ à vie.</strong> Réduit votre revenu imposable à l'entrée. Sort libre d'impôt pour votre première propriété. Vous ne le remboursez jamais. Maximum pour une seule année : <strong>16 000 $</strong>. <a href="/french/blog/fhsa">Guide complet.</a></p>
              </div>
              <div class="fh-program-card">
                <div class="fh-program-tag">REER</div>
                <div class="fh-program-title">Régime d'accession à la propriété (RAP)</div>
                <p>Jusqu'à <strong>60 000 $ par personne</strong> (120 000 $ par couple). Remboursable sur 15 ans. L'argent doit rester dans le REER <strong>90 jours</strong> avant le retrait. Utilisez le CELIAPP en premier.</p>
              </div>
              <div class="fh-program-card">
                <div class="fh-program-tag">Crédit d'impôt</div>
                <div class="fh-program-title">Crédit d'impôt pour premier acheteur</div>
                <p><strong>1 500 $</strong> de retour à l'impôt. Petit, mais automatique. Réclamez-le sur votre prochaine déclaration après la clôture.</p>
              </div>
              <div class="fh-program-card">
                <div class="fh-program-tag">Remboursement des droits de mutation</div>
                <div class="fh-program-title">Remboursement des droits de mutation immobilière</div>
                <p>Ontario jusqu'à <strong>4 000 $</strong>. Toronto, un supplément de <strong>4 475 $</strong>. Plafond combiné <strong>8 475 $</strong>. Vous ne devez jamais avoir été propriétaire d'une maison où que ce soit dans le monde.</p>
              </div>
            </div>

            <details class="b60-section-toggle" style="margin-top:22px;">
              <summary class="b60-section-toggle-summary">Constructions neuves seulement : remboursements de TVH (jusqu'à 130 000 $ combinés)</summary>
              <div class="b60-section-body">
                <p>Les condos de revente n'ont pas de TVH. Les condos neufs d'un constructeur, oui.</p>
                <ul class="bullets">
                  <li><strong>Remboursement fédéral pour premier acheteur :</strong> jusqu'à <strong>50 000 $</strong> sur les propriétés admissibles.</li>
                  <li><strong>Programme temporaire de l'Ontario :</strong> jusqu'à <strong>80 000 $</strong>. La fenêtre actuelle exige que la convention soit signée d'ici le <strong>31 mars 2027</strong>.</li>
                  <li><strong>Plafond combiné :</strong> jusqu'à <strong>130 000 $</strong>.</li>
                </ul>
                <p><strong>Les règles de cumul sont complexes.</strong> Demandez à votre avocat et à votre comptable avant de signer quoi que ce soit. Voir aussi le <a href="/french/blog/fthb-rebate">dossier complet sur le remboursement FTHB</a>.</p>
              </div>
            </details>

            <!-- ============================================================
                 PART 4 — STATUS CERTIFICATE
                 ============================================================ -->
            <h2 id="status" style="margin-top:48px;">Partie 4 · Le certificat d'état — ne sautez PAS cette étape</h2>
            <p>Le document le plus important dans un achat de condo.</p>

            <div class="fh-formula" style="justify-content: flex-start; flex-wrap: wrap;">
              <div class="fh-formula-cell">
                <div class="fh-formula-label">Livraison</div>
                <div class="fh-formula-value">10 jours</div>
                <div class="fh-formula-sub">à partir de votre demande écrite</div>
              </div>
              <div class="fh-formula-op">·</div>
              <div class="fh-formula-cell">
                <div class="fh-formula-label">Frais (plafonnés par la loi)</div>
                <div class="fh-formula-value">100 $</div>
                <div class="fh-formula-sub">taxes incluses</div>
              </div>
              <div class="fh-formula-op">·</div>
              <div class="fh-formula-cell fh-formula-result">
                <div class="fh-formula-label">Qui le révise</div>
                <div class="fh-formula-value" style="font-size:20px;">VOTRE AVOCAT</div>
                <div class="fh-formula-sub">pas vous</div>
              </div>
            </div>

            <h3 style="margin-top:22px;">Ce qu'il contient</h3>
            <ul class="bullets">
              <li>Le solde du <strong>fonds de réserve</strong> + la dernière étude du fonds de réserve</li>
              <li>Le <strong>budget</strong> actuel et les <strong>frais de copropriété</strong> actuels pour votre unité</li>
              <li>Toute <strong>cotisation spéciale</strong> approuvée ou à venir</li>
              <li>La <strong>déclaration, les règlements et les règles</strong></li>
              <li>Le <strong>certificat d'assurance</strong></li>
              <li>Toute <strong>poursuite judiciaire</strong> impliquant le syndicat</li>
              <li>Si le propriétaire actuel <strong>doit de l'argent</strong> sur l'unité</li>
            </ul>

            <div class="callout" style="border-left: 3px solid var(--ink); padding-left: 22px;">
              <strong>Votre offre doit être conditionnelle à la révision du certificat d'état par votre avocat.</strong> Prévoyez assez de jours pour réellement l'obtenir et le lire. C'est exactement pour ça que vous payez un avocat.
            </div>

            <!-- ============================================================
                 PART 5 — RESERVE FUND
                 ============================================================ -->
            <h2 id="reserve" style="margin-top:48px;">Partie 5 · Fonds de réserve &amp; cotisations spéciales</h2>
            <p>Le fonds de réserve est le compte d'épargne de l'immeuble pour les grosses réparations — toit, ascenseurs, fenêtres, garage, chaudières. Chaque propriétaire y contribue par ses frais mensuels.</p>

            <div class="callout" style="border-left: 3px solid #b8002e; padding-left: 22px;">
              <strong>Pourquoi c'est plus important que tout le reste :</strong> si le fonds de réserve est trop petit quand une grosse réparation devient nécessaire, le syndicat facture directement les propriétaires. C'est une <strong>cotisation spéciale</strong>. Elle peut se chiffrer à des milliers, voire des dizaines de milliers de dollars par unité, exigible à court préavis, sans possibilité de s'y soustraire. Si vous êtes propriétaire le jour où elle est imposée, vous la devez.
            </div>

            <h3 style="margin-top:22px;">Comment vérifier</h3>
            <ul class="bullets">
              <li>Lisez l'<strong>étude du fonds de réserve</strong>. Elle projette les réparations futures et si le fonds peut les couvrir.</li>
              <li>Regardez l'<strong>historique des frais</strong>. Des frais qui n'augmentent jamais sont un signal d'alarme, pas un bon signe — les coûts montent, et un syndicat qui refuse d'augmenter les frais sous-finance souvent sa réserve.</li>
              <li>Demandez si des <strong>travaux majeurs</strong> sont prévus dans les cinq prochaines années.</li>
            </ul>

            <h3 style="margin-top:22px;">L'âge délicat</h3>
            <p>Les immeubles d'environ <strong>15 à 25 ans</strong> vivent souvent leur première vague de réparations majeures d'un seul coup : fenêtres, balcons, membrane du garage, ascenseurs. Examinez de très près le fonds de réserve des immeubles de cette tranche d'âge.</p>

            <!-- ============================================================
                 PART 6 — CONDO FEES
                 ============================================================ -->
            <h2 id="fees" style="margin-top:48px;">Partie 6 · Frais de copropriété</h2>

            <div class="fh-before-after" style="grid-template-columns: 1fr 1fr;">
              <div class="fh-ba-col fh-ba-do">
                <div class="fh-ba-title">Ce que les frais couvrent HABITUELLEMENT</div>
                <ul>
                  <li>Entretien de l'immeuble</li>
                  <li>Assurance de l'immeuble</li>
                  <li>Commodités (piscine, gym, salle de réception)</li>
                  <li>Personnel, déneigement &amp; aménagement paysager</li>
                  <li>Cotisations au fonds de réserve</li>
                  <li>Souvent l'eau et le chauffage</li>
                </ul>
              </div>
              <div class="fh-ba-col fh-ba-dont">
                <div class="fh-ba-title">Ce que les frais ne couvrent HABITUELLEMENT PAS</div>
                <ul>
                  <li>Les réparations de votre propre unité</li>
                  <li>Votre propre assurance de condo</li>
                  <li>L'hydro (dans plusieurs immeubles)</li>
                  <li>Internet et câble (dans la plupart)</li>
                  <li>L'impôt foncier — toujours séparé</li>
                </ul>
              </div>
            </div>

            <p style="margin-top:14px;"><strong>Des frais élevés ne sont pas toujours mauvais.</strong> Un immeuble avec piscine, gym, concierge et salle de réception coûte plus cher à exploiter. Ce qui compte, c'est si les frais sont raisonnables pour ce que vous obtenez, et si la réserve est bien financée.</p>

            <p><strong>Des frais bas combinés à un fonds de réserve faible, c'est la combinaison dangereuse.</strong> Prévoyez que les frais augmentent chaque année — demandez l'historique des cinq dernières années.</p>

            <!-- ============================================================
                 PART 7 — PARKING
                 ============================================================ -->
            <h2 id="parking" style="margin-top:48px;">Partie 7 · Stationnement, casiers &amp; ce que vous possédez réellement</h2>
            <p>Trois arrangements — ils ne sont pas équivalents.</p>

            <div class="fh-program-grid" style="grid-template-columns: repeat(3, 1fr);">
              <div class="fh-program-card">
                <div class="fh-program-tag">Le meilleur</div>
                <div class="fh-program-title">Propriété (enregistré au titre)</div>
                <p>Vous en êtes propriétaire. Ça figure au titre. Dans certains immeubles, vous pouvez le vendre séparément.</p>
              </div>
              <div class="fh-program-card">
                <div class="fh-program-tag">Correct</div>
                <div class="fh-program-title">Usage exclusif</div>
                <p>Appartient au syndicat, mais vous seul pouvez l'utiliser. Vous ne pouvez généralement pas le vendre séparément.</p>
              </div>
              <div class="fh-program-card" style="border-left-color: #b8002e;">
                <div class="fh-program-tag" style="color: #b8002e;">Risqué</div>
                <div class="fh-program-title">Loué</div>
                <p>Appartient à quelqu'un d'autre. Cesse d'être à vous quand le bail se termine.</p>
              </div>
            </div>

            <div class="callout" style="border-left: 3px solid var(--ink); padding-left: 22px; margin-top:18px;">
              <strong>Confirmez lequel des trois par écrit avant de lever vos conditions.</strong> Des acheteurs découvrent régulièrement après la clôture que la place qu'ils ont visitée n'est pas incluse. Confirmez aussi : assez grande pour votre voiture ? Où est-elle située ? Une place au P5 au fond n'est pas la même chose qu'une place près de l'ascenseur.
            </div>

            <!-- ============================================================
                 PART 8 — RULES
                 ============================================================ -->
            <h2 id="rules" style="margin-top:48px;">Partie 8 · Les règles sous lesquelles vous vivrez</h2>
            <p>Les règles de condo sont exécutoires. Lisez-les AVANT d'acheter, pas après.</p>

            <ul class="bullets">
              <li><strong>Animaux.</strong> Limites de poids, limites de race, ou interdictions pures et simples sont courantes.</li>
              <li><strong>Locations à court terme.</strong> La plupart des immeubles les interdisent maintenant (pas d'Airbnb).</li>
              <li><strong>Locations à long terme.</strong> Certains immeubles limitent le nombre d'unités pouvant être louées.</li>
              <li><strong>Tabagisme.</strong> Beaucoup d'immeubles sont maintenant sans fumée, y compris le cannabis, y compris sur les balcons.</li>
              <li><strong>Rénovations.</strong> Vous avez généralement besoin de l'approbation du conseil pour les planchers, la plomberie et tout ce qui est structural. <strong>Le bois franc est interdit</strong> dans plusieurs immeubles au-dessus du rez-de-chaussée.</li>
              <li><strong>Usage du balcon.</strong> Les barbecues, l'entreposage et les moustiquaires sont souvent restreints.</li>
              <li><strong>Déménagement.</strong> Réservations d'ascenseur, dépôts et plages horaires sont la norme.</li>
            </ul>

            <!-- ============================================================
                 PART 9 — INSURANCE
                 ============================================================ -->
            <h2 id="insurance" style="margin-top:48px;">Partie 9 · Assurance — la partie que personne n'explique</h2>
            <p>Il y a DEUX polices, et vous devez comprendre les deux.</p>

            <div class="fh-before-after" style="grid-template-columns: 1fr 1fr;">
              <div class="fh-ba-col fh-ba-after">
                <div class="fh-ba-title">La police du syndicat</div>
                <ul>
                  <li>Couvre l'immeuble</li>
                  <li>Couvre les aires communes (hall, corridors, ascenseurs, toit)</li>
                  <li>Payée à même vos frais de copropriété</li>
                </ul>
              </div>
              <div class="fh-ba-col fh-ba-do">
                <div class="fh-ba-title">VOTRE police (propriétaire de l'unité)</div>
                <ul>
                  <li>Couvre votre contenu</li>
                  <li>Couvre vos améliorations</li>
                  <li>Couvre votre responsabilité civile</li>
                  <li>Couvre vos frais de subsistance si vous êtes forcé de quitter</li>
                </ul>
              </div>
            </div>

            <h3 style="margin-top:22px;">Le piège de la franchise</h3>
            <div class="callout" style="border-left: 3px solid #b8002e; padding-left: 22px;">
              Si un dégât commence dans votre unité — un boyau qui éclate, une baignoire qui déborde — le syndicat peut vous refacturer sa franchise d'assurance. Ces franchises sont souvent de <strong>25 000 $ à 100 000 $, voire plus</strong>.
            </div>
            <p style="margin-top:14px;">Votre police de condo personnelle a besoin d'une couverture spécifique pour ça. C'est habituellement peu coûteux à ajouter. <strong>Demandez-la nommément à votre courtier d'assurance</strong>, et remettez-lui une copie du certificat d'état pour qu'il puisse ajuster le montant.</p>

            <!-- ============================================================
                 PART 10 — RESALE
                 ============================================================ -->
            <h2 id="resale" style="margin-top:48px;">Partie 10 · Acheter un condo de revente — quoi vérifier</h2>

            <details class="b60-section-toggle">
              <summary class="b60-section-toggle-summary">L'unité — étage, orientation, lumière, bruit, plan</summary>
              <div class="b60-section-body">
                <ul class="bullets">
                  <li><strong>Étage et orientation.</strong> Le sud et l'ouest reçoivent plus de lumière et de chaleur. Le nord est sombre et plus frais. L'est est lumineux le matin.</li>
                  <li><strong>Ce qu'il y a devant votre fenêtre.</strong> Vérifiez si un terrain voisin est vacant ou approuvé pour une tour. Votre vue peut disparaître.</li>
                  <li><strong>Le bruit.</strong> Cages d'ascenseur, vide-ordures, salles mécaniques, salles de réception, bars au niveau de la rue. Visitez le soir.</li>
                  <li><strong>Le plan.</strong> Les unités longues et étroites, et celles sans fenêtre dans la chambre, sont plus difficiles à revendre.</li>
                  <li><strong>La superficie réelle.</strong> Demandez le plan d'étage du constructeur. Les superficies affichées varient.</li>
                  <li><strong>Chauffage et climatisation.</strong> Les immeubles plus âgés ont souvent une bascule saisonnière, ce qui veut dire aucune climatisation au début de l'automne.</li>
                </ul>
              </div>
            </details>

            <details class="b60-section-toggle">
              <summary class="b60-section-toggle-summary">L'immeuble — ascenseurs, propreté, inscriptions, ratio de locataires</summary>
              <div class="b60-section-body">
                <ul class="bullets">
                  <li><strong>Ratio d'ascenseurs.</strong> Trop peu d'ascenseurs pour trop d'unités = de longues attentes tous les jours.</li>
                  <li><strong>Propreté des aires communes.</strong> Un hall bien entretenu signale généralement un syndicat bien géré.</li>
                  <li><strong>Nombre d'unités à vendre.</strong> Plusieurs en même temps peuvent signaler un problème.</li>
                  <li><strong>Pourcentage de locataires.</strong> Des ratios de locataires très élevés peuvent affecter le financement et l'entretien de l'immeuble.</li>
                  <li><strong>Parlez au concierge ou à un résident.</strong> Ils vous diront des choses qu'aucune inscription ne révèle.</li>
                </ul>
              </div>
            </details>

            <!-- ============================================================
                 PART 11 — PRE-CONSTRUCTION
                 ============================================================ -->
            <h2 id="preconstruction" style="margin-top:48px;">Partie 11 · Acheter un condo en préconstruction</h2>
            <p>Processus différent, risques différents. Lisez attentivement si vous y songez.</p>

            <div class="callout" style="border-left: 3px solid #1a6b32; padding-left: 22px;">
              <strong>La période de réflexion de 10 jours.</strong> En vertu de la Loi sur les condominiums, vous avez <strong>10 jours civils</strong> après la signature pour annuler et récupérer votre dépôt en entier (les fins de semaine sont incluses). <strong>Utilisez chacun de ces jours.</strong> Faites réviser la convention, la déclaration de renseignements, le budget et l'addenda Tarion par un avocat expérimenté en préconstruction. C'est votre seule fenêtre pour négocier. (<em>Les condos de revente et les maisons en propriété franche n'ont AUCUNE période de réflexion.</em>)
            </div>

            <details class="b60-section-toggle">
              <summary class="b60-section-toggle-summary">Dépôts &amp; occupation intérimaire — la partie mal comprise</summary>
              <div class="b60-section-body">
                <p><strong>Dépôts.</strong> Habituellement 15 %–20 % du prix, payés en versements échelonnés sur plusieurs mois. Les dépôts de condo doivent être détenus en fiducie en vertu de la Loi sur les condominiums.</p>
                <p><strong>Occupation intérimaire.</strong> Quand votre unité est prête mais que l'immeuble n'est pas encore enregistré, vous pouvez emménager sans en être propriétaire. Vous payez des <strong>frais d'occupation</strong> mensuels au constructeur couvrant l'intérêt estimé sur le solde impayé, l'impôt foncier estimé et les frais de copropriété estimés.</p>
                <div class="callout" style="border-left: 3px solid #b8002e; padding-left: 22px;">
                  <strong>Ce n'est PAS un paiement hypothécaire. Ça ne vous bâtit aucun avoir. Vous ne pouvez pas le déduire.</strong> L'occupation intérimaire dure habituellement de 3 à 18 mois. Sur un gros projet, plus longtemps. Budgétez-la comme un paiement de loyer supplémentaire en plus de tout le reste.
                </div>
              </div>
            </details>

            <details class="b60-section-toggle">
              <summary class="b60-section-toggle-summary">Redevances d'aménagement, cession, et le piège de la TVH</summary>
              <div class="b60-section-body">
                <ul class="bullets">
                  <li><strong>Redevances d'aménagement.</strong> Les frais de clôture d'un condo neuf sont beaucoup plus élevés que pour une revente. Attendez-vous à des redevances d'aménagement et d'éducation, des raccordements aux services publics, l'inscription Tarion, des frais juridiques — au total 3 % à 5 % du prix. <strong>Négociez un plafond sur les redevances d'aménagement</strong> pendant votre période de réflexion de 10 jours. Des redevances non plafonnées peuvent atteindre des dizaines de milliers de dollars. C'est l'une des choses les plus précieuses que votre avocat puisse faire pour vous.</li>
                  <li><strong>Cession.</strong> Vendre votre contrat avant la clôture. Beaucoup de constructeurs la restreignent, exigent des frais élevés, ou l'interdisent carrément. Si la flexibilité compte pour vous, vérifiez cette clause avant de signer.</li>
                  <li><strong>Le piège de la TVH.</strong> Le remboursement de TVH pour condo neuf s'adresse aux gens qui <em>y emménagent</em>. Si vous achetez avec l'intention d'y habiter puis que vous le louez à la clôture, le remboursement crédité par le constructeur peut être récupéré — vous pourriez devoir une somme importante le jour de la clôture. Il existe un remboursement distinct pour les propriétaires-bailleurs, avec des règles différentes. Ne devinez pas — demandez à votre comptable.</li>
                </ul>
              </div>
            </details>

            <details class="b60-section-toggle">
              <summary class="b60-section-toggle-summary">Garantie Tarion (1 / 2 / 7 ans)</summary>
              <div class="b60-section-body">
                <p>Les condos neufs viennent avec une couverture de garantie en trois étapes :</p>
                <div class="fh-formula" style="justify-content: space-around;">
                  <div class="fh-formula-cell">
                    <div class="fh-formula-label">Malfaçons</div>
                    <div class="fh-formula-value">1 an</div>
                  </div>
                  <div class="fh-formula-cell">
                    <div class="fh-formula-label">Eau, électricité, plomberie, chauffage</div>
                    <div class="fh-formula-value">2 ans</div>
                  </div>
                  <div class="fh-formula-cell fh-formula-result">
                    <div class="fh-formula-label">Vices structuraux majeurs</div>
                    <div class="fh-formula-value">7 ans</div>
                  </div>
                </div>
                <p>Il existe aussi des protections pour les dépôts, les retards d'occupation et l'annulation du projet. Les délais pour déposer une réclamation sont stricts. Faites votre <strong>inspection préalable à la livraison</strong> avec soin — c'est votre seule chance de documenter les défauts au dossier.</p>
              </div>
            </details>

            <details class="b60-section-toggle">
              <summary class="b60-section-toggle-summary">Le risque honnête</summary>
              <div class="b60-section-body">
                <p>Les projets prennent des années de retard. Certains sont annulés. Vos finances doivent rester stables tout au long du processus, car votre hypothèque est approuvée vers la fin, pas au début. Si votre revenu baisse ou que les taux montent, vous pouvez vous retrouver coincé.</p>
              </div>
            </details>

            <!-- ============================================================
                 PART 12 — INTERNATIONAL BUYERS
                 ============================================================ -->
            <h2 id="international" style="margin-top:48px;">Partie 12 · Pour les acheteurs internationaux</h2>
            <p>Si vous n'êtes ni citoyen canadien ni résident permanent, vos règles sont différentes. Lisez cette section AVANT de magasiner.</p>

            <div class="callout" style="border-left: 3px solid #b8002e; padding-left: 22px;">
              <strong>Interdiction fédérale d'achat pour non-Canadiens.</strong> En vertu de la Loi sur l'interdiction d'achat d'immeubles résidentiels par des non-Canadiens, il est actuellement interdit aux non-Canadiens d'acheter la plupart des immeubles résidentiels (interdiction prolongée jusqu'au 1er janvier 2027 au moins). Il existe des exceptions limitées — étudiants internationaux, titulaires de permis de travail répondant à des conditions précises, réfugiés, et certains diplomates. <strong>Confirmez votre admissibilité auprès d'un avocat immobilier canadien avant de signer quoi que ce soit.</strong> Voir mon <a href="/french/blog/foreign-buyer-ban">dossier complet sur l'interdiction</a>.
            </div>

            <h3 style="margin-top:22px;">Taxe de spéculation des non-résidents (NRST)</h3>
            <p>Si vous entrez dans une exception légale à l'interdiction et pouvez acheter, l'Ontario impose aussi une <strong>Taxe de spéculation des non-résidents (NRST) de 25 %</strong> sur le prix d'achat pour les non-citoyens et les non-résidents permanents. Elle est due le jour de la clôture, en plus des droits de mutation immobilière. Il existe des remboursements limités (par exemple, si vous devenez résident permanent par la suite dans un délai prescrit).</p>

            <h3 style="margin-top:22px;">Liste de vérification pratique pour les acheteurs internationaux</h3>
            <ul class="bullets">
              <li><strong>Confirmez d'abord votre admissibilité.</strong> Un avocat immobilier canadien doit examiner votre statut d'immigration par rapport à l'interdiction fédérale AVANT que vous fassiez une offre. Ne vous fiez pas à un constructeur ou à un COURTIER IMMOBILIER®.</li>
              <li><strong>Ouvrez un compte bancaire canadien.</strong> Vous en aurez besoin pour détenir votre dépôt et vos fonds de clôture. Certaines banques canadiennes offrent des programmes « nouveaux arrivants » pour les personnes qui se relocalisent.</li>
              <li><strong>Attendez-vous à une mise de fonds plus élevée.</strong> Pour la plupart des emprunteurs non-résidents, les prêteurs exigent 35 % et plus de mise de fonds. Certains exigent 50 %. Les hypothèques assurées ne sont généralement pas offertes.</li>
              <li><strong>Documentation de la provenance des fonds.</strong> En vertu des règles canadiennes de lutte contre le blanchiment d'argent (FINTRAC — le Centre d'analyse des opérations et déclarations financières du Canada), on vous demandera de documenter la provenance de votre mise de fonds. Relevés bancaires des 3 à 12 derniers mois, lettres d'employeurs, déclarations de revenus de votre pays d'origine, et lettres de don si les fonds proviennent de votre famille. Commencez à les rassembler tôt.</li>
              <li><strong>Risque de change.</strong> Si vos revenus et vos économies sont dans une autre devise, le taux de change peut varier de 5 % à 15 % entre l'offre et la clôture. Envisagez un contrat à terme avec une firme de change canadienne pour verrouiller le taux.</li>
              <li><strong>Obligations fiscales.</strong> Les non-résidents propriétaires d'un bien immobilier canadien sont soumis à des règles de retenue d'impôt sur les revenus locatifs, et lors de la vente éventuelle. Parlez à un comptable canadien ayant de l'expérience en fiscalité transfrontalière.</li>
              <li><strong>Représentation juridique.</strong> Engagez un avocat immobilier canadien indépendant du constructeur. Si vous achetez en préconstruction, engagez-en un spécifiquement expérimenté en condos préconstruction.</li>
              <li><strong>Pièces d'identité et vérification d'identité.</strong> En vertu des règles immobilières de l'Ontario, votre courtier doit vérifier votre identité au moyen d'une pièce d'identité émise par un gouvernement. Ayez votre passeport et vos documents d'immigration prêts.</li>
              <li><strong>Gestion de la propriété.</strong> Si vous prévoyez louer l'unité depuis l'étranger, budgétez 8 % à 12 % du loyer brut pour un gestionnaire de propriété, et assurez-vous que l'immeuble permet les locations à long terme (plusieurs immeubles les restreignent).</li>
              <li><strong>Contact d'urgence et adresse postale.</strong> Vous aurez besoin d'une adresse postale canadienne pour les factures d'impôt foncier, les avis du syndicat et la correspondance municipale. Certains gestionnaires de propriété offrent ce service.</li>
            </ul>

            <div class="callout" style="border-left: 3px solid var(--ink); padding-left: 22px;">
              <strong>Mon avis honnête :</strong> si vous êtes un non-Canadien en 2026–2027, la voie la plus sûre est de (1) confirmer votre admissibilité par écrit auprès d'un avocat, (2) budgéter pour la NRST + une mise de fonds plus élevée + des frais de clôture plus élevés, et (3) accepter que c'est un engagement de 5 ans ou plus. Acheter puis revendre rapidement un condo canadien en tant que non-résident n'est pas une stratégie viable selon les règles actuelles.
            </div>

            <!-- ============================================================
                 RED FLAGS
                 ============================================================ -->
            <h2 id="redflags" style="margin-top:48px;">Signaux d'alarme — ralentissez si vous voyez ceci</h2>
            <ul class="bullets">
              <li>L'étude du fonds de réserve indique que le fonds est sous-financé</li>
              <li>Une cotisation spéciale approuvée, discutée, ou « à l'étude »</li>
              <li>Des frais de copropriété qui n'ont pas augmenté depuis plusieurs années</li>
              <li>Des poursuites judiciaires actives impliquant le syndicat</li>
              <li>Des réparations majeures en cours sans plan de financement clair</li>
              <li>Un roulement fréquent des sociétés de gestion de la propriété</li>
              <li>Un grand nombre d'unités à vendre en même temps</li>
              <li>Des problèmes connus touchant tout l'immeuble : fuites, revêtement extérieur, membrane du garage, plomberie</li>
              <li>Toute pression pour <strong>renoncer à la condition du certificat d'état</strong></li>
            </ul>

            <!-- ============================================================
                 COMMON MISTAKES
                 ============================================================ -->
            <h2 id="mistakes" style="margin-top:48px;">Les 10 erreurs les plus courantes des acheteurs de condo</h2>
            <ol class="bullets" style="list-style: decimal; padding-left: 20px;">
              <li><strong>Sauter ou bâcler le certificat d'état.</strong> L'erreur la plus coûteuse dans l'achat d'un condo.</li>
              <li><strong>Ignorer le fonds de réserve.</strong> Les cotisations spéciales n'ont aucun plafond.</li>
              <li><strong>Oublier que les frais de copropriété réduisent votre approbation hypothécaire.</strong></li>
              <li><strong>Supposer que la place de stationnement ou le casier est inclus.</strong> Confirmez par écrit.</li>
              <li><strong>Ne pas lire les règles.</strong> Puis découvrir l'interdiction des animaux ou du bois franc après la clôture.</li>
              <li><strong>Acheter sans l'assurance appropriée</strong> pour la franchise du syndicat.</li>
              <li><strong>Ne pas vérifier ce qui peut être construit à côté.</strong> Les vues ne sont pas protégées.</li>
              <li><strong>Ne pas visiter le soir ou la fin de semaine.</strong></li>
              <li><strong>Traiter la préconstruction comme une revente.</strong> Les frais d'occupation et les redevances prennent les gens par surprise.</li>
              <li><strong>Gaspiller la période de réflexion de 10 jours.</strong> C'est le seul levier de négociation que vous obtenez sur une construction neuve.</li>
            </ol>

