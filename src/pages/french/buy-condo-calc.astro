---
import BaseLayout from '../../layouts/BaseLayout.astro';
import TopBar from '../../components/FrenchTopBar.astro';
import Header from '../../components/FrenchHeader.astro';
import Footer from '../../components/FrenchFooter.astro';
import CTASection from '../../components/FrenchCTASection.astro';
import { CONFIG } from '../../lib/condo-calc.js';

export const prerender = true;

const rateDate = new Date(CONFIG.RATE_LAST_UPDATED + 'T12:00:00Z').toLocaleDateString('fr-CA', { year: 'numeric', month: 'long', day: 'numeric', timeZone: 'UTC' });

const hreflangAlternates = [
  { hreflang: 'en-CA', href: 'https://www.realtorpeterlaw.com/buy-condo-calc' },
  { hreflang: 'zh-CN', href: 'https://www.realtorpeterlaw.com/chinese/buy-condo-calc' },
  { hreflang: 'fr-CA', href: 'https://www.realtorpeterlaw.com/french/buy-condo-calc' },
  { hreflang: 'x-default', href: 'https://www.realtorpeterlaw.com/buy-condo-calc' },
];
---
<BaseLayout
  title="BUY Condo Calc. | Calculateur du coût mensuel d'un condo à Toronto | Peter Law"
  description="Le vrai coût mensuel d'un condo de revente à Toronto, tout compris : hypothèque, frais de condo, taxes foncières, services publics et assurance, plus l'argent requis le jour de la clôture."
  lang="fr"
  bodyClass="fr calc-page"
  hreflangAlternates={hreflangAlternates}
>
  <TopBar />
  <Header active="buyers" />

  <section class="page-hero">
    <div class="wrap">
      <div class="eyebrow">BUY Condo Calc.</div>
      <h1>Calculateur du coût mensuel d'un condo à Toronto</h1>
      <p>Condos de revente seulement. Quatre chiffres suffisent pour obtenir le coût mensuel tout compris, pas seulement le paiement hypothécaire. Contactez Peter pour plus d'information sur l'achat et le financement. Parler à un courtier hypothécaire est recommandé.</p>
    </div>
  </section>

  <section class="major" style="padding-top: 24px;">
    <div class="wrap">
      <div class="ac-shell cc-shell">

        <!-- ============================ INPUTS ============================ -->
        <div class="ac-inputs cc-inputs">
          <div class="ac-input-group">
            <label for="cc-price">Prix d'achat</label>
            <div class="input-prefix"><input type="text" id="cc-price" inputmode="decimal" placeholder="p. ex. 650 000,00" /></div>
          </div>

          <div class="ac-input-group cc-down-group" id="cc-down-wrap" data-mode="%">
            <label for="cc-down">Mise de fonds</label>
            <div class="cc-down-row">
              <div class="cc-mode" role="group" aria-label="Entrer la mise de fonds en dollars ou en pourcentage">
                <button type="button" data-down-mode="$" aria-pressed="false">$</button>
                <button type="button" data-down-mode="%" aria-pressed="true" class="is-on">%</button>
              </div>
              <div class="cc-down-input"><input type="text" id="cc-down" inputmode="decimal" value="20" /></div>
            </div>
            <label for="cc-down-slider" class="visually-hidden">Curseur du pourcentage de mise de fonds</label>
            <input type="range" id="cc-down-slider" min="5" max="35" step="0.5" value="20" list="cc-ticks" />
            <datalist id="cc-ticks"><option value="5"></option><option value="10"></option><option value="15"></option><option value="20"></option></datalist>
            <div class="cc-slider-notes"><span id="cc-min-note"></span><span class="cc-pill" id="cc-ins-pill" aria-live="polite"></span></div>
          </div>

          <div class="ac-input-group">
            <label for="cc-fee">Frais de condo mensuels</label>
            <div class="input-prefix"><input type="text" id="cc-fee" inputmode="decimal" placeholder="p. ex. 650,00" /></div>
          </div>

          <div class="ac-input-group ac-checkbox-group cc-sqft-toggle">
            <label for="cc-sqft-on" class="ac-checkbox">
              <input type="checkbox" id="cc-sqft-on" />
              <span class="ac-checkbox-text">Ajouter la superficie <span class="hint">Facultatif. Affiche le prix et les frais par pied carré.</span></span>
            </label>
          </div>
          <div class="ac-input-group" id="cc-sqft-wrap" hidden>
            <label for="cc-sqft">Pieds carrés</label>
            <input type="text" id="cc-sqft" inputmode="numeric" placeholder="p. ex. 720" />
          </div>

          <div class="ac-input-group">
            <label for="cc-rate">Taux hypothécaire <span class="hint">Taux à titre indicatif, mis à jour le <span data-rate-date>{rateDate}</span>. Votre prêteur fixe votre vrai taux.</span></label>
            <div class="input-suffix"><input type="number" id="cc-rate" min="0" max="25" step="0.05" inputmode="decimal" /></div>
          </div>

          <details class="ac-more" id="cc-refine">
            <summary>Préciser cette estimation</summary>
            <div class="ac-more-body">
              <div class="ac-input-group">
                <label for="cc-heat">Les frais incluent-ils le chauffage et l'eau?</label>
                <select id="cc-heat"><option value="yes">Oui</option><option value="no">Non</option></select>
              </div>
              <div class="ac-input-group">
                <label for="cc-hydro">Les frais incluent-ils l'électricité?</label>
                <select id="cc-hydro"><option value="no">Non</option><option value="yes">Oui</option></select>
              </div>
              <div class="ac-input-group">
                <label for="cc-utilities">Services publics mensuels non couverts par les frais</label>
                <div class="input-prefix"><input type="text" id="cc-utilities" inputmode="decimal" /></div>
              </div>
              <div class="ac-input-group">
                <label for="cc-tax">Taxes foncières annuelles <span class="hint">Préremplies à 0,7 % du prix. Utilisez le chiffre de l'inscription si vous l'avez.</span></label>
                <div class="input-prefix"><input type="text" id="cc-tax" inputmode="decimal" /></div>
              </div>
              <div class="ac-input-group">
                <label for="cc-insurance">Assurance de l'unité (mensuelle)</label>
                <div class="input-prefix"><input type="text" id="cc-insurance" inputmode="decimal" data-default="40" /></div>
              </div>
              <div class="ac-input-group">
                <label for="cc-parking">Stationnement</label>
                <select id="cc-parking"><option value="owned">Inclus dans le prix</option><option value="rented">Loué au mois</option><option value="none">Aucun</option></select>
              </div>
              <div class="ac-input-group" id="cc-parking-cost-wrap" hidden>
                <label for="cc-parking-cost">Coût mensuel du stationnement</label>
                <div class="input-prefix"><input type="text" id="cc-parking-cost" inputmode="decimal" data-default="200" /></div>
              </div>
              <div class="ac-input-group">
                <label for="cc-locker">Casier</label>
                <select id="cc-locker"><option value="none">Aucun</option><option value="owned">Inclus dans le prix</option><option value="rented">Loué au mois</option></select>
              </div>
              <div class="ac-input-group" id="cc-locker-cost-wrap" hidden>
                <label for="cc-locker-cost">Coût mensuel du casier</label>
                <div class="input-prefix"><input type="text" id="cc-locker-cost" inputmode="decimal" data-default="50" /></div>
              </div>
              <div class="ac-input-group ac-checkbox-group">
                <label for="cc-fthb" class="ac-checkbox">
                  <input type="checkbox" id="cc-fthb" />
                  <span class="ac-checkbox-text">Je suis un premier acheteur <span class="hint">Donne droit aux remboursements des droits de cession et à un amortissement de 30 ans.</span></span>
                </label>
              </div>
              <div class="ac-input-group">
                <label for="cc-amort">Amortissement</label>
                <select id="cc-amort"><option value="20">20 ans</option><option value="25" selected>25 ans</option><option value="30">30 ans</option></select>
              </div>
              <div class="ac-input-group">
                <label for="cc-toronto">Propriété située dans la ville de Toronto?</label>
                <select id="cc-toronto"><option value="yes">Oui (droits de cession de Toronto applicables)</option><option value="no">Non, ailleurs en Ontario</option></select>
              </div>
              <div class="ac-input-group">
                <label for="cc-income">Revenu brut du ménage (annuel) <span class="hint">Facultatif. Affiche vos ratios de coûts d'habitation.</span></label>
                <div class="input-prefix"><input type="text" id="cc-income" inputmode="decimal" placeholder="facultatif" /></div>
              </div>
              <div class="ac-input-group">
                <label for="cc-debts">Autres paiements de dettes mensuels <span class="hint">Facultatif. Prêt auto, prêt étudiant, minimums de cartes de crédit.</span></label>
                <div class="input-prefix"><input type="text" id="cc-debts" inputmode="decimal" placeholder="facultatif" /></div>
              </div>
            </div>
          </details>
        </div>

        <!-- ============================ RESULTS ============================ -->
        <div class="ac-results cc-results" aria-live="polite">
          <div class="cc-empty" id="cc-empty">Entrez un prix pour voir votre coût mensuel.</div>
          <div class="cc-errors" id="cc-errors" hidden role="alert"></div>

          <div id="cc-out" hidden>
            <div class="cc-headline">
              <div class="ac-headline-label">Votre coût mensuel estimé</div>
              <div class="cc-headline-value" id="cc-total" data-output>$0</div>
              <div class="ac-headline-sub">Tout compris : hypothèque, frais de condo, taxes foncières, services publics et assurance. Exactement <span id="cc-total-cents">0,00 $</span> par mois.</div>
            </div>

            <div class="cc-bar" aria-hidden="true">
              <span class="cc-bar-seg cc-bar-pi" id="cc-bar-pi"></span><span class="cc-bar-seg cc-bar-fee" id="cc-bar-fee"></span><span class="cc-bar-seg cc-bar-tax" id="cc-bar-tax"></span><span class="cc-bar-seg cc-bar-util" id="cc-bar-util"></span><span class="cc-bar-seg cc-bar-ins" id="cc-bar-ins"></span><span class="cc-bar-seg cc-bar-park" id="cc-bar-park"></span>
            </div>

            <div class="cc-sqft" id="cc-sqft-out" hidden>
              <div class="cc-sqft-h">Par pied carré</div>
              <div class="cc-sqft-grid">
                <div class="cc-sqft-item"><span class="cc-sqft-label">Prix par pi²</span><strong id="cc-sqft-price">$0</strong></div>
                <div class="cc-sqft-item"><span class="cc-sqft-label">Frais de condo par pi²</span><strong><span id="cc-sqft-fee">$0</span> <small>par mois</small></strong></div>
              </div>
              <div class="cc-sqft-note">Pratique pour comparer des unités de tailles différentes.</div>
            </div>

            <h2 class="ac-section-h">Détail mensuel</h2>
            <div class="ac-breakdown cc-breakdown">
              <div class="ac-row"><span><i class="cc-dot cc-bar-pi"></i>Paiement hypothécaire</span><strong id="cc-m-pi">$0</strong></div>
              <div class="ac-row"><span><i class="cc-dot cc-bar-fee"></i>Frais de condo</span><strong id="cc-m-fee">$0</strong></div>
              <div class="ac-row"><span><i class="cc-dot cc-bar-tax"></i>Taxes foncières</span><strong id="cc-m-tax">$0</strong></div>
              <div class="ac-row"><span><i class="cc-dot cc-bar-util"></i>Services publics non couverts par les frais</span><strong id="cc-m-util">$0</strong></div>
              <div class="ac-row"><span><i class="cc-dot cc-bar-ins"></i>Assurance condo</span><strong id="cc-m-ins">$0</strong></div>
              <div class="ac-row" id="cc-m-park-row" hidden><span><i class="cc-dot cc-bar-park"></i>Location stationnement / casier</span><strong id="cc-m-park">$0</strong></div>
              <div class="ac-row ac-row-total"><span>Total mensuel</span><strong id="cc-m-total">$0</strong></div>
            </div>

            <h2 class="ac-section-h">Argent comptant requis le jour de la clôture</h2>
            <div class="ac-breakdown cc-closing">
              <div class="ac-row"><span>Mise de fonds</span><strong id="cc-c-down">$0</strong></div>
              <div class="ac-row"><span>TVP sur la prime d'assurance hypothécaire <em class="ac-note" id="cc-c-pst-note"></em></span><strong id="cc-c-pst">$0</strong></div>
              <div class="ac-row"><span>Droits de cession immobilière de l'Ontario</span><strong id="cc-c-ltt-on">$0</strong></div>
              <div class="ac-row" id="cc-c-ltt-tor-row"><span>Droits de cession immobilière de Toronto</span><strong id="cc-c-ltt-tor">$0</strong></div>
              <div class="ac-row" id="cc-c-rebate-row" hidden><span>Remboursements premier acheteur</span><strong id="cc-c-rebate">$0</strong></div>
              <div class="ac-row cc-row-edit"><label for="cc-legal">Frais juridiques</label><span class="input-prefix"><input type="text" id="cc-legal" inputmode="decimal" data-default="2000" /></span></div>
              <div class="ac-row cc-row-edit"><label for="cc-title">Assurance titres, inspection, certificat d'état</label><span class="input-prefix"><input type="text" id="cc-title" inputmode="decimal" data-default="1000" /></span></div>
              <div class="ac-row cc-row-edit"><label for="cc-adjust">Ajustements</label><span class="input-prefix"><input type="text" id="cc-adjust" inputmode="decimal" data-default="500" /></span></div>
              <div class="ac-row ac-row-total"><span>Total requis le jour de la clôture</span><strong id="cc-c-total">$0</strong></div>
            </div>

            <details class="cc-details">
              <summary>Voir les détails</summary>
              <div class="ac-checks cc-checks">
                <div class="ac-check"><div class="ac-check-label">Hypothèque totale, prime d'assurance incluse</div><div class="ac-check-value" id="cc-d-mortgage">$0</div><div class="ac-check-sub" id="cc-d-mortgage-note"></div></div>
                <div class="ac-check"><div class="ac-check-label">Intérêts totaux sur l'amortissement complet</div><div class="ac-check-value" id="cc-d-interest">$0</div><div class="ac-check-sub" id="cc-d-interest-note"></div></div>
                <div class="ac-check"><div class="ac-check-label">Paiement au taux du test de résistance</div><div class="ac-check-value" id="cc-d-stress">$0</div><div class="ac-check-sub" id="cc-d-stress-note"></div></div>
                <div class="ac-check cc-ratios" id="cc-d-ratios"></div>
              </div>
            </details>

            <p class="calc-disclaimer cc-disclaimer">Estimations seulement, à titre indicatif. Ceci n'est ni une préapprobation hypothécaire, ni une soumission, ni un conseil financier. Les taux affichés sont indicatifs en date du <span data-rate-date>{rateDate}</span> et peuvent changer. Les coûts réels varient selon le prêteur, le profil de crédit et la propriété. Confirmez vos chiffres avec un professionnel hypothécaire agréé, un avocat et un comptable avant de signer quoi que ce soit.<br>Peter Law, Représentant commercial, HomeLife Golconda Realty Inc., Brokerage.</p>

            <!-- ============================ LEAD CAPTURE (after the answer, never before) ============================ -->
            <div class="cc-lead">
              <div class="cc-lead-card">
                <h3>Recevoir une estimation par courriel</h3>
                <p>Je vous envoie par courriel un rapport de calcul simple.</p>
                <form method="POST" action="https://formspree.io/f/xnjrzgda" class="cc-lead-form">
                  <div class="cc-lead-fields">
                    <div class="cc-lead-address"><label for="cc-lead-address">Adresse de l'immeuble</label><input id="cc-lead-address" name="building_address" type="text" required autocomplete="street-address" placeholder="p. ex. 55 Mercer St, Toronto" /></div>
                    <div class="cc-lead-unit"><label for="cc-lead-unit">Unité no</label><input id="cc-lead-unit" name="unit_number" type="text" inputmode="numeric" placeholder="p. ex. 1204" /></div>
                    <div class="cc-lead-name"><label for="cc-lead-name">Nom</label><input id="cc-lead-name" name="name" type="text" required autocomplete="name" /></div>
                    <div class="cc-lead-email"><label for="cc-lead-email">Courriel</label><input id="cc-lead-email" name="email" type="email" required autocomplete="email" /></div>
                  </div>
                  <input type="hidden" name="_subject" value="BUY Condo Calc. estimate request (French)" />
                  <input type="hidden" name="_next" value="https://www.realtorpeterlaw.com/french/contact/thanks" />
                  <input type="hidden" name="purchase_price" id="cc-lead-price" value="" />
                  <input type="hidden" name="all_in_monthly" id="cc-lead-total" value="" />
                  <input type="hidden" name="breakdown" id="cc-lead-summary" value="" />
                  <div class="hp-field" aria-hidden="true"><label for="cc-gotcha">Ne pas remplir</label><input id="cc-gotcha" name="_gotcha" type="text" tabindex="-1" autocomplete="off" /></div>
                  <div class="cc-lead-actions">
                    <button type="submit" class="btn-primary">M'ENVOYER le détail par courriel</button>
                  </div>
                </form>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ============================ SEO TEXT ============================ -->
  <section class="major" style="padding-top: 0;">
    <div class="wrap">
      <div class="prose-body cc-prose">
        <h2>Ce que ce calculateur inclut</h2>
        <p>La plupart des calculateurs hypothécaires s'arrêtent au paiement hypothécaire. Dans un condo à Toronto, ce chiffre n'est qu'une partie de la facture. Ce calculateur ajoute les frais de condo mensuels, les taxes foncières, les services publics que les frais ne couvrent pas, l'assurance condo et tout stationnement ou casier loué, pour que le chiffre en tête soit ce qui sort vraiment de votre compte chaque mois.</p>
        <p>L'hypothèque elle-même est calculée à la canadienne : composition semestrielle, mise de fonds minimale fédérale selon le prix, prime d'assurance prêt hypothécaire lorsque la mise de fonds est inférieure à 20 % (surcharge de 30 ans incluse), et TVP ontarienne de 8 % sur cette prime, payée comptant le jour de la clôture plutôt qu'ajoutée à l'hypothèque. Le bloc de clôture montre aussi les droits de cession immobilière de l'Ontario, ceux de la ville de Toronto lorsque le condo est dans la ville, et les remboursements pour premier acheteur sur les deux.</p>
        <p>Entrez le revenu de votre ménage sous « Préciser cette estimation » et vous verrez aussi vos ratios de coûts d'habitation à côté des chiffres que les prêteurs regardent habituellement. L'outil montre les ratios, pas un verdict : c'est votre prêteur qui décide. Pour les maisons et maisons en rangée, ou pour comparer plusieurs prix à la fois, utilisez le <a href="/french/all-calculator">BUY Calculateur</a> complet. Si c'est votre premier condo, le <a href="/french/blog/first-time-buyer-guide-condos">Guide d'achat CONDO première fois</a> passe en revue le certificat d'état, le fonds de réserve et les questions à poser avant d'offrir.</p>
      </div>
    </div>
  </section>

  <CTASection heading="Vous voulez vérifier ces chiffres sur de vraies inscriptions?" lead="Envoyez-moi l'immeuble ou le quartier que vous regardez. En 15 minutes, je vous dis à quoi ressemblent vraiment les frais, les taxes et les coûts de clôture là-bas." />
  <Footer />

  <script>
    import { initCondoCalc } from '../../lib/condo-calc-ui.js';
    initCondoCalc({
      locale: 'fr-CA',
      formatDate: (iso) => new Date(iso + 'T12:00:00Z').toLocaleDateString('fr-CA', { year: 'numeric', month: 'long', day: 'numeric', timeZone: 'UTC' }),
      perMonth: '/mois',
      minNote: (min, p) => `Minimum pour ce prix : ${min} (${p})`,
      pillNotInsurable: 'Sous le minimum légal',
      pillNone: 'Aucune assurance hypothécaire requise (20 % et plus)',
      pillPremium: (rate, amt) => `Assurance hypothécaire : prime de ${rate} (${amt})`,
      errMinDown: (price, min, short, rule) => `La mise de fonds minimale pour un achat de ${price} est de ${min}` + (rule === 'CAP' ? ' (20 % : aucune assurance hypothécaire n\'est offerte à partir de 1 500 000 $)' : rule === 'FIVE' ? ' (5 %)' : ' (5 % des premiers 500 000 $ plus 10 % du reste)') + `. Il vous manque ${short}.`,
      errDownOverPrice: 'La mise de fonds ne peut pas dépasser le prix d\'achat.',
      errAmort30: 'Un amortissement de 30 ans sur une hypothèque assurée (moins de 20 % de mise de fonds) est réservé aux premiers acheteurs. Choisissez 25 ans, mettez 20 % de mise de fonds, ou cochez « premier acheteur » si cela s\'applique à vous.',
      errAmortOver30: 'Les amortissements de plus de 30 ans ne sont pas offerts pour un condo de revente.',
      errRate: 'Entrez un taux hypothécaire supérieur à 0 %.',
      pstNote: (rate, prem) => `8 % de la prime de ${rate} (${prem}), payée comptant`,
      pstNone: 'aucune : 20 % ou plus de mise de fonds',
      mortgageNote: (base, prem) => `${base} empruntés + prime d\'assurance de ${prem} ajoutée au prêt`,
      mortgageNoteNone: 'Aucune prime d\'assurance (20 % ou plus de mise de fonds).',
      interestNote: (yrs, rate) => `Sur ${yrs} ans à ${rate}, si le taux ne changeait jamais et sans paiement supplémentaire.`,
      stressNote: (rate, actual) => `Les prêteurs vous qualifient à ${rate} (le plus élevé de votre taux + 2 % ou 5,25 %). Votre paiement réel est de ${actual}.`,
      gdsText: (gds, guide) => `Vos coûts d\'habitation représentent <strong>${gds}</strong> de votre revenu brut (ABD). Les prêteurs visent généralement ${guide} ou moins.`,
      tdsText: (tds, guide) => `En incluant vos autres dettes, c\'est <strong>${tds}</strong> (ATD). Les prêteurs visent généralement ${guide} ou moins.`,
      ratioNote: 'C\'est votre prêteur qui décide. Ceci est une estimation.',
      ratioEmpty: 'Entrez le revenu de votre ménage sous « Préciser cette estimation » pour voir vos ratios de coûts d\'habitation.',
      sqftSummary: (sf, p, fee) => `${sf} pi² : ${p}/pi², frais ${fee}/pi² par mois`,
      summary: (r, money, pct) => [
        `Prix ${money(r.inputs.price, 0)}, mise de fonds ${money(r.inputs.down, 0)} (${pct(r.inputs.downPct, 1)}), taux ${pct(r.inputs.ratePct)}, ${r.inputs.amort} ans`,
        `Hypothèque ${money(r.monthly.pAndI)} + frais de condo ${money(r.monthly.condoFee)} + taxes ${money(r.monthly.propertyTax)} + services ${money(r.monthly.utilities)} + assurance ${money(r.monthly.insurance)} + stationnement/casier ${money(r.monthly.parkingRent + r.monthly.lockerRent)} = ${money(r.monthly.total)}/mois`,
        `Clôture : mise de fonds ${money(r.closing.down)} + TVP sur la prime ${money(r.closing.premiumPST)} + droits de cession ${money(r.closing.ltt.total)} + juridique/titres/ajustements ${money(r.closing.legal + r.closing.titleEtc + r.closing.adjustments)} = ${money(r.closing.total)}`,
        `Test de résistance ${pct(r.mortgage.stressRate)} = ${money(r.mortgage.stressPayment)}/mois` + (r.ratios ? `; ABD ${pct(r.ratios.gds, 0)}, ATD ${pct(r.ratios.tds, 0)}` : ''),
      ].join(' | '),
    });
  </script>
</BaseLayout>

<style is:global>
  /* BUY Condo Calc. page styles (shared by EN / ZH / FR) */
  .cc-shell [hidden] { display: none !important; }
  .cc-down-row { display: flex; gap: 8px; align-items: stretch; }
  .cc-mode { display: inline-flex; border: 1px solid var(--rule); border-radius: 4px; overflow: hidden; flex: 0 0 auto; }
  .cc-mode button { font: inherit; font-weight: 600; font-size: 14px; padding: 0 14px; background: var(--surface); color: var(--ink-soft); border: 0; cursor: pointer; min-width: 44px; }
  .cc-mode button + button { border-left: 1px solid var(--rule); }
  .cc-mode button.is-on { background: var(--ink); color: var(--bg); }
  .cc-mode button:focus-visible { outline: 2px solid var(--accent); outline-offset: -2px; }
  .cc-down-input { position: relative; flex: 1; }
