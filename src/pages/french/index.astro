---
import BaseLayout from '../../layouts/BaseLayout.astro';
import FrenchTopBar from '../../components/FrenchTopBar.astro';
import FrenchHeader from '../../components/FrenchHeader.astro';
import FrenchFooter from '../../components/FrenchFooter.astro';
import FrenchCTASection from '../../components/FrenchCTASection.astro';
import RecentDeals from '../../components/RecentDeals.astro';
import FrenchRentalQuestionnaire from '../../components/FrenchRentalQuestionnaire.astro';
---
<BaseLayout
  title="Peter Law, Agent immobilier de location à Toronto | Trilingue"
  description="Peter Law | Agent immobilier trilingue à Toronto. J'aide les locataires à se faire approuver, à emménager sans stress. RECO · 647-888-8472."
  lang="fr"
  bodyClass="fr"
  hreflangAlternates={[
    { hreflang: 'x-default', href: 'https://www.realtorpeterlaw.com/' },
    { hreflang: 'en-CA', href: 'https://www.realtorpeterlaw.com/' },
    { hreflang: 'fr-CA', href: 'https://www.realtorpeterlaw.com/french' },
    { hreflang: 'zh-CN', href: 'https://www.realtorpeterlaw.com/chinese' },
  ]}
>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@graph": [
        {
          "@type": "RealEstateAgent",
          "@id": "https://www.realtorpeterlaw.com/french/#agent",
          "name": "Peter Law",
          "jobTitle": "Représentant commercial",
          "description": "Agent immobilier trilingue à Toronto (anglais, chinois, français). Service complet aux locataires, de la recherche à la remise des clés. Enregistré RECO en Ontario.",
          "url": "https://www.realtorpeterlaw.com/french",
          "image": "https://www.realtorpeterlaw.com/photos/peter-portrait.webp",
          "telephone": "+1-647-888-8472",
          "email": "Admin@RealtorPeterLaw.com",
          "priceRange": "$$-$$$",
          "knowsLanguage": ["French", "English", "Chinese"],
          "areaServed": [
            { "@type": "City", "name": "Toronto" },
            { "@type": "AdministrativeArea", "name": "Grand Toronto" },
            { "@type": "City", "name": "Markham" }
          ],
          "sameAs": [
            "https://www.realtor.ca/agent/2071856/peter-law-3601-hwy-7-215-markham-ontario-l3r0m3",
            "https://www.instagram.com/realtorpeterlaw",
            "https://www.facebook.com/RealtorPeterLaw",
            "https://www.linkedin.com/in/peter-law-5053a6192"
          ],
          "worksFor": {
            "@type": "RealEstateAgent",
            "name": "HomeLife Golconda Realty Inc., Brokerage",
            "address": {
              "@type": "PostalAddress",
              "streetAddress": "215 - 3601 HWY 7 East",
              "addressLocality": "Markham",
              "addressRegion": "ON",
              "postalCode": "L3R 0M3",
              "addressCountry": "CA"
            }
          }
        },
        {
          "@type": "WebSite",
          "@id": "https://www.realtorpeterlaw.com/french/#website",
          "url": "https://www.realtorpeterlaw.com/french",
          "name": "Peter Law, Agent immobilier de location à Toronto",
          "publisher": { "@id": "https://www.realtorpeterlaw.com/french/#agent" },
          "inLanguage": ["fr-CA", "en-CA", "zh-CN"]
        },
        {
          "@type": "LocalBusiness",
          "@id": "https://www.realtorpeterlaw.com/french/#brokerage",
          "name": "Peter Law, HomeLife Golconda Realty Inc., Brokerage",
          "url": "https://www.realtorpeterlaw.com/french",
          "telephone": "+1-647-888-8472",
          "email": "Admin@RealtorPeterLaw.com",
          "image": "https://www.realtorpeterlaw.com/photos/peter-portrait.webp",
          "address": {
            "@type": "PostalAddress",
            "streetAddress": "215 - 3601 HWY 7 East",
            "addressLocality": "Markham",
            "addressRegion": "ON",
            "postalCode": "L3R 0M3",
            "addressCountry": "CA"
          },
          "areaServed": [
            { "@type": "City", "name": "Toronto" },
            { "@type": "AdministrativeArea", "name": "Grand Toronto" }
          ]
        }
      ]
    })} />
  </Fragment>

  <FrenchTopBar />
  <FrenchHeader />

    <section class="proof-bar">
    <div class="wrap proof-grid">
      <div class="proof-item"><div class="proof-num"><a class="proof-num-link" href="/french/past-deals">Historique des ventes</a></div><div class="proof-lbl">6 ans à temps plein</div></div>
      <div class="proof-item"><div class="proof-num"><a class="proof-num-link" href="/">EN · 中文</a></div><div class="proof-lbl">Anglais <span class="nocase">l</span> Chinois</div></div>
      <div class="proof-item"><div class="proof-num">RECO</div><div class="proof-lbl">Inscrit en Ontario</div></div>
      <a class="proof-item proof-link" href="https://www.homelifegolconda.com/" target="_blank" rel="noopener"><div class="proof-num">HomeLife</div><div class="proof-lbl">Golconda Realty Inc.</div></a>
    </div>
  </section>

  <section class="hero">
    <div class="wrap">
      <div class="hero-headline-block">
        <div class="eyebrow">Toronto · Centre-ville · Bord de l'eau</div>
        <h1 class="hero-h">La location à Toronto, <em>faite comme il faut.</em></h1>
      </div>
      <div class="hero-grid">
        <div>
          <FrenchRentalQuestionnaire />
        </div>
        <div>
          <div class="hero-photo hero-video">
          <video controls playsinline preload="none" poster="/videos/renting-in-toronto-7-steps-poster.webp" width="806" height="1291" aria-label="Vidéo : Peter Law explique les 7 étapes pour louer à Toronto (en anglais, sous-titres chinois)">
            <source src="/videos/renting-in-toronto-7-steps.mp4" type="video/mp4" />
            <a href="/videos/renting-in-toronto-7-steps.mp4">Vidéo : Peter Law explique les 7 étapes pour louer à Toronto (en anglais, sous-titres chinois)</a>
          </video>
        </div>
        </div>
      </div>
    </div>
  </section>


  <section class="boc-widget" aria-label="Taux directeur de la Banque du Canada et ligne directrice sur l'augmentation des loyers en Ontario">
    <div class="wrap">
      <div class="boc-widget-grid">
        <div class="boc-cell">
          <span class="boc-cell-label">Taux directeur de la Banque du Canada</span>
          <span class="boc-cell-value">2,25<span class="pct">%</span></span>
        </div>
        <div class="boc-divider" aria-hidden="true"></div>
        <div class="boc-cell">
          <span class="boc-cell-label">Prochaine annonce</span>
          <span class="boc-cell-value" style="font-size:21px;">29 octobre 2026</span>
        </div>
        <div class="boc-divider" aria-hidden="true"></div>
        <a class="boc-source" href="https://www.bankofcanada.ca/core-functions/monetary-policy/key-interest-rate/" target="_blank" rel="noopener">Source : bankofcanada.ca ↗</a>
        <hr class="boc-row-rule" aria-hidden="true" />
        <div class="boc-cell">
          <span class="boc-cell-label">Augmentation des loyers en Ontario (2027)</span>
          <span class="boc-cell-value">1,9<span class="pct">%</span></span>
        </div>
        <div class="boc-divider" aria-hidden="true"></div>
        <div class="boc-cell">
          <span class="boc-cell-label">Prochaine annonce</span>
          <span class="boc-cell-value" style="font-size:21px;">Décembre 2027</span>
        </div>
        <div class="boc-divider" aria-hidden="true"></div>
        <a class="boc-source" href="https://www.ontario.ca/fr/page/augmentation-des-loyers-residentiels" target="_blank" rel="noopener">Source : ontario.ca ↗</a>
      </div>
    </div>
  </section>

  <RecentDeals lang="fr" />

  <section class="major newsletter">
    <div class="wrap">
      <div class="newsletter-inner">
        <div class="section-eyebrow">Rapport de marché mensuel</div>
        <h2 class="section-h">Ce qui se passe vraiment sur le marché immobilier de Toronto.</h2>
        <p class="section-lead">L'information, c'est essentiel. Rapport locations et ventes.<br />Prenez une longueur d'avance en vous abonnant ci-dessous.</p>
        <form class="newsletter-form" method="POST" action="https://peters-newsletter-469474.beehiiv.com/subscribe">
            <label for="newsletter-email" class="sr-only">Adresse courriel</label>
            <input id="newsletter-email" type="email" name="email" placeholder="votre@email.com" required autocomplete="email" />
            <button type="submit" class="btn-primary">S'abonner
              <svg width="14" height="14" viewBox="0 0 14 14" fill="none"><path d="M1 7h12M8 2l5 5-5 5" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/></svg>
            </button>
          </form>
        <p class="newsletter-trust">Désabonnement en tout temps. Votre courriel n'est jamais partagé.</p>
      </div>
    </div>
  </section>

  <FrenchCTASection />

  <FrenchFooter />

</BaseLayout>

<style>
  /* Tighten homepage vertical rhythm, only affects this page */
  .hero { padding-bottom: 40px; padding-top: 56px; }
  .boc-widget + section.major { padding-top: 56px; }

  /* New full-width headline above the hero-grid */
  .hero-headline-block { max-width: 760px; margin-bottom: 40px; }
  .hero-headline-block .eyebrow { margin-bottom: 18px; }
  .hero-headline-block .hero-h { margin: 0; }

  /* Make photo column match form column height, stretch instead of center align */
  .hero-grid { align-items: start; }
  .hero-photo.hero-video {
    aspect-ratio: 806 / 1291;
    height: auto;
    min-height: 0;
    background: #000;
    box-shadow: 0 0 0 4px rgba(198, 150, 65, 0.10), 0 10px 32px -14px rgba(198, 150, 65, 0.32);
  }
  .hero-video video { display: block; width: 100%; height: 100%; object-fit: cover; }

  @media (max-width: 900px) {
    .hero { padding-bottom: 28px; padding-top: 36px; }
    .hero-headline-block { margin-bottom: 28px; }
    .hero-photo.hero-video { aspect-ratio: 806 / 1291; }
    /* Phones: show the video before the questionnaire */
    .hero-grid > div:last-child { order: -1; }
    .hero-photo.hero-video { max-width: 420px; margin: 0 auto; }
  }
  @media (max-width: 720px) {
    .boc-widget + section.major { padding-top: 40px; }
  }
</style>
