---
import BaseLayout from '../../layouts/BaseLayout.astro';
import FrenchTopBar from '../../components/FrenchTopBar.astro';
import FrenchHeader from '../../components/FrenchHeader.astro';
import FrenchFooter from '../../components/FrenchFooter.astro';
import FrenchCTASection from '../../components/FrenchCTASection.astro';
import RecentDeals from '../../components/RecentDeals.astro';
---
<BaseLayout
  title="Peter Law — Agent immobilier de location à Toronto | Trilingue"
  description="Peter Law | Agent immobilier trilingue à Toronto. J'aide les locataires à se faire approuver et à emménager sereinement — service complet, de la recherche aux clés. RECO enregistré · 647-888-8472."
  lang="fr"
  bodyClass="fr"
  hreflangAlternates={[
    { hreflang: 'x-default', href: 'https://www.realtorpeterlaw.com/' },
    { hreflang: 'en-CA', href: 'https://www.realtorpeterlaw.com/' },
    { hreflang: 'fr-CA', href: 'https://www.realtorpeterlaw.com/french/' },
    { hreflang: 'zh-CN', href: 'https://www.realtorpeterlaw.com/chinese/' },
  ]}
>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@graph": [
        {
          "@type": "RealEstateAgent",
          "@id": "https://www.realtorpeterlaw.com/french/#agent",
          "name": "Peter Law",
          "jobTitle": "Représentant commercial",
          "description": "Agent immobilier trilingue à Toronto (anglais, chinois, français). Service complet aux locataires — de la recherche à la remise des clés. Enregistré RECO en Ontario.",
          "url": "https://www.realtorpeterlaw.com/french/",
          "image": "https://www.realtorpeterlaw.com/photos/peter-portrait.webp",
          "telephone": "+1-647-888-8472",
          "email": "Admin@RealtorPeterLaw.com",
          "priceRange": "$$-$$$",
          "knowsLanguage": ["French", "English", "Chinese"],
          "areaServed": [
            { "@type": "City", "name": "Toronto" },
            { "@type": "AdministrativeArea", "name": "Grand Toronto" },
            { "@type": "City", "name": "Markham" }
          ],
          "sameAs": [
            "https://www.realtor.ca/agent/2071856/peter-law-3601-hwy-7-215-markham-ontario-l3r0m3",
            "https://www.instagram.com/realtorpeterlaw",
            "https://www.facebook.com/RealtorPeterLaw",
            "https://www.linkedin.com/in/peter-law-5053a6192"
          ],
          "worksFor": {
            "@type": "RealEstateAgent",
            "name": "HomeLife Golconda Realty Inc., Brokerage",
            "address": {
              "@type": "PostalAddress",
              "streetAddress": "215 - 3601 HWY 7 East",
              "addressLocality": "Markham",
              "addressRegion": "ON",
              "postalCode": "L3R 0M3",
              "addressCountry": "CA"
            }
          }
        },
        {
          "@type": "WebSite",
          "@id": "https://www.realtorpeterlaw.com/french/#website",
          "url": "https://www.realtorpeterlaw.com/french/",
          "name": "Peter Law — Agent immobilier de location à Toronto",
          "publisher": { "@id": "https://www.realtorpeterlaw.com/french/#agent" },
          "inLanguage": ["fr-CA", "en-CA", "zh-CN"]
        },
        {
          "@type": "LocalBusiness",
          "@id": "https://www.realtorpeterlaw.com/french/#brokerage",
          "name": "Peter Law — HomeLife Golconda Realty Inc., Brokerage",
          "url": "https://www.realtorpeterlaw.com/french/",
          "telephone": "+1-647-888-8472",
          "email": "Admin@RealtorPeterLaw.com",
          "image": "https://www.realtorpeterlaw.com/photos/peter-portrait.webp",
          "address": {
            "@type": "PostalAddress",
            "streetAddress": "215 - 3601 HWY 7 East",
            "addressLocality": "Markham",
            "addressRegion": "ON",
            "postalCode": "L3R 0M3",
            "addressCountry": "CA"
          },
          "areaServed": [
            { "@type": "City", "name": "Toronto" },
            { "@type": "AdministrativeArea", "name": "Grand Toronto" }
          ]
        }
      ]
    })} />
  </Fragment>

  <FrenchTopBar />
  <FrenchHeader />

    <section class="proof-bar">
    <div class="wrap proof-grid">
      <div class="proof-item"><div class="proof-num">$10M+ Ventes</div><div class="proof-lbl">6 ans à temps plein</div></div>
      <div class="proof-item"><div class="proof-num"><a class="proof-num-link" href="/">EN · 中文</a></div><div class="proof-lbl">Anglais <span class="nocase">l</span> Chinois</div></div>
      <div class="proof-item"><div class="proof-num">RECO</div><div class="proof-lbl">Inscrit en Ontario</div></div>
      <a class="proof-item proof-link" href="https://www.homelifegolconda.com/" target="_blank" rel="noopener"><div class="proof-num">HomeLife</div><div class="proof-lbl">Golconda Realty Inc.</div></a>
    </div>
  </section>

  <section class="hero">
    <div class="wrap">
      <div class="hero-headline-block">
        <div class="eyebrow">Toronto · Centre-ville · Bord de l'eau</div>
        <h1 class="hero-h">La location à Toronto, <em>faite comme il faut.</em></h1>
      </div>
      <div class="hero-grid">
        <div>
          <form id="rental-questionnaire" class="quiz-form" method="POST" action="https://formspree.io/f/xnjrzgda" style="scroll-margin-top:100px">
            <div class="quiz-eyebrow">Questionnaire de location</div>
            <h2 class="quiz-heading">Que recherchez-vous?</h2>
            <p class="quiz-sub">(Durée minimale de 1 an)</p>
            <div class="quiz-fields">
              <div class="quiz-field">
                <label for="quiz-beds">Chambres*</label>
                <select id="quiz-beds" name="bedrooms" required>
                  <option value="">Sélectionner…</option>
                  <option>Studio</option>
                  <option>1 CAC</option>
                  <option>1 CAC + Bureau</option>
                  <option>2 CAC</option>
                  <option>3 CAC</option>
                  <option>4+ CAC</option>
                </select>
              </div>
              <div class="quiz-field">
                <label for="quiz-baths">Salles de bain*</label>
                <select id="quiz-baths" name="bathrooms" required>
                  <option value="">Sélectionner…</option>
                  <option>1</option><option>1.5</option><option>2</option><option>2.5</option><option>3+</option>
                </select>
              </div>
              <div class="quiz-field">
                <label for="quiz-parking">Stationnement*</label>
                <select id="quiz-parking" name="parking" required>
                  <option value="">Sélectionner…</option>
                  <option>Pas nécessaire</option>
                  <option>1 place</option>
                  <option>2 places</option>
                  <option>3+ places</option>
                </select>
              </div>
              <div class="quiz-field">
                <label for="quiz-budget">Budget / mois*</label>
                <select id="quiz-budget" name="budget" required>
                  <option value="">Sélectionner…</option>
                  <option>Moins de 2 000 $</option>
                  <option>2 000 $ – 2 500 $</option>
                  <option>2 500 $ – 3 000 $</option>
                  <option>3 000 $ – 3 500 $</option>
                  <option>3 500 $ – 4 500 $</option>
                  <option>4 500 $ et plus</option>
                </select>
              </div>
              <div class="quiz-field">
                <label for="quiz-movein">Date d'emménagement*</label>
                <input id="quiz-movein" name="move_in_date" type="date" required>
              </div>
              <div class="quiz-field">
                <label for="quiz-notice">Préavis de 60 jours donné au propriétaire?*</label>
                <select id="quiz-notice" name="landlord_notice_60_days" required>
                  <option value="">Sélectionner…</option>
                  <option>Oui</option>
                  <option>Non</option>
                  <option>Non applicable</option>
                </select>
              </div>
              <div class="quiz-field quiz-field-full">
                <label>Secteur souhaité* <span class="quiz-hint">(cochez toutes les options qui s'appliquent)</span></label>
                <div class="quiz-checkboxes" data-checkbox-group="location">
                  <label class="quiz-check"><input type="checkbox" name="location[]" value="Downtown Toronto (Yonge &amp; Dundas St)"> Centre-ville de Toronto (Yonge &amp; Dundas)</label>
                  <label class="quiz-check"><input type="checkbox" name="location[]" value="King West / Liberty Village"> King West / Liberty Village</label>
                  <label class="quiz-check"><input type="checkbox" name="location[]" value="Yonge & Bloor / Yorkville"> Yonge & Bloor / Yorkville</label>
                  <label class="quiz-check"><input type="checkbox" name="location[]" value="Waterfront / Harbourfront"> Bord de l'eau / Harbourfront</label>
                  <label class="quiz-check"><input type="checkbox" name="location[]" value="Yonge–Eglinton"> Yonge–Eglinton</label>
                  <label class="quiz-check"><input type="checkbox" name="location[]" value="East Toronto (Leslieville, East York)"> Est de Toronto (Leslieville, East York)</label>
                  <label class="quiz-check"><input type="checkbox" name="location[]" value="Markham / GTA North"> Markham / Nord du Grand Toronto</label>
                  <label class="quiz-check"><input type="checkbox" name="location[]" value="Walking distance to Subway Station"> À distance de marche d'une station de métro</label>
                  <label class="quiz-check"><input type="checkbox" name="location[]" value="Walking distance to Union Subway Station"> À distance de marche de la station Union</label>
                  <label class="quiz-check"><input type="checkbox" name="location[]" value="Walking distance to UofT St. George"> À distance de marche de UofT St. George</label>
                  <label class="quiz-check"><input type="checkbox" name="location[]" value="Walking distance to Waterfront"> À distance de marche du bord de l'eau</label>
                  <label class="quiz-check"><input type="checkbox" name="location[]" value="Open to suggestions"> Ouvert aux suggestions</label>
                </div>
              </div>
              <div class="quiz-field quiz-field-full">
                <label for="quiz-email">Courriel*</label>
                <input id="quiz-email" name="email" type="email" required autocomplete="email" placeholder="votre@email.com">
              </div>
            </div>
            <div class="hp-field" aria-hidden="true">
              <label for="quiz-gotcha">Ne pas remplir</label>
              <input id="quiz-gotcha" name="_gotcha" type="text" tabindex="-1" autocomplete="off">
            </div>
            <input type="hidden" name="_subject" value="New Rental Questionnaire (French)">
            <input type="hidden" name="_next" value="https://www.realtorpeterlaw.com/contact/thanks">
            <button type="submit" class="btn-primary quiz-cta">
              Commencer
              <svg width="14" height="14" viewBox="0 0 14 14" fill="none"><path d="M1 7h12M8 2l5 5-5 5" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/></svg>
            </button>
            <div class="quiz-cta-alt">
              <a href="/french/rental-calculator" class="btn-warm quiz-cta-warm">
                <svg width="15" height="15" viewBox="0 0 24 24" fill="none" aria-hidden="true"><rect x="5" y="3" width="14" height="18" rx="2" stroke="currentColor" stroke-width="1.8"/><line x1="8" y1="8" x2="16" y2="8" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/><circle cx="8.5" cy="12.5" r="1.2" fill="currentColor"/><circle cx="12" cy="12.5" r="1.2" fill="currentColor"/><circle cx="15.5" cy="12.5" r="1.2" fill="currentColor"/><circle cx="8.5" cy="16" r="1.2" fill="currentColor"/><circle cx="12" cy="16" r="1.2" fill="currentColor"/><circle cx="15.5" cy="16" r="1.2" fill="currentColor"/></svg>
                Calculateur de location
                <svg width="14" height="14" viewBox="0 0 14 14" fill="none" aria-hidden="true"><path d="M1 7h12M8 2l5 5-5 5" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/></svg>
              </a>
            </div>
          </form>
        </div>
        <div>
          <a href="/french/about" class="hero-photo-link" aria-label="À propos de Peter Law — en savoir plus">
            <div class="hero-photo">
              <img src="/photos/peter-portrait.webp" alt="Peter Law, agent immobilier à Toronto, avec la tour CN en arrière-plan." width="800" height="1006" loading="eager" fetchpriority="high" decoding="async" />
            </div>
          </a>
        </div>
      </div>
    </div>
  </section>


  <section class="boc-widget" aria-label="Taux directeur de la Banque du Canada et plafond d'augmentation des loyers en Ontario">
    <div class="wrap">
      <div class="boc-widget-grid">
        <div class="boc-cell">
          <span class="boc-cell-label">Taux directeur de la Banque du Canada</span>
          <span class="boc-cell-value">2,25<span class="pct">%</span></span>
        </div>
        <div class="boc-divider" aria-hidden="true"></div>
        <div class="boc-cell">
          <span class="boc-cell-label">Prochaine annonce</span>
          <span class="boc-cell-value" style="font-size:21px;">2 septembre 2026</span>
        </div>
        <div class="boc-divider" aria-hidden="true"></div>
        <a class="boc-source" href="https://www.bankofcanada.ca/core-functions/monetary-policy/key-interest-rate/" target="_blank" rel="noopener">Source : bankofcanada.ca ↗</a>
        <hr class="boc-row-rule" aria-hidden="true" />
        <div class="boc-cell">
          <span class="boc-cell-label">Augmentation des loyers en Ontario (2027)</span>
          <span class="boc-cell-value">1,9<span class="pct">%</span></span>
        </div>
        <div class="boc-divider" aria-hidden="true"></div>
        <div class="boc-cell">
          <span class="boc-cell-label">Prochaine annonce</span>
          <span class="boc-cell-value" style="font-size:21px;">1er janvier 2027</span>
        </div>
        <div class="boc-divider" aria-hidden="true"></div>
        <a class="boc-source" href="https://www.ontario.ca/fr/page/augmentation-des-loyers-residentiels" target="_blank" rel="noopener">Source : ontario.ca ↗</a>
      </div>
    </div>
  </section>

  <RecentDeals lang="fr" />

  <section class="major newsletter">
    <div class="wrap">
      <div class="newsletter-inner">
        <div class="section-eyebrow">Rapport de marché mensuel</div>
        <h2 class="section-h">Ce qui se passe vraiment sur le marché immobilier de Toronto.</h2>
        <p class="section-lead">L'information, c'est essentiel. Rapport locations et ventes.<br />Prenez une longueur d'avance en vous abonnant ci-dessous.</p>
        <form class="newsletter-form" method="POST" action="https://peters-newsletter-469474.beehiiv.com/subscribe">
            <label for="newsletter-email" class="sr-only">Adresse courriel</label>
            <input id="newsletter-email" type="email" name="email" placeholder="votre@email.com" required autocomplete="email" />
            <button type="submit" class="btn-primary">S'abonner
              <svg width="14" height="14" viewBox="0 0 14 14" fill="none"><path d="M1 7h12M8 2l5 5-5 5" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/></svg>
            </button>
          </form>
        <p class="newsletter-trust">Désabonnement en tout temps. Votre courriel n'est jamais partagé.</p>
      </div>
    </div>
  </section>

  <FrenchCTASection />

  <FrenchFooter />

  <script>
    document.querySelectorAll('form.quiz-form').forEach(function(form){
      form.addEventListener('submit', function(e){
        var cbs = form.querySelectorAll('input[name="location[]"]');
        if (cbs.length && ![].some.call(cbs, function(cb){ return cb.checked; })) {
          e.preventDefault();
          alert('Veuillez sélectionner au moins un secteur.');
          cbs[0].focus();
        }
      });
    });
  </script>
</BaseLayout>

<style>
  /* Tighten homepage vertical rhythm — only affects this page */
  .hero { padding-bottom: 40px; padding-top: 56px; }
  .boc-widget + section.major { padding-top: 56px; }

  /* New full-width headline above the hero-grid */
  .hero-headline-block { max-width: 760px; margin-bottom: 40px; }
  .hero-headline-block .eyebrow { margin-bottom: 18px; }
  .hero-headline-block .hero-h { margin: 0; }

  /* Make photo column match form column height — stretch instead of center align */
  .hero-grid { align-items: stretch; }
  .hero-photo {
    aspect-ratio: auto;
    height: 100%;
    min-height: 100%;
  }
  .hero-photo-link {
    height: 100%;
    display: block;
  }

  @media (max-width: 900px) {
    .hero { padding-bottom: 28px; padding-top: 36px; }
    .hero-headline-block { margin-bottom: 28px; }
    .hero-photo { aspect-ratio: 4/5; height: auto; min-height: 0; }
  }
  @media (max-width: 720px) {
    .boc-widget + section.major { padding-top: 40px; }
  }
</style>
