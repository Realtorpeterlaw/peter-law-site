---
import BaseLayout from '../../layouts/BaseLayout.astro';
import FrenchTopBar from '../../components/FrenchTopBar.astro';
import FrenchHeader from '../../components/FrenchHeader.astro';
import FrenchFooter from '../../components/FrenchFooter.astro';
import FrenchCTASection from '../../components/FrenchCTASection.astro';

export const prerender = true;

const hreflangAlternates = [
  { hreflang: 'en-CA', href: 'https://www.realtorpeterlaw.com/rental-calculator/' },
  { hreflang: 'zh-CN', href: 'https://www.realtorpeterlaw.com/chinese/rental-calculator/' },
  { hreflang: 'fr-CA', href: 'https://www.realtorpeterlaw.com/french/rental-calculator/' },
  { hreflang: 'x-default', href: 'https://www.realtorpeterlaw.com/rental-calculator/' },
];
---
<BaseLayout
  title="Calculateur de location — pouvez-vous payer ce loyer ? | Peter Law"
  description="Une seule page. Entrez ce que vous gagnez, le loyer, et vos coûts de base. Voyez instantanément si le loyer entre dans votre revenu, si vous allez le sentir, ou si c'est trop serré."
  lang="fr"
  bodyClass="fr calc-page"
  hreflangAlternates={hreflangAlternates}
>
  <FrenchTopBar />
  <FrenchHeader active="rental" />

  <section class="page-hero">
    <div class="wrap">
      <div class="eyebrow">Calculateur de location</div>
      <h1>Abordabilité locative</h1>
      <p>Entrez les variables ci-dessous.</p>
    </div>
  </section>

  <section class="major" style="padding-top: 24px;">
    <div class="wrap">
      <div class="ac-shell">

        <!-- ENTRÉES -->
        <div class="ac-inputs">
          <div class="ac-input-group">
            <label>1. Combien gagnez-vous par mois ? <span class="hint">Avant impôts.</span></label>
            <div class="input-prefix"><input type="number" id="rc-income" value="6500" min="0" step="100" inputmode="decimal" /></div>
          </div>

          <div class="ac-input-group">
            <label>2. Coût mensuel du loyer</label>
            <div class="input-prefix"><input type="number" id="rc-rent" value="2200" min="0" step="50" inputmode="decimal" /></div>
          </div>

          <div class="ac-section-h ac-inline-h">Dépenses mensuelles</div>

          <div class="ac-input-group">
            <label>3. <span class="rc-icon-label"><span class="rc-icon" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg"><path d="M2 8.5C5 5.5 8.5 4 12 4s7 1.5 10 4.5" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/><path d="M5 12c2-2 4.5-3 7-3s5 1 7 3" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/><path d="M8.5 15.5c1-1 2.2-1.5 3.5-1.5s2.5 0.5 3.5 1.5" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/><circle cx="12" cy="19" r="1.4" fill="currentColor"/></svg></span><span>Internet</span></span> <span class="hint">Frais Internet approximatifs, 55 $ à 100 $ par mois.</span></label>
            <div class="input-prefix"><input type="number" id="rc-internet" value="80" min="0" step="5" inputmode="decimal" /></div>
          </div>

          <div class="ac-input-group">
            <label>4. <span class="rc-icon-label"><span class="rc-icon" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg"><path d="M12 3l8 3v6c0 4.5-3.4 8.4-8 9-4.6-0.6-8-4.5-8-9V6l8-3z" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round"/><path d="M9 12l2 2 4-4" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg></span><span>Assurance responsabilité locataire</span></span> <span class="hint">15 $ à 30 $ par mois.</span></label>
            <div class="input-prefix"><input type="number" id="rc-insurance" value="22" min="0" step="1" inputmode="decimal" /></div>
          </div>

          <div class="ac-input-group">
            <label>5. <span class="rc-icon-label"><span class="rc-icon" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg"><path d="M13 3L5 14h6l-1 7 8-11h-6l1-7z" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round" fill="none"/></svg></span><span>Services publics</span></span> <span class="hint">Frais approximatifs, 60 $ à 100 $ par mois.*</span></label>
            <div class="input-prefix"><input type="number" id="rc-utilities" value="100" min="0" step="5" inputmode="decimal" /></div>
          </div>

          <p class="rc-hint-note">*Chaque condo est différent MAIS toutes les unités d'un immeuble ont le même fournisseur de services publics.<br /><br />Certains condos ou appartements PEUVENT inclure le chauffage, l'eau, les meubles, et dans de rares cas l'Internet ou TOUS les services publics. Vérifiez avec votre agent immobilier.</p>
        </div>

        <!-- RÉSULTATS -->
        <div class="ac-results">
          <!-- Jauge d'abordabilité -->
          <div class="rc-meter-card">
            <div class="rc-meter-head">
              <div class="rc-meter-title">Logement en % de votre revenu</div>
              <div class="rc-meter-pct"><span id="rc-meter-pct">0 %</span></div>
            </div>
            <div class="rc-meter-bar" aria-hidden="true">
              <div class="rc-meter-fill" id="rc-meter-fill" style="width: 0%"></div>
              <div class="rc-meter-tick" style="left: 30%"><span class="rc-meter-tick-label" style="left: 50%;">30 %</span></div>
              <div class="rc-meter-tick" style="left: 40%"><span class="rc-meter-tick-label" style="left: 50%;">40 %</span></div>
            </div>
            <div class="rc-meter-tiers">
              <span class="tier-safe">Zone sûre</span>
              <span class="tier-tight">Tendu</span>
              <span class="tier-over">Trop élevé</span>
            </div>
          </div>

          <!-- Deux cartes principales -->
          <div class="ac-headline">
            <div class="ac-headline-item">
              <div class="ac-headline-label">Coût mensuel total du logement</div>
              <div class="ac-headline-value" id="rc-out-total">0 $</div>
              <div class="ac-headline-sub">Loyer + Internet + assurance + services publics.</div>
            </div>
            <div class="ac-headline-item">
              <div class="ac-headline-label">Dépenses mensuelles (sans loyer)</div>
              <div class="ac-headline-value"><span id="rc-leftover">0 $</span><span class="ac-headline-per"> / mois</span></div>
            </div>
          </div>

          <!-- Carte verdict avec grande icône -->
          <div class="rc-verdict" id="rc-verdict">
            <div class="rc-verdict-icon" id="rc-verdict-icon" aria-hidden="true"></div>
            <div class="rc-verdict-body">
              <div class="rc-verdict-title" id="rc-verdict-title">Entrez vos chiffres ci-dessus.</div>
              <div class="rc-verdict-sub" id="rc-verdict-sub">Sous 30 % du revenu en logement est la zone sûre. Entre 30 % et 40 % est tendu. Au-dessus de 40 % et la plupart des propriétaires refusent.</div>
            </div>
          </div>

          <h3 class="ac-section-h">Où va l'argent</h3>
          <div class="ac-breakdown">
            <div class="ac-row"><span>Loyer</span><strong id="rc-out-rent">0 $</strong></div>
            <div class="ac-row"><span>Internet</span><strong id="rc-out-internet">0 $</strong></div>
            <div class="ac-row"><span>Assurance responsabilité locataire</span><strong id="rc-out-insurance">0 $</strong></div>
            <div class="ac-row"><span>Services publics</span><strong id="rc-out-utilities">0 $</strong></div>
            <div class="ac-row ac-row-total"><span>Coût mensuel total du logement</span><strong id="rc-out-total-2">0 $</strong></div>
          </div>

          <h3 class="ac-section-h">Test de réalité</h3>
          <div class="ac-checks">
            <div class="ac-check">
              <div class="ac-check-label">Logement en % de votre revenu</div>
              <div class="ac-check-value" id="rc-pct">0 %</div>
              <div class="ac-check-sub">Loyer + Internet + assurance + services publics, divisé par le revenu mensuel. Sous 30 % est la zone sûre.</div>
            </div>
            <div class="ac-check">
              <div class="ac-check-label">Ligne des 30 % du revenu</div>
              <div class="ac-check-value" id="rc-30line">0 $/mois</div>
              <div class="ac-check-sub">Le plafond de la zone sûre. Si votre logement mensuel total reste sous cette ligne, vous êtes confortable.</div>
            </div>
            <div class="ac-check">
              <div class="ac-check-label">Loyer qui vous garde dans la zone sûre</div>
              <div class="ac-check-value" id="rc-approve">0 $</div>
              <div class="ac-check-sub">Loyer maximum calculé automatiquement qui garde le logement à 30 % du revenu compte tenu de vos autres coûts. Une cible, pas une promesse.</div>
            </div>
            <div class="ac-check">
              <div class="ac-check-label">Coussin par rapport au plafond de la zone sûre</div>
              <div class="ac-check-value" id="rc-cushion">0 $</div>
              <div class="ac-check-sub">Nombre positif = marge à revendre ; négatif = vous dépassez la ligne des 30 % de ce montant par mois.</div>
            </div>
          </div>

          <p class="calc-disclaimer">Chiffres à titre indicatif. La plupart des propriétaires torontois utilisent 30 à 33 % du revenu mensuel brut comme seuil d'abordabilité, bien que des garants, un excellent crédit, des mois de loyer d'avance ou des baux corporatifs puissent étirer cela. Les services publics varient beaucoup selon l'immeuble — demandez toujours ce qui est inclus dans le bail. C'est un outil de dépistage, pas une approbation. Discutez de votre situation avec un agent immobilier licencié avant de signer. Voir l'<a href="/french/disclaimer#calculators">Avis de non-responsabilité</a> pour le détail complet.</p>
        </div>
      </div>
    </div>
  </section>

  <FrenchCTASection heading="Vous n'êtes pas sûr qu'une inscription vous convienne ?" lead="Envoyez-moi l'adresse et votre revenu — je vous dirai honnêtement si le propriétaire va vous approuver, si le prix est juste, et si c'est le bon moment pour négocier." />

  <FrenchFooter />

  <script is:inline>
    (function() {
      function fmtCAD(n, dp) {
        if (dp === undefined) dp = 0;
        if (!isFinite(n) || isNaN(n)) return '0 $';
        return n.toLocaleString('fr-CA', { style: 'currency', currency: 'CAD', maximumFractionDigits: dp, minimumFractionDigits: dp });
      }

      // Grandes icônes SVG pour la carte verdict
      const ICON_CHECK = '<svg viewBox="0 0 64 64" xmlns="http://www.w3.org/2000/svg"><circle cx="32" cy="32" r="30" fill="none" stroke="currentColor" stroke-width="4"/><path d="M18 33 L28 43 L46 23" fill="none" stroke="currentColor" stroke-width="6" stroke-linecap="round" stroke-linejoin="round"/></svg>';
      const ICON_WARN  = '<svg viewBox="0 0 64 64" xmlns="http://www.w3.org/2000/svg"><circle cx="32" cy="32" r="30" fill="none" stroke="currentColor" stroke-width="4"/><line x1="32" y1="18" x2="32" y2="36" stroke="currentColor" stroke-width="6" stroke-linecap="round"/><circle cx="32" cy="46" r="3.6" fill="currentColor"/></svg>';
      const ICON_CROSS = '<svg viewBox="0 0 64 64" xmlns="http://www.w3.org/2000/svg"><circle cx="32" cy="32" r="30" fill="none" stroke="currentColor" stroke-width="4"/><line x1="20" y1="20" x2="44" y2="44" stroke="currentColor" stroke-width="6" stroke-linecap="round"/><line x1="44" y1="20" x2="20" y2="44" stroke="currentColor" stroke-width="6" stroke-linecap="round"/></svg>';

      const $ = (id) => document.getElementById(id);
      const inputs = ['rc-income', 'rc-rent', 'rc-internet', 'rc-insurance', 'rc-utilities'];
      inputs.forEach((id) => { const el = $(id); if (!el) return; el.addEventListener('input', recompute); el.addEventListener('change', recompute); });

      function recompute() {
        const income    = Math.max(0, parseFloat($('rc-income').value)    || 0);
        const rent      = Math.max(0, parseFloat($('rc-rent').value)      || 0);
        const internet  = Math.max(0, parseFloat($('rc-internet').value)  || 0);
        const insurance = Math.max(0, parseFloat($('rc-insurance').value) || 0);
        const utilities = Math.max(0, parseFloat($('rc-utilities').value) || 0);

        const totalHousing = rent + internet + insurance + utilities;
        const pct = income > 0 ? (totalHousing / income) * 100 : 0;
        const leftover = income - totalHousing;
        const expensesNoRent = internet + insurance + utilities;
        const safeCeiling = income * 0.30;
        const approvableRent = Math.max(0, income * 0.30 - internet - insurance - utilities);

        $('rc-out-total').textContent     = fmtCAD(totalHousing, 0);
        $('rc-out-total-2').textContent   = fmtCAD(totalHousing, 0);
        $('rc-leftover').textContent      = fmtCAD(expensesNoRent, 0);
        $('rc-out-rent').textContent      = fmtCAD(rent, 0);
        $('rc-out-internet').textContent  = fmtCAD(internet, 0);
        $('rc-out-insurance').textContent = fmtCAD(insurance, 0);
        $('rc-out-utilities').textContent = fmtCAD(utilities, 0);

        // Jauge d'abordabilité
        const clamped = Math.max(0, Math.min(100, pct));
        const fillEl = $('rc-meter-fill');
        fillEl.style.width = clamped.toFixed(1) + '%';
        fillEl.classList.remove('tier-yellow', 'tier-red');
        if (pct > 40)      fillEl.classList.add('tier-red');
        else if (pct > 30) fillEl.classList.add('tier-yellow');
        $('rc-meter-pct').textContent = pct.toFixed(1).replace('.', ',') + ' %';

        $('rc-pct').textContent      = pct.toFixed(1).replace('.', ',') + ' %';
        $('rc-30line').textContent   = fmtCAD(safeCeiling, 0) + '/mois';
        $('rc-approve').textContent  = fmtCAD(approvableRent, 0);
        const cushion = safeCeiling - totalHousing;
        $('rc-cushion').textContent  = (cushion >= 0 ? '+' : '−') + fmtCAD(Math.abs(cushion), 0) + '/mois';

        // Verdict
        const v = $('rc-verdict');
        const iconEl = $('rc-verdict-icon');
        let vTitle, vSub, vClass, vIcon;

        if (income <= 0 || rent <= 0) {
          vTitle = 'Entrez vos chiffres ci-dessus.';
          vSub = 'Sous 30 % du revenu en logement est la zone sûre. Entre 30 % et 40 % est tendu. Au-dessus de 40 % et la plupart des propriétaires refusent.';
          vClass = 'rc-verdict-neutral';
          vIcon = '';
        } else if (pct <= 30) {
          vTitle = 'Oui — vous pouvez payer ce loyer.';
          vSub = 'Le logement est à ' + pct.toFixed(1).replace('.', ',') + ' % de votre revenu — dans la zone sûre. Les propriétaires approuvent ce genre de demandes toute la journée.';
          vClass = 'rc-verdict-green';
          vIcon = ICON_CHECK;
        } else if (pct <= 40) {
          vTitle = 'Tendu. Faisable, mais vous le sentirez.';
          vSub = 'Le logement est à ' + pct.toFixed(1).replace('.', ',') + ' % de votre revenu — au-dessus de la ligne de confort de 30 % mais encore accessible. Épicerie, transport et épargne seront plus serrés. Le propriétaire peut demander un garant ou plusieurs mois de loyer d\'avance.';
          vClass = 'rc-verdict-yellow';
          vIcon = ICON_WARN;
        } else if (pct < 80) {
          vTitle = 'Possible, mais parlez-en avec votre agent immobilier.';
          vSub = 'Le logement est à ' + pct.toFixed(1).replace('.', ',') + ' % de votre revenu — la plupart des propriétaires diront non à ce ratio. Exceptions possibles : garant, loyer d\'avance, bail corporatif, excellent crédit. Parlez à un agent immobilier licencié avant de soumettre.';
          vClass = 'rc-verdict-red';
          vIcon = ICON_CROSS;
        } else {
          vTitle = "Malheureusement, votre ratio revenu/loyer est trop élevé et ne suffira pas dans le marché actuel.";
          vSub = 'Le logement est à ' + pct.toFixed(1).replace('.', ',') + ' % de votre revenu. À ce ratio, quasiment aucun propriétaire n\'approuvera — la limite standard que la plupart des courtiers appliquent est autour de 33 à 40 %. Envisagez une unité moins chère, un cosignataire, ou augmentez votre revenu vérifiable avant de postuler.';
          vClass = 'rc-verdict-red';
          vIcon = ICON_CROSS;
        }

        v.classList.remove('rc-verdict-neutral', 'rc-verdict-green', 'rc-verdict-yellow', 'rc-verdict-red');
        v.classList.add(vClass);
        iconEl.innerHTML = vIcon;
        $('rc-verdict-title').textContent = vTitle;
        $('rc-verdict-sub').textContent = vSub;
      }

      recompute();
    })();
  </script>

  <style is:global>
    .ac-input-group label .hint { display: block; font-weight: 400; color: var(--ink-mute); font-size: 12px; margin-top: 4px; margin-left: 0; }
    .ac-inline-h { margin: 6px 0 -4px; font-size: 13px; letter-spacing: 0.14em; text-transform: uppercase; color: var(--ink-mute); font-weight: 600; }
    .rc-hint-note { margin-top: 6px; padding: 12px 14px; background: var(--bg-warm); border-left: 3px solid rgba(198, 150, 65, 0.55); border-radius: 3px; font-size: 12.5px; color: var(--ink-soft); line-height: 1.55; }

    .ac-headline-per {
      font-family: 'Fraunces', Georgia, serif;
      font-size: 0.55em;
      font-weight: 400;
      color: var(--ink-soft);
      letter-spacing: 0.01em;
      margin-left: 4px;
      vertical-align: baseline;
    }
    .rc-verdict {
      display: flex;
      align-items: center;
      gap: 20px;
      padding: 22px 24px;
      border-radius: 8px;
      border: 1px solid var(--rule);
      background: var(--surface);
      transition: background 0.2s, border-color 0.2s;
    }
    @media (max-width: 560px) {
      .rc-verdict { gap: 16px; padding: 18px 18px; }
    }
    .rc-verdict-icon { flex: 0 0 72px; width: 72px; height: 72px; display: flex; align-items: center; justify-content: center; color: var(--ink-mute); }
    .rc-verdict-icon svg { width: 100%; height: 100%; }
    .rc-verdict-body { flex: 1 1 auto; }
    .rc-verdict-title { font-family: 'Fraunces', Georgia, serif; font-weight: 500; font-size: 22px; line-height: 1.2; color: var(--ink); margin-bottom: 6px; }
    .rc-verdict-sub { font-size: 13.5px; color: var(--ink-soft); line-height: 1.55; }

    .rc-verdict-neutral { }
    .rc-verdict-green   { background: #f0f6f0; border-color: #cfe0cf; }
    .rc-verdict-green .rc-verdict-icon   { color: #4a8a4a; }
    .rc-verdict-yellow  { background: #fbf6ea; border-color: #ead9a8; }
    .rc-verdict-yellow .rc-verdict-icon  { color: #c69625; }
    .rc-verdict-red     { background: #fbf0ee; border-color: #e6c7c1; }
    .rc-verdict-red .rc-verdict-icon     { color: #b64830; }
  </style>
</BaseLayout>
