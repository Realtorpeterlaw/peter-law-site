---
import BaseLayout from '../layouts/BaseLayout.astro';
import TopBar from '../components/TopBar.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import CTASection from '../components/CTASection.astro';
import { DISTRICTS, SCHOOLS } from '../map/neighborhood-data.js';

export const prerender = true;

// Figures for the page description come from the map's own data, so they always match the map.
type District = { condos: string[] };
const districts = Object.values(DISTRICTS as Record<string, District>);
const totalBuildings = districts.reduce((n, d) => n + d.condos.reduce((m, c) => m + c.split(';').length, 0), 0);
const totalSchools = Object.values(SCHOOLS as Record<string, unknown[]>).reduce((n, l) => n + l.length, 0);

const title = 'Toronto Neighborhood Map: Districts, Condos & Schools | Peter Law';
const description = `Interactive map of Toronto's real estate districts, W01 to E11: neighbourhoods, ${totalBuildings} condominium buildings, ${totalSchools} schools, subway stations, groceries and local highlights for each district.`;
const pageUrl = 'https://www.realtorpeterlaw.com/neighborhood';
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'WebPage',
  name: 'Toronto Neighborhood Map',
  description,
  url: pageUrl,
  inLanguage: 'en-CA',
  author: { '@type': 'Person', name: 'Peter Law', url: 'https://www.realtorpeterlaw.com/about' },
};
---
<BaseLayout title={title} description={description} bodyClass="guide-page nb-page">
  <TopBar />
  <Header active="neighborhood" />

  <section class="page-hero nb-hero">
    <div class="wrap">
      <div class="eyebrow">Neighborhood · Toronto districts</div>
      <h1>Toronto's Condo Map</h1>
      <ul class="nb-legend" aria-label="Map legend">
        <li><svg class="nb-legend-pin" width="16" height="22" viewBox="0 0 16 22" aria-hidden="true"><path d="M8 0.8C4.1 0.8 1 3.9 1 7.8c0 5.2 7 13.4 7 13.4s7-8.2 7-13.4C15 3.9 11.9 0.8 8 0.8z" fill="#e0245e" stroke="#9f1239" stroke-width="1"/><circle cx="8" cy="7.8" r="2.6" fill="#fff"/></svg>Red pin = Condo</li>
        <li><svg class="nb-legend-pin" width="16" height="22" viewBox="0 0 16 22" aria-hidden="true"><path d="M8 0.8C4.1 0.8 1 3.9 1 7.8c0 5.2 7 13.4 7 13.4s7-8.2 7-13.4C15 3.9 11.9 0.8 8 0.8z" fill="#7b3fbf" stroke="#55288a" stroke-width="1"/><circle cx="8" cy="7.8" r="2.6" fill="#fff"/></svg>Purple pin = Loft</li>
        <li><svg class="nb-legend-pin" width="16" height="22" viewBox="0 0 16 22" aria-hidden="true"><path d="M8 0.8C4.1 0.8 1 3.9 1 7.8c0 5.2 7 13.4 7 13.4s7-8.2 7-13.4C15 3.9 11.9 0.8 8 0.8z" fill="#aab1ba" stroke="#6b737d" stroke-width="1"/><circle cx="8" cy="7.8" r="2.6" fill="#fff"/></svg>Grey pin = Pre-Con</li>
        <li><span class="nb-legend-dots" aria-hidden="true"><i style="background:#f2b600"></i><i style="background:#1a9a50"></i><i style="background:#a3238e"></i></span>Dots = Subway Station</li>
        <li><svg class="nb-legend-icon" width="22" height="22" viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12.5" r="11.5" fill="#fff" stroke="#c3cad3"/><path d="M2.2 3.4h3.1l2.3 10.2h10.3l2-7.4H6.2" fill="#fff" stroke="#16202b" stroke-width="2.1" stroke-linecap="round" stroke-linejoin="round"/><path d="M8.6 9.3h10.2M12.9 6.4v7M9.3 6.4l.9 7M16.6 6.4l-.6 7" stroke="#16202b" stroke-width="1.1" fill="none"/><circle cx="9.3" cy="18.6" r="1.9" fill="#16202b"/><circle cx="16.6" cy="18.6" r="1.9" fill="#16202b"/></svg>Cart = Grocery Store</li>
        <li><svg class="nb-legend-icon" width="24" height="24" viewBox="0 0 24 24" fill="#fff" stroke="#16202b" stroke-width="1.6" stroke-linejoin="round" stroke-linecap="round" aria-hidden="true"><circle cx="12" cy="12" r="11.4" stroke="#c3cad3" stroke-width="1"/><path d="M12 4.2 2.2 9l9.8 4.8L21.8 9z"/><path d="M6.2 11.2v4.6c0 1.6 2.6 2.9 5.8 2.9s5.8-1.3 5.8-2.9v-4.6" fill="none"/><path d="M3.4 9.9v4.9"/><rect x="2.5" y="14.8" width="1.8" height="2.6" rx=".6"/></svg>Cap = University / College</li>
      </ul>
    </div>
  </section>

  <section class="nb-map-section" aria-labelledby="nb-map-h">
    <div class="wrap">
      <h2 id="nb-map-h" class="visually-hidden">Interactive map</h2>
      <a class="btn-primary nb-fullscreen" href="/neighborhood-map">
        <svg width="15" height="15" viewBox="0 0 16 16" fill="none" aria-hidden="true"><path d="M1.5 5.5v-4h4M10.5 1.5h4v4M14.5 10.5v4h-4M5.5 14.5h-4v-4" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"/></svg>
        Open the map full screen
      </a>
      <div class="nb-frame">
        <iframe id="nb-map" src="/neighborhood-map" title="Interactive map of Toronto real estate districts" loading="eager"></iframe>
      </div>
    </div>
  </section>

  <CTASection heading="Looking at a particular neighbourhood?" lead="Tell me which districts you are weighing and I will walk you through the buildings, prices and trade-offs in each. Fifteen-minute call, no pitch." />
  <Footer />

  <script type="application/ld+json" is:inline set:html={JSON.stringify(jsonLd)} />
</BaseLayout>

<style>
  .nb-hero { padding-bottom: 28px; }
  .nb-legend { list-style: none; margin: 4px 0 0; display: inline-grid; grid-template-columns: repeat(3, auto); justify-content: start; gap: 10px 28px; font-size: 17px; color: var(--ink-soft); padding: 12px 20px; border: 1px solid var(--rule); border-radius: 10px; background: var(--surface); box-shadow: 0 0 0 1px rgba(224, 36, 94, 0.22), 0 10px 30px -6px rgba(224, 36, 94, 0.45), 0 0 42px -2px rgba(123, 63, 191, 0.38); animation: nb-aura 4s ease-in-out infinite alternate; }
  @keyframes nb-aura { to { box-shadow: 0 0 0 1px rgba(123, 63, 191, 0.26), 0 10px 34px -6px rgba(123, 63, 191, 0.48), 0 0 48px 0 rgba(224, 36, 94, 0.40); } }
  @media (prefers-reduced-motion: reduce) { .nb-legend { animation: none; } }
  .nb-legend-icon { flex: none; }
  .nb-legend li { display: inline-flex; align-items: center; gap: 10px; }
  .nb-legend-pin { flex: none; }
  .nb-legend-dots { display: inline-flex; gap: 4px; }
  .nb-legend-dots i { display: block; width: 11px; height: 11px; border-radius: 50%; border: 1.5px solid #fff; box-shadow: 0 0 0 1px rgba(0, 0, 0, 0.25); }
  .nb-map-section { padding: 0 0 8px; }
  .nb-frame { position: relative; border: 1px solid var(--rule); border-radius: 10px; overflow: hidden; background: #cfe3ee; box-shadow: 0 10px 30px -18px rgba(0, 0, 0, 0.35); }
  .nb-frame iframe { display: block; width: 100%; height: min(78vh, 820px); min-height: 520px; border: 0; }
  .nb-fullscreen { display: inline-flex; align-items: center; gap: 10px; margin: 0 0 16px; font-weight: 700; }
  .visually-hidden { position: absolute; width: 1px; height: 1px; overflow: hidden; clip: rect(0 0 0 0); white-space: nowrap; }

  @media (max-width: 720px) {
    .nb-legend { grid-template-columns: 1fr; }
    .nb-frame { border-radius: 8px; }
    .nb-frame iframe { height: 72vh; min-height: 440px; }
  }
</style>
